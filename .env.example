# Local development only. In Azure these are App Service settings (secrets = Key Vault references, see infra/main.bicep).
NODE_ENV=development
PORT=8080
PUBLIC_BASE_URL=http://localhost:8080
# Local: no Google needed — reads local-data/fixture.json
APS_DATA_MODE=fixture
APS_FIXTURE_PATH=local-data/fixture.json
# LOCAL ONLY: /dev/login?email=... signs in without Google. Refused in Azure.
DEV_LOGIN=1
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Same names and JSON-array format as the Apps Script Script Properties
SUPERADMIN_EMAILS=[]
ADMIN_EMAILS=[]
HEADMASTER_EMAILS=[]
VCFO_AMCHATS_BOD_EMAILS=[]
ON_CALL_COORDINATOR_EMAILS=[]
# With APS_DATA_MODE=sheets (needs the Phase 0 service account):
TARGET_SPREADSHEET_ID=
# Attendance spreadsheet (Script Property of the same name) — Meet link map sheets
ATTENDANCE_SPREADSHEET_ID=
GOOGLE_IMPERSONATE_USER=
GOOGLE_SERVICE_ACCOUNT_JSON=
# Phase 3 — Apps Script live-data bridge (online now, last login, class status …). Local fixture mode reads "live"
# from the fixture file instead. In Azure: APPS_SCRIPT_BRIDGE_URL = the live /exec address; the secret is a Key Vault
# reference (apps-script-bridge-secret) with the same value as Script Property AZURE_BRIDGE_SECRET.
APPS_SCRIPT_BRIDGE_URL=
APPS_SCRIPT_BRIDGE_SECRET=

/* =============================================================================
 *  SYSTEM BACKUP + AUDIT ARCHIVE (r49, Oct 2026)
 *  - apsWeeklyMaintenance (time trigger, Sunday ~2 AM America/New_York):
 *      1. full backup  -> new dated folder inside APS-DASHBOAD-SYSTEM-BACKUP-CLAUDE (Script Property APS_BACKUP_FOLDER_ID):
 *           copy of this Apps Script project (code + manifest), copies of every dashboard spreadsheet
 *           (main / Attendance / Exam Question Paper), and a MANIFEST.txt (IDs, sizes, non-secret Script Properties).
 *         Only the newest APS_BACKUP_KEEP (default 8) backup folders are kept; older ones go to Drive Trash (recoverable 30 days).
 *      2. audit archive -> rows older than APS_AUDIT_RETENTION_DAYS (default 90) in the audit / log sheets are COPIED to the
 *         yearly "APS Dashboard Audit Archive <year> (<ENV>)" spreadsheet in the same folder, verified, and only then removed
 *         from the live sheet. Never touched: Exam Question Paper downloads, letters (Appreciation / Reference), Grade change
 *         requests, Roster/Grading data, Attendance week sheets. A backup always runs first.
 *  - Admin / Super Admin UI (User Roles tab card): status + preview, "Back up now", "Archive now" — server re-checks the role.
 *  Restore: open the dated backup folder -> "Make a copy" of the needed spreadsheet / script, or copy rows back from the
 *  archive spreadsheet. See dashboard-architecture-and-config.md, Round 49.
 * ============================================================================= */
var APS_BACKUP_FOLDER_DEFAULT_ = '1B9qATFrfcqbafzqYMBnbshGo0mA4nQTY'; // APS-DASHBOAD-SYSTEM-BACKUP-CLAUDE (owner: info@)
var APS_BACKUP_PREFIX_ = 'APS-Dashboard-Backup ';
var APS_ARCHIVE_PREFIX_ = 'APS Dashboard Audit Archive ';
var APS_MAINT_LOG_PROP_ = 'APS_MAINTENANCE_LAST_JSON';
var APS_AUDIT_ARCHIVE_SHEETS_DEFAULT_ = [
  'Attendance_Audit_Log', 'Class_Access_Audit', 'Examination_Audit_Log', 'Roster_Audit_Log', 'Roster_Sync_Log',
  'Student_Classroom_Assignment_Audit', 'Teacher_Availability_Email_Log', 'EXAM_QUESTION_PAPER_AUDIT'
];
function apsBackupFolderId_() { return String(rosterProp_('APS_BACKUP_FOLDER_ID', APS_BACKUP_FOLDER_DEFAULT_)).trim(); }
function apsAuditRetentionDays_() { var d = Number(rosterProp_('APS_AUDIT_RETENTION_DAYS', '90')); return d >= 30 && d <= 3650 ? Math.floor(d) : 90; }
function apsBackupKeep_() { var n = Number(rosterProp_('APS_BACKUP_KEEP', '8')); return n >= 2 && n <= 60 ? Math.floor(n) : 8; }
function apsMaintenanceEnabled_() { return String(rosterProp_('APS_MAINTENANCE_ENABLED', 'true')).trim().toLowerCase() !== 'false'; }
function apsAuditArchiveSheets_() {
  var raw = rosterProp_('APS_AUDIT_ARCHIVE_SHEETS', '');
  if (raw) { try { var l = JSON.parse(raw); if (Array.isArray(l) && l.length) return l.map(String); } catch (e) { /* default */ } }
  return APS_AUDIT_ARCHIVE_SHEETS_DEFAULT_.slice();
}

/** Every dashboard spreadsheet that exists in this environment: [{ label, ss }] (unique by ID; unconfigured ones skipped). */
function apsMaintenanceWorkbooks_() {
  var out = [], seen = {};
  var add = function (label, fn) {
    try { var ss = fn(); if (ss && !seen[ss.getId()]) { seen[ss.getId()] = true; out.push({ label: label, ss: ss }); } }
    catch (e) { console.warn('[Maintenance] ' + label + ' workbook not available: ' + (e && e.message)); }
  };
  add('Main', getWorkbook_);
  add('Attendance', getAttendanceWorkbook_);
  add('ExamQuestionPaper', examQpSpreadsheet_);
  return out;
}

/** Column index (0-based) holding the row's date/time: first header like Timestamp / Time / Date / At whose rows parse as dates. */
function apsAuditDateCol_(header, rows) {
  var cands = [];
  header.forEach(function (h, i) { if (/time ?stamp|date|time|^at$|_at$| at$|when|logged/i.test(String(h || ''))) cands.push(i); });
  if (cands.indexOf(0) === -1) cands.push(0);
  var sample = rows.slice(0, 40);
  for (var c = 0; c < cands.length; c++) {
    var ok = 0;
    sample.forEach(function (r) { if (apsAuditRowTime_(r[cands[c]]) !== null) ok++; });
    if (sample.length && ok >= Math.ceil(sample.length * 0.6)) return cands[c];
  }
  return -1;
}
function apsAuditRowTime_(v) {
  if (v instanceof Date) return isNaN(v.getTime()) ? null : v.getTime();
  var s = String(v || '').trim();
  if (!s) return null;
  var m = s.match(/^(\d{1,2})\/(\d{1,2})\/(\d{4})(?:[ T,]+(\d{1,2}):(\d{2}))?/); // MM/DD/YYYY [HH:MM]
  if (m) return new Date(Number(m[3]), Number(m[1]) - 1, Number(m[2]), Number(m[4] || 0), Number(m[5] || 0)).getTime();
  if (/^\d{4}-\d{2}-\d{2}/.test(s)) { var t = new Date(s.replace(' ', 'T')).getTime(); return isNaN(t) ? null : t; }
  return null;
}

/** Read-only scan: what an archive run would move. [{ workbook, sheet, rows, old, dateColumn, skipped? }] */
function apsAuditArchivePlan_(cutoffMs) {
  var names = apsAuditArchiveSheets_(), plan = [];
  apsMaintenanceWorkbooks_().forEach(function (wb) {
    names.forEach(function (name) {
      var sh = wb.ss.getSheetByName(name);
      if (!sh || sh.getLastRow() < 2) return;
      var lastCol = sh.getLastColumn();
      var values = sh.getRange(1, 1, sh.getLastRow(), lastCol).getValues();
      var header = values[0], rows = values.slice(1);
      var col = apsAuditDateCol_(header, rows);
      if (col < 0) { plan.push({ workbook: wb.label, sheet: name, rows: rows.length, old: 0, skipped: 'no date column found' }); return; }
      var oldIdx = [];
      rows.forEach(function (r, i) { var t = apsAuditRowTime_(r[col]); if (t !== null && t < cutoffMs) oldIdx.push(i); });
      plan.push({ workbook: wb.label, sheet: name, rows: rows.length, old: oldIdx.length, dateColumn: String(header[col] || ('column ' + (col + 1))),
        _sh: sh, _ss: wb.ss, _header: header, _rows: rows, _oldIdx: oldIdx, _lastCol: lastCol });
    });
  });
  return plan;
}

function apsBackupRootFolder_() {
  var id = apsBackupFolderId_();
  if (!id) throw new Error('Backup folder is not configured (Script Property APS_BACKUP_FOLDER_ID).');
  try { return DriveApp.getFolderById(id); }
  catch (e) { throw new Error('The backup folder (APS_BACKUP_FOLDER_ID) cannot be opened by the dashboard account. Share it with that account as Editor.'); }
}
function apsEnvLabel_() { return getDashboardEnvironment_().key; }
function apsStamp_(d) { return Utilities.formatDate(d || new Date(), APS_TZ, 'yyyy-MM-dd HHmm'); }

/** Full backup into a new dated folder. Returns { folderId, folderUrl, files:[...], errors:[...] }. */
function apsSystemBackup_(reason, actor) {
  var root = apsBackupRootFolder_();
  var now = new Date(), env = apsEnvLabel_();
  var folder = root.createFolder(APS_BACKUP_PREFIX_ + env + ' ' + apsStamp_(now));
  var files = [], errors = [];
  try {
    var script = DriveApp.getFileById(ScriptApp.getScriptId());
    var sc = script.makeCopy('APS Dashboard SCRIPT (code) ' + env + ' ' + apsStamp_(now), folder);
    files.push({ kind: 'Apps Script project', name: sc.getName(), id: sc.getId() });
  } catch (e) { errors.push('Script project copy: ' + (e && e.message)); }
  apsMaintenanceWorkbooks_().forEach(function (wb) {
    try {
      var c = DriveApp.getFileById(wb.ss.getId()).makeCopy(wb.label + ' workbook ' + env + ' ' + apsStamp_(now) + ' (' + wb.ss.getName() + ')', folder);
      files.push({ kind: wb.label + ' spreadsheet', name: c.getName(), id: c.getId(), sourceId: wb.ss.getId(), sheets: wb.ss.getSheets().length });
    } catch (e) { errors.push(wb.label + ' spreadsheet copy: ' + (e && e.message)); }
  });
  var props = PropertiesService.getScriptProperties().getProperties(), safe = {};
  Object.keys(props).sort().forEach(function (k) {
    if (/SECRET|TOKEN|PASSWORD|PRIVATE|CLIENT_ID|API_KEY|_KEY$|KEY_SECRET/i.test(k)) { safe[k] = '(not copied — secret; restore from ENV_VARIABLE_' + env + '.gs)'; return; }
    var v = String(props[k]); safe[k] = v.length > 400 ? v.slice(0, 400) + '… (' + v.length + ' chars)' : v;
  });
  var manifest = [
    'APS Classroom Dashboard — system backup', 'Environment: ' + env, 'Created: ' + apsStamp_(now) + ' ' + APS_TZ,
    'Reason: ' + (reason || 'scheduled'), 'By: ' + (actor || 'weekly trigger'), '',
    'FILES', JSON.stringify(files, null, 1), '', 'ERRORS', errors.length ? errors.join('\n') : 'none', '',
    'RESTORE', '1. Spreadsheet: open the copy -> File > Make a copy (or use it directly) and point the matching Script Property',
    '   (TARGET_SPREADSHEET_ID / ATTENDANCE_SPREADSHEET_ID / EXAM question paper sheet ID) at the restored file.',
    '2. Code: open the "APS Dashboard SCRIPT (code)" copy, review, then copy Code.gs / Dashboard.html / PdfLib.gs / appsscript.json',
    '   back into the live project and deploy a new version (Deploy > Manage deployments > Edit > New version).',
    '3. Script Properties (non-secret values below); secrets come from ENV_VARIABLE_' + env + '.gs.', '',
    'SCRIPT PROPERTIES (non-secret)', JSON.stringify(safe, null, 1)
  ].join('\n');
  folder.createFile('MANIFEST.txt', manifest, MimeType.PLAIN_TEXT);
  // Retention: keep the newest N backup folders of this environment.
  var mine = [], it = root.getFolders();
  while (it.hasNext()) { var f = it.next(); if (f.getName().indexOf(APS_BACKUP_PREFIX_ + env + ' ') === 0) mine.push(f); }
  mine.sort(function (a, b) { return a.getName() < b.getName() ? 1 : -1; });
  mine.slice(apsBackupKeep_()).forEach(function (f) { try { f.setTrashed(true); } catch (e) { errors.push('Trash old backup ' + f.getName() + ': ' + (e && e.message)); } });
  var res = { folderId: folder.getId(), folderUrl: folder.getUrl(), name: folder.getName(), files: files, errors: errors };
  console.log('[Maintenance] backup ' + res.name + ' | files ' + files.length + ' | errors ' + errors.length);
  return res;
}

/** Yearly archive spreadsheet in the backup folder (created on first use). */
function apsArchiveSpreadsheet_() {
  var root = apsBackupRootFolder_();
  var name = APS_ARCHIVE_PREFIX_ + Utilities.formatDate(new Date(), APS_TZ, 'yyyy') + ' (' + apsEnvLabel_() + ')';
  var it = root.getFilesByName(name);

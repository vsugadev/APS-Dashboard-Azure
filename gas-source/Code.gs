/**
 * Runs one notification window: build → (dry run: return) → skip if nothing new → send ONE consolidated email
 * → log every class (SENT / FAILED) and the run. opts = { dryRun, runBy, ignoreDay }.
 */
function ptaRunWindow_(windowKey, now, opts) {
  opts = opts || {};
  now = now || new Date();
  var w = PTA_WINDOWS_[windowKey];
  if (!w) throw new Error('Unknown notification window: ' + windowKey);
  var runId = 'PTA-' + Utilities.formatDate(now, APS_TZ, 'yyyyMMdd-HHmmss') + '-' + w.key.slice(0, 3);
  var at = ptaFmtNow_(now), runBy = opts.runBy || 'trigger';
  var runRow = function (result, details) { return [at, runId, 'RUN', w.key, '', '', '', '', '', '', '', '', '', '', result, details + ' | run by ' + runBy]; };
  if (!ptaEnabled_()) { ptaLogRows_([runRow('SKIPPED', 'disabled (PTA_COVERAGE_NOTIFY_ENABLED=false)')]); return { skipped: 'disabled' }; }
  if (!opts.ignoreDay && easternDayOfWeek_(now) !== w.dow) {
    var why = 'today is not ' + PTA_DAY_LABEL_[w.days[0]] + ' in America/New_York';
    if (!opts.dryRun) ptaLogRows_([runRow('SKIPPED', why)]);
    return { skipped: why };
  }
  var lock = LockService.getScriptLock();
  if (!opts.dryRun && !lock.tryLock(30000)) return { skipped: 'another run is in progress' };
  try {
    var b = ptaBuild_(windowKey, now), s = b.stats;
    var summary = 'Window ' + w.label + ' | Run ' + at + ' EST | Week ' + b.weekId + ' | Courses found ' + s.coursesFound + ' | Eligible ' + s.eligible +
      ' | Friday ' + s.byDay.FRI + ' | Saturday ' + s.byDay.SAT + ' | Sunday ' + s.byDay.SUN + ' | Recipients ' + (b.items.length ? b.to.length + b.cc.length : 0) +
      ' | Duplicate/Already sent ' + s.duplicates + ' | Ended ' + s.ended + ' | Missing Meet URL ' + s.missingMeet + ' | Missing Primary Teacher ' + s.missingPrimary +
      ' | Missing HM ' + s.missingHm + ' | Missing VP ' + s.missingVp + (s.unreadableSchedule ? ' | Unreadable schedule ' + s.unreadableSchedule : '');
    console.log('[PTA-Coverage] ' + summary);
    var out = { window: w.key, weekId: b.weekId, stats: s, to: b.to, cc: b.cc, classes: b.items.map(function (it) { return { key: it.key, className: it.className, day: it.day, date: it.date, meetUrl: it.meetUrl, missing: it.missing }; }) };
    if (opts.dryRun) { out.dryRun = true; out.subject = b.items.length ? ptaSubject_(b) : ''; out.html = b.items.length ? ptaRenderHtml_(b) : ''; return out; }
    if (!b.items.length) { ptaLogRows_([runRow(s.schoolLeave ? 'SKIPPED_SCHOOL_LEAVE' : s.duplicates ? 'ALREADY_SENT' : 'NOTHING_TO_SEND', summary + (s.schoolLeave ? ' | School leave ' + s.schoolLeave : '') + ' | Emails sent 0 | Errors 0')]); out.emailsSent = 0; return out; }
    var subject = ptaSubject_(b);
    var res = apsGmailSend_('TICKETS', { to: b.to, cc: b.cc, replyTo: attMailAdminCc_(), subject: subject, html: ptaRenderHtml_(b), text: ptaRenderText_(b) });
    var result = res.ok ? 'SENT' : 'FAILED', err = res.ok ? '' : String(res.error || 'send failed');
    var recipients = b.to.join(', ') + (b.cc.length ? ' | CC ' + b.cc.join(', ') : '');
    var rows = b.items.map(function (it) {
      return [at, runId, 'CLASS', w.key, it.key, it.courseId, it.className, it.date, it.dayLabel, ptaPeopleText_(it.primary), ptaPeopleText_(it.hm), ptaPeopleText_(it.vp), it.meetUrl || 'MISSING',
        recipients, result, (it.missing.length ? 'Missing: ' + it.missing.join('; ') : 'OK') + (err ? ' | ' + err : '')];
    });
    rows.push(runRow(result, summary + ' | Emails sent ' + (res.ok ? 1 : 0) + ' | Errors ' + (res.ok ? 0 : 1) + (err ? ' (' + err + ')' : '') + ' | Subject: ' + subject));
    ptaLogRows_(rows);
    if (!res.ok) console.error('[PTA-Coverage] email FAILED (' + res.mode + '): ' + err); else console.log('[PTA-Coverage] email SENT (' + res.mode + ') to ' + b.to.length + ' + CC ' + b.cc.length);
    out.emailsSent = res.ok ? 1 : 0; out.subject = subject; out.result = result; if (err) out.error = err;
    return out;
  } catch (e) {
    console.error('[PTA-Coverage] run failed: ' + (e && e.message));
    if (!opts.dryRun) ptaLogRows_([runRow('ERROR', String(e && e.message || e))]);
    return { error: String(e && e.message || e) };
  } finally { if (!opts.dryRun) lock.releaseLock(); }
}

/* Trigger handlers — each refuses anything but its own installed trigger. */

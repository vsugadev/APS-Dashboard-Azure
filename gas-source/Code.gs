var ROSTER_SYNC_LOG_HEADER = ['Run_ID', 'Started', 'Finished', 'Trigger', 'Run_By', 'Result', 'Active_Classrooms', 'Teachers_Found',
  'Students_Found', 'Student_Enrollments', 'New_Students', 'Updated_Students', 'Removed_Inactive', 'New_Classrooms', 'Updated_Classrooms',
  'Classrooms_Processed', 'Classrooms_Deferred', 'Error_Count', 'Duration', 'Errors_JSON'];
var ROSTER_AUDIT_HEADER = ['Timestamp', 'User', 'APSID', 'Role', 'Action', 'Course_ID', 'Result', 'Detail'];
var ROSTER_MEMO_ = { ds: null, gen: null, enabled: null };

/* ------------------------------ configuration ------------------------------ */
function rosterProp_(key, fallback) {
  var v = PropertiesService.getScriptProperties().getProperty(key);
  return v === null || v === undefined || v === '' ? fallback : v;
}
/** Kill switch. Read on every getDashboardData poll, so memoised per execution and cached for 5 minutes. */
function rosterEnabled_() {
  if (ROSTER_MEMO_.enabled !== null) return ROSTER_MEMO_.enabled;
  var cache = CacheService.getScriptCache(), c = null;
  try { c = cache.get('rosterEnabled'); } catch (e) { c = null; }
  if (c === null || c === undefined) {
    c = String(rosterProp_('APS_CLASSROOM_ROSTER_ENABLED', 'true')).trim().toLowerCase() === 'false' ? '0' : '1';
    try { cache.put('rosterEnabled', c, 300); } catch (e) { /* ignore */ }
  }
  ROSTER_MEMO_.enabled = c === '1';
  return ROSTER_MEMO_.enabled;
}
/** Academic year "2026-2027" (Script Property APS_CLASSROOM_ROSTER_ACADEMIC_YEAR) -> course-name suffix "AY26-27". */
function rosterAcademicYear_() {
  var ay = String(rosterProp_('APS_CLASSROOM_ROSTER_ACADEMIC_YEAR', '')).trim();
  var m = /^(\d{4})\s*-\s*(\d{4})$/.exec(ay);
  if (m) return { label: m[1] + '-' + m[2], suffix: 'AY' + m[1].slice(2) + '-' + m[2].slice(2) };
  var s = /^AY(\d{2})-(\d{2})$/i.exec(String(COURSE_NAME_SUFFIX || '').trim());
  return s ? { label: '20' + s[1] + '-20' + s[2], suffix: String(COURSE_NAME_SUFFIX).trim().toUpperCase() } : { label: '', suffix: String(COURSE_NAME_SUFFIX || '') };
}
function rosterNameMatches_(name, suffix) {
  if (suffix === COURSE_NAME_SUFFIX) return courseNameMatches_(name); // the dashboard's existing AY26-27 rule
  var t = String(name || '').trim().toLowerCase(), s = String(suffix || '').trim().toLowerCase();
  return !!t && !!s && t.slice(-s.length) === s;
}
function rosterTs_(d) { return Utilities.formatDate(d || new Date(), APS_TZ, 'yyyy-MM-dd HH:mm:ss'); }
function rosterLabel_(d) { return Utilities.formatDate(d || new Date(), APS_TZ, 'MM/dd/yyyy hh:mm a') + ' EST'; }
function rosterDuration_(ms) {
  var s = Math.max(0, Math.round(ms / 1000));
  return ('0' + Math.floor(s / 3600)).slice(-2) + ':' + ('0' + Math.floor((s % 3600) / 60)).slice(-2) + ':' + ('0' + (s % 60)).slice(-2);
}

/**
 * ONE reusable APS classroom-name parser for this module (spec name). Delegates to the
 * existing examQpParseClassName_ (which itself reuses parseCourseSchedule_ and
 * extractNilaiFromCourseName_), so the parsing rules live in one place.
 * "NILAI 3 - EF | FRI 6:30 - 8:00 PM EST | AY26-27" ->
 * { academicYear:'2026-2027', nilai:'NILAI 3', section:'EF', day:'FRI', startTime:'6:30 PM', endTime:'8:00 PM', timezone:'EST' }
 */
function parseAPSClassroomName(courseName) {
  var p = examQpParseClassName_(courseName);
  var ay = /^AY(\d{2})-(\d{2})$/.exec(p.academicYear || '');
  return {
    academicYear: ay ? '20' + ay[1] + '-20' + ay[2] : '',
    nilai: p.grade || '', section: p.section || '', day: p.day || '',
    startTime: p.startLabel || '', endTime: p.endLabel || '', timezone: p.startLabel ? (p.timeZone || 'EST') : ''
  };
}

/* ------------------------------ role / access ------------------------------ */
/** Display gate sent to the browser as currentUser.gradingAccess ('' = no Grading sub-tab). */
function rosterAccessForRole_(role) {
  if (!rosterEnabled_()) return '';
  if (isAdminRole_(role)) return 'ADMIN';
  if (role === 'headmaster') return 'HM';
  if (isReadOnlyRole_(role)) return 'BOD';
  if (role === 'teacher') return 'TEACHER';
  if (role === 'student') return 'STUDENT';
  return '';
}
/** Centralized server-side user context for every roster endpoint (never trusts the browser). */
function rosterUserContext_(sessionToken) {
  var session = requireValidSession_(sessionToken);
  var email = normalizeEmail_(session.email);
  var role = rosterAccessForRole_(session.role);
  var ctx = { email: email, apsId: getAPSIdFromEmail(email), role: role || String(session.role || '').toUpperCase(), rawRole: session.role, token: sessionToken };
  var perms = getDashboardRolePermission_(session.role);
  if (!role || perms.tabs === false) {
    rosterAudit_(ctx, 'ACCESS_ROSTER', '', 'DENIED', 'Role has no Classroom Roster access');
    throw new Error('Access denied. You do not have access to the Classroom Roster.');
  }
  ctx.isStudent = role === 'STUDENT';
  ctx.seeAll = !ctx.isStudent && role !== 'TEACHER' && String(rosterProp_('APS_GRADING_ALL_CLASSES_ROLES', '')).toUpperCase().split(/[\s,]+/).indexOf(role) > -1;
  ctx.canSync = rosterCanSync_(ctx);
  ctx.canExport = role === 'ADMIN' || role === 'HM' || role === 'TEACHER'; // always limited to the caller's own classrooms
  ctx.canSeeSync = role === 'ADMIN';
  return ctx;
}
/** Sync (spends Google API quota): Admin / Super Admin only; read-only role permissions never. */
function rosterCanSync_(ctx) {
  if (ctx.role !== 'ADMIN') return false;
  try { requireDashboardMutationPermission_({ role: ctx.rawRole }, 'sync'); return true; } catch (e) { return false; }
}
/**
 * Classrooms the user is ASSIGNED to — an ACTIVE teacher or ACTIVE student of the classroom in the
 * roster — for every role (Admin, HM, BOD, Teacher, Student). null = all classrooms, only for roles
 * listed in APS_GRADING_ALL_CLASSES_ROLES. teach[courseId] = sees the whole class (teacher there).
 */
function gradingScope_(ctx, rds) {
  if (ctx.seeAll) return null;
  var sc = { courses: {}, teach: {} };
  rds.teachers.forEach(function (t) { if (t.e === ctx.email && t.s === ROSTER_STATUS.ACTIVE) { sc.courses[t.c] = true; sc.teach[t.c] = true; } });
  rds.students.forEach(function (x) { if (x.e === ctx.email && x.s === ROSTER_STATUS.ACTIVE) sc.courses[x.c] = true; });
  return sc;
}

/**
 * Security audit (Roster_Audit_Log): every denial, sync and export is written; views are
 * de-duplicated per user/action/course for 30 minutes so normal browsing stays fast.
 * Never logs tokens or credentials.
 */
function rosterAudit_(ctx, action, courseId, result, detail) {
  try {
    if (result === 'SUCCESS' && /^VIEW_/.test(action)) {
      var cache = CacheService.getScriptCache();
      var k = 'rosterAud_' + Utilities.base64EncodeWebSafe(ctx.email + '|' + action + '|' + (courseId || '')).slice(0, 200);
      if (cache.get(k)) return;
      cache.put(k, '1', ROSTER_CONFIG.VIEW_AUDIT_DEDUPE_SECONDS);
    }
    var sheet = rosterSheet_(ROSTER_CONFIG.SHEET_AUDIT, ROSTER_AUDIT_HEADER).sheet;
    sheet.appendRow([rosterTs_(new Date()), ctx.email || '', ctx.apsId || '', ctx.role || '', action, String(courseId || ''), result, String(detail || '').slice(0, 500)]);
  } catch (e) {
    console.warn('[Roster] audit write failed: ' + (e && e.message));
  }
}

/* -------------------------------- storage ---------------------------------- */
/** Sheet in the dashboard workbook with the given header; existing headers/rows are kept and missing columns appended. */
function rosterSheet_(name, header) {
  var ss = getWorkbook_();
  var sheet = ss.getSheetByName(name);
  if (!sheet) {
    sheet = ss.insertSheet(name);
    if (sheet.getMaxColumns() < header.length) sheet.insertColumnsAfter(sheet.getMaxColumns(), header.length - sheet.getMaxColumns());
    sheet.getRange(1, 1, 1, header.length).setValues([header]).setFontWeight('bold');
    sheet.setFrozenRows(1);
    return { sheet: sheet, header: header.slice() };
  }
  var width = Math.max(1, sheet.getLastColumn());
  var current = sheet.getRange(1, 1, 1, width).getValues()[0].map(function (h) { return String(h || '').trim(); });
  if (!current.some(Boolean)) current = [];
  var missing = header.filter(function (h) { return current.indexOf(h) === -1; });
  if (missing.length) {
    var start = current.length + 1;
    if (sheet.getMaxColumns() < current.length + missing.length) sheet.insertColumnsAfter(sheet.getMaxColumns(), current.length + missing.length - sheet.getMaxColumns());
    sheet.getRange(1, start, 1, missing.length).setValues([missing]).setFontWeight('bold');
    current = current.concat(missing);
  }
  return { sheet: sheet, header: current };
}
/** Whole table in memory: { sheet, header, col{name:index}, rows[[...]], byKey{key:rowIndex} }. */
function rosterLoadTable_(name, header, keyColumn) {
  var t = rosterSheet_(name, header);
  t.col = {};
  t.header.forEach(function (h, i) { t.col[h] = i; });
  var last = t.sheet.getLastRow();
  t.rows = last >= 2 ? t.sheet.getRange(2, 1, last - 1, t.header.length).getValues().map(function (r) { return r.map(function (v) { return v === null || v === undefined ? '' : String(v); }); }) : [];
  t.byKey = {};
  if (keyColumn) t.rows.forEach(function (r, i) { var k = r[t.col[keyColumn]]; if (k && t.byKey[k] === undefined) t.byKey[k] = i; });
  return t;
}
function rosterGet_(t, row, name) { return row[t.col[name]]; }
/** Sets fields on a row; returns true if any value changed. */
function rosterSet_(t, row, values) {
  var changed = false;
  Object.keys(values).forEach(function (k) {
    if (t.col[k] === undefined) return;
    var v = values[k] === null || values[k] === undefined ? '' : String(values[k]);
    if (row[t.col[k]] !== v) { row[t.col[k]] = v; changed = true; }
  });
  return changed;
}
function rosterNewRow_(t) { var r = []; for (var i = 0; i < t.header.length; i++) r.push(''); return r; }
/** One bulk write per table (text format first so ids / dates are never re-interpreted by Sheets). */
function rosterWriteTable_(t) {
  if (!t.rows.length) return;
  var range = t.sheet.getRange(2, 1, t.rows.length, t.header.length);
  range.setNumberFormat('@');
  range.setValues(t.rows);
}

/* ------------------------------ Classroom API ------------------------------ */
function rosterListAll_(fn, key) {
  var out = [], token;
  do {
    var pt = token;
    var resp = callWithBackoff_(function () { return fn(pt); }) || {};
    (resp[key] || []).forEach(function (x) { out.push(x); });
    token = resp.nextPageToken;
  } while (token);
  return out;
}
function rosterPermissionHint_(msg) {
  msg = String(msg || '');
  if (!/insufficient|permission|forbidden|not authorized|unauthorized|403|scope/i.test(msg)) return '';
  // "Required permissions: https://www.googleapis.com/auth/<scope>" -> name the scope that is actually missing.
  var m = /required permissions?:\s*(\S+)/i.exec(msg);
  if (m) {
    var scope = m[1].replace(/[.,;]+$/, '');
    return ' — The script is not authorized for ' + scope + '. Fix: Apps Script editor > Project Settings > tick "Show appsscript.json manifest file", make sure oauthScopes contains "' + scope + '" (copy the project appsscript.json), save, then run apsOwnerReauthorizeAllScopes from the editor and click Allow. Finally Deploy > Manage deployments > Edit > New version.';
  }
  return ' — Google Classroom permission missing: the dashboard owner account must be able to see this classroom and be authorized for the Classroom scopes in appsscript.json. Run apsOwnerReauthorizeAllScopes from the Apps Script editor and click Allow.';
}

/* ---------------------------------- sync ----------------------------------- */
/**
 * Runs one roster sync (UPSERT). Safe to call repeatedly: never duplicates rows, marks removed
 * members INACTIVE, isolates failures per classroom and defers what does not fit in the time
 * budget to the next run. Returns the sync summary.
 */
function rosterRunSync_(triggerType, runBy, opts) {
  opts = opts || {};
  var t0 = Date.now();
  var deadline = opts.deadline || t0 + ROSTER_CONFIG.MAX_RUN_MS;
  var props = PropertiesService.getScriptProperties();
  if (!opts.skipMarker) { // gradingRunSync_ already holds the run marker
    var lock = LockService.getScriptLock();
    if (!lock.tryLock(15000)) throw new Error('The dashboard is busy right now. Please try the roster sync again in a minute.');
    try {
      var running = Number(props.getProperty('ROSTER_SYNC_RUNNING') || 0);
      if (running && t0 - running < ROSTER_CONFIG.RUN_STALE_MS) {
        return { alreadyRunning: true, message: 'A Google Classroom roster sync is already running (started ' + rosterLabel_(new Date(running)) + '). Please wait for it to finish.' };
      }
      props.setProperty('ROSTER_SYNC_RUNNING', String(t0));
    } finally { lock.releaseLock(); }
  }

  var now = new Date(), ts = rosterTs_(now);
  var ay = rosterAcademicYear_();
  var errors = [];
  var stats = { newStudents: 0, updatedStudents: 0, removedInactive: 0, newClassrooms: 0, updatedClassrooms: 0, processed: 0, deferred: 0 };
  var addError = function (course, op, e) {
    var msg = String(e && e.message ? e.message : e).slice(0, 300);
    errors.push({ classroom: course ? course.name : '', courseId: course ? String(course.id) : '', operation: op, error: msg + rosterPermissionHint_(msg), timestamp: rosterLabel_(new Date()) });
    console.error('[Roster] ' + op + ' failed' + (course ? ' for ' + course.id + ' (' + course.name + ')' : '') + ': ' + msg);
  };
  var summary, written = false;
  try {
    console.log('[Roster] sync start (' + triggerType + ', ' + (runBy || 'system') + ', suffix ' + ay.suffix + ')');
    // 1-2. ALL active courses (every page), then only names ending with the academic-year suffix.
    var courses;
    try {
      courses = rosterListAll_(function (pt) { return Classroom.Courses.list({ courseStates: ['ACTIVE'], pageToken: pt, pageSize: 100 }); }, 'courses')
        .filter(function (c) { return c && c.courseState === 'ACTIVE' && rosterNameMatches_(c.name, ay.suffix); });
    } catch (e) {
      var m = String(e && e.message || e);
      throw new Error('Could not list Google Classroom courses: ' + m + rosterPermissionHint_(m));
    }
    var C = rosterLoadTable_(ROSTER_CONFIG.SHEET_CLASSROOMS, ROSTER_CLASSROOM_HEADER, 'Course_ID');
    var prevActive = C.rows.filter(function (r) { return rosterGet_(C, r, 'Status') === ROSTER_STATUS.ACTIVE; }).length;
    // Safety: if Classroom suddenly returns no (or far fewer) matching classrooms — lost visibility, wrong academic-year
    // property — do NOT mark the missing classrooms INACTIVE (teachers would lose access); report it instead.
    var suspicious = prevActive > 0 && (courses.length === 0 || (prevActive >= 10 && courses.length < prevActive * 0.5));
    if (suspicious) addError(null, 'List Courses', new Error('Google Classroom returned ' + courses.length + ' matching ' + ay.suffix + ' classrooms (previously ' + prevActive + '). Missing classrooms were NOT marked inactive. Check the owner account access and APS_CLASSROOM_ROSTER_ACADEMIC_YEAR.'));
    var T = rosterLoadTable_(ROSTER_CONFIG.SHEET_TEACHERS, ROSTER_TEACHER_HEADER, 'Enrollment_Key');
    var S = rosterLoadTable_(ROSTER_CONFIG.SHEET_STUDENTS, ROSTER_STUDENT_HEADER, 'Enrollment_Key');
    var tRowsByCourse = {}, sRowsByCourse = {};
    T.rows.forEach(function (r, i) { (tRowsByCourse[rosterGet_(T, r, 'Course_ID')] = tRowsByCourse[rosterGet_(T, r, 'Course_ID')] || []).push(i); });
    S.rows.forEach(function (r, i) { (sRowsByCourse[rosterGet_(S, r, 'Course_ID')] = sRowsByCourse[rosterGet_(S, r, 'Course_ID')] || []).push(i); });

    // Classrooms deferred by the previous run go first, so every classroom is refreshed within a few runs.
    var deferredBefore = {};
    try { (JSON.parse(props.getProperty('ROSTER_DEFERRED') || '[]') || []).forEach(function (id) { deferredBefore[id] = true; }); } catch (e) { /* ignore */ }
    courses.sort(function (a, b) { return (deferredBefore[b.id] ? 1 : 0) - (deferredBefore[a.id] ? 1 : 0); });
    var includeInvites = String(rosterProp_('APS_CLASSROOM_ROSTER_INCLUDE_INVITATIONS', 'false')).toLowerCase() === 'true';
    var profileMemo = {};
    var deferred = [];
    var activeIds = {};
    courses.forEach(function (c) { activeIds[String(c.id)] = true; });

    courses.forEach(function (course) {
      var cid = String(course.id);
      if (Date.now() > deadline) { deferred.push(cid); return; }
      stats.processed++;
      var p = parseAPSClassroomName(course.name);
      var teachers = null, students = null, invites = [];
      try { teachers = rosterListAll_(function (pt) { return Classroom.Courses.Teachers.list(cid, { pageToken: pt, pageSize: 100 }); }, 'teachers'); }
      catch (e) { addError(course, 'List Teachers', e); }
      try { students = rosterListAll_(function (pt) { return Classroom.Courses.Students.list(cid, { pageToken: pt, pageSize: 100 }); }, 'students'); }
      catch (e) { addError(course, 'List Students', e); }
      if (includeInvites) {
        try {
          invites = rosterListAll_(function (pt) { return Classroom.Invitations.list({ courseId: cid, pageToken: pt, pageSize: 100 }); }, 'invitations');
          invites.forEach(function (inv) {
            if (!profileMemo[inv.userId]) profileMemo[inv.userId] = callWithBackoff_(function () { return Classroom.UserProfiles.get(inv.userId); }) || {};
            inv.profile = profileMemo[inv.userId];
          });
        } catch (e) { addError(course, 'List Invitations', e); invites = []; }
      }

      // ---- classroom (upsert by Course ID)
      var ci = C.byKey[cid], crow, isNew = ci === undefined;
      if (isNew) { crow = rosterNewRow_(C); C.byKey[cid] = C.rows.length; C.rows.push(crow); rosterSet_(C, crow, { Course_ID: cid, First_Seen: ts }); }
      else crow = C.rows[ci];
      var visibleTeachers = (teachers || []).filter(function (t) {
        var pr = t.profile || {}; var nm = splitNameAndPhone_(pr.name ? pr.name.fullName : (pr.emailAddress || '')).name;
        return !isHiddenTeacherName_(nm, pr.emailAddress || '') && !isRosterHiddenStaffEmail_(pr.emailAddress || '');
      });
      var changedC = rosterSet_(C, crow, {
        Course_Name: course.name, Course_State: course.courseState, Status: ROSTER_STATUS.ACTIVE, Section: course.section || '',
        Description: String(course.descriptionHeading || course.description || '').slice(0, 1000), Room: course.room || '', Owner_ID: course.ownerId || '',
        Creation_Time: course.creationTime || '', Update_Time: course.updateTime || '', Academic_Year: p.academicYear || ay.label,
        Nilai: p.nilai, Section_Code: p.section, Class_Day: p.day, Start_Time: p.startTime, End_Time: p.endTime, Time_Zone: p.timezone,
        Teacher_Count: teachers ? visibleTeachers.length : rosterGet_(C, crow, 'Teacher_Count'),
        Student_Count: students ? students.length : rosterGet_(C, crow, 'Student_Count'),
        Last_Error: errors.filter(function (x) { return x.courseId === cid; }).map(function (x) { return x.operation + ': ' + x.error; }).join(' | ').slice(0, 500)
      });
      if (isNew) stats.newClassrooms++; else if (changedC) stats.updatedClassrooms++;
      rosterSet_(C, crow, { Last_Seen: ts, Last_Synced: ts });
      var teacherNames = visibleTeachers.map(function (t) { var pr = t.profile || {}; return splitNameAndPhone_(pr.name ? pr.name.fullName : (pr.emailAddress || '')).name; }).join(', ');
      var teacherEmails = visibleTeachers.map(function (t) { return normalizeEmail_((t.profile || {}).emailAddress || ''); }).filter(Boolean).join(', ');

      // ---- teachers (upsert by Course ID + User ID); only when the list call succeeded
      if (teachers) {
        var seenT = {};
        var tMembers = teachers.map(function (t) { return { userId: t.userId, profile: t.profile || {}, state: ROSTER_STATUS.ACTIVE }; });
        invites.filter(function (i) { return i.role === 'TEACHER' || i.role === 'OWNER'; }).forEach(function (i) { tMembers.push({ userId: i.userId, profile: i.profile || {}, state: ROSTER_STATUS.INVITED }); });
        tMembers.forEach(function (m) {
          var email = normalizeEmail_(m.profile.emailAddress || '');
          var key = cid + '|' + (m.userId || email);
          if (seenT[key]) return;
          seenT[key] = true;
          var name = splitNameAndPhone_(m.profile.name ? m.profile.name.fullName : email).name;
          var idx = T.byKey[key], row, created = idx === undefined;
          if (created) { row = rosterNewRow_(T); T.byKey[key] = T.rows.length; (tRowsByCourse[cid] = tRowsByCourse[cid] || []).push(T.rows.length); T.rows.push(row); rosterSet_(T, row, { Enrollment_Key: key, Course_ID: cid, First_Seen: ts }); }
          else row = T.rows[idx];
          rosterSet_(T, row, {
            Course_Name: course.name, Teacher_User_ID: m.userId || '', Teacher_Name: name, Teacher_Email: email, APSID: getAPSIdFromEmail(email),
            Teacher_Role: m.state === ROSTER_STATUS.INVITED ? 'INVITED_TEACHER' : (m.userId && m.userId === course.ownerId ? 'OWNER' : 'TEACHER'),
            Membership_State: m.state, Support_Account: isHiddenTeacherName_(name, email) || isRosterHiddenStaffEmail_(email) ? 'TRUE' : 'FALSE',
            Nilai: p.nilai, Academic_Year: p.academicYear || ay.label, Inactive_Since: ''
          });
          rosterSet_(T, row, { Last_Seen: ts, Last_Synced: ts });
        });
        (tRowsByCourse[cid] || []).forEach(function (i) {
          var row = T.rows[i];
          if (seenT[rosterGet_(T, row, 'Enrollment_Key')] || rosterGet_(T, row, 'Membership_State') === ROSTER_STATUS.INACTIVE) return;
          rosterSet_(T, row, { Membership_State: ROSTER_STATUS.INACTIVE, Inactive_Since: ts, Last_Synced: ts });
        });
      }

      // ---- students (upsert by Course ID + User ID); removed members -> INACTIVE (kept for audit)
      if (students) {
        var seenS = {};
        var sMembers = students.map(function (s) { return { userId: s.userId, profile: s.profile || {}, state: ROSTER_STATUS.ACTIVE }; });
        invites.filter(function (i) { return i.role === 'STUDENT'; }).forEach(function (i) { sMembers.push({ userId: i.userId, profile: i.profile || {}, state: ROSTER_STATUS.INVITED }); });
        sMembers.forEach(function (m) {
          var email = normalizeEmail_(m.profile.emailAddress || '');
          var key = cid + '|' + (m.userId || email);
          if (seenS[key]) return;
          seenS[key] = true;
          var name = splitNameAndPhone_(m.profile.name ? m.profile.name.fullName : email).name;
          var idx = S.byKey[key], row, created = idx === undefined;
          if (created) { row = rosterNewRow_(S); S.byKey[key] = S.rows.length; (sRowsByCourse[cid] = sRowsByCourse[cid] || []).push(S.rows.length); S.rows.push(row); rosterSet_(S, row, { Enrollment_Key: key, Course_ID: cid, First_Seen: ts }); }
          else row = S.rows[idx];
          var fields = {
            Course_Name: course.name, Student_User_ID: m.userId || '', Student_Name: name, Student_Email: email, APSID: getAPSIdFromEmail(email),
            Membership_State: m.state, Nilai: p.nilai, Section: p.section, Academic_Year: p.academicYear || ay.label, Inactive_Since: ''
          };
          if (teachers) { fields.Teacher_Name = teacherNames; fields.Teacher_Email = teacherEmails; } // keep the last known teachers if that call failed
          var changed = rosterSet_(S, row, fields);
          if (created) stats.newStudents++; else if (changed) stats.updatedStudents++;
          rosterSet_(S, row, { Last_Seen: ts, Last_Synced: ts });
        });
        (sRowsByCourse[cid] || []).forEach(function (i) {
          var row = S.rows[i];
          if (seenS[rosterGet_(S, row, 'Enrollment_Key')] || rosterGet_(S, row, 'Membership_State') === ROSTER_STATUS.INACTIVE) return;
          rosterSet_(S, row, { Membership_State: ROSTER_STATUS.INACTIVE, Inactive_Since: ts, Last_Synced: ts });
          stats.removedInactive++;
        });
      }
      if (SYNC_THROTTLE_MS) Utilities.sleep(SYNC_THROTTLE_MS); // existing per-course spacing to stay under quota
    });

    // Classrooms that are no longer ACTIVE / no longer end with the suffix: kept, marked INACTIVE with their members.
    if (!suspicious) C.rows.forEach(function (crow) {

    var ts = Utilities.formatDate(new Date(), APS_TZ, 'MM/dd/yyyy hh:mm:ss a');
    sh.getRange(sh.getLastRow() + 1, 1, events.length, CLASS_ACCESS_AUDIT_HEADER_.length).setValues(events.map(function (v) {
      return [ts, v.exec || '', v.courseId || '', v.courseName || '', v.email || '', v.apsRole || '', v.classroomRole || '', v.source || '', v.action, v.result || 'SUCCESS', String(v.error || '').slice(0, 300)];
    }));

    S.rows.forEach(function (r) { if (rosterGet_(S, r, 'Membership_State') === ROSTER_STATUS.ACTIVE) { enroll++; uniqS[rosterGet_(S, r, 'Student_User_ID') || rosterGet_(S, r, 'Student_Email')] = true; } });
    summary = {
      result: errors.length ? (deferred.length ? 'PARTIAL_WITH_ERRORS' : 'COMPLETED_WITH_ERRORS') : (deferred.length ? 'PARTIAL' : 'COMPLETED'),
      activeClassrooms: courses.length, teachersFound: Object.keys(uniqT).length, studentsFound: Object.keys(uniqS).length, studentEnrollments: enroll,
      newStudents: stats.newStudents, updatedStudents: stats.updatedStudents, removedInactive: stats.removedInactive,
      newClassrooms: stats.newClassrooms, updatedClassrooms: stats.updatedClassrooms,
      classroomsProcessed: stats.processed, classroomsDeferred: stats.deferred, errorCount: errors.length,
      errors: errors.slice(0, ROSTER_CONFIG.MAX_ERRORS_KEPT), duration: rosterDuration_(Date.now() - t0),

  try { return s ? JSON.parse(s) : null; } catch (e) { return null; }
}

/* ---------- step 1: analysis (~Wed 7:00 PM) ---------- */
function ccwRunAnalysis_(now, runBy) {
  now = now || new Date();
  var lock = LockService.getScriptLock();
  if (!lock.tryLock(30000)) return { skipped: 'busy' };
  try {
    var id = ccwReportId_(now), rec = ccwFind_(id) || { Report_ID: id };
    if (rec.Email_Status === 'SENT') return { reportId: id, skipped: 'already sent' }; // the sent report is final for this Report_ID
    rec.Academic_Year = ccwAy_(); rec.Analysis_Date = ccwDateLabel_(now); rec.Analysis_Started = rosterTs_(new Date()); rec.Run_By = runBy || 'trigger';
    if (rec.Email_Status !== 'SENT') rec.Email_Status = rec.Email_Status || 'PENDING';
    var r;
    try { r = ccwBuild_(readAllCoursesFromCache_(), now); }
    catch (e) {
      rec.Status = 'FAILED'; rec.Error = 'Analysis failed: ' + srmSafeErr_(e); rec.Analysis_Completed = rosterTs_(new Date());
      ccwWrite_(rec); console.error('[ClassConsolidation] ' + rec.Error); return { reportId: id, status: 'FAILED', error: rec.Error };
    }
    if (!r.classes.length) { rec.Status = 'FAILED'; rec.Error = 'No active ' + ccwAy_() + ' classes in the course cache — run Classroom sync first.'; rec.Analysis_Completed = rosterTs_(new Date()); ccwWrite_(rec); return { reportId: id, status: 'FAILED', error: rec.Error }; }
    var json = JSON.stringify(r);
    if (json.length > CCW_PAYLOAD_CHUNK_ * 4) { r.explore = r.explore.slice(0, 20); r.small = r.small.slice(0, 80); r.classes = []; json = JSON.stringify(r); }
    rec.Payload_1 = json.slice(0, CCW_PAYLOAD_CHUNK_); rec.Payload_2 = json.slice(CCW_PAYLOAD_CHUNK_, 2 * CCW_PAYLOAD_CHUNK_);
    rec.Payload_3 = json.slice(2 * CCW_PAYLOAD_CHUNK_, 3 * CCW_PAYLOAD_CHUNK_); rec.Payload_4 = json.slice(3 * CCW_PAYLOAD_CHUNK_, 4 * CCW_PAYLOAD_CHUNK_);
    rec.Status = 'COMPLETED'; rec.Error = ''; rec.Analysis_Completed = rosterTs_(new Date());
    rec.Classes = String(r.counts.classes); rec.Students = String(r.counts.students); rec.Teachers = String(r.counts.teachers); rec.Multi_Class_Teachers = String(r.counts.multi);
    rec.High = String(r.counts.high); rec.Medium = String(r.counts.medium); rec.Low = String(r.counts.low);
    rec.Potential_Classes_Reduced = String(r.impact.classesReducedAll); rec.Potential_Assignments_Reduced = String(r.impact.assignmentsReducedAll);
    rec.Recipients_Count = String(r.recipients.length);
    ccwWrite_(rec);
    console.log('[ClassConsolidation] analysis ' + id + ': ' + r.counts.classes + ' classes, ' + r.counts.students + ' students, ' + r.counts.teachers + ' teachers, merges ' + r.counts.high + ' high / ' + r.counts.medium + ' medium');
    return { reportId: id, status: 'COMPLETED', counts: r.counts, impact: r.impact };
  } finally { lock.releaseLock(); }
}

/* ---------- step 2: email (~Wed 7:30 PM) ---------- */
function ccwSubject_(r) { return 'APS Class Consolidation Analysis – ' + r.ay + ' - ' + r.dateLabel; }
function ccwRunEmail_(now, runBy) {
  now = now || new Date();
  var id = ccwReportId_(now), rec = ccwFind_(id);
  var retry = rec && rec.Status === 'FAILED' && rec.Email_Status !== 'FAILURE_NOTICE_SENT' && !/retry/.test(rec.Run_By);
  if (!rec || retry || (rec.Status !== 'COMPLETED' && rec.Status !== 'FAILED')) { // the 7:00 PM run did not happen / failed: run it once more now
    var a = ccwRunAnalysis_(now, (runBy || 'trigger') + (retry ? ' (retry at email time)' : ' (analysis missing at email time)'));
    if (a.skipped) return { skipped: 'busy' };
    rec = ccwFind_(id);
  }
  if (!rec) return { error: 'no analysis' };
  if (rec.Email_Status === 'SENT') return { reportId: id, skipped: 'already sent' };
  var lock = LockService.getScriptLock();
  if (!lock.tryLock(30000)) return { skipped: 'busy' };
  try {
    rec = ccwFind_(id);
    if (rec.Email_Status === 'SENT') return { reportId: id, skipped: 'already sent' };
    if (rec.Status !== 'COMPLETED') { // never an incomplete report — tell admin@ once, clearly
      if (rec.Email_Status !== 'FAILURE_NOTICE_SENT') {
        var n = apsGmailSend_('TICKETS', { to: [attMailAdminCc_()], cc: [], replyTo: attMailAdminCc_(), subject: 'APS Class Consolidation Analysis – ' + ccwAy_() + ' - ' + ccwDateLabel_(now) + ' – NOT SENT (analysis failed)',
          html: apsEmailShell_('Class Consolidation Analysis not sent', '<p style="font-size:15px;line-height:1.55;">Vanakkam,</p><p style="font-size:15px;line-height:1.55;">This week\'s Class Consolidation Analysis could not be completed, so no report was sent to HM/VP.</p><p style="font-size:14px;line-height:1.55;"><b>Reason:</b> ' + htmlEscape_(rec.Error || 'unknown') + '</p><p style="font-size:14px;">APS Tech Support Team</p>', {}),
          text: 'This week\'s Class Consolidation Analysis could not be completed, so no report was sent.\nReason: ' + (rec.Error || 'unknown') });
        rec.Email_Status = n.ok ? 'FAILURE_NOTICE_SENT' : 'FAILED'; ccwWrite_(rec);
      }
      return { reportId: id, status: 'NOT_SENT', reason: rec.Error };
    }
    var r = ccwPayload_(rec);
    if (!r || r.reportId !== id) { rec.Email_Status = 'FAILED'; rec.Error = 'Stored analysis unreadable for ' + id; ccwWrite_(rec); return { reportId: id, status: 'FAILED', error: rec.Error }; }
    var res;
    try { res = apsGmailSend_('TICKETS', { to: r.recipients, cc: [], replyTo: attMailAdminCc_(), subject: ccwSubject_(r), html: ccwHtml_(r), text: ccwText_(r) }); }
    catch (eS) { res = { ok: false, error: srmSafeErr_(eS) }; }

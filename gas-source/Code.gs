function isOnCallTeacherEmail_(email) {
  var normalized = normalizeEmail_(email);
  return normalized === normalizeEmail_(ON_CALL_NAMED_TEACHER_EMAIL) ||
    isInEmailList_(normalized, ON_CALL_ADDITIONAL_NAMED_TEACHER_EMAILS) ||
    attIsOnCallEmail_(normalized); // tcs_ / tts_ (+ ATTENDANCE_ON_CALL_PREFIXES), case-insensitive

}

/** Reads the small, sync-produced on-call directory without touching Classroom. */
function getOnCallTeachers_() {
  var raw = PropertiesService.getScriptProperties().getProperty(ON_CALL_TEACHERS_PROP_KEY);
  if (!raw) return [];

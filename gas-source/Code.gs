  try { var hit = cache.get(CLASS_MEET_CACHE_KEY_); if (hit) return JSON.parse(hit); } catch (e) { /* re-read */ }
  var out = { mapped: {}, auto: {}, detected: {} };
  try {
    var ss = getAttendanceWorkbook_();
    var read = function (name, codeCol, target) {
      var sh = ss.getSheetByName(name);

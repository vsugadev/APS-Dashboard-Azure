/** Server-side mirror of the client's roleCan('seeMonitoringFilters'/'seeMonitoringTotals') — ADMIN/HM only. */
function canViewAllDashboardFilters_(role) {
  return getDashboardRolePermission_(role).filters && (isAdminOrHm_(role) || role === VCFO_AMCHSTS_BOD_ROLE);
}
function canViewMonitoringFilters_(role) { return canViewAllDashboardFilters_(role); }
function canViewMonitoringTotals_(role) { return canViewAllDashboardFilters_(role); }

function isReadOnlyRole_(role) { return role === VCFO_AMCHSTS_BOD_ROLE; }
function requireDashboardMutationPermission_(viewer, action) {
  var permissions = getDashboardRolePermission_(viewer.role);
  if (isReadOnlyRole_(viewer.role) || !permissions.buttons || permissions.readOnly) {
    throw new Error('Read-only access: this account cannot ' + action + '.');
  }
}

function getOrCreateUserRoleSheet_() {
  var ss = getWorkbook_();
  var sheet = ss.getSheetByName(USER_ROLE_SHEET_NAME);
  if (sheet) return sheet;
  sheet = ss.insertSheet(USER_ROLE_SHEET_NAME);
  sheet.getRange(1, 1, 1, 5).setValues([['Email', 'Role', 'Active', 'Updated At', 'Updated By']]).setFontWeight('bold');
  sheet.setFrozenRows(1);
  return sheet;
}

function readConfiguredUserRoles_() {
  var cache = CacheService.getScriptCache();
  var cached = cache.get(USER_ROLE_CACHE_KEY);
  if (cached) return JSON.parse(cached);
  var roles = {};
  var sheet = getWorkbook_().getSheetByName(USER_ROLE_SHEET_NAME);
  if (!sheet) {
    cache.put(USER_ROLE_CACHE_KEY, JSON.stringify(roles), USER_ROLE_CACHE_SECONDS);
    return roles;
  }
  if (sheet.getLastRow() < 2) {
    cache.put(USER_ROLE_CACHE_KEY, JSON.stringify(roles), USER_ROLE_CACHE_SECONDS);
    return roles;
  }
  sheet.getRange(2, 1, sheet.getLastRow() - 1, 5).getValues().forEach(function (row) {
    var email = normalizeEmail_(row[0]);
    var role = String(row[1] || '').trim().toLowerCase();
    var active = row[2] === true || String(row[2]).toLowerCase() === 'true' || row[2] === 1;
    if (email && active && DASHBOARD_ROLES.indexOf(role) > -1) roles[email] = role;
  });
  cache.put(USER_ROLE_CACHE_KEY, JSON.stringify(roles), USER_ROLE_CACHE_SECONDS);
  return roles;
}

// Sept 2026, twenty-seventh round: dashboard role/permission management
// (the "Dashboard User Roles & Permissions" panel — assigning
// VCFO_AMCHSTS_BOD/Headmaster/Teacher/Student role overrides AND toggling
// each role's buttons/filters/tabs permissions) is Super Admin ONLY per
// explicit request — no other role, including regular Admin, may use it.
// Renamed from the old requireAdminViewer_() (which allowed admin OR
// superadmin) to requireSuperAdminViewer_() to make the narrower rule
// obvious at every call site. Confirmed via grep that there are exactly
// 5 call sites below (saveDashboardRolePermissions,
// getDashboardRolePermissions, getDashboardUserRoles, saveDashboardUserRole,
// deleteDashboardUserRole) — no other feature (Assign Classroom, deployment
// info, etc.) depends on it, so this change is isolated to role/permission
// management only, exactly as requested.
function requireSuperAdminViewer_(sessionToken) {
  var session = requireValidSession_(sessionToken);
  if (session.role !== SUPERADMIN_ROLE) throw new Error('Only the Super Admin account can manage dashboard roles and permissions.');
  if (!apsTabAllowed_(session.role, 'adminControl.userRoles')) throw new Error(AC_OFF_MSG_); // r75: Super Admin can switch User Roles off (Access Control stays on)
  var courses = readAllCoursesFromCache_();
  return { courses: courses, viewer: { email: session.email, role: session.role } };
}

function getDashboardUserRoles(sessionToken) {
  requireSuperAdminViewer_(sessionToken);
  var sheet = getOrCreateUserRoleSheet_();
  if (sheet.getLastRow() < 2) return [];
  return sheet.getRange(2, 1, sheet.getLastRow() - 1, 5).getValues().filter(function (row) { return row[0]; }).map(function (row) {
    return { email: normalizeEmail_(row[0]), role: String(row[1] || ''), active: row[2] === true || String(row[2]).toLowerCase() === 'true' || row[2] === 1, updatedAt: row[3] || '', updatedBy: row[4] || '' };
  });
}

/**
 * Sept 2026 addendum: the "APS School - Live Dashboard" spreadsheet (this
 * project's shared data workbook — see getWorkbook_()) is shared with a
 * Google Group ("American Charitable Tamil Society") rather than the whole
 * organization, because this Web App is deployed "Execute as: User
 * accessing the web app" and several everyday features (posting a chat
 * message, for one — see postChatMessage()) write to this same spreadsheet
 * under each person's own Google identity, so every authorized user's
 * account needs at least Editor access to it. That Group's membership isn't
 * automatically kept in sync with who this Dashboard actually considers
 * authorized, so a real user can be fully authorized here yet still fail to
 * open the underlying data (see the Sept 2026 round on the login-error
 * investigation) simply because nobody added their account to the Group.
 *
 * This computes the full set of currently-authorized emails from every
 * ENUMERABLE source this Dashboard has, so a Super Admin can copy/paste the
 * result straight into that Group's "Add people" box (Share dialog) and
 * close the gap. Deliberately read-only and manual, by explicit choice —
 * see dashboard-architecture-and-config.md for the fully-automated
 * alternative (reading/writing the Group's real membership via the Admin
 * Directory API) that was considered and NOT built this round.
 *
 * Deliberately excludes the broad "authorized" role fallback (any email at
 * one of the four APS_ALLOWED_DOMAINS with no other role) — that population
 * can't be enumerated from anything this Dashboard has cached; only a full
 * Workspace Directory query across all four domains could list it, and
 * that's a materially bigger, more sensitive capability than what was asked
 * for here. See the Self-review flags in the architecture doc.
 */
function getAuthorizedEmailsForGroupSync(sessionToken) {
  var auth = requireSuperAdminViewer_(sessionToken);
  var courses = auth.courses;

  var staticRoles = [], configuredRoles = [], teachers = [], students = [];
  var seen = {}; // per-bucket dedup, keyed "bucketName|email"

  function addTo(bucket, bucketName, email, extra) {
    var normalized = normalizeEmail_(email);
    if (!normalized) return;
    var key = bucketName + '|' + normalized;
    if (seen[key]) return;
    seen[key] = true;
    var row = { email: normalized };
    for (var k in extra) { if (extra.hasOwnProperty(k)) row[k] = extra[k]; }
    bucket.push(row);
  }

  SUPERADMIN_EMAILS.forEach(function (e) { addTo(staticRoles, 'staticRoles', e, { role: SUPERADMIN_ROLE }); });
  VCFO_AMCHATS_BOD_EMAILS.forEach(function (e) { addTo(staticRoles, 'staticRoles', e, { role: VCFO_AMCHSTS_BOD_ROLE }); });
  ADMIN_EMAILS.forEach(function (e) { addTo(staticRoles, 'staticRoles', e, { role: 'admin' }); });
  HEADMASTER_EMAILS.forEach(function (e) { addTo(staticRoles, 'staticRoles', e, { role: 'headmaster' }); });

  var configured = readConfiguredUserRoles_();
  Object.keys(configured).forEach(function (email) {
    addTo(configuredRoles, 'configuredRoles', email, { role: configured[email] });
  });

  courses.forEach(function (c) {
    (c.teachers || []).forEach(function (t) { addTo(teachers, 'teachers', t.email, { name: t.name || '' }); });
    (c.students || []).forEach(function (s) { addTo(students, 'students', s.email, { name: s.name || '' }); });
  });

  var allEmailsSet = {};
  [staticRoles, configuredRoles, teachers, students].forEach(function (bucket) {
    bucket.forEach(function (row) { allEmailsSet[row.email] = true; });
  });
  var allEmails = Object.keys(allEmailsSet).sort();

  return {
    generatedAt: new Date().toISOString(),
    counts: {
      staticRoles: staticRoles.length,
      configuredRoles: configuredRoles.length,
      teachers: teachers.length,
      students: students.length,
      totalUnique: allEmails.length
    },
    allEmails: allEmails, // ready to paste, one per line, into the Group's "Add people" box
    buckets: { staticRoles: staticRoles, configuredRoles: configuredRoles, teachers: teachers, students: students }
  };
}

function saveDashboardUserRole(sessionToken, email, role, active) {
  var auth = requireSuperAdminViewer_(sessionToken);
  var normalizedEmail = normalizeEmail_(email);
  var normalizedRole = String(role || '').trim().toLowerCase();
  if (!isApsEmailAllowed_(normalizedEmail)) throw new Error('Enter a valid APS email address.');
  if (DASHBOARD_ROLES.indexOf(normalizedRole) === -1) throw new Error('Unknown dashboard role.');
  if (normalizedRole === 'admin' && !isInEmailList_(normalizedEmail, ADMIN_EMAILS)) throw new Error('Admin access must remain on the protected Admin email list.');
  if (normalizedRole === SUPERADMIN_ROLE && !isInEmailList_(normalizedEmail, SUPERADMIN_EMAILS)) throw new Error('Super Admin access must remain on the protected Super Admin email list.');
  var sheet = getOrCreateUserRoleSheet_();
  var values = sheet.getLastRow() > 1 ? sheet.getRange(2, 1, sheet.getLastRow() - 1, 5).getValues() : [];
  var rowNumber = -1;
  values.forEach(function (row, i) { if (normalizeEmail_(row[0]) === normalizedEmail) rowNumber = i + 2; });
  var row = [normalizedEmail, normalizedRole, !!active, new Date().toISOString(), auth.viewer.email];
  if (rowNumber > -1) sheet.getRange(rowNumber, 1, 1, row.length).setValues([row]); else sheet.appendRow(row);
  CacheService.getScriptCache().remove(USER_ROLE_CACHE_KEY);
  return getDashboardUserRoles(sessionToken);
}

function deleteDashboardUserRole(sessionToken, email) {
  requireSuperAdminViewer_(sessionToken);
  var normalizedEmail = normalizeEmail_(email);
  if (isInEmailList_(normalizedEmail, SUPERADMIN_EMAILS) || isInEmailList_(normalizedEmail, ADMIN_EMAILS) || isInEmailList_(normalizedEmail, HEADMASTER_EMAILS)) throw new Error('Protected Super Admin, Admin, and Headmaster roles cannot be removed here.');
  var sheet = getOrCreateUserRoleSheet_();
  for (var i = 2; i <= sheet.getLastRow(); i++) {
    if (normalizeEmail_(sheet.getRange(i, 1).getValue()) === normalizedEmail) { sheet.deleteRow(i); break; }
  }
  CacheService.getScriptCache().remove(USER_ROLE_CACHE_KEY);
  return getDashboardUserRoles(sessionToken);
}

/**
 * Very small, syntax-only email check — not a full RFC 5322 validator, just
 * enough to reject obviously malformed input like "teacher@" before
 * checking the domain.
 */
function isSyntacticallyValidEmail_(email) {
  return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(String(email || '').trim());
}

/**
 * True if `email` is syntactically valid AND its domain is one of
 * APS_ALLOWED_DOMAINS (case-insensitive). Checked both client-side (fast,
 * friendly error) and here, server-side — which is the only check that
 * actually matters for security.
 */
function isApsEmailAllowed_(email) {
  if (!isSyntacticallyValidEmail_(email)) return false;
  var domain = String(email).trim().toLowerCase().split('@')[1];
  return APS_ALLOWED_DOMAINS.indexOf(domain) > -1;
}

/**
 * Extracts the "APSID" embedded in an APS email's local part, e.g.
 * "vadivel_aps789@avvaiyarpadasalai.org" -> "APS789". Returns 'NA' when the
 * "_apsNNN@" pattern isn't present (e.g. generic accounts like
 * info@avvaiyarpadasalai.org) — never 'undefined'/'null'.
 */
function extractAPSID_(email) {
  if (!email) return 'NA';
  var match = String(email).match(/_aps([a-z0-9]+)@/i);
  if (!match || !match[1]) return 'NA';
  return ('APS' + match[1]).toUpperCase();
}

/**
 * OWNER-EXECUTION MODEL (fifty-second round). This Web App is deployed
 * "Execute as: Me" (USER_DEPLOYING) — every Sheets/Drive/Classroom call in
 * this file runs under the Dashboard owner's own Google identity, regardless
 * of who is visiting. That is deliberate: it is what lets the underlying
 * workbooks stay fully Restricted — owner-only, never shared with any
 * user's Google account — instead of requiring per-user/per-domain/per-Group
 * Drive sharing. See dashboard-owner-execution-migration-design.md for the
 * full rationale.
 *
 * The one consequence: Session.getActiveUser().getEmail() no longer
 * reliably identifies the VISITOR under this deployment mode — Apps Script
 * only exposes that when the execution identity and the accessing identity
 * are the same, which is no longer true here. So "who is this, really" can
 * no longer come from Session — it comes from a Google Sign-In ID token,
 * verified server-side below, then carried as an opaque, server-issued
 * session token on every subsequent call. NOTHING below this point should
 * call Session.getActiveUser() to determine the VISITOR's identity; it
 * would silently return '' for anyone but the owner. (getViewerRole_()
 * further down still does, deliberately — see its own comment.)
 */

/** The OAuth 2.0 Web application Client ID created for this Dashboard's
 *  "Sign in with Google" button (see dashboard-owner-execution-migration-
 *  design.md §3.1 for how to create one — it's free, no billing required).
 *  This is a PUBLIC identifier — not a secret in the sense OAUTH_CLIENT_SECRET
 *  is — but it's still environment-specific (test vs. production Apps Script
 *  project each need their own OAuth Client), so it moved out of source too.
 *
 *  Sept 2026, fifty-fourth round: moved to Script Properties — set
 *  'OAUTH_CLIENT_ID'. Blank at load time never crashes the script (see the
 *  config block near the top of this file); buildGoogleAuthUrl_() below
 *  checks for a blank value itself and throws a clear setup error only when
 *  someone actually tries to sign in, rather than breaking every page load.
 */
var OAUTH_CLIENT_ID = getConfigString_('OAUTH_CLIENT_ID', '');

/**
 * Sept 2026 addendum: this DOES need to stay a genuine secret — unlike
 * OAUTH_CLIENT_ID above, never paste this into Dashboard.html or anywhere
 * else a visitor's browser could read it. Used exclusively by
 * exchangeCodeForTokens_() below, which runs entirely server-side inside
 * doGet().
 *
 * Sept 2026, fifty-fourth round: this is the value that made moving
 * everything else in this file worthwhile — it was a literal Google OAuth
 * Client Secret sitting in plaintext in this source file, which gets
 * copied into this project's local sync folder and Claude Project docs.
 * Moved to Script Properties — set 'OAUTH_CLIENT_SECRET'. It no longer
 * exists anywhere in this file's text. exchangeCodeForTokens_() below
 * checks for a blank value itself and throws a clear setup error.
 */
var OAUTH_CLIENT_SECRET = getConfigString_('OAUTH_CLIENT_SECRET', '');

/** How long an established session stays valid before the visitor has to sign
 *  in again — CacheService's own hard maximum. */
var SESSION_TTL_SECONDS = 21600; // 6 hours
var SESSION_CACHE_PREFIX_ = 'aps_sess_';
var OAUTH_STATE_CACHE_PREFIX_ = 'aps_oauth_state_';
var OAUTH_STATE_TTL_SECONDS = 600; // 10 minutes — just long enough to complete the Google consent screen

/**
 * Sept 2026, fifty-third round: Apps Script Web Apps always render their
 * content inside a sandboxed `*.script.googleusercontent.com` iframe, even
 * on a plain direct visit — and Google explicitly refuses to let that domain
 * be registered as an OAuth "Authorized JavaScript origin" (it hosts many
 * different people's content, so allowing it would let anyone impersonate an
 * authorized origin). That makes Google Identity Services' client-side
 * "Sign in with Google" BUTTON (which checks the page's own origin against
 * the OAuth Client's registered origins) structurally impossible to use here
 * — this was tried in Round 52 and fails with "Error 401: invalid_client —
 * no registered origin" on every real deployment, not just when embedded
 * elsewhere as originally assumed.
 *
 * The fix is the older, classical OAuth 2.0 Authorization Code flow instead:
 * a plain link (buildGoogleAuthUrl_() below, rendered with target="_top" in
 * Dashboard.html so it breaks out of the sandbox iframe for the navigation)
 * sends the whole browser tab to Google's own accounts.google.com sign-in
 * page, and Google redirects the browser back to THIS SAME /exec URL with a
 * one-time authorization `code`. This flow is governed by "Authorized
 * redirect URIs" (an exact-URL-match mechanism, not an origin check) —
 * script.google.com addresses are explicitly permitted there, which is
 * exactly why this is the long-established pattern other Apps Script apps
 * use for visitor sign-in. doGet() below detects that `code` parameter,
 * exchanges it for the visitor's verified identity entirely server-side
 * (exchangeCodeForTokens_(), which is the one place OAUTH_CLIENT_SECRET is
 * used), and renders Dashboard.html with the resulting session already
 * established — Dashboard.html's apsBootstrapSession() picks this up via the
 * APS_BOOT_* template values injected below, reusing the exact same
 * post-establishSession handling (apsHandleAuthResult()) Round 52 already
 * built for the (now-abandoned) button-based flow.
 */
function buildGoogleAuthUrl_(state) {
  if (!OAUTH_CLIENT_ID) {
    throw new Error('Sign-in is not configured yet: the Script Property "OAUTH_CLIENT_ID" is missing. An Administrator needs to set it in the Apps Script editor (Project Settings > Script Properties).');
  }
  var params = {
    client_id: OAUTH_CLIENT_ID,
    redirect_uri: ScriptApp.getService().getUrl(),
    response_type: 'code',
    scope: 'openid email',
    state: state,
    prompt: 'select_account'
  };
  var qs = Object.keys(params).map(function (k) {
    return encodeURIComponent(k) + '=' + encodeURIComponent(params[k]);
  }).join('&');
  return 'https://accounts.google.com/o/oauth2/v2/auth?' + qs;
}

/**
 * Exchanges a one-time authorization `code` (from the redirect Google just
 * sent the browser back with) for real tokens, via a server-to-server POST —
 * the one call in this file that uses OAUTH_CLIENT_SECRET. `redirect_uri`
 * here MUST be byte-for-byte identical to the one used in
 * buildGoogleAuthUrl_() above (Google rejects a mismatch), which is why both
 * read it fresh from ScriptApp.getService().getUrl() rather than a stored
 * constant. Throws INVALID_TOKEN on any failure — an expired/already-used
 * code (single-use; a page refresh after signing in will hit this) included.
 */
function exchangeCodeForTokens_(code) {
  if (!OAUTH_CLIENT_ID || !OAUTH_CLIENT_SECRET) {
    throw new Error('Sign-in is not configured yet: the Script Property "OAUTH_CLIENT_ID" and/or "OAUTH_CLIENT_SECRET" is missing. An Administrator needs to set both in the Apps Script editor (Project Settings > Script Properties).');
  }
  var resp = UrlFetchApp.fetch('https://oauth2.googleapis.com/token', {
    method: 'post',
    payload: {
      code: code,
      client_id: OAUTH_CLIENT_ID,
      client_secret: OAUTH_CLIENT_SECRET,
      redirect_uri: ScriptApp.getService().getUrl(),
      grant_type: 'authorization_code'
    },
    muteHttpExceptions: true
  });
  if (resp.getResponseCode() !== 200) {
    throw new Error('INVALID_TOKEN: Google could not complete the sign-in (the code may have expired or already been used — this happens if the page was reloaded). Please try signing in again.');
  }
  var tokens = JSON.parse(resp.getContentText());
  if (!tokens.id_token) {
    throw new Error('INVALID_TOKEN: Google did not return an identity token for this sign-in.');
  }
  return tokens;
}

/**
 * Verifies a Google-issued ID token directly against Google's own tokeninfo
 * endpoint — Google itself checks the cryptographic signature, issuer, and
 * expiry; the one thing tokeninfo does NOT check is the audience, so that's
 * verified here. Throws on anything not a currently-valid token issued for
 * THIS app. Returns the token's claims (email, email_verified, aud, exp, ...).
 */
function verifyGoogleIdToken_(idToken) {
  if (!idToken) throw new Error('INVALID_TOKEN: no credential supplied.');
  var resp = UrlFetchApp.fetch(
    'https://oauth2.googleapis.com/tokeninfo?id_token=' + encodeURIComponent(idToken),
    { muteHttpExceptions: true }
  );
  if (resp.getResponseCode() !== 200) {
    throw new Error('INVALID_TOKEN: Google could not verify this sign-in. Please try signing in again.');
  }
  var claims = JSON.parse(resp.getContentText());
  if (claims.aud !== OAUTH_CLIENT_ID) {
    throw new Error('INVALID_TOKEN: wrong audience — this sign-in was not issued for this app.');
  }
  return claims;
}

/**
 * Shared core of establishing a session once we have ALREADY-VERIFIED claims
 * (verifyGoogleIdToken_() has run and email_verified has been checked by the
 * caller) — checks them against APS_ALLOWED_DOMAINS and the Dashboard's own
 * role logic, and on success issues the short-lived, server-side session the
 * client carries on every subsequent call. Used by doGet()'s OAuth-redirect
 * callback below.
 * Returns { ok:false, code:'invalid_email'|'not_authorized' } or
 * { ok:true, token, user }.
 */
function establishSessionForVerifiedClaims_(claims) {
  var email = normalizeEmail_(claims.email);
  if (!isApsEmailAllowed_(email)) {
    return { ok: false, code: 'invalid_email' };
  }

  var courses = readAllCoursesFromCache_();
  var viewer = getViewerRoleForEmail_(email, courses);
  if (viewer.role === 'none') {
    return { ok: false, code: 'not_authorized', email: email };
  }

  var token = Utilities.getUuid();
  CacheService.getScriptCache().put(
    SESSION_CACHE_PREFIX_ + token,
    JSON.stringify({ email: viewer.email, role: viewer.role, issuedAt: Date.now() }),
    SESSION_TTL_SECONDS
  );

  return { ok: true, token: token, user: buildAuthenticatedUserPayload_(viewer, courses) };
}

/**
 * Kept as a directly-callable RPC for API completeness (verifies a
 * Google ID token the caller already has, e.g. from some future non-redirect
 * flow) but NOT used by Dashboard.html's current login flow — see the
 * fifty-third-round comment above buildGoogleAuthUrl_() for why the sign-in
 * flow itself now goes through doGet()'s OAuth-redirect callback instead.
 * Returns { ok:false, code:'invalid_email'|'not_authorized' } or
 * { ok:true, token, user }.
 */
function establishSession(idToken) {
  var claims = verifyGoogleIdToken_(idToken);
  if (claims.email_verified !== 'true' && claims.email_verified !== true) {
    throw new Error('INVALID_TOKEN: Google did not report this email as verified.');
  }
  return establishSessionForVerifiedClaims_(claims);
}

/**
 * Every OTHER client-callable function's required first line. Looks up the
 * session established by establishSession() and returns { email, role }.
 * Throws an Error whose message starts with 'SESSION_EXPIRED' — Dashboard.
 * html's apsScriptRun() wrapper specifically recognizes that prefix and
 * shows the sign-in screen again, instead of a generic error toast.
 */
function requireValidSession_(sessionToken) {
  var raw = sessionToken && CacheService.getScriptCache().get(SESSION_CACHE_PREFIX_ + sessionToken);
  if (!raw) throw new Error('SESSION_EXPIRED: please sign in again.');
  return JSON.parse(raw);
}

/** Explicit "Sign Out" — removes the session immediately rather than waiting
 *  for it to expire on its own. Safe to call with an already-invalid token. */
function endSession(sessionToken) {
  if (sessionToken) CacheService.getScriptCache().remove(SESSION_CACHE_PREFIX_ + sessionToken);
  return { ok: true };
}

/**
 * Builds the same { authenticated, email, name, apsId, role, permissions,
 * canViewMonitoringFilters, canViewMonitoringTotals } shape the client has
 * always received after login — unchanged from before the owner-execution
 * migration, just built from an already-verified { email, role } instead of
 * re-deriving it from Session.getActiveUser().
 */
function buildAuthenticatedUserPayload_(viewer, courses) {
  var name = resolveViewerBadgeName_({ role: viewer.role, email: viewer.email }, courses);
  return {
    authenticated: true,
    email: viewer.email,
    name: name,
    apsId: extractAPSID_(viewer.email),
    role: viewer.role,
    permissions: getDashboardRolePermission_(viewer.role),
    canViewMonitoringFilters: canViewMonitoringFilters_(viewer.role),
    canViewMonitoringTotals: canViewMonitoringTotals_(viewer.role),
    examinationAccess: examinationAccessForRole_(viewer.role),
    gradingAccess: rosterAccessForRole_(viewer.role), // Examination > Grading (Classroom Roster) gate — see CLASSROOM ROSTER / GRADING MODULE
    apsRole: apsRoleFor_(viewer, courses), // ADMIN / HM / VP / TEACHER / … — display + Class Support label (see CLASS SUPPORT module)
    roleLabel: isOnCallCoordinatorEmail_(viewer.email) ? ON_CALL_COORDINATOR_LABEL_ : '', // r54: display only
    tabAccess: acEffectiveForRole_(viewer.role), // r56: { key: false } for tabs an admin turned off for this role (Admin Control → Access Control)
    coverageAccess: tccCanUse_(viewer.role, viewer.email, courses), // r58: Classes → Temporary Class Coverage (Admin / Super Admin / HM / class VP-HM)
    coverageTrackingAccess: tccCanUse_(viewer.role, viewer.email, courses), // r70: Classes → Class Coverage Tracking (same people; server re-checks every call)
    tempTeacherAccess: ttmCanUse_(viewer.role, viewer.email) // r89: Classes → Temp Teacher (server re-checks every call)
  };
}

/**
 * Kept for the one remaining internal caller (submitUserIdea) that wants the
 * full user payload rather than the bare { email, role } requireValidSession_()
 * returns. Throws SESSION_EXPIRED the same way requireValidSession_() does if
 * the token is missing/expired.
 */
function getAuthenticatedAPSUser(sessionToken) {
  var session = requireValidSession_(sessionToken);
  var courses = readAllCoursesFromCache_();
  return buildAuthenticatedUserPayload_({ email: session.email, role: session.role }, courses);
}

function normalizeEmail_(email) {
  return (email || '').trim().toLowerCase();
}

function isInEmailList_(email, list) {
  var normalized = normalizeEmail_(email);
  if (!normalized) return false;
  return list.some(function (e) { return normalizeEmail_(e) === normalized; });
}

/** True if `course` lists this (already-normalized) email as a teacher. */
function courseHasTeacherEmail_(course, normalizedEmail) {
  if (!normalizedEmail || !course) return false;
  if ((course.teachers || []).some(function (t) { return normalizeEmail_(t.email) === normalizedEmail; })) return true;
  // r46 — every Google Classroom teacher of the course has teacher access to it, including tcs_ / tts_ on-call
  // accounts and others hidden from the card display (display rules are unchanged).
  return (course.rosterTeacherEmails || []).indexOf(normalizedEmail) > -1;
}

/**
 * True if this (already-normalized) email is a VP / HM named in the course's Room / Description (Class Support)
 * AND is a Google Classroom TEACHER of it — both are required (a failed Classroom add grants no dashboard access).
 */
function courseHasSupportEmail_(course, normalizedEmail) {
  return !!normalizedEmail && (course.classSupport || []).some(function (s) {
    return s.email === normalizedEmail && s.member === true && (s.roles || []).some(function (r) { return r === 'VP' || r === 'HM'; });
  });
}
/**
 * Course-level authorization for class-scoped (teacher-level) users: the Classroom TEACHER of the
 * course, or a VP / HM named in its Room / Description. Every teacher-scoped permission check uses
 * this, so a changed courseId from the browser never opens another class.
 */
function userHasCourseAccess_(userEmail, course) {
  var e = normalizeEmail_(userEmail);
  if (!course || !e) return false;
  if (courseHasTeacherEmail_(course, e)) return true;
  // Named in the Course Description (PRIMARY_TEACHER) or Room (VP / HM) AND a Classroom TEACHER — even when the
  // account is hidden from the roster display (HIDDEN_TEACHER_EMAIL_PREFIXES / Hide toggle).
  return (course.classSupport || []).some(function (s) { return s.email === e && classSupportGrantsAccess_(s); });
}

/** VP / HM of THIS class (Room/Description label + Classroom TEACHER): HM-level operations on this class only. Never for other classes. */
function classSupportElevated_(viewer, course) {
  return !!viewer && viewer.role === 'teacher' && !!course && courseHasSupportEmail_(course, normalizeEmail_(viewer.email));
}

/** True if `course` lists this (already-normalized) email as a student. */
function courseHasStudentEmail_(course, normalizedEmail) {
  return (course.students || []).some(function (s) { return normalizeEmail_(s.email) === normalizedEmail; });
}

/**
 * Figures out who's looking at the dashboard and returns just
 * { email, role } — role is one of 'admin' | 'headmaster' | 'teacher' |
 * 'student' | 'none'. Used both by getViewerContext_() (to decide what to
 * show) and by the setTeacherNotInClassStage/setNeedsTechSupportStage
 * permission checks (to decide who's allowed to click what).
 */
function getViewerRoleForEmail_(email, courses) {
  email = normalizeEmail_(email);

  if (isInEmailList_(email, SUPERADMIN_EMAILS)) return { email: email, role: SUPERADMIN_ROLE };
  if (isInEmailList_(email, VCFO_AMCHATS_BOD_EMAILS)) return { email: email, role: VCFO_AMCHSTS_BOD_ROLE };
  if (isInEmailList_(email, ADMIN_EMAILS)) return { email: email, role: 'admin' };
  if (isInEmailList_(email, HEADMASTER_EMAILS)) return { email: email, role: 'headmaster' };
  if (isOnCallCoordinatorEmail_(email)) return { email: email, role: VCFO_AMCHSTS_BOD_ROLE }; // r54: On-Call Coordinator — read-only, all classes
  var configuredRoles = readConfiguredUserRoles_();
  if (configuredRoles[email]) return { email: email, role: configuredRoles[email] };

  if (email) {
    var isTeacher = courses.some(function (c) { return userHasCourseAccess_(email, c); }); // Classroom TEACHER or Room VP/HM (Class Support)
    var isStudent = courses.some(function (c) { return courseHasStudentEmail_(c, email); });
    if (isTeacher) {
      return { email: email, role: 'teacher' };
    }
    if (isStudent) {
      return { email: email, role: 'student' };
    }
    if (isApsEmailAllowed_(email)) return { email: email, role: AUTHORIZED_ROLE };
  }

  return { email: email, role: 'none' };
}

/** LEGACY/cosmetic-only. Derives the viewer's role straight from
 *  Session.getActiveUser() — under the owner-execution deployment model
 *  (see the session-infrastructure block above) that reliably resolves only
 *  for the Dashboard owner; for anyone else it degrades harmlessly to role
 *  'none'. Its only remaining caller is doGet(), for the browser tab's
 *  cosmetic page title, which already tolerates a generic fallback. Every
 *  function that gates real data/actions uses requireValidSession_() /
 *  getViewerRoleForEmail_() with the verified email from establishSession()
 *  instead — never this. */
function getViewerRole_(courses) {
  return getViewerRoleForEmail_(Session.getActiveUser().getEmail(), courses);
}

/**
 * Figures out who's looking at the dashboard and returns
 * { email, role, courses } where role is one of:
 *   'admin' | 'headmaster' | 'teacher' | 'student' | 'none'
 * and courses is already filtered down to what that role should see.
 */
function getViewerContext_(courses, viewer) {
  if (viewer.role === SUPERADMIN_ROLE || viewer.role === 'admin' || viewer.role === 'headmaster' || viewer.role === VCFO_AMCHSTS_BOD_ROLE) {
    return { email: viewer.email, role: viewer.role, courses: courses };
  }
  if (viewer.role === 'teacher') {
    var asTeacherOrStudent = courses.filter(function (c) {
      return userHasCourseAccess_(viewer.email, c) || courseHasStudentEmail_(c, viewer.email);
    });
    asTeacherOrStudent.forEach(function (c) { c.viewerAccess = classAccessFor_(c, viewer.email); }); // "VP · Class Support" etc. on the card
    return { email: viewer.email, role: 'teacher', courses: asTeacherOrStudent };
  }
  if (viewer.role === 'student') {
    var asStudent = courses.filter(function (c) { return courseHasStudentEmail_(c, viewer.email); });
    return { email: viewer.email, role: 'student', courses: asStudent };
  }
  if (viewer.role === AUTHORIZED_ROLE) {
    return { email: viewer.email, role: AUTHORIZED_ROLE, courses: [] };
  }

  return { email: viewer.email, role: 'none', courses: [] };
}

// Part 19: the browser TAB title is generated per-role, after resolving who's
// signed in — the exact strings below are as specified. This is separate
// from the on-page <h1> heading (still "Avvaiyar Padasalai Tamil Virtual
// School — Classroom Dashboard", full branding preserved) which
// Dashboard.html itself appends "(ROLE)" onto client-side, once currentUser
// is known — see renderViewerInfo() there.
var CLASS_ROLE_TITLE_SUFFIX = { superadmin: 'SUPERADMIN', admin: 'ADMIN', headmaster: 'HM', teacher: 'Teacher', student: 'Student', authorized: 'Authorized User', vcfo_amchsts_bod: 'BOD-AMCHATS' };

/**
 * Sept 2026, fifty-third round: doGet() now does double duty. On a PLAIN
 * visit (no `code` parameter) it renders the dashboard as before, PLUS a
 * fresh "Sign in with Google" link (buildGoogleAuthUrl_()) for the Login
 * screen. On the OAuth-redirect CALLBACK visit — Google sending the browser
 * back here with `?code=...&state=...` after the visitor approves sign-in —
 * it exchanges that code for the visitor's verified identity entirely
 * server-side and renders the SAME Dashboard.html template, but with the
 * resulting session (APS_BOOT_SESSION_TOKEN/APS_BOOT_USER) or failure
 * (APS_BOOT_ERROR) baked directly into the page as it's generated.
 * Dashboard.html's apsBootstrapSession() checks for these first, before
 * falling back to a remembered localStorage session — see the comment above
 * buildGoogleAuthUrl_() for why this redirect approach replaced the Round 52
 * button-based one.
 */

/**
 * Sept 2026, fifty-ninth round — RUN THIS ONE FUNCTION, ONCE, MANUALLY, as
 * the Google account that owns/deployed this Web App, to fix
 * "scope_authorization" / "We couldn't verify your Google sign-in ...
 * UrlFetchApp.fetch ... Required permissions: script.external_request"
 * errors:
 *   1. Open this Apps Script project (Extensions > Apps Script from the
 *      linked Google Sheet, or script.google.com) signed in as that owner.
 *   2. In the function dropdown at the top of the editor toolbar, select
 *      "apsOwnerReauthorizeAllScopes".
 *   3. Click the Run (▶) button.
 *   4. Google will show an "Authorization required" dialog listing every
 *      permission in appsscript.json's oauthScopes. Click through it —
 *      "Advanced > Go to [project name] (unsafe)" if it warns the app is
 *      unverified — and Allow. (Declaring a scope in appsscript.json does
 *      NOT retroactively grant it; only actually clicking Allow here does.)
 *   5. Back in the editor, View > Logs (or View > Execution log) shows a
 *      PASS/FAIL line for every scope this dashboard actually uses. If
 *      everything says PASS, sign-in is fixed for everyone — no redeploy
 *      needed. If anything still says FAIL, that line's message says
 *      exactly which permission is still missing.
 *
 * WHY ONLY "a few users" are seeing this and not everyone: this Web App
 * runs "Execute as: Me" (USER_DEPLOYING) — every visitor's request runs
 * under the SAME owner authorization, so a missing scope should normally
 * block ALL sign-ins, not just some. It shows up as "a few users" here
 * because apsBootstrapSession() (Dashboard.html) only exercises the broken
 * code path (exchangeCodeForTokens_()/verifyGoogleIdToken_(), the only
 * functions that call UrlFetchApp during sign-in) for a FRESH Google
 * sign-in — anyone with a still-valid remembered session (localStorage,
 * up to 30 days) skips straight past it and never notices anything is
 * wrong. The affected group will keep growing as more people's remembered
 * sessions expire, until this is actually run and authorized — so this is
 * worth doing right away even though most users still look fine today.
 *
 * Every probe below is READ-ONLY and safe to run against live production
 * data — nothing is created, changed, sent, or deleted. A probe for a
 * config value that isn't set (e.g. REFERENCE_LETTER_TEMPLATE_DOC_ID on a
 * deployment that hasn't configured that feature) is skipped, not failed,
 * since that's a separate, unrelated setup step (see the fifty-fourth
 * round) — not a scope-authorization problem.
 */
function apsOwnerReauthorizeAllScopes() {
  apsRequireOwnerOrTrigger_(null); // r55: editor (script owner) only — not callable from the web app
  var results = [];
  function probe(label, fn) {
    try {
      fn();
      results.push('PASS - ' + label);
    } catch (e) {
      results.push('FAIL - ' + label + ' -> ' + (e && e.message ? e.message : String(e)));
    }
  }
  function skip(label, reason) {
    results.push('SKIP - ' + label + ' (' + reason + ')');
  }

  // The exact scope named in the reported error — this is the one that
  // matters most for fixing sign-in.
  probe('UrlFetchApp / external requests (script.external_request)', function () {
    UrlFetchApp.fetch('https://www.googleapis.com/discovery/v1/apis', { muteHttpExceptions: true });
  });

  probe('Signed-in identity (userinfo.email)', function () {
    Session.getActiveUser().getEmail();
  });

  probe('Outgoing mail quota check, does NOT send anything (script.send_mail)', function () {
    MailApp.getRemainingDailyQuota();
  });

  (function () {
    var id = getConfigString_('TARGET_SPREADSHEET_ID', '');
    if (!id) { skip('Spreadsheets (spreadsheets)', 'TARGET_SPREADSHEET_ID not set'); return; }
    probe('Spreadsheets (spreadsheets)', function () { SpreadsheetApp.openById(id).getName(); });
  })();

  (function () {
    var id = getConfigString_('REFERENCE_LETTER_TEMPLATE_DOC_ID', '');
    if (!id) { skip('Docs (documents)', 'REFERENCE_LETTER_TEMPLATE_DOC_ID not set'); return; }
    probe('Docs (documents)', function () { DocumentApp.openById(id).getName(); });
  })();

  probe('Drive (drive)', function () { DriveApp.getRootFolder().getName(); });

  var firstCourseId = '';
  probe('Classroom (classroom.courses.readonly)', function () {
    var r = Classroom.Courses.list({ pageSize: 1, courseStates: ['ACTIVE'] });
    firstCourseId = r && r.courses && r.courses[0] ? r.courses[0].id : '';
  });

  // Examination > Grading reads assignments + student submissions (read-only list calls).
  if (!firstCourseId) skip('Classroom coursework / submissions (classroom.coursework.students)', 'no ACTIVE classroom visible');
  else {
    probe('Classroom coursework list (classroom.coursework.students)', function () { Classroom.Courses.CourseWork.list(firstCourseId, { pageSize: 1 }); });
    probe('Classroom student submissions list (classroom.coursework.students)', function () { Classroom.Courses.CourseWork.StudentSubmissions.list(firstCourseId, '-', { pageSize: 1 }); });
  }

  probe('Admin Directory (admin.directory.user.readonly)', function () {
    // Looks up the running (owner) account's own directory entry — the
    // smallest possible read against this scope. A FAIL here that mentions
    // "Not Authorized"/403 rather than a scope name can also mean this
    // Google Workspace account isn't a domain admin, which is a separate,
    // unrelated setup issue, not a script-authorization one.
    AdminDirectory.Users.get(Session.getActiveUser().getEmail());
  });

  probe('Admin Reports (admin.reports.audit.readonly)', function () {
    AdminReports.Activities.list('all', 'login', { maxResults: 1 });
  });

  Logger.log(results.join('\n'));
  return results; // also visible in View > Executions if Logger output is missed
}

function doGet(e) {
  var bootSessionToken = null;
  var bootUser = null;
  var bootError = null;

  var code = e && e.parameter && e.parameter.code;
  var oauthError = e && e.parameter && e.parameter.error; // e.g. user clicked "Cancel" on Google's consent screen
  // r52 Tickets: email links open ?ticket=APS-YYYYMMDD-NNNN. The number is validated, carried through Google sign-in
  // via the existing state nonce (cache, 10 min) and handed to the page; the ticket itself is still permission-checked.
  var bootTicket = null;
  try {
    var tkParam = String(e && e.parameter && e.parameter.ticket || '').trim().toUpperCase();
    if (/^APS-\d{8}-\d{4,6}$/.test(tkParam)) bootTicket = tkParam;
    else if (e && e.parameter && e.parameter.state) bootTicket = CacheService.getScriptCache().get('aps_tk_link_' + e.parameter.state) || null;
  } catch (eTk) { bootTicket = null; }
  if (code) {
    try {
      // Best-effort CSRF/replay check — Apps Script Web Apps have no simple
      // cookie/session mechanism to bind this more strongly to the specific
      // browser that started the flow, so a short-lived (10 min), single-use
      // cache entry keyed BY the nonce itself is the practical option here.
      // Deliberately non-fatal if it's missing/expired: failing OPEN on this
      // check only weakens replay protection for a narrow window on an
      // already-single-use, short-lived authorization code — it never fails
      // CLOSED and blocks a legitimate sign-in over a cache eviction.
      var state = e.parameter.state;
      if (state) {
        var stateKey = OAUTH_STATE_CACHE_PREFIX_ + state;
        if (CacheService.getScriptCache().get(stateKey)) {
          CacheService.getScriptCache().remove(stateKey); // single-use
        }
      }

      var tokens = exchangeCodeForTokens_(code);
      var claims = verifyGoogleIdToken_(tokens.id_token);
      if (claims.email_verified !== 'true' && claims.email_verified !== true) {
        bootError = { code: 'invalid_token', message: 'Google did not report this email as verified.' };
      } else {
        var result = establishSessionForVerifiedClaims_(claims);
        if (result.ok) {
          bootSessionToken = result.token;
          bootUser = result.user;
        } else {
          bootError = { code: result.code };
        }
      }
    } catch (err) {
      var bootErrMsg = String((err && err.message) || err);
      // Sept 2026 addendum: a raw Apps Script authorization exception (the
      // platform itself blocking UrlFetchApp.fetch() inside
      // exchangeCodeForTokens_()/verifyGoogleIdToken_() above because the
      // DEPLOYING OWNER account hasn't yet granted a scope that IS already
      // declared in appsscript.json — adding a scope to the manifest does
      // NOT retroactively grant it; only the owner re-running the
      // authorization prompt does) is a completely different problem from a
      // genuinely invalid/expired sign-in token, and needs different
      // instructions (re-authorize the script, not fix the OAuth Client ID).
      // Recognized by Apps Script's own standard wording for this failure
      // class ("You do not have permission to call X. Required
      // permissions: ..."), so it's classified separately here rather than
      // being lumped into 'invalid_token' — see apsShowAuthError() in
      // Dashboard.html for the matching client-side copy.
      if (/do not have permission to call|Required permissions:/i.test(bootErrMsg)) {
        bootError = { code: 'scope_authorization', message: bootErrMsg };
      } else {
        bootError = { code: 'invalid_token', message: bootErrMsg };
      }
    }
  } else if (oauthError) {
    // Visitor landed back here via the redirect but declined/cancelled on
    // Google's own consent screen — not a real error, just show Login again.
    bootError = { code: 'cancelled' };
  }

  var pageTitle = 'Avvaiyar Padasalai Tamil Virtual School - Classroom Dashboard'; // fallback for 'none'/unrecognized, or if role lookup fails
  try {
    // Read-only from the cache Sheet (no Classroom API call), same as
    // getDashboardData() — safe to do here too, no quota risk.
    var courses = readAllCoursesFromCache_();
    var viewer = getViewerRole_(courses);
    var suffix = CLASS_ROLE_TITLE_SUFFIX[viewer.role];
    if (suffix) pageTitle = 'Avvaiyar Padasalai — Classroom Dashboard (' + suffix + ')';
  } catch (titleErr) {
    // Cache sheet not created yet (brand-new deployment) or any other read
    // failure — fall back to the generic title rather than blocking the page.
  }

  // A fresh state nonce for the login link THIS render offers — independent
  // of whatever `state` (if any) was just consumed above, so the link always
  // works for the visitor's next attempt even after a failed/cancelled one.
  var freshState = Utilities.getUuid();
  CacheService.getScriptCache().put(OAUTH_STATE_CACHE_PREFIX_ + freshState, '1', OAUTH_STATE_TTL_SECONDS);
  if (bootTicket) { try { CacheService.getScriptCache().put('aps_tk_link_' + freshState, bootTicket, OAUTH_STATE_TTL_SECONDS); } catch (eTk2) { /* link only */ } }

  // Sept 2026, fifty-fourth round: OAUTH_CLIENT_ID now comes from a Script
  // Property that could be unset (see the config block near the top of this
  // file), and buildGoogleAuthUrl_() throws in that case — this used to be
  // an unguarded call, which would crash doGet() ENTIRELY (no page at all,
  // for every visitor) instead of just disabling sign-in with a clear
  // message. Guarded the same way the OAuth-callback branch above already
  // is, so a missing Script Property degrades gracefully instead of taking
  // the whole login page down.
  var authUrl = '';
  try {
    authUrl = buildGoogleAuthUrl_(freshState);
  } catch (authUrlErr) {
    console.error('[Dashboard] Could not build the Google sign-in URL: ' + (authUrlErr && authUrlErr.message ? authUrlErr.message : String(authUrlErr)));
    if (!bootError) bootError = { code: 'oauth_not_configured', message: 'Sign-in is not configured yet. Please contact an Administrator.' };
  }

  var tmpl = HtmlService.createTemplateFromFile('Dashboard');
  tmpl.APS_OAUTH_AUTH_URL = authUrl;
  tmpl.APS_BOOT_SESSION_TOKEN = bootSessionToken;
  tmpl.APS_BOOT_USER = bootUser;
  tmpl.APS_BOOT_ERROR = bootError;
  tmpl.APS_BOOT_TICKET = bootTicket;

  return tmpl.evaluate()
    .setTitle(pageTitle)
    .addMetaTag('viewport', 'width=device-width, initial-scale=1')
    .setXFrameOptionsMode(HtmlService.XFrameOptionsMode.ALLOWALL);
}

function include(filename) {
  return HtmlService.createHtmlOutputFromFile(filename).getContent();
}

function fixPhoto_(url) {
  if (!url) return PLACEHOLDER_PHOTO;
  return url.indexOf('//') === 0 ? 'https:' + url : url;
}

/**
 * Returns true if the course name ends with COURSE_NAME_SUFFIX (trimmed,
 * case-insensitive). If COURSE_NAME_SUFFIX is empty, everything matches.
 */
function courseNameMatches_(name) {
  if (!COURSE_NAME_SUFFIX) return true;
  if (!name) return false;
  var trimmed = name.trim().toLowerCase();
  var suffix = COURSE_NAME_SUFFIX.trim().toLowerCase();
  return trimmed.slice(-suffix.length) === suffix;
}

/** Returns true if this name is a support/admin co-teacher account that should be hidden. */
function isHiddenTeacherName_(name, email) {
  var normalizedName = String(name || '').trim().toLowerCase();
  var normalizedEmail = String(email || '').trim().toLowerCase();
  if (normalizedEmail && APS_GRADING_TEAM_EMAILS_.some(function (g) { return normalizeEmail_(g) === normalizedEmail; })) return true; // r116: Grading Help Team account
  if (normalizedName && HIDDEN_TEACHER_NAMES.indexOf(normalizedName) > -1) return true;
  if (normalizedName && HIDDEN_TEACHER_NAME_PREFIXES.some(function (prefix) {
    return normalizedName.indexOf(String(prefix || '').trim().toLowerCase()) === 0;
  })) return true;
  return !!normalizedEmail && HIDDEN_TEACHER_EMAIL_PREFIXES.some(function (prefix) {
    return normalizedEmail.indexOf(String(prefix || '').trim().toLowerCase()) === 0;
  });
}

/**
 * Sept 2026, thirty-third round: display-only "Hide/Show" filter for the
 * Headmaster/Admin/support-staff accounts in ROSTER_HIDDEN_STAFF_EMAILS.
 * Unlike isHiddenTeacherName_ above (baked into the Classroom-sync cache,
 * permanent, no toggle), this filter is applied FRESH on every
 * getDashboardData() call and is gated by the ROSTER_HIDDEN_STAFF_VISIBLE_
 * PROP_KEY toggle (default: hidden) — so the Admin/Super Admin "Hide"/"Show"
 * toolbar button takes effect instantly for every viewer, with no Force
 * Sync required, and costs zero Classroom API quota either way.
 *
 * Mutates each course's `teachers`/`students` arrays in place (dropping the
 * matching entries) and recomputes the small set of flags/counts that are
 * purely derived from array length (noTeacher, noStudents, studentCount) so
 * those badges stay accurate for what's actually DISPLAYED.
 *
 * Deliberately does NOT touch: `onCallTeacherCandidates` (already stripped
 * from the cached record before it's written — see buildCourseRecord_);
 * `studentsInMeetCount`/`live`/`liveSource` (computed once at Classroom-sync
 * time from the FULL roster and cached — a hidden account's genuine Meet/
 * Classroom activity still legitimately signals a class is "Live", even
 * though that account is no longer listed in the visible roster); or the
 * persistent Last Login record (a separate, deliberate design choice — see
 * getMeetPresenceMap_/getClassroomActivityMap_'s GC/GM exclusion for these
 * same accounts, and recordHeartbeat_'s unconditional DB capture).
 *
 * Called once per getDashboardData() request, right after courses are read
 * from cache and BEFORE the heavier applyLivePresence_/applyLastLogin_/
 * applyUserCountry_ decoration passes — so a hidden account's roster entry
 * is filtered out before any of that per-person decoration work runs on it
 * at all, not just hidden after the fact.
 */
/**
 * Classes tab: accounts ALWAYS shown on every class card where they are a Google Classroom teacher — even when an
 * Admin/hidden list, HIDDEN_TEACHER_EMAIL_PREFIXES, the Hide toggle or the "Primary Teacher only" card view would hide them.
 * Display only: no Classroom change, no extra permission, Attendance / Teacher Availability exclusions unchanged.
 * Script Property APS_CLASSES_ALWAYS_SHOW_EMAILS (JSON array or comma list); default vsugadev@avvaiyarpadasalai.org.
 */
var CLASSES_ALWAYS_SHOW_CACHE_ = null;
function classesAlwaysShowEmails_() {
  if (CLASSES_ALWAYS_SHOW_CACHE_) return CLASSES_ALWAYS_SHOW_CACHE_;
  var raw = PropertiesService.getScriptProperties().getProperty('APS_CLASSES_ALWAYS_SHOW_EMAILS');
  var list = ['vsugadev@avvaiyarpadasalai.org'];
  if (raw !== null && raw !== undefined && String(raw).trim() !== '') {
    try { list = JSON.parse(raw); if (!Array.isArray(list)) throw new Error('not an array'); } catch (e) { list = String(raw).split(/[;,\s]+/); }
  }
  var out = {};
  list.forEach(function (e) { e = normalizeEmail_(e); if (e) out[e] = true; });
  CLASSES_ALWAYS_SHOW_CACHE_ = out;
  return out;
}
/**
 * Email prefixes shown on a class card only as the Course Description's Primary Teacher (Script Property
 * APS_CLASSES_PRIMARY_ONLY_PREFIXES, comma list; default "tcs_,tts_"). Display only.
 */
var CLASSES_PRIMARY_ONLY_PREFIXES_CACHE_ = null;
function classesPrimaryOnlyPrefix_(email) {
  var e = normalizeEmail_(email);
  if (!e) return false;
  if (!CLASSES_PRIMARY_ONLY_PREFIXES_CACHE_) {
    var raw = PropertiesService.getScriptProperties().getProperty('APS_CLASSES_PRIMARY_ONLY_PREFIXES');
    raw = raw === null || raw === undefined ? 'tcs_,tts_' : String(raw);
    CLASSES_PRIMARY_ONLY_PREFIXES_CACHE_ = raw.replace(/[\[\]"']/g, ' ').split(/[,;\s]+/).map(function (p) { return p.trim().toLowerCase(); }).filter(Boolean);
  }
  return CLASSES_PRIMARY_ONLY_PREFIXES_CACHE_.some(function (p) { return e.indexOf(p) === 0; });
}
function classesAlwaysShowEmail_(email) { var e = normalizeEmail_(email); return !!e && !!classesAlwaysShowEmails_()[e]; }

function applyRosterHiddenStaffFilter_(courses) {
  if (getRosterHiddenStaffVisible_()) return; // toggle currently set to "Show" — nothing to filter
  (courses || []).forEach(function (course) {
    if (course.teachers && course.teachers.length) {
      // a person named in the Course Description / Room (t.apsRoles) is always shown with their (VP)/(HM) tag
      course.teachers = course.teachers.filter(function (t) { return (t.apsRoles && t.apsRoles.length) || classesAlwaysShowEmail_(t.email) || !isRosterHiddenStaffEmail_(t.email); });
    }
    if (course.students && course.students.length) {
      course.students = course.students.filter(function (s) { return !isRosterHiddenStaffEmail_(s.email); });
    }
    course.noTeacher = course.teachers.length === 0;
    course.noStudents = course.students.length === 0;
    course.studentCount = course.students.length;
  });
}

/**
 * Splits a phone number out of a Classroom display name like
 * "Mrs. Kavitha - 98410 12345" or "Head Master (+91 98410 12345)".
 * Returns { name: <phone removed, cleaned up>, phone: <the phone number, or ''> }.
 * If stripping would empty the name out entirely, falls back to the raw name.
 */
function splitNameAndPhone_(rawName) {
  if (!rawName) return { name: rawName, phone: '' };
  var phoneMatch = rawName.match(/\+?\d[\d\-\s().]{5,}\d/);
  var phone = phoneMatch ? phoneMatch[0].trim() : '';
  var name = rawName
    .replace(/\+?\d[\d\-\s().]{5,}\d/g, '')
    .replace(/[-|,;:()]+\s*$/g, '')
    .replace(/^[-|,;:()]+\s*/g, '')
    .replace(/\s{2,}/g, ' ')
    .trim();
  if (!name) name = rawName;
  return { name: name, phone: phone };
}

/**
 * An on-call teacher is either a Classroom teacher whose email local-part
 * starts with "tcs_" or "tts_" (any case; attIsOnCallEmail_), or a specifically designated on-call account. This
 * is intentionally evaluated while the scheduled sync already has the
 * Classroom teacher roster in hand; dashboard reads never add API calls.

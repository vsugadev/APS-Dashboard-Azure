}

/** Sync step for one course: add missing Classroom TEACHER membership (once; failures retried after 6 h), tag course.teachers, log skips. */
function classSupportForCourse_(course, parsed, teachers, rawTeacherEmails, teachersListed) {
  var entries = (parsed && parsed.entries) || [];
  var cache = CacheService.getScriptCache();
  var exec = classSupportExecId_();
  var cid = String(course.id), cname = course.name || '';

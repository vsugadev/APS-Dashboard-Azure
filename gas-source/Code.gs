  for (var i = vals.length - 1; i >= 0; i--) {
    if (String(vals[i][0]) !== reportId) continue;
    var o = { _row: i + 2 }; CCW_HEADER_.forEach(function (h, j) { o[h] = String(vals[i][j] === null || vals[i][j] === undefined ? '' : vals[i][j]); });
    return o;

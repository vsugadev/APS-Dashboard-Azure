        if (!diag.rest.lastError) { var t = ''; try { t = String(r.getContentText() || ''); } catch (eT) { t = ''; } diag.rest.lastError = 'HTTP ' + r.getResponseCode() + ' for ' + a.code + ': ' + t.replace(/\s+/g, ' ').replace(/(Bearer|token|secret|private_key)[^\s,)]*/gi, '$1 [hidden]').slice(0, 160); }
        return;
      }
      delete noAccess[a.code];
      diag.rest.ok++;
      var space = {}; try { space = JSON.parse(r.getContentText()); } catch (eP) { space = {}; }
      var conf = space.activeConference && space.activeConference.conferenceRecord;
      a.restKnown = true;
      a.live = !!conf;
      if (conf) {
        diag.rest.live++;
        partReq.push({ url: MEET_API_BASE_ + '/' + conf + '/participants?pageSize=100&filter=' + encodeURIComponent('latest_end_time IS NULL'), headers: { Authorization: 'Bearer ' + token }, muteHttpExceptions: true });
        partIdx.push(restIdx[k]);

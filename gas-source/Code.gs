// CLASS-DURATION RULE (Sept 27, 2026): the teacher's ACTUAL class minutes
// (first valid teacher join -> last valid teacher leave) are kept as-is for
// audit; the EFFECTIVE minutes used as the attendance denominator are
// actual when actual < 90, otherwise a fixed 95 (a calculation maximum,
// never the real Meet duration).
var ATTENDANCE_EFFECTIVE_CAP_FROM_MIN = 90;
var ATTENDANCE_EFFECTIVE_CAP_MIN = 95;
function getEffectiveClassMinutes(actualMinutes) {
  var minutes = Number(actualMinutes) || 0;
  if (minutes < ATTENDANCE_EFFECTIVE_CAP_FROM_MIN) return minutes;
  return ATTENDANCE_EFFECTIVE_CAP_MIN;
}

/** Minutes CREDITED against the class (attended capped at the effective minutes) — used for the On-Call report's "Credited minutes" total. The Minutes column itself always shows the real attended minutes / calculation minutes (e.g. 135 / 95). */
function attCountedMinutes_(r) {
  var eff = Number(r.effectiveClassMinutes !== undefined && r.effectiveClassMinutes !== null ? r.effectiveClassMinutes : r.callMinutes) || 0;
  return Math.min(Number(r.activeMinutes) || 0, eff);
}

/** Attended % = attended / effective class minutes, 2 decimals, capped at 100 (0 when there was no class). */
function attAttendedPct_(attendedMinutes, effectiveMinutes) {
  var eff = Number(effectiveMinutes) || 0;
  if (eff <= 0) return 0;
  return Math.min(100, Math.round(((Number(attendedMinutes) || 0) / eff) * 10000) / 100);
}

/** 'Actual: 130 min · Calculation: 95 min (Max)' / 'Actual: 75 min · Calculation: 75 min' — the one display string for class duration (emails; the tab builds the same from the same fields). */
function attClassMinutesLabel_(r) {
  var eff = Number(r.effectiveClassMinutes !== undefined && r.effectiveClassMinutes !== null ? r.effectiveClassMinutes : r.callMinutes) || 0;
  var actual = (r.actualClassMinutes === null || r.actualClassMinutes === undefined) ? eff : (Number(r.actualClassMinutes) || 0);
  return 'Actual: ' + actual + ' min · Calculation: ' + eff + ' min' + (actual >= ATTENDANCE_EFFECTIVE_CAP_FROM_MIN ? ' (Max)' : '');
}

/** Attended % -> score per ATTENDANCE_SCORE_TIERS_. */
function attScoreForPct_(pct) {
  pct = Number(pct) || 0;
  for (var i = 0; i < ATTENDANCE_SCORE_TIERS_.length; i++) {
    var t = ATTENDANCE_SCORE_TIERS_[i];
    if (t.exclusive ? pct > t.minPct : pct >= t.minPct) return t.score;
  }
  return 0;
}

/** Captured status label for a score: 100 PRESENT, 0 ABSENT, anything between PARTIAL. */
function attStatusForScore_(score) {
  return score >= 100 ? ATTENDANCE_STATUS.PRESENT : (score <= 0 ? ATTENDANCE_STATUS.ABSENT : ATTENDANCE_STATUS.PARTIAL);
}

/** Effective score of a record: the override's fixed score if overridden, else the captured score. */
function attEffectiveScore_(r) {
  if (r.overrideStatus && ATTENDANCE_OVERRIDE_SCORES_.hasOwnProperty(r.overrideStatus)) return ATTENDANCE_OVERRIDE_SCORES_[r.overrideStatus];
  return Number(r.autoScore) || 0;
}

/** Weight (minutes) of a record in the overall %: its call minutes; if no call happened but it was overridden, its scheduled minutes. */
function attRecordWeight_(r) {
  var call = Number(r.callMinutes) || 0;
  if (call > 0) return call;
  return r.overrideStatus ? attScheduledMinutesFromLabels_(r.schedStart, r.schedEnd) : 0;
}

/** 'h:mm AM' labels -> minutes between them (0 if unparseable). */
function attScheduledMinutesFromLabels_(startLabel, endLabel) {
  var toMin = function (t) {
    var m = /^(\d{1,2}):(\d{2})\s*(AM|PM)$/i.exec(String(t || '').trim());
    if (!m) return null;
    var h = Number(m[1]) % 12 + (m[3].toUpperCase() === 'PM' ? 12 : 0);
    return h * 60 + Number(m[2]);
  };
  var a = toMin(startLabel), b = toMin(endLabel);
  if (a === null || b === null) return 0;
  return b > a ? b - a : b + 1440 - a;
}


  var defaults = defaultDashboardRolePermissions_();
  var raw = PropertiesService.getScriptProperties().getProperty(ROLE_PERMISSION_PROP_KEY);
  var saved = raw ? JSON.parse(raw) : {};
  Object.keys(defaults).forEach(function (role) {

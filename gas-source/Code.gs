  S.push({ h: 'மாதாந்திர வகுப்பு சுருக்கம்', list: ['மொத்த வகுப்பு நாட்கள்: ' + classDays, 'மொத்த வகுப்பு அமர்வுகள்: ' + sessions, 'மாணவர்கள் (கடைசி வகுப்பு நாள்): ' + students, 'ஆசிரியர்கள் (கடைசி வகுப்பு நாள்): ' + teachers,

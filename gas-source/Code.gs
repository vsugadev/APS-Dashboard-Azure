  var lastCol = sh.getLastColumn(), have = lastCol ? sh.getRange(1, 1, 1, lastCol).getValues()[0].map(String) : [];
  if (!have.length || !have[0]) { room(header.length); sh.getRange(1, 1, 1, header.length).setValues([header]).setFontWeight('bold'); sh.setFrozenRows(1); have = header.slice(); }
  else { var missing = header.filter(function (h) { return have.indexOf(h) === -1; }); if (missing.length) { room(have.length + missing.length); sh.getRange(1, have.length + 1, 1, missing.length).setValues([missing]).setFontWeight('bold'); have = have.concat(missing); } }
  var col = {}; have.forEach(function (h, i) { col[h] = i; });

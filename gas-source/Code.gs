    var k = 'csSkip_' + Utilities.base64EncodeWebSafe(cid + '|' + s.token + '|' + s.reason).slice(0, 200);
    if (cache.get(k)) return;
    cache.put(k, '1', 21600);
    CLASS_SUPPORT_SYNC_EVENTS_.push({ exec: exec, courseId: cid, courseName: cname, email: s.token, apsRole: '', classroomRole: '', source: s.source, action: 'EMAIL_SKIPPED', result: 'SKIPPED', error: s.reason });
  });
  entries.forEach(function (s) {
    s.member = !!rawTeacherEmails[s.email];
    if (s.member || !teachersListed || !classSupportAddEnabled_()) return;
    var failKey = 'csAddFail_' + cid + '_' + s.email;
    if (cache.get(failKey)) { s.error = 'previous add failed; retried after 6 hours'; return; }
    var ev = { exec: exec, courseId: cid, courseName: cname, email: s.email, apsRole: s.roles.join('+'), classroomRole: 'TEACHER', source: s.sources.join('+') };
    try {
      var created = callWithBackoff_(function () { return Classroom.Courses.Teachers.create({ userId: s.email }, course.id); }) || {};
      s.member = true; s.added = true;
      var prof = created.profile || {};
      var parsedName = splitNameAndPhone_((prof.name && prof.name.fullName) || '');
      teachers.push({ name: teacherDisplayName_(parsedName.name) || classPrimaryNameFromEmail_(s.email), phone: parsedName.phone || '', email: s.email, isHeadmaster: isInEmailList_(s.email, HEADMASTER_EMAILS), photo: fixPhoto_(prof.photoUrl), inMeet: false, meetSince: null, classroomActivitySince: null });
      CLASS_SUPPORT_SYNC_EVENTS_.push(Object.assign(ev, { action: 'CLASSROOM_TEACHER_ADDED', result: 'SUCCESS', error: '' }));
    } catch (e) {
      var msg = String(e && e.message || e);
      if (/already exists|ALREADY_EXISTS|409/i.test(msg)) { s.member = true; CLASS_SUPPORT_SYNC_EVENTS_.push(Object.assign(ev, { action: 'CLASS_ACCESS_ALREADY_EXISTS', result: 'SUCCESS', error: '' })); return; }
      s.error = msg.slice(0, 200);
      cache.put(failKey, '1', 21600);
      console.warn('[ClassSupport] could not add ' + s.email + ' as teacher of ' + cid + ': ' + s.error);
      CLASS_SUPPORT_SYNC_EVENTS_.push(Object.assign(ev, { classroomRole: 'NONE', action: 'CLASSROOM_TEACHER_ADD_FAILED', result: 'FAILED', error: s.error }));
    }
  });
  // The Course Description is authoritative for the Primary Teacher: if that person is not (yet) a Classroom
  // TEACHER (add disabled / failed / pending invitation), the class still shows them as its Primary Teacher and
  // they get teacher-level access to THIS class. VP / HM still need Classroom membership.
  entries.forEach(function (s) {
    if (s.member || s.roles.indexOf('PRIMARY_TEACHER') < 0) return;
    if (teachers.some(function (t) { return normalizeEmail_(t.email) === s.email; })) return;
    teachers.push({ name: classPrimaryNameFromEmail_(s.email), phone: '', email: s.email, isHeadmaster: isInEmailList_(s.email, HEADMASTER_EMAILS),
      photo: '', inMeet: false, meetSince: null, classroomActivitySince: null, notInClassroom: true });
  });
  var byEmail = {};
  entries.forEach(function (s) { byEmail[s.email] = s; });
  teachers.forEach(function (t) {
    var s = byEmail[normalizeEmail_(t.email)];
    if (!s) return;
    t.apsRoles = s.roles.slice();
    t.roleTags = s.roles.filter(function (r) { return r === 'VP' || r === 'HM'; });
    if (s.roles.indexOf('PRIMARY_TEACHER') < 0) t.supportRole = classRolesPrimary_(s.roles); // VP/HM only -> never the teacher of record
  });
  return entries;
}

/** True when this classSupport entry gives class access: Classroom member, or the Course Description's Primary Teacher. */
function classSupportGrantsAccess_(s) { return !!s && (s.member === true || (s.roles || []).indexOf('PRIMARY_TEACHER') > -1); }
/** Display name for a Primary Teacher known only by email ('abitha_aps978@…' -> 'Abitha'); never shows the email. */
function classPrimaryNameFromEmail_(email) {
  var local = String(email || '').split('@')[0].replace(/_aps[a-z0-9]+$/i, '').replace(/^(tts|tcs)[._-]+/i, '');
  return local.split(/[._-]+/).filter(Boolean).map(function (w) { return w.charAt(0).toUpperCase() + w.slice(1).toLowerCase(); }).join(' ') || 'Teacher';
}
/** Teacher card name without a trailing on-call tag: "Abitha Sri - TTS" -> "Abitha Sri", "Kala (TCS)" -> "Kala". Display only (never a role rule). */
function teacherDisplayName_(name) {

/**
 * One "Sync Now" for the Grading sub-tab: refreshes the roster only when needed (stale or asked),
 * then the grades, inside one time budget and one run marker. Returns the combined summary.
 */
function gradingRunSync_(triggerType, runBy, refreshRoster) {
  var t0 = Date.now();
  var props = PropertiesService.getScriptProperties();
  var lock = LockService.getScriptLock();
  if (!lock.tryLock(15000)) throw new Error('The dashboard is busy right now. Please try the sync again in a minute.');
  try {
    var running = Number(props.getProperty('ROSTER_SYNC_RUNNING') || 0);
    if (running && t0 - running < ROSTER_CONFIG.RUN_STALE_MS) return { alreadyRunning: true, message: 'A Grading sync is already running (started ' + rosterLabel_(new Date(running)) + '). Please wait for it to finish.' };
    props.setProperty('ROSTER_SYNC_RUNNING', String(t0));
  } finally { lock.releaseLock(); }
  var errors = [];
  var addError = function (course, op, e) {
    var msg = String(e && e.message ? e.message : e).slice(0, 300);
    errors.push({ classroom: course ? course.name : '', courseId: course ? String(course.id) : '', operation: op, error: msg + rosterPermissionHint_(msg), timestamp: rosterLabel_(new Date()) });
    console.error('[Grading] ' + op + ' failed' + (course ? ' for ' + course.id + ' (' + course.name + ')' : '') + ': ' + msg);
  };
  var summary = { trigger: triggerType, runBy: runBy || 'system' };
  try {
    var last = rosterLastSync_();
    var staleHours = Number(rosterProp_('APS_GRADING_ROSTER_REFRESH_HOURS', '12')) || 12;
    var rosterNeeded = refreshRoster || !last || !last.lastSyncAt || last.result === 'FAILED' || (last.classroomsDeferred > 0) || Date.now() - last.lastSyncAt > staleHours * 3600000;
    if (rosterNeeded) {
      summary.roster = rosterRunSync_(triggerType, runBy, { skipMarker: true, deadline: t0 + ROSTER_CONFIG.MAX_RUN_MS * 0.6 });
      (summary.roster.errors || []).forEach(function (e) { errors.push(e); });
    }
    console.log('[Grading] grades sync start (' + triggerType + ', ' + (runBy || 'system') + ')');
    summary.grades = gradesSyncCore_(t0 + ROSTER_CONFIG.MAX_RUN_MS, errors, addError);
  } catch (e) {
    addError(null, 'Sync', e);
    summary.failed = String(e && e.message || e);
  } finally {
    props.deleteProperty('ROSTER_SYNC_RUNNING');
  }
  var g = summary.grades || {};
  summary.result = summary.failed ? 'FAILED' : (errors.length ? (g.classroomsDeferred ? 'PARTIAL_WITH_ERRORS' : 'COMPLETED_WITH_ERRORS') : (g.classroomsDeferred ? 'PARTIAL' : 'COMPLETED'));
  summary.errorCount = errors.length;
  summary.errors = errors.slice(0, ROSTER_CONFIG.MAX_ERRORS_KEPT);
  summary.duration = rosterDuration_(Date.now() - t0);
  summary.lastSync = rosterLabel_(new Date()); summary.lastSyncAt = Date.now();
  var forProp = { result: summary.result, errorCount: summary.errorCount, errors: summary.errors.slice(0, 20), duration: summary.duration, lastSync: summary.lastSync, lastSyncAt: summary.lastSyncAt,
    trigger: triggerType, runBy: summary.runBy, grades: summary.grades || null, rosterRefreshed: !!summary.roster };
  var text = JSON.stringify(forProp);
  while (text.length > 8500 && forProp.errors.length) { forProp.errors.pop(); text = JSON.stringify(forProp); }
  props.setProperty('GRADES_LAST_SYNC_JSON', text);
  console.log('[Grading] sync end: ' + summary.result + ' | roster ' + (summary.roster ? summary.roster.result : 'not needed') + ' | classrooms ' + (g.classroomsProcessed || 0) + '/' + (g.classrooms || 0) +
    ' (deferred ' + (g.classroomsDeferred || 0) + ') | assignments ' + (g.assignments || 0) + ' | submissions ' + (g.submissions || 0) + ' (graded ' + (g.graded || 0) + ') | API calls ' + (g.apiCalls || 0) + ' | errors ' + errors.length + ' | ' + summary.duration);
  return summary;
}
/** Planned next data refresh = the next daily automatic sync (APS_DAILY_SYNC_HOUR, default 5:00 PM EST) — shown in the Grading note. */
function gradesNextRefresh_() {
  if (!apsDailySyncEnabled_() || !rosterEnabled_()) return { auto: false, label: '' };
  var hour = apsDailySyncHour_();
  var now = new Date();
  var ymd = Utilities.formatDate(now, APS_TZ, 'yyyy-MM-dd');
  var next = easternWallTimeToDate_(ymd, hour, 0);
  if (next.getTime() <= now.getTime()) {
    var t = new Date(now.getTime() + 86400000);
    next = easternWallTimeToDate_(Utilities.formatDate(t, APS_TZ, 'yyyy-MM-dd'), hour, 0);
  }
  return { auto: true, daily: true, hour: hour, at: next.getTime(), label: rosterLabel_(next) };
}
function gradesLastSync_() { try { return JSON.parse(rosterProp_('GRADES_LAST_SYNC_JSON', '') || 'null'); } catch (e) { return null; } }
function gradesInvalidate_() {
  var props = PropertiesService.getScriptProperties();
  props.setProperty('GRADES_DATA_GEN', String(Number(props.getProperty('GRADES_DATA_GEN') || 0) + 1));
  GRADES_MEMO_.ds = null; GRADES_MEMO_.gen = null;
}
/**
 * Grades read model, keyed by classroom so a request loads ONLY the classrooms it may see:
 * per-execution memo -> one CacheService getAll of the needed per-classroom entries -> sheets
 * (then every classroom is cached in one putAll). Entry = { w:[assignment], s:[submission] }.
 */
function gradesForCourses_(courseIds) {
  var gen = String(rosterProp_('GRADES_DATA_GEN', '0'));
  var out = {};
  if (GRADES_MEMO_.ds && GRADES_MEMO_.gen === gen) { courseIds.forEach(function (id) { out[id] = GRADES_MEMO_.ds[id] || { w: [], s: [] }; }); return out; }
  var cache = CacheService.getScriptCache(), prefix = 'grades_' + gen + '_';
  var getAll = function (keys) {
    if (!keys.length) return {};
    try { return cache.getAll ? cache.getAll(keys) : keys.reduce(function (o, k) { var v = cache.get(k); if (v !== null && v !== undefined) o[k] = v; return o; }, {}); } catch (e) { return {}; }
  };
  // Each classroom is stored as prefix+id = part count, then prefix+id+'_'+i = JSON parts (CacheService values <= 100 KB).
  var metas = getAll(courseIds.map(function (id) { return prefix + id; }).concat([prefix + 'built']));
  if (metas[prefix + 'built'] && courseIds.every(function (id) { return metas[prefix + id]; })) {
    var partKeys = [];
    courseIds.forEach(function (id) { for (var i = 0; i < Number(metas[prefix + id]); i++) partKeys.push(prefix + id + '_' + i); });
    var parts = getAll(partKeys);
    if (partKeys.every(function (k) { return parts[k] !== undefined && parts[k] !== null; })) {
      courseIds.forEach(function (id) { var t = ''; for (var i = 0; i < Number(metas[prefix + id]); i++) t += parts[prefix + id + '_' + i]; out[id] = JSON.parse(t); });
      return out;
    }
  }
  var all = {};
  var W = rosterLoadTable_(GRADES_CONFIG.SHEET_WORK, GRADES_WORK_HEADER, null);
  W.rows.forEach(function (r) {
    var g = function (k) { return rosterGet_(W, r, k) || ''; };
    if (!g('Course_ID') || g('Status') === 'REMOVED') return;
    (all[g('Course_ID')] = all[g('Course_ID')] || { w: [], s: [] }).w.push({ id: g('CourseWork_ID'), t: g('Title'), type: g('Work_Type'), max: g('Max_Points'), ad: g('Assigned_Date'), due: g('Due_Date'), lsn: g('Lesson_No'), lk: g('Link') || '' });
  });
  var S = rosterLoadTable_(GRADES_CONFIG.SHEET_SUBS, GRADES_SUB_HEADER, null);
  S.rows.forEach(function (r) {
    var g = function (k) { return rosterGet_(S, r, k) || ''; };
    var e = all[g('Course_ID')];
    if (!e) return;
    e.s.push({ w: g('CourseWork_ID'), u: g('Student_User_ID'), e: g('Student_Email'), st: g('State'), late: g('Late') === 'TRUE', g: g('Assigned_Grade'), dg: g('Draft_Grade'), ti: g('Turn_In_Date'), gd: g('Graded_Date'), rd: g('Returned_Date') });
  });
  try {
    var put = {};
    Object.keys(all).forEach(function (id) {
      var v = JSON.stringify(all[id]), n = 0;
      for (var off = 0; off < v.length; off += ROSTER_CONFIG.CACHE_CHUNK) put[prefix + id + '_' + (n++)] = v.slice(off, off + ROSTER_CONFIG.CACHE_CHUNK);
      put[prefix + id] = String(n || 1); if (!n) put[prefix + id + '_0'] = v;
    });
    // Classrooms without any captured assignment are cached as empty so they never force a sheet read.
    courseIds.forEach(function (id) { if (!all[id]) { put[prefix + id] = '1'; put[prefix + id + '_0'] = '{"w":[],"s":[]}'; } });
    put[prefix + 'built'] = '1';
    if (cache.putAll) cache.putAll(put, ROSTER_CONFIG.CACHE_SECONDS); else Object.keys(put).forEach(function (k) { cache.put(k, put[k], ROSTER_CONFIG.CACHE_SECONDS); });
  } catch (e) { console.warn('[Grading] cache put failed: ' + (e && e.message)); }
  GRADES_MEMO_.ds = all; GRADES_MEMO_.gen = gen;
  courseIds.forEach(function (id) { out[id] = all[id] || { w: [], s: [] }; });
  return out;
}

/** Grade status like the Classroom Grades tab (RETURNED is shown as COMPLETED; dates compared in EST text form, which sorts correctly). */
function gradesStatus_(sub, work, nowTs) {
  var st = sub ? sub.st : '';
  if (st === 'RETURNED') return 'COMPLETED'; // returned by the teacher — shown as COMPLETED
  if (st === 'TURNED_IN') return sub.late ? 'TURNED_IN_LATE' : 'TURNED_IN';
  if (st === 'RECLAIMED_BY_STUDENT') return 'RECLAIMED';
  if (work.due && work.due < nowTs) return 'MISSING';
  return 'ASSIGNED';
}

/**
 * Role-scoped Grading data. EVERY role sees only the classrooms it is assigned to (ACTIVE teacher
 * or student in the roster), unless the role is listed in APS_GRADING_ALL_CLASSES_ROLES. Teachers
 * (and Admin/HM who teach the class) see all students of their classrooms; students see only their
 * own rows. No teacher names or emails are returned.
 */
function getGradingData(sessionToken) {
  apsRequireTabForToken_(sessionToken, 'exam.grading'); // r56: Admin Control → Access Control
  var ctx = rosterUserContext_(sessionToken);
  var rds = rosterDataset_();
  var scope = gradingScope_(ctx, rds);
  var classrooms = rds.classrooms.filter(function (c) { return !scope || scope.courses[c.id]; });
  var ids = classrooms.map(function (c) { return c.id; });
  var grades = gradesForCourses_(ids);
  var nowTs = rosterTs_(new Date());
  var ownOnly = function (cid) { return ctx.isStudent || (scope && !scope.teach[cid]); };
  var students = rds.students.filter(function (s) { return (!scope || scope.courses[s.c]) && (!ownOnly(s.c) || s.e === ctx.email); })
    .map(function (s) { return { c: s.c, u: s.u, n: s.n, e: s.e, a: s.a, s: s.s }; });
  var work = [], subs = [];
  ids.forEach(function (cid) {
    var g = grades[cid];
    var wById = {};
    g.w.forEach(function (w) {
      var cat = gradesCategory_(w.t);
      if (!cat) return; // rows captured before the approved-prefix rule never reach the Grading dataset
      wById[w.id] = w; work.push({ c: cid, id: w.id, t: w.t, type: w.type, max: w.max, ad: w.ad, due: w.due, lsn: w.lsn, cat: cat });
    });
    var own = ownOnly(cid);
    var seen = {};
    g.s.forEach(function (x) {
      if (own && x.e !== ctx.email) return;
      var w = wById[x.w];
      if (!w) return;
      seen[x.w + '|' + x.u] = true;
      subs.push({ c: cid, w: x.w, u: x.u, g: x.g, ti: x.ti, gd: x.gd, rd: x.rd, status: gradesStatus_(x, w, nowTs) }); // draft marks are never sent (not a grade yet)
    });
  });
  // r111: grades carried over from a previous classroom (Re-Map) — view-only; only for students the viewer may see now.
  var carried = [];
  try {
    var teachStu = {}; rds.students.forEach(function (x) { if (x.s === ROSTER_STATUS.ACTIVE && scope && scope.teach[x.c]) teachStu[x.e] = true; });
    carried = gtReadItems_().filter(function (r) {
      var e = normalizeEmail_(r.Student_Email);
      if (ctx.isStudent) return e === ctx.email;
      return !scope || teachStu[e] || !!scope.teach[r.To_Course_ID];
    }).map(function (r) { return { id: r.Transfer_ID, at: r.Captured_At, e: normalizeEmail_(r.Student_Email), a: r.Student_APS_ID, n: r.Student_Name, fromId: r.From_Course_ID, from: r.From_Class, toId: r.To_Course_ID, to: r.To_Class,
      t: r.Title, cat: r.Category, lsn: r.Lesson_No, max: r.Max_Points, g: r.Assigned_Grade, status: r.Status, ti: r.Turn_In_Date, gd: r.Graded_Date, ad: r.Assigned_Date, due: r.Due_Date }; });
  } catch (eGT) { console.warn('[GradeTransfer] carried grades unavailable: ' + (eGT && eGT.message)); }
  if (ctx.role === 'ADMIN') rosterEnsureTrigger_(false);
  rosterAudit_(ctx, ctx.isStudent ? 'VIEW_OWN_GRADES' : 'VIEW_GRADES', '', 'SUCCESS', classrooms.length + ' classroom(s)');
  return {
    role: ctx.role, me: { email: ctx.email, apsId: ctx.apsId }, ownOnly: !!ctx.isStudent, seeAll: !scope,
    canSync: ctx.canSync, canExport: ctx.canExport, academicYear: rosterAcademicYear_().label,
    classrooms: classrooms.map(function (c) { return { id: c.id, name: c.name, section: c.section || '', nilai: c.nilai, sec: c.sec, day: c.day, start: c.start, end: c.end, tz: c.tz, ay: c.ay, teach: !ownOnly(c.id) }; }),
    students: students, work: work, subs: subs, carried: carried,
    lastSync: ctx.canSeeSync ? gradesLastSync_() : null, lastSyncLabel: (gradesLastSync_() || {}).lastSync || '', nextRefresh: gradesNextRefresh_(), serverNow: Date.now()
  };
}

/** Server-built CSV (Assignment Report rows) of the caller's authorized data, honouring the same filters as the screen. */
function exportGrading(sessionToken, filters) {
  apsRequireTabForToken_(sessionToken, 'exam.grading'); // r56: Admin Control → Access Control
  var ctx = rosterUserContext_(sessionToken);
  if (!ctx.canExport) {
    rosterAudit_(ctx, 'EXPORT_GRADES', '', 'DENIED', 'Not permitted');
    throw new Error('Access denied. You do not have permission to export grades.');
  }
  filters = filters || {};
  var d = getGradingData(sessionToken);
  if (filters.courseId && !d.classrooms.some(function (c) { return c.id === String(filters.courseId); })) {
    rosterAudit_(ctx, 'EXPORT_GRADES', String(filters.courseId).slice(0, 40), 'DENIED', 'Not an assigned classroom');
    throw new Error('Access denied. You are not authorized to view this Classroom.');
  }
  var rows = gradingReportRows_(d, filters);
  var q = function (s) { s = String(s === null || s === undefined ? '' : s).replace(/[\u0000-\u0008\u000b\u000c\u000e-\u001f]/g, ''); if (/^[=+\-@\t\r]/.test(s)) s = "'" + s; return '"' + s.replace(/"/g, '""') + '"'; };
  var lines = [['Student Name', 'Student Email Address', 'APSID', 'Google Classroom Name', 'Nilai', 'Assignment', 'Assignment Type', 'Assigned Date', 'Due Date', 'Turned In Date', 'Graded Mark', 'Max Points', 'Graded Type', 'Graded Date', 'Returned Date', 'Status'].map(q).join(',')];
  rows.forEach(function (r) { lines.push([r.studentName, r.email, r.apsId, r.classroom, r.nilai, r.title, r.type, r.assigned, r.due, r.turnIn, r.grade, r.max, r.gradedType, r.gradedDate, r.returned, r.status].map(q).join(',')); });
  rosterAudit_(ctx, 'EXPORT_GRADES', filters.courseId ? String(filters.courseId) : '', 'SUCCESS', rows.length + ' row(s)');
  return { csv: '﻿' + lines.join('\r\n'), rows: rows.length, fileName: 'grades_' + Utilities.formatDate(new Date(), APS_TZ, 'yyyyMMdd-HHmm') + '.csv' };
}

/**
 * Assignment Report rows (one per student x assignment, including assignments with no submission
 * record yet) filtered like the screen. Mirrored by grdReportRows_ in Dashboard.html.
 * filters: { q, nilai, courseId, assignment (title), status, gradedType, from, to, studentStatus }
 */
function gradingReportRows_(d, f) {
  f = f || {};
  var q = String(f.q || '').trim().toUpperCase();
  var studentStatus = f.studentStatus === undefined ? ROSTER_STATUS.ACTIVE : String(f.studentStatus || '');
  var cById = {}; d.classrooms.forEach(function (c) { cById[c.id] = c; });
  var subBy = {}; d.subs.forEach(function (s) { subBy[s.c + '|' + s.w + '|' + s.u] = s; });
  var wByCourse = {}; d.work.forEach(function (w) { (wByCourse[w.c] = wByCourse[w.c] || []).push(w); });
  var nowTs = rosterTs_(new Date());
  var out = [];
  d.students.forEach(function (st) {
    if (studentStatus && st.s !== studentStatus) return;
    var c = cById[st.c] || {};
    if (f.nilai && c.nilai !== f.nilai) return;
    if (f.courseId && st.c !== String(f.courseId)) return;
    (wByCourse[st.c] || []).forEach(function (w) {
      if (f.assignment && String(w.t).trim().toUpperCase() !== String(f.assignment).trim().toUpperCase()) return;
      if (f.from && w.ad && w.ad.slice(0, 10) < f.from) return;
      if (f.to && w.ad && w.ad.slice(0, 10) > f.to) return;
      var s = subBy[st.c + '|' + w.id + '|' + st.u];
      var status = s ? s.status : gradesStatus_(null, w, nowTs);
      var graded = !!(s && s.g !== '' && s.g !== undefined && s.g !== null);
      if (f.status && status !== f.status) return;
      if (f.gradedType && (graded ? 'GRADED' : 'UNGRADED') !== f.gradedType) return;
      var r = { studentName: st.n, email: st.e, apsId: st.a, classroom: c.name || st.c, courseId: st.c, nilai: c.nilai || '', title: w.t, type: w.type, assigned: w.ad, due: w.due,
        turnIn: s ? s.ti : '', grade: graded ? s.g : '', max: w.max, gradedType: graded ? 'GRADED' : 'UNGRADED', gradedDate: s ? s.gd : '', returned: s ? s.rd : '', status: status };
      if (q && [r.studentName, r.email, r.apsId, r.classroom, r.courseId, r.nilai, r.title].join(' | ').toUpperCase().indexOf(q) === -1) return;
      out.push(r);
    });
  });
  return out;
}

/** Manual "Sync Now" for Grading (Admin; HM per the existing force-sync rule). */
function syncGrading(sessionToken, options) {
  apsRequireTabForToken_(sessionToken, 'exam.grading'); // r56: Admin Control → Access Control
  var ctx = rosterUserContext_(sessionToken);
  if (!ctx.canSync) {
    rosterAudit_(ctx, 'SYNC_GRADES', '', 'DENIED', 'Not permitted');
    throw new Error('Access denied. You do not have permission to synchronize Google Classroom grades.');
  }
  var summary = gradingRunSync_('MANUAL', ctx.email, !!(options && options.refreshRoster));
  rosterAudit_(ctx, 'SYNC_GRADES', '', summary.alreadyRunning ? 'SKIPPED' : (summary.result === 'FAILED' ? 'FAILED' : 'SUCCESS'), summary.alreadyRunning ? 'already running' : summary.result + ' ' + (summary.duration || ''));
  if (isAdminRole_(ctx.rawRole)) rosterEnsureTrigger_(true);
  return summary;

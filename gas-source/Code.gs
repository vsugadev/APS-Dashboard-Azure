// Name of the Sheet tab (in the same workbook as "Courses") that holds the
// live, editable WhatsApp-group-link lookup. A school admin opens this tab
// directly in Google Sheets and adds/changes/removes a class's link at any
// time — no code edit or redeploy needed, and it's picked up on the very
// next dashboard poll (see applyWhatsAppLinks_ below), not just after the
// next Classroom sync. The sheet is the sole source of truth for these
// links — there is no hardcoded copy of them in this file.
var WHATSAPP_LINKS_SHEET_NAME = 'WhatsApp_Group_Links';

/**
 * Normalizes a class name down to just its uppercase letters/digits, after
 * first stripping a trailing COURSE_NAME_SUFFIX (e.g. "AY26-27") if present.
 * This is what makes matching tolerant of spacing/dash/suffix differences
 * between however a class name is typed into the WhatsApp_Group_Links sheet
 * (e.g. "NILAI 1 - CA") and however Google Classroom actually stores the
 * course's Name field (e.g. "NILAI 1 - CA AY26-27" or "NILAI 1-CA AY26-27").
 */
function normalizeClassKey_(name) {
  if (!name) return '';
  var n = String(name).toUpperCase();
  var suffix = (COURSE_NAME_SUFFIX || '').toUpperCase();
  if (suffix && n.indexOf(suffix) !== -1) {
    n = n.substring(0, n.lastIndexOf(suffix));
  }
  return n.replace(/[^A-Z0-9]/g, ''); // collapse away spaces, dashes, pipes, punctuation
}

/**
 * Returns (creating it, empty except for the header row, if it doesn't exist
 * yet) the Sheet tab that holds the editable WhatsApp group link lookup.
 * Layout: row 1 is a header; column A is the class name (matched via
 * normalizeClassKey_, so exact spacing/dashes don't matter), column B is a
 * free-text schedule note for humans only (never read by code), column C is
 * the WhatsApp group link. The sheet already exists and is fully populated
 * in production — this only creates a fresh (empty) tab as a fallback for a
 * brand-new deployment, e.g. a new copy of this project for another school.
 */
function getOrCreateWhatsAppLinksSheet_() {
  var ss = getWorkbook_();
  var sheet = ss.getSheetByName(WHATSAPP_LINKS_SHEET_NAME);
  if (sheet) return sheet;

  sheet = ss.insertSheet(WHATSAPP_LINKS_SHEET_NAME);
  sheet.getRange(1, 1, 1, 3).setValues([['Class Name', 'Schedule (reference only)', 'WhatsApp Group Link']]);
  sheet.setFrozenRows(1);
  return sheet;
}

/**
 * Reads the WhatsApp_Group_Links sheet and returns { normalizedClassKey: url }.
 * Blank class-name or blank-link rows are skipped. Read fresh on every call
 * (small sheet — a couple hundred rows, two columns actually read) so an
 * admin's edit shows up on the very next getDashboardData() poll.
 */
function getWhatsAppLinksMap_() {
  // r49: cached for 10 minutes (it was re-read from the sheet on every dashboard refresh of every user).
  // Edits made directly in the WhatsApp_Group_Links sheet show within 10 minutes (or after a Force Sync).
  var waCache = null;
  try { waCache = CacheService.getScriptCache(); var hit = waCache.get('aps_whatsapp_map_v1'); if (hit) return JSON.parse(hit); } catch (eC) { waCache = null; }
  var map = getWhatsAppLinksMapFromSheet_();
  try { if (waCache) waCache.put('aps_whatsapp_map_v1', JSON.stringify(map), 600); } catch (eP) { /* too large or cache down — fine */ }
  return map;
}
function getWhatsAppLinksMapFromSheet_() {
  var sheet = getOrCreateWhatsAppLinksSheet_();
  var lastRow = sheet.getLastRow();
  var map = {};
  if (lastRow < 2) return map;
  var values = sheet.getRange(2, 1, lastRow - 1, 3).getValues(); // [name, scheduleNote, link]
  values.forEach(function (row) {
    var name = row[0];
    var link = row[2];
    if (!name || !link) return;
    map[normalizeClassKey_(name)] = String(link).trim();
  });
  return map;
}

/**
 * Stamps `whatsappLink` (possibly '') onto every course in `courses`, from
 * the live WhatsApp_Group_Links sheet — mirrors the applyLivePresence_ /
 * applyStudentOnboardedFlag_ pattern of enriching the cached course list at
 * request time rather than baking it into the 15-minute sync cache. Visible
 * to every role that can see the course at all (no gating) — see
 * Dashboard.html's renderCard(), which only omits the button when this is ''.
 */
function applyWhatsAppLinks_(courses) {
  var map = getWhatsAppLinksMap_();
  courses.forEach(function (c) {
    c.whatsappLink = map[normalizeClassKey_(c.name)] || '';
  });
  return courses;
}

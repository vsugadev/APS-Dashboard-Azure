/**
 * Scheduled run: Tue–Fri only, inside the configured hour window, once per calendar day.
 * Data is read fresh. Returns { sent | skipped | error }.
 */
function ctaRunScheduled_(now, runBy) {
  var cfg = ctaConfig_();
  if (!cfg.enabled) { ctaLog_('SCHEDULED', 'SKIPPED', null, cfg.to, '', 'disabled (APS_CLASS_TEACHER_AVAILABILITY_EMAIL_ENABLED=false)', runBy); return { skipped: 'disabled' }; }
  var dow = Number(Utilities.formatDate(now, cfg.tz, 'u')) % 7;
  if (CTA_REPORT_DAYS_.indexOf(dow) === -1) return { skipped: 'not a report day (Tue-Fri only)' };
  var hm = Utilities.formatDate(now, cfg.tz, 'HH:mm').split(':');
  var mins = Number(hm[0]) * 60 + Number(hm[1]);
  if (mins < cfg.hour * 60 - 20 || mins >= (cfg.hour + 2) * 60) return { skipped: 'outside the ' + cfg.hour + ':00 send window' };
  if (!cfg.to.length) { ctaLog_('SCHEDULED', 'FAILED', null, [], '', 'no valid recipients in APS_CLASS_TEACHER_AVAILABILITY_EMAIL_TO', runBy); return { error: 'no recipients' }; }
  var lock = LockService.getScriptLock();
  if (!lock.tryLock(30000)) return { skipped: 'another run is in progress' };
  var props = PropertiesService.getScriptProperties();
  var day = Utilities.formatDate(now, cfg.tz, 'yyyy-MM-dd');
  var m = null;
  try {
    if (props.getProperty('CTA_EMAIL_LAST_SENT_DATE') === day) return { skipped: 'already sent today (' + day + ')' };
    var wkL = getCurrentWeekId_(now), ayL = readAllCoursesFromCache_().filter(function (c) { return ctaAyMatch_(c.name, cfg.academicYear) && (!c.courseState || c.courseState === 'ACTIVE'); })
      .map(function (c) { return examQpParseClassName_(c.name).dayOfWeek; }).filter(function (d) { return d !== null && d !== undefined; }); // classes with a readable day
    if (ayL.length && ayL.every(function (d) { return isAPSSchoolHoliday(apsClassDateInWeek_(wkL, d)); })) { // r109
      ctaLog_('SCHEDULED', 'SKIPPED', null, cfg.to, '', 'SKIPPED_SCHOOL_LEAVE — every class of ' + wkL + ' falls in an approved school leave', runBy);
      return { skipped: 'SKIPPED_SCHOOL_LEAVE' };
    }
    m = ctaBuildReport_(now);
    var subject = ctaSend_(m, cfg.to, false, cfg.cc);
    props.setProperty('CTA_EMAIL_LAST_SENT_DATE', day);
    ctaLog_('SCHEDULED', 'SENT', m, cfg.to.concat(cfg.cc.map(function (x) { return 'cc:' + x; })), subject, ctaClassCounts_(m), runBy);
    return { sent: true, subject: subject, recipients: cfg.to.length, teachers: m.summary.total };
  } catch (err) {
    ctaLog_('SCHEDULED', 'FAILED', m, cfg.to, m ? ctaSubject_(m, false) : '', String(err && err.message || err), runBy);
    if (err && err.apsPaused) attMailAlertAdmin_('Teacher Availability report', err.message);
    return { error: String(err && err.message || err) };
  } finally { lock.releaseLock(); }
}


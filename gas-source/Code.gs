// --- Admin-only Web App deployment metadata --------------------------------
// The Apps Script runtime does not expose the human-readable deployment
// description or the version create-time directly. These optional values are
// therefore kept as explicit production metadata so the Admin can always see
// exactly what this build identifies itself as. Update both values whenever
// the production Web App is redeployed.
var WEB_APP_DEPLOYMENT_NAME = 'APS Dashboard Production';
var WEB_APP_DEPLOYMENT_DATETIME = 'Not recorded'; // e.g. '09/14/2026 02:30 PM EDT'
// Sept 2026, fifty-fifth round: renamed from 'APS_ENV' to 'APS_ENVIRONMENT'
// (clearer name, matches the Script-Properties config convention from the
// prior round), and its accepted values changed from PROD/TEST (displayed
// as LIVE/DEMO) to the two values requested directly: LIVE and TESTING.
// Set this Script Property to 'TESTING' on a separate TEST Apps Script
// deployment (see test-environment-setup-guide.md) so the Admin-only
// deployment badge in Dashboard.html visibly distinguishes it from
// production. Leave unset (or 'LIVE') for production — that's the default,
// so production needs no Script Property set at all.
var APS_ENV_PROPERTY = 'APS_ENVIRONMENT';

function getDashboardEnvironment_() {
  var value = String(PropertiesService.getScriptProperties().getProperty(APS_ENV_PROPERTY) || '').trim().toUpperCase();
  // 'TEST' accepted too, for backward compatibility with the old 'APS_ENV' property's value —
  // this Script Property was renamed, so a deployment still using the old name/value degrades
  // safely to the LIVE default below rather than silently keeping stale behavior either way.
  if (value === 'TESTING' || value === 'TEST') return { key: 'TESTING', label: 'TESTING' };
  return { key: 'LIVE', label: 'LIVE' };
}

function getAdminWebAppDeploymentInfo(sessionToken) {
  var session = requireValidSession_(sessionToken);
  var courses = readAllCoursesFromCache_();
  var viewer = { email: session.email, role: session.role };
  if (!isAdminRole_(viewer.role)) throw new Error('Only Admin users can view deployment information.');
  return {
    name: WEB_APP_DEPLOYMENT_NAME,
    dateTime: WEB_APP_DEPLOYMENT_DATETIME,
    environment: getDashboardEnvironment_(),
    url: ScriptApp.getService().getUrl() || ''
  };
}

// --- Class Status state machine (Scheduled / Yet to Start / Class Started / ---
// --- Class Completed / Class Cancelled / Class Rescheduled) ------------------
// AUTOMATIC statuses (everything except the two manual ones) are NEVER
// persisted — they're recomputed fresh every time getDashboardData() runs
// (see applyClassStatus_), from three inputs: (a) the weekly day/start/end
// time parsed out of the course's title text (parseCourseSchedule_ — the
// Classroom API has no field for this), (b) the current Eastern-time instant
// (Utilities.formatDate against LAST_LOGIN_TIMEZONE), and (c) whether anyone
// (student or teacher) in that course is currently detected in a Meet call
// (the same per-person `inMeet` flag buildCourseRecord_ already stamps from
// getMeetPresenceMap_). This is the same "compute live at request time"
// pattern already used for the green "online" dot and WhatsApp links, so no
// new trigger is needed for the automatic transitions — the existing
// 1-minute dashboard poll already provides the cadence.
// MANUAL overrides (Class Cancelled / Class Rescheduled) are the only part
// of this feature that's actually persisted (CLASS_STATUS_PROP_KEY) — once
// set, applyClassStatus_ skips automatic computation entirely for that
// course, so nothing here can ever revert or downgrade a manual override.
var CLASS_STATUS_PROP_KEY = 'classStatusMap'; // { courseId: { status: 'cancelled'|'rescheduled', updatedAt: iso, updatedBy: email } } — MANUAL overrides only.
// Remembers, per course, the scheduledStartIso of the weekly occurrence that
// was last observed with someone in Meet — so once a class has been seen as
// "Class Started" this week, a brief Meet disconnect before the 90-minute
// completion mark doesn't visibly flicker the status back to "Yet to Start".
// Naturally "resets" the following week since that week's scheduledStartIso
// differs — no cleanup job needed.
var CLASS_STARTED_MARK_PROP_KEY = 'classStartedMarkMap';
var CLASS_STATUS_COMPLETION_MINUTES = 90; // fixed window after the SCHEDULED start time, never the join time (Part 11)


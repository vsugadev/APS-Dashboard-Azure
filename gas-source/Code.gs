var WJ_DAYS_ = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];
var WJ_JOBS_ = [
  { id: 'WEEKLY_MAINTENANCE', label: 'System backup & audit archive', dow: 0, hour: 2, old: 'apsWeeklyMaintenance',
    run: function () { if (!apsMaintenanceEnabled_()) return { skipped: 'MAINTENANCE_DISABLED' }; var b = apsSystemBackup_('weekly', 'weekly trigger'); apsMaintenanceRecord_('backup', b, 'weekly trigger'); var a = apsAuditArchive_('weekly trigger', { skipBackup: true }); apsMaintenanceRecord_('archive', a, 'weekly trigger'); return { backup: b.name, moved: a.moved }; } },
  { id: 'MULTIPLE_CLASSROOM_REPORT', label: 'Students in more than one classroom (admin@)', dow: 1, hour: 7, old: 'apsWeeklyMultipleClassroomReport', leave: 'MULTIPLE_CLASSROOM_REPORT',
    run: function (now) { return admcRun_(now, { runBy: 'weekly trigger' }); } },
  { id: 'MISSING_GRADING_REPORT', label: 'Grading Help Team report (grading@)', dow: 2, hour: 8, old: 'apsMissingGradingWeekly', leave: 'MISSING_GRADING_REPORT',
    run: function (now) { return mhgRun_(now, 'trigger', 'system', {}); } },
  { id: 'STUDENT_ABSENCE', label: 'Continuous student absence', dow: 3, hour: 9, old: 'apsStudentAbsenceWeekly', leave: 'STUDENT_ABSENCE',
    run: function (now) { return saRun_(now, 'trigger'); } },
  { id: 'CLASS_CONSOLIDATION_ANALYSIS', label: 'Class consolidation analysis', dow: 3, hour: 19, old: 'apsClassConsolidationAnalysis', leave: 'CLASS_CONSOLIDATION',
    run: function (now) { return ccwRunAnalysis_(now, 'trigger'); } },
  { id: 'TEACHER_APPRECIATION', label: 'Weekly Teacher Appreciation', dow: 3, hour: 19, old: 'apsTeacherAppreciationWeekly',
    run: function (now) { return taRun_(now, 'trigger', 'system', {}); } },
  { id: 'CLASS_CONSOLIDATION_EMAIL', label: 'Class consolidation email', dow: 3, hour: 19, old: 'apsClassConsolidationEmail', leave: 'CLASS_CONSOLIDATION', after: 'CLASS_CONSOLIDATION_ANALYSIS', afterMinutes: 25,
    run: function (now) { return ccwRunEmail_(now, 'trigger'); } }

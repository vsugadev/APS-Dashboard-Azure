];

var REFERENCE_LETTER_SOURCE = { TEACHER_SELF: 'TEACHER_SELF', ADMIN_INITIATED: 'ADMIN_INITIATED' };
var REFERENCE_LETTER_TYPE = { STANDARD: 'STANDARD', VOLUNTEER: 'VOLUNTEER' };

// Sheet columns — the 18 columns from the original spec, exactly in order,
// plus 4 more APPENDED afterward (never inserted in the middle — same
// "append only" convention every other Sheet in this project follows) to
// support the Admin "issue for an inactive/former Teacher" enhancement.
var REFERENCE_LETTER_COLUMNS = [
  'Request ID', 'Request Date Time', 'Teacher Email', 'Teacher Full Name', 'APSID', 'APS Join Date',
  'Request Reason', 'Request Status', 'Stage 1 Approver Email', 'Stage 1 Approval Date Time',
  'Stage 1 Comments', 'Final Approver Email', 'Final Approval Date Time', 'Final Approval Comments',
  'PDF File ID', 'PDF File Name', 'Processing Notes', 'Completed Date Time',
  'Source', 'Recipient Personal Email', 'Initiated By Admin Email', 'Letter Type'
];
var REFERENCE_LETTER_FIELD_KEYS = [
  'requestId', 'requestDateTime', 'teacherEmail', 'teacherName', 'apsId', 'apsJoinDate',
  'requestReason', 'requestStatus', 'stage1ApproverEmail', 'stage1ApprovalDateTime',
  'stage1Comments', 'finalApproverEmail', 'finalApprovalDateTime', 'finalApprovalComments',
  'pdfFileId', 'pdfFileName', 'processingNotes', 'completedDateTime',
  'source', 'recipientPersonalEmail', 'initiatedByAdminEmail', 'letterType'
];

/** ---------------------------------------------------------------------
 *  SHEET STORAGE — "Teacher_Reference_Letter_Request", one row per request.
 *  Created automatically on first use; never touches any existing sheet.
 * ------------------------------------------------------------------- */
// 1-based column numbers of every date/time-shaped column in this sheet — kept forced to plain-text
// ('@') number format so Sheets' automatic value coercion (the same class of bug that once silently
// turned Course ID cells into Numbers — see the architecture doc's "Bugs fixed" section) can never turn
// one of these ISO/formatted-date strings into a real Sheets Date/serial value on write. A Date value
// read back from a cell has no .localeCompare(), which is exactly what broke request-list sorting.
var REFERENCE_LETTER_DATE_TIME_COLUMNS_ = [2, 6, 10, 13, 18]; // Request Date Time, APS Join Date, Stage 1/Final Approval Date Time, Completed Date Time

function getOrCreateReferenceLetterSheet_() {
  var ss = getWorkbook_();
  var sheet = ss.getSheetByName(REFERENCE_LETTER_SHEET_NAME);
  if (!sheet) {
    sheet = ss.insertSheet(REFERENCE_LETTER_SHEET_NAME);
    sheet.getRange(1, 1, 1, REFERENCE_LETTER_COLUMNS.length).setValues([REFERENCE_LETTER_COLUMNS]).setFontWeight('bold');
    sheet.setFrozenRows(1);
  }
  // Idempotent/cheap — also self-heals a sheet created before this fix, for every FUTURE write to it
  // (it cannot retroactively change values already stored as a real Date; rlRowToObject_ below handles
  // reading those back safely).
  REFERENCE_LETTER_DATE_TIME_COLUMNS_.forEach(function (col) {
    sheet.getRange(1, col, Math.max(sheet.getMaxRows(), 2), 1).setNumberFormat('@');
  });
  return sheet;
}

function rlRowToObject_(rowValues) {
  var obj = {};
  REFERENCE_LETTER_FIELD_KEYS.forEach(function (key, i) {
    var v = rowValues[i];
    // Defensive: if Sheets ever stored this cell as a real Date (auto-coerced pre-fix, or a user
    // pasted/typed a literal date into it by hand), normalize back to an ISO string here so every
    // downstream consumer — sorting, the PDF template, email bodies — only ever sees a string, never
    // a Date object with no .localeCompare().
    if (v instanceof Date) v = v.toISOString();
    obj[key] = v !== undefined && v !== null ? v : '';
  });
  return obj;
}

function rlObjectToRow_(obj) {
  return REFERENCE_LETTER_FIELD_KEYS.map(function (key) {
    return (obj[key] !== undefined && obj[key] !== null) ? obj[key] : '';
  });
}

/** Every request row as plain objects (each carrying `_row`, its 1-based Sheet row, for in-place updates). */
function readAllReferenceLetterRequests_() {
  var sheet = getOrCreateReferenceLetterSheet_();
  var lastRow = sheet.getLastRow();
  if (lastRow < 2) return [];
  var values = sheet.getRange(2, 1, lastRow - 1, REFERENCE_LETTER_COLUMNS.length).getValues();
  var out = [];
  for (var i = 0; i < values.length; i++) {
    if (!values[i][0]) continue; // skip a blank row
    var obj = rlRowToObject_(values[i]);
    obj._row = i + 2;
    out.push(obj);
  }
  return out;
}

function findReferenceLetterRequestById_(requestId) {
  var rows = readAllReferenceLetterRequests_();
  for (var i = 0; i < rows.length; i++) {
    if (rows[i].requestId === requestId) return rows[i];
  }
  return null;
}

function writeReferenceLetterRequestRow_(rowNum, obj) {
  var sheet = getOrCreateReferenceLetterSheet_();
  sheet.getRange(rowNum, 1, 1, REFERENCE_LETTER_COLUMNS.length).setValues([rlObjectToRow_(obj)]);
}

function appendReferenceLetterRequestRow_(obj) {
  var sheet = getOrCreateReferenceLetterSheet_();
  sheet.appendRow(rlObjectToRow_(obj));
  return sheet.getLastRow();
}

var REFERENCE_LETTER_REQUEST_ID_COUNTER_PROP_KEY = 'referenceLetterRequestIdCounter'; // { 'yyyyMMdd': lastSequenceUsedThatDay } — only ever holds TODAY's key

/** APS-RL-YYYYMMDD-NNNN, a day-scoped sequence, lock-protected so two simultaneous submissions never collide. Mirrors generateGtrRequestId_(). */
function generateReferenceLetterRequestId_() {
  var lock = LockService.getScriptLock();
  try { lock.waitLock(10000); } catch (e) { /* proceed best-effort even without the lock */ }
  try {
    var props = PropertiesService.getScriptProperties();
    var todayKey = Utilities.formatDate(new Date(), LAST_LOGIN_TIMEZONE, 'yyyyMMdd');
    var raw = props.getProperty(REFERENCE_LETTER_REQUEST_ID_COUNTER_PROP_KEY);
    var counters = raw ? JSON.parse(raw) : {};
    var next = (counters[todayKey] || 0) + 1;
    var newCounters = {};
    newCounters[todayKey] = next;
    props.setProperty(REFERENCE_LETTER_REQUEST_ID_COUNTER_PROP_KEY, JSON.stringify(newCounters));
    var seq = ('0000' + next).slice(-4);
    return 'APS-RL-' + todayKey + '-' + seq;
  } finally {
    try { lock.releaseLock(); } catch (e) { /* best-effort */ }
  }
}

/**
 * Wraps the EXISTING extractAPSID_() helper (used elsewhere for the login
 * badge) rather than duplicating its regex, per the "reuse existing helpers"
 * requirement — extractAPSID_() already implements the exact "_APS[0-9]+@"
 * pattern this feature's spec calls for. Only difference: this feature's
 * fallback is REFERENCE_LETTER_FALLBACK_APSID ('APS201099'), never extractAPSID_'s
 * own generic 'NA' fallback, and the browser can never override this value.
 */
function referenceLetterApsId_(email) {
  var apsId = extractAPSID_(email);
  return apsId === 'NA' ? REFERENCE_LETTER_FALLBACK_APSID : apsId;
}

// { normalizedEmail: 'MM/dd/yyyy' } — permanent; a Workspace account's
// creation date never changes, so unlike STAFF_NAME_CACHE_PROP_KEY this
// cache never expires once populated.
var REFERENCE_LETTER_JOIN_DATE_CACHE_PROP_KEY = 'referenceLetterJoinDateCache';

/**
 * The Teacher's APS Join Date = the Google Workspace account's creation
 * date (AdminDirectory.Users.get(email).creationTime), formatted MM/dd/yyyy
 * in the APS timezone — NEVER the Dashboard login date, Classroom enrollment
 * date, or request submission date. Mirrors getGoogleProfileName_()'s exact
 * Advanced-Service/error-handling pattern. Requires the same "Admin
 * Directory API" advanced service + Workspace super-admin authorization
 * already required by that function (see
 * APS_Reference_Letter_Feature.md, "Google Workspace API requirement").
 * Returns null (NEVER a fabricated/substituted date) if the lookup fails —
 * callers must surface a clear error rather than guessing.
 */
function getReferenceLetterJoinDate_(email) {
  var normalized = normalizeEmail_(email);
  if (!normalized) return null;

  var props = PropertiesService.getScriptProperties();
  var raw = props.getProperty(REFERENCE_LETTER_JOIN_DATE_CACHE_PROP_KEY);
  var cache = raw ? JSON.parse(raw) : {};
  if (cache[normalized]) return cache[normalized];

  try {
    var user = AdminDirectory.Users.get(normalized);
    if (user && user.creationTime) {
      var formatted = Utilities.formatDate(new Date(user.creationTime), LAST_LOGIN_TIMEZONE, 'MM/dd/yyyy');
      cache[normalized] = formatted;
      props.setProperty(REFERENCE_LETTER_JOIN_DATE_CACHE_PROP_KEY, JSON.stringify(cache));
      return formatted;
    }
  } catch (e) {
    // Admin Directory API not enabled/authorized, or account not found — the
    // caller must show a clear error, never fabricate/substitute a date.
  }
  return null;
}

function hasActiveReferenceLetterRequest_(teacherEmail) {
  var normalized = normalizeEmail_(teacherEmail);
  return readAllReferenceLetterRequests_().some(function (r) {
    return normalizeEmail_(r.teacherEmail) === normalized &&
      r.source === REFERENCE_LETTER_SOURCE.TEACHER_SELF &&
      REFERENCE_LETTER_ACTIVE_STATUSES.indexOf(r.requestStatus) > -1;
  });
}

/** Word counting treats consecutive whitespace as one separator — reuses the EXISTING countWords_() helper (already generic, not Grade/Time-Change-specific) rather than duplicating it. */
function validateReferenceLetterReason_(reasonText) {
  var text = String(reasonText || '').trim();
  var words = countWords_(text);
  if (words < REFERENCE_LETTER_MIN_REASON_WORDS) {
    throw new Error('Reason for Request is required and must contain at least ' + REFERENCE_LETTER_MIN_REASON_WORDS + ' words.');
  }
  if (words > REFERENCE_LETTER_MAX_REASON_WORDS) {
    throw new Error('Reason for Request must not exceed ' + REFERENCE_LETTER_MAX_REASON_WORDS + ' words.');
  }
  return text;
}

function validateReferenceLetterTeacherName_(name) {
  var text = String(name || '').trim();
  if (text.length < 2 || text.length > 100) {
    throw new Error('Teacher Full Name is required and must be between 2 and 100 characters.');
  }
  return text;
}

/**
 * Lets the client show/hide the "Reference Letter Approvals" tab WITHOUT a
 * Sheet read — mirrors getGradeChangeApproverInfo() exactly. The "Generate
 * Reference Letter" tab's visibility is derived purely client-side from
 * currentUser.role === 'teacher' (already returned by getDashboardData()),
 * exactly like the existing "Assign Classroom" tab — so this stays a cheap,
 * once-per-login call with no Sheet/Classroom/AdminDirectory access, per the
 * performance requirement.
 */
function getReferenceLetterAccessInfo(sessionToken) {
  var session = requireValidSession_(sessionToken);
  var email = session.email;
  // Sept 2026 addendum: isReadOnlyViewer (BOD only) is deliberately separate from
  // isApprover/isFinalApprover — the client uses it only to SHOW the approvals queue,
  // never to enable an approve/reject action (see renderReferenceLetterApprovalList()
  // in Dashboard.html, which gates its buttons on isApprover/isFinalApprover directly).
  // Checked directly against the email lists (mirroring getViewerRole_()'s own
  // SuperAdmin-beats-BOD precedence) rather than via getViewerRole_()/
  // readAllCoursesFromCache_(), to keep this the same cheap, no-Sheet-access,
  // once-per-login call the function's original design called for.
  var isReadOnlyViewer = isInEmailList_(email, VCFO_AMCHATS_BOD_EMAILS) && !isInEmailList_(email, SUPERADMIN_EMAILS);
  return {
    isApprover: isInEmailList_(email, REFERENCE_LETTER_APPROVER_EMAILS),
    isFinalApprover: email === normalizeEmail_(REFERENCE_LETTER_FINAL_APPROVER_EMAIL),
    isReadOnlyViewer: isReadOnlyViewer
  };
}

/** The signed-in Teacher's own Reference Letter requests (self-submitted only — never an Admin-initiated one raised in their name). Empty array for any other role — this is a read, not an authorization error, matching getMyClassChangeRequests()'s pattern. */
function getMyReferenceLetterRequests(sessionToken) {
  apsRequireTabForToken_(sessionToken, 'letters.reference'); // r56: Admin Control → Access Control
  var session = requireValidSession_(sessionToken);
  var email = session.email;
  var courses = readAllCoursesFromCache_();
  var viewer = { email: session.email, role: session.role };
  // Sept 2026 addendum: matches the same widened eligibility as
  // submitReferenceLetterRequest() — a dual-hat Admin/Headmaster/BOD/
  // SuperAdmin who also co-teaches a course can now submit a request, so
  // they must also be able to see it here afterward.
  var isClassroomTeacher = courses.some(function (c) { return courseHasTeacherEmail_(c, email); });
  if (viewer.role !== 'teacher' && !isClassroomTeacher) return [];
  return readAllReferenceLetterRequests_()
    .filter(function (r) { return normalizeEmail_(r.teacherEmail) === email && r.source === REFERENCE_LETTER_SOURCE.TEACHER_SELF; })
    .sort(function (a, b) { return String(b.requestDateTime || '').localeCompare(String(a.requestDateTime || '')); });
}

/**
 * The approver/admin-facing list. Visible to the REFERENCE_LETTER_APPROVER_EMAILS
 * group, the final approver, and Admin (Admin needs this tab for the
 * "issue for inactive/former Teacher" panel below) — rejected here,
 * server-side, for anyone else (a Teacher, a Student, a Headmaster not on
 * the approver list, etc.), not just hidden by the client.
 */
function getReferenceLetterRequestsForApprover(sessionToken) {
  apsRequireTabForToken_(sessionToken, 'rlApprovals'); // r56: Admin Control → Access Control
  var session = requireValidSession_(sessionToken);
  var email = session.email;
  var isApprover = isInEmailList_(email, REFERENCE_LETTER_APPROVER_EMAILS);
  var isFinalApprover = email === normalizeEmail_(REFERENCE_LETTER_FINAL_APPROVER_EMAIL);
  var viewerRole = session.role;
  var isAdmin = viewerRole === 'admin';
  // Sept 2026 addendum: BOD (vcfo_amchsts_bod) gets READ-ONLY visibility into this
  // queue too — decideReferenceLetterStage1()/decideReferenceLetterFinalApproval()
  // below are unchanged and still require isApprover/isFinalApprover, so this alone
  // grants no write access.
  var isReadOnlyViewer = viewerRole === VCFO_AMCHSTS_BOD_ROLE;
  if (!isApprover && !isFinalApprover && !isAdmin && !isReadOnlyViewer) {
    throw new Error('You are not authorized to view Reference Letter requests.');
  }
  return readAllReferenceLetterRequests_().sort(function (a, b) { return String(b.requestDateTime || '').localeCompare(String(a.requestDateTime || '')); });
}

/**
 * Teacher self-service submission. Every identity/derived field
 * (teacherEmail, apsId, apsJoinDate, role) is computed here, server-side —
 * the browser only ever supplies teacherName and reason (see
 * REFERENCE_LETTER section of Dashboard.html).
 */
function submitReferenceLetterRequest(sessionToken, teacherName, reason) {
  apsRequireTabForToken_(sessionToken, 'letters.reference'); // r56: Admin Control → Access Control
  var lock = LockService.getScriptLock();
  try { lock.waitLock(15000); } catch (e) { /* proceed best-effort */ }
  try {
    var session = requireValidSession_(sessionToken);
    var email = session.email;
    var courses = readAllCoursesFromCache_();
    var viewer = { email: session.email, role: session.role };
    // Sept 2026 addendum: also allow a viewer whose overall Dashboard role
    // outranks 'teacher' (Admin/Headmaster/BOD/SuperAdmin) but who ALSO
    // co-teaches an active Classroom course themselves — see
    // ctx.isClassroomTeacher in getDashboardData() for the full rationale.
    var isClassroomTeacher = courses.some(function (c) { return courseHasTeacherEmail_(c, email); });
    if (viewer.role !== 'teacher' && !isClassroomTeacher) throw new Error('Only a Teacher account can request a Reference Letter.');

    var validatedName = validateReferenceLetterTeacherName_(teacherName);
    var validatedReason = validateReferenceLetterReason_(reason);
    if (hasActiveReferenceLetterRequest_(email)) {
      throw new Error('You already have an active Reference Letter request in progress. Please wait for it to be completed or rejected before submitting another.');
    }

    var apsId = referenceLetterApsId_(email);
    var joinDate = getReferenceLetterJoinDate_(email);
    if (!joinDate) {
      throw new Error('Your APS Join Date could not be determined right now (Admin Directory lookup unavailable). Please contact APS Tech Support before submitting.');
    }

    var requestId = generateReferenceLetterRequestId_();
    var obj = {
      requestId: requestId,
      requestDateTime: new Date().toISOString(),
      teacherEmail: email,
      teacherName: validatedName,
      apsId: apsId,
      apsJoinDate: joinDate,
      requestReason: validatedReason,
      requestStatus: REFERENCE_LETTER_STATUS.SUBMITTED,
      stage1ApproverEmail: '', stage1ApprovalDateTime: '', stage1Comments: '',
      finalApproverEmail: '', finalApprovalDateTime: '', finalApprovalComments: '',
      pdfFileId: '', pdfFileName: '', processingNotes: '', completedDateTime: '',
      source: REFERENCE_LETTER_SOURCE.TEACHER_SELF,
      recipientPersonalEmail: '',
      initiatedByAdminEmail: '',
      letterType: REFERENCE_LETTER_TYPE.STANDARD
    };
    appendReferenceLetterRequestRow_(obj);
    notifyReferenceLetterApprovers_('New Reference Letter request — ' + validatedName, obj, 'A new Reference Letter request was submitted and needs Stage 1 review.');
    notifyReferenceLetterTeacher_(obj, 'Your Reference Letter request (' + requestId + ') has been submitted and is awaiting review.');
    return obj;
  } finally {
    try { lock.releaseLock(); } catch (e) { /* best-effort */ }
  }
}

/**
 * Admin-only: raises a Reference Letter on behalf of an inactive/former
 * Teacher who may no longer have Dashboard access, addressed to a personal
 * (non-APS) email — see APS_Reference_Letter_Feature.md, "Admin-initiated
 * Reference Letters" for the full design rationale. Skips Stage 1 (an Admin
 * has already vouched for the request) but STILL requires the same final
 * sign-off as every other request — final approval is never skipped, per
 * the base spec's explicit requirement.
 */
function submitAdminInitiatedReferenceLetter(sessionToken, teacherName, teacherApsEmail, personalEmail, reason) {
  apsRequireTabForToken_(sessionToken, 'rlApprovals'); // r56: Admin Control → Access Control
  var lock = LockService.getScriptLock();
  try { lock.waitLock(15000); } catch (e) { /* proceed best-effort */ }
  try {
    var session = requireValidSession_(sessionToken);
    var courses = readAllCoursesFromCache_();
    var viewer = { email: session.email, role: session.role };
    if (viewer.role !== 'admin') throw new Error('Only an Admin account can issue a Reference Letter on behalf of another teacher.');

    var validatedName = validateReferenceLetterTeacherName_(teacherName);
    var apsEmail = normalizeEmail_(teacherApsEmail);
    if (!isApsEmailAllowed_(apsEmail)) {
      throw new Error('Enter the teacher’s APS email address (their @avvaiyarpadasalai.org — or another approved APS domain — account), used to look up their APSID and APS Join Date.');
    }
    var personal = normalizeEmail_(personalEmail);
    if (!isSyntacticallyValidEmail_(personal)) {
      throw new Error('Enter a valid personal email address to receive the completed letter.');
    }

    var reasonText = String(reason || '').trim();
    if (reasonText) reasonText = validateReferenceLetterReason_(reasonText); // optional — validated only if provided

    var apsId = referenceLetterApsId_(apsEmail);
    var joinDate = getReferenceLetterJoinDate_(apsEmail);
    if (!joinDate) {
      throw new Error('APS Join Date could not be determined for that APS email right now (Admin Directory lookup unavailable). Please try again or contact APS Tech Support.');
    }

    var requestId = generateReferenceLetterRequestId_();
    var obj = {
      requestId: requestId,
      requestDateTime: new Date().toISOString(),
      teacherEmail: apsEmail,
      teacherName: validatedName,
      apsId: apsId,
      apsJoinDate: joinDate,
      requestReason: reasonText, // may be ''. Kept for the audit Sheet only — the letter template has no {{REQUEST_REASON}} placeholder, so this is never printed on the generated letter.
      requestStatus: REFERENCE_LETTER_STATUS.AWAITING_FINAL_APPROVAL, // Stage 1 skipped by design — see doc comment above
      stage1ApproverEmail: '', stage1ApprovalDateTime: '', stage1Comments: 'Admin-initiated — Stage 1 skipped by design.',
      finalApproverEmail: '', finalApprovalDateTime: '', finalApprovalComments: '',
      pdfFileId: '', pdfFileName: '', processingNotes: '', completedDateTime: '',
      source: REFERENCE_LETTER_SOURCE.ADMIN_INITIATED,
      recipientPersonalEmail: personal,
      initiatedByAdminEmail: viewer.email,
      letterType: REFERENCE_LETTER_TYPE.VOLUNTEER
    };
    appendReferenceLetterRequestRow_(obj);
    notifyReferenceLetterFinalApprover_(obj, 'An Admin (' + viewer.email + ') raised a Reference Letter for ' + validatedName + ' (' + apsId + '). It is awaiting your final approval.');
    return obj;
  } finally {
    try { lock.releaseLock(); } catch (e) { /* best-effort */ }
  }
}

/**
 * Stage 1 — any ONE of the REFERENCE_LETTER_APPROVER_EMAILS approves or
 * rejects. Re-checks the CURRENT status under lock before writing (mirrors
 * decideGradeTimeChangeStage1's exact re-check pattern) so a second,
 * near-simultaneous Stage-1 click from someone else is rejected rather than
 * silently applied twice. `decision` is 'approve' | 'reject'.
 */
function decideReferenceLetterStage1(sessionToken, requestId, decision, comments) {
  apsRequireTabForToken_(sessionToken, 'rlApprovals'); // r56: Admin Control → Access Control
  var session = requireValidSession_(sessionToken);
  var email = session.email;
  if (!isInEmailList_(email, REFERENCE_LETTER_APPROVER_EMAILS)) {
    throw new Error('You are not authorized to review Reference Letter requests.');
  }
  var lock = LockService.getScriptLock();
  try { lock.waitLock(15000); } catch (e) { /* proceed best-effort */ }
  try {
    var request = findReferenceLetterRequestById_(requestId);
    if (!request) throw new Error('Request not found.');
    if (request.requestStatus !== REFERENCE_LETTER_STATUS.SUBMITTED) {
      throw new Error('This request is no longer awaiting Stage 1 review (current status: ' + request.requestStatus + ').');
    }

    request.stage1ApproverEmail = email;
    request.stage1Comments = (comments || '').trim();
    request.stage1ApprovalDateTime = new Date().toISOString();

    if (decision === 'approve') {
      request.requestStatus = REFERENCE_LETTER_STATUS.AWAITING_FINAL_APPROVAL;
      writeReferenceLetterRequestRow_(request._row, request);
      notifyReferenceLetterFinalApprover_(request, 'This request passed Stage 1 review (' + email + ') and now needs your final approval.');
      notifyReferenceLetterTeacher_(request, 'Your Reference Letter request (' + requestId + ') passed initial review and is awaiting final approval.');
    } else {
      request.requestStatus = REFERENCE_LETTER_STATUS.REJECTED;
      writeReferenceLetterRequestRow_(request._row, request);
      notifyReferenceLetterApprovers_('Request rejected (' + requestId + ')', request, 'This request was rejected at Stage 1 by ' + email + '. Reason: ' + (request.stage1Comments || 'not specified') + '.');
      notifyReferenceLetterTeacher_(request, 'Your Reference Letter request (' + requestId + ') was not approved. Reason: ' + (request.stage1Comments || 'not specified') + '.');
    }
    return request;
  } finally {
    try { lock.releaseLock(); } catch (e) { /* best-effort */ }
  }
}

/**
 * Stage 2 — FINAL approval, ONLY REFERENCE_LETTER_FINAL_APPROVER_EMAIL.
 * Idempotent by design (Part 24 of the spec): re-reads the request INSIDE
 * the lock and requires status === AWAITING_FINAL_APPROVAL before doing
 * anything; if the request is already DONE, returns the existing record
 * without generating a second PDF or sending a second email — protects
 * against a double-click exactly like decideGradeTimeChangeFinalApproval's
 * capacity re-check protects against a double-add. `decision` is
 * 'approve' | 'reject'.
 */
function decideReferenceLetterFinalApproval(sessionToken, requestId, decision, comments) {
  apsRequireTabForToken_(sessionToken, 'rlApprovals'); // r56: Admin Control → Access Control
  var session = requireValidSession_(sessionToken);
  var email = session.email;
  if (email !== normalizeEmail_(REFERENCE_LETTER_FINAL_APPROVER_EMAIL)) {
    throw new Error('Only the final approver can complete this step.');
  }
  var lock = LockService.getScriptLock();
  try { lock.waitLock(30000); } catch (e) { /* proceed best-effort */ }
  try {
    var request = findReferenceLetterRequestById_(requestId);
    if (!request) throw new Error('Request not found.');
    if (request.requestStatus === REFERENCE_LETTER_STATUS.DONE) return request; // idempotent — already completed, never re-send
    if (request.requestStatus !== REFERENCE_LETTER_STATUS.AWAITING_FINAL_APPROVAL) {
      throw new Error('This request is not awaiting final approval (current status: ' + request.requestStatus + ').');
    }

    request.finalApproverEmail = email;
    request.finalApprovalComments = (comments || '').trim();
    request.finalApprovalDateTime = new Date().toISOString();

    if (decision !== 'approve') {
      request.requestStatus = REFERENCE_LETTER_STATUS.REJECTED;
      writeReferenceLetterRequestRow_(request._row, request);
      notifyReferenceLetterApprovers_('Final approval declined (' + requestId + ')', request, 'Final approval was declined. Reason: ' + (request.finalApprovalComments || 'not specified') + '.');
      notifyReferenceLetterTeacher_(request, 'Your Reference Letter request (' + requestId + ') was not given final approval. Reason: ' + (request.finalApprovalComments || 'not specified') + '.');
      return request;
    }

    request.requestStatus = REFERENCE_LETTER_STATUS.FINAL_APPROVED;
    writeReferenceLetterRequestRow_(request._row, request);
    request.requestStatus = REFERENCE_LETTER_STATUS.PROCESSING;
    writeReferenceLetterRequestRow_(request._row, request);

    var pdfResult;
    try {
      pdfResult = generateReferenceLetterPdf_(request);
    } catch (e) {
      request.requestStatus = REFERENCE_LETTER_STATUS.PROCESSING_ERROR;
      request.processingNotes = 'PDF generation failed: ' + e.message + '. Not marked DONE — needs manual retry from Final Approval once the underlying issue (see APS_Reference_Letter_Feature.md, Troubleshooting) is resolved.';
      writeReferenceLetterRequestRow_(request._row, request);
      notifyReferenceLetterApprovers_('PROCESSING ERROR — PDF generation failed (' + requestId + ')', request, request.processingNotes);
      return request;
    }
    request.pdfFileId = pdfResult.fileId || '';
    request.pdfFileName = pdfResult.fileName || '';

    try {
      sendReferenceLetterPdf_(request, pdfResult.blob);
    } catch (e) {
      request.requestStatus = REFERENCE_LETTER_STATUS.PROCESSING_ERROR;
      request.processingNotes = 'PDF generated (' + request.pdfFileName + ') but email delivery failed: ' + e.message + '. Not marked DONE.';
      writeReferenceLetterRequestRow_(request._row, request);
      notifyReferenceLetterApprovers_('PROCESSING ERROR — email delivery failed (' + requestId + ')', request, request.processingNotes);
      return request;
    }

    request.requestStatus = REFERENCE_LETTER_STATUS.DONE;
    request.completedDateTime = new Date().toISOString();
    request.processingNotes = 'Reference Letter generated and emailed successfully.';
    writeReferenceLetterRequestRow_(request._row, request);
    notifyReferenceLetterApprovers_('Request DONE (' + requestId + ')', request, 'The Reference Letter was generated and sent.');
    return request;
  } finally {
    try { lock.releaseLock(); } catch (e) { /* best-effort */ }
  }
}

/** Body.replaceText() treats its 2nd argument as a regex replacement string, where a bare "$" starts a backreference (e.g. "$1"). A teacher name or APS ID containing "$" would otherwise corrupt the substitution, so every literal replacement value is passed through this first — "$" becomes the literal-dollar escape "$$". */
function docReplacementSafe_(value) {
  return String(value == null ? '' : value).replace(/\$/g, '$$$$');
}

/**
 * Generates the PDF from the ONE master template Doc
 * (REFERENCE_LETTER_TEMPLATE_DOC_ID) — makes a temporary copy, fills in the
 * placeholders via Body.replaceText(), exports the copy to PDF, then trashes
 * the copy in a `finally` block so it is never left behind even if export
 * fails. Only ever called from decideReferenceLetterFinalApproval(), i.e.
 * only ever runs under the REFERENCE_LETTER_FINAL_APPROVER_EMAIL account's
 * authorization. Returns { blob, fileName, fileId } — fileId is ''
 * unless REFERENCE_LETTER_PDF_ARCHIVE_FOLDER_ID is configured.
 */
function generateReferenceLetterPdf_(request) {
  var issueDateFormatted = Utilities.formatDate(new Date(), LAST_LOGIN_TIMEZONE, 'MMMM d, yyyy');

  var templateFile = DriveApp.getFileById(REFERENCE_LETTER_TEMPLATE_DOC_ID);
  var copyFile = templateFile.makeCopy('TEMP - APS Reference Letter - ' + request.requestId);
  try {
    var doc = DocumentApp.openById(copyFile.getId());
    var body = doc.getBody();

    body.replaceText('\\{\\{TEACHER_NAME\\}\\}', docReplacementSafe_(request.teacherName));
    body.replaceText('\\{\\{APSID\\}\\}', docReplacementSafe_(request.apsId));
    body.replaceText('\\{\\{APS_JOIN_DATE\\}\\}', docReplacementSafe_(request.apsJoinDate));
    body.replaceText('\\{\\{ISSUE_DATE\\}\\}', docReplacementSafe_(issueDateFormatted));

    doc.saveAndClose();

    var fileName = 'APS_Reference_Letter_' + request.apsId + '_' + Utilities.formatDate(new Date(), LAST_LOGIN_TIMEZONE, 'yyyyMMdd') + '.pdf';
    var pdfBlob = DriveApp.getFileById(copyFile.getId()).getAs(MimeType.PDF).setName(fileName);

    var result = { blob: pdfBlob, fileName: fileName, fileId: '' };
    if (REFERENCE_LETTER_PDF_ARCHIVE_FOLDER_ID) {
      try {
        var folder = DriveApp.getFolderById(REFERENCE_LETTER_PDF_ARCHIVE_FOLDER_ID);
        var savedFile = folder.createFile(pdfBlob);
        result.fileId = savedFile.getId();
      } catch (e) { /* best-effort — archiving is optional and must never block delivery */ }
    }
    return result;
  } finally {
    // Delete the temporary COPY after successful (or failed) export — never
    // leave one-off Docs behind. The master template
    // (REFERENCE_LETTER_TEMPLATE_DOC_ID) itself is never touched. If
    // archiving is desired long-term, that is the separate, EXPLICITLY
    // OPT-IN REFERENCE_LETTER_PDF_ARCHIVE_FOLDER_ID above (a PDF copy), not
    // this temporary intermediate Doc.
    try { DriveApp.getFileById(copyFile.getId()).setTrashed(true); } catch (e) { /* best-effort cleanup */ }
  }
}

/** aka "notifyReferenceLetterCompletion_" — sends the finished PDF to the Teacher (or, for an Admin-initiated request, the recipientPersonalEmail) CC admin@, then separately sends the completion package to the final-approval mailbox — exactly the two deliveries the spec's Final Approval step calls for. */
function sendReferenceLetterPdf_(request, pdfBlob) {
  var recipient = request.source === REFERENCE_LETTER_SOURCE.ADMIN_INITIATED ? request.recipientPersonalEmail : request.teacherEmail;
  if (!recipient || !isSyntacticallyValidEmail_(recipient)) {
    throw new Error('No valid recipient email address is on file for this request.');
  }
  var message = 'Please find attached your APS Reference Letter (' + request.requestId + ').';
  apsMailAppSend_({ // r63: TEST guard
    to: recipient,
    cc: REFERENCE_LETTER_COMPLETION_CC_EMAIL,
    subject: 'Your APS Reference Letter — ' + request.teacherName,
    body: message,
    htmlBody: referenceLetterEmailHtml_(request, message),
    attachments: [pdfBlob]
  });
  try {
    apsMailAppSend_({ // r63: TEST guard
      to: REFERENCE_LETTER_FINAL_APPROVER_EMAIL,
      subject: 'APS Reference Letter completed — ' + request.requestId,
      body: 'Reference Letter completed for ' + request.teacherName + ' (' + request.apsId + '). Sent to: ' + recipient,
      htmlBody: referenceLetterEmailHtml_(request, 'Reference Letter completed and delivered. Sent to: ' + recipient),
      attachments: [pdfBlob]
    });
  } catch (e) { /* best-effort — never fail the whole completion over this internal copy */ }
}

function referenceLetterEmailHtml_(request, message) {
  var lines = [
    '<p style="margin-top:0;font-size:18px;"><b>APS Reference Letter Request</b></p>',
    '<table style="width:100%;border-collapse:collapse;line-height:1.55;">',
    '<tr><td style="padding:4px 10px 4px 0;width:160px;"><b>Request ID</b></td><td style="padding:4px 0;">' + htmlEscape_(request.requestId) + '</td></tr>',
    '<tr><td style="padding:4px 10px 4px 0;"><b>Teacher</b></td><td style="padding:4px 0;">' + htmlEscape_(request.teacherName) + ' (' + htmlEscape_(request.apsId) + ')</td></tr>',
    '<tr><td style="padding:4px 10px 4px 0;"><b>APS Join Date</b></td><td style="padding:4px 0;">' + htmlEscape_(request.apsJoinDate) + '</td></tr>',
    '<tr><td style="padding:4px 10px 4px 0;"><b>Status</b></td><td style="padding:4px 0;">' + htmlEscape_(request.requestStatus) + '</td></tr>',
    '</table>',
    '<div style="margin-top:16px;padding:12px;background:#f8f9fa;border-radius:8px;"><b>Reason</b><br>' + htmlEscape_(request.requestReason || '(none provided)').replace(/\n/g, '<br>') + '</div>',
    '<p style="margin-top:16px;">' + htmlEscape_(message || '') + '</p>'
  ].join('');
  return apsEmailShell_('APS Reference Letter', lines);
}

/** Broadcasts to every REFERENCE_LETTER_APPROVER_EMAILS address (new submission, rejection, completion, or PROCESSING ERROR notices). */
function notifyReferenceLetterApprovers_(subject, request, message) {
  try {
    var recipients = REFERENCE_LETTER_APPROVER_EMAILS.filter(function (e) { return e && e.indexOf('@') > -1; }).join(',');
    if (!recipients) return;
    sendApsHtmlEmail_({ to: recipients, subject: 'APS Reference Letter: ' + subject, body: message, htmlBody: referenceLetterEmailHtml_(request, message) });
  } catch (e) { /* best-effort */ }
}

/** Targeted notice to ONLY REFERENCE_LETTER_FINAL_APPROVER_EMAIL that a request needs their final sign-off (Stage-1-approved, or an Admin-initiated request that skipped Stage 1). */
function notifyReferenceLetterFinalApprover_(request, message) {
  try {
    sendApsHtmlEmail_({
      to: REFERENCE_LETTER_FINAL_APPROVER_EMAIL,
      subject: 'ACTION NEEDED — Final Approval — APS Reference Letter ' + request.requestId,
      body: message,
      htmlBody: referenceLetterEmailHtml_(request, message)
    });
  } catch (e) { /* best-effort */ }
}

/** Notifies the submitting Teacher — or, for an Admin-initiated request, the recipientPersonalEmail (the Teacher's own account may not exist/be reachable). Silently skipped if no valid address is on file. */
function notifyReferenceLetterTeacher_(request, message) {
  try {
    var to = request.source === REFERENCE_LETTER_SOURCE.ADMIN_INITIATED ? request.recipientPersonalEmail : request.teacherEmail;
    if (!to || !isSyntacticallyValidEmail_(to)) return;
    sendApsHtmlEmail_({ to: to, subject: 'APS Reference Letter Request ' + request.requestId, body: message, htmlBody: referenceLetterEmailHtml_(request, message) });
  } catch (e) { /* best-effort */ }
}
/* =====================================================================
 *  STUDENT & TEACHER ATTENDANCE CAPTURE (Google Meet) — fully isolated,
 *  additive module. Nothing above this line is modified, renamed, or
 *  refactored — same discipline as the APS Reference Letter module above.
 *  New Spreadsheet ID, new Script Properties, new constants, new
 *  functions only.
 *
 *  WHAT THIS DOES: for every AY26-27 Classroom course, on its scheduled
 *  class day/time, captures each enrolled student's and assigned
 *  teacher's real Google Meet join/leave session data, merges overlapping
 *  sessions, bounds active minutes to the scheduled class window, and
 *  writes one row per person per class date into that school WEEK's sheet
 *  (AWK01ATT = Week 1, AWK02ATT = Week 2, ... — every classroom's students
 *  and teachers together; Sept 26, 2026 redesign, see ATTENDANCE_WEEK1_START)
 *  inside spreadsheet ATTENDANCE_SPREADSHEET_ID. Re-running the sync updates

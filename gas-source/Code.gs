}
/** First meet.google.com link in the Classroom Description / Room / Section / heading ('' if none). */
function classMeetLinkFromClassroom_(course) {
  var text = [course.description, course.descriptionHeading, course.room, course.section].map(function (x) { return String(x || ''); }).join(' ');
  var m = text.match(/meet\.google\.com\/([a-z]{3}-[a-z]{4}-[a-z]{3})\b/i);
  return m ? classMeetUrl_(m[1]) : '';
}
/** Attendance sync: remember the single Meet code a class used on its latest class date (teacher's / class's Meet). */
function classMeetNoteDetected_(store, course, dateStr, attribution) {
  try {
    if (!attribution || [ATTENDANCE_SOURCE.AUDIT_MAPPED_CODE, ATTENDANCE_SOURCE.AUDIT_TEACHER_CODE, ATTENDANCE_SOURCE.AUDIT_CLASS_CODE].indexOf(attribution.source) < 0) return;
    var codes = Object.keys(attribution.codes || {});
    if (codes.length !== 1 || !classMeetUrl_(codes[0])) return; // ambiguous (several Meets) -> keep the previous one
    var id = String(course.id), prev = store[id];
    if (prev && prev.date > dateStr) return;
    store[id] = { code: codes[0], source: attribution.source, date: dateStr, courseName: course.name || '' };
  } catch (e) { /* never affects attendance */ }
}
/** One read + one write of Course_Meet_Link_Detected (upsert by Course ID; never replaces with an older class date). */
function classMeetDetectedSave_(store) {
  var ids = Object.keys(store || {});
  if (!ids.length) return;
  try {
    var ss = getAttendanceWorkbook_();
    var sh = ss.getSheetByName(CLASS_MEET_DETECTED_SHEET_);
    if (!sh) { sh = ss.insertSheet(CLASS_MEET_DETECTED_SHEET_); sh.getRange(1, 1, 1, CLASS_MEET_DETECTED_HEADER_.length).setValues([CLASS_MEET_DETECTED_HEADER_]).setFontWeight('bold'); sh.setFrozenRows(1); }
    var last = sh.getLastRow(), rows = [], at = {};
    if (last > 1) rows = sh.getRange(2, 1, last - 1, CLASS_MEET_DETECTED_HEADER_.length).getValues();
    rows.forEach(function (r, i) { if (r[0] !== '' && at[String(r[0])] === undefined) at[String(r[0])] = i; });
    var now = new Date().toISOString(), changed = false;
    ids.forEach(function (id) {
      var d = store[id], code = classMeetUrl_(d.code).replace('https://meet.google.com/', '');
      var row = [id, d.courseName, code, d.source, d.date, now];
      var i = at[id];
      if (i === undefined) { at[id] = rows.length; rows.push(row); changed = true; return; }
      var r = rows[i], had = r[4] instanceof Date ? Utilities.formatDate(r[4], APS_TZ, 'yyyy-MM-dd') : String(r[4] || '');
      if (had > d.date || (String(r[2]) === code && had === d.date)) return;
      rows[i] = row; changed = true;
    });
    if (!changed) return;
    sh.getRange(2, 1, rows.length, CLASS_MEET_DETECTED_HEADER_.length).setValues(rows);
    classMeetLinksInvalidate_();
  } catch (e) {
    console.warn('[ClassMeet] could not save detected Meet links: ' + (e && e.message));
  }
}
function classMeetLinksInvalidate_() { try { CacheService.getScriptCache().remove(CLASS_MEET_CACHE_KEY_); } catch (e) { /* ignore */ } }

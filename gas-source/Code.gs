      if (Date.now() - started > DS_RUN_BUDGET_MS_) { out.daily.push({ key: d + ' | DAILY', deferred: true }); continue; }
      try { out.daily.push(dsRunDaily_(d, now)); }
      catch (e) { console.error('[DailySummary] ' + d + ' not generated (will retry next morning): ' + srmSafeErr_(e)); out.daily.push({ key: d + ' | DAILY', error: srmSafeErr_(e) }); }
    }

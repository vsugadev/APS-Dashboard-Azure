/** The signed-in student's published papers (own classes only), with server time for an authoritative countdown. */
function getMyExamQuestionPapers(sessionToken) {
  apsRequireTabForToken_(sessionToken, 'exam.questionPaper'); // r56: Admin Control → Access Control
  const v = examQpViewer_(sessionToken);
  if (!v.isStudent) throw new Error('Only students have personal question papers.');
  const nowMs = Date.now();
  const courses = readAllCoursesFromCache_().filter(function (c) { return examIsAllowedCourseName_(c.name) && courseHasStudentEmail_(c, v.email); });
  const byId = {};
  courses.forEach(function (c) { byId[String(c.id)] = c; });
  let me = { name: '', email: v.email, apsId: getAPSIdFromEmail(v.email) };
  courses.some(function (c) { const s = (c.students || []).filter(function (x) { return normalizeEmail_(x.email) === v.email; })[0]; if (s && s.name) { me.name = s.name; return true; } return false; });
  const records = examQpReadRecords_().filter(function (r) {
    if (!byId[r.Course_ID]) return false;
    if (r.Status !== EXAM_QP_STATUS.PUBLISHED && !(r.Status === EXAM_QP_STATUS.CANCELLED && r.Published_Date_Time)) return false;
    const w = examQpWindowOf_(r);
    return !!w && w.close.getTime() + EXAM_QP_CONFIG.STUDENT_HISTORY_DAYS * 86400000 > nowMs;
  });
  const mine = examQpSummariesFor_(records.map(function (r) { return r.Question_Paper_ID; }), v.email);
  const viewAudits = [];
  const papers = records.map(function (r) {
    const w = examQpWindowOf_(r);
    let state = 'WAITING';
    if (r.Status === EXAM_QP_STATUS.CANCELLED) state = 'CANCELLED';
    else if (examQpBool_(r.Locked)) state = 'LOCKED';
    else if (nowMs >= w.close.getTime()) state = 'CLOSED';
    else if (nowMs >= w.release.getTime()) state = 'AVAILABLE';
    const s = mine[r.Question_Paper_ID] || {};
    const cache = CacheService.getScriptCache();
    const viewKey = 'examQpView_' + r.Question_Paper_ID + '_' + Utilities.base64EncodeWebSafe(v.email).slice(0, 40);
    if (!cache.get(viewKey)) { cache.put(viewKey, '1', 21600); viewAudits.push({ type: EXAM_QP_EVENTS.STUDENT_VIEWED_EXAM, examId: r.Exam_ID, qpId: r.Question_Paper_ID, className: r.Class_Name, studentName: me.name, result: state }); }
    if (state === 'AVAILABLE') examQpNoteWindowOpened_(r, viewAudits);
    return {
      questionPaperId: r.Question_Paper_ID, examId: r.Exam_ID, examTitle: r.Exam_Title, className: r.Class_Name, shortClass: String(r.Class_Name).split('|')[0].trim(),
      grade: r.Grade, teacherName: r.Teacher_Name, state: state, releaseAt: w.release.getTime(), closeAt: w.close.getTime(), startAt: w.start.getTime(),
      releaseLabel: examQpLabel_(w.release), releaseTimeLabel: examQpTimeLabel_(w.release), releaseLongLabel: examQpLongLabel_(w.release),
      closeLabel: examQpLabel_(w.close), startLabel: examQpLabel_(w.start), myDownloadCount: Number(s.Download_Count || 0),
      myLastDownload: s.Last_Download_Date_Time ? examQpLabel_(examQpParseTs_(s.Last_Download_Date_Time)) : '',
      myFirstDownload: s.First_Download_Date_Time ? examQpLabel_(examQpParseTs_(s.First_Download_Date_Time)) : '',
      myDownloadKey: Number(s.Download_Count || 0) ? (s.Download_Key || examQpDownloadKey_(r.Question_Paper_ID, v.email)) : '' // shown again after the first download
    };
  }).sort(function (a, b) { return a.releaseAt - b.releaseAt; });
  if (viewAudits.length) examQpAudit_(v, viewAudits);
  return { serverNow: Date.now(), student: me, papers: papers };
}

function examQpNoteWindowOpened_(r, audits) {
  const cache = CacheService.getScriptCache();
  const key = 'examQpOpened_' + r.Question_Paper_ID;
  if (cache.get(key)) return;
  cache.put(key, '1', 21600);
  audits.push({ type: EXAM_QP_EVENTS.DOWNLOAD_WINDOW_OPENED, examId: r.Exam_ID, qpId: r.Question_Paper_ID, className: r.Class_Name, result: 'AVAILABLE', metadata: { release: r.Calculated_Release_Date_Time, close: r.Calculated_Close_Date_Time } });
}

/** Summary rows for (qpIds x one student) or (qpIds x everyone) keyed by paper (and email). */
function examQpSummariesFor_(qpIds, email) {
  if (!qpIds.length) return {};
  const meta = examQpSheet_(EXAM_QP_CONFIG.SHEET_SUMMARY, EXAM_QP_SUMMARY_HEADER);
  const last = meta.sheet.getLastRow();
  const out = {};
  if (last < 2) return out;
  const want = {};
  qpIds.forEach(function (id) { want[id] = true; });
  meta.sheet.getRange(2, 1, last - 1, meta.width).getValues().forEach(function (row) {
    const o = examQpObjectFromRow_(meta, row);
    if (!want[o.Question_Paper_ID]) return;
    if (email) { if (normalizeEmail_(o.Student_Email) === email) out[o.Question_Paper_ID] = o; }
    else out[o.Question_Paper_ID + '|' + normalizeEmail_(o.Student_Email)] = o;
  });
  return out;
}


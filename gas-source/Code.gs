  var kv = function (rows) { return '<table role="presentation" cellpadding="0" cellspacing="0" border="0" style="border-collapse:collapse;font-size:14px;margin:4px 0 10px;">' + rows.map(function (x) { return '<tr><td style="padding:3px 14px 3px 0;color:#5f6368;">' + e(x[0]) + '</td><td style="padding:3px 0;font-weight:700;">' + e(x[1]) + '</td></tr>'; }).join('') + '</table>'; };
  var body = '<p style="font-size:15px;line-height:1.55;margin:0 0 10px;">Vanakkam,</p>' +

  var cats = c.categories === undefined ? d.categories : (Array.isArray(c.categories) ? c.categories : String(c.categories).split(/[\s,]+/)).map(function (x) { return String(x).toUpperCase().trim(); }).filter(function (x) { return MHG_CATS_[x]; });

    classStatusManual: apsScopeById_(getClassStatusOverrideMap_(), scope),
    weeklyAvailability: apsScopeById_(rec.weeklyAvailability || {}, scope, true),
    externalActivity: apsScopeByEmail_(rec.externalActivity, scope),

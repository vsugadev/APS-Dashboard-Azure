    'Original class: ' + plan.orig.name, 'Coverage class: ' + plan.dest.name, 'Coverage teacher: ' + (plan.destinationTeacher ? plan.destinationTeacher.name : '-'),
    'When: ' + s.dateLabel + ', ' + s.timeLabel, 'Students joining: ' + plan.studentCount, 'Google Meet: ' + plan.meet.url, 'Arranged by: ' + plan.requestedBy, '',

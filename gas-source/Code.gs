/** ---------------------------------------------------------------------
 *  WEEKLY CLASS ATTENDANCE REPORT EMAIL (Monday ~7:00 AM ET)
 *  One consolidated report per Google Classroom for the week that just
 *  ended, sent to that classroom's students and teachers, CC'd to
 *  ATTENDANCE_REPORT_CC (default admin@; admin@ is always included). r53: sent
 *  From attendance@ via the Gmail API (attMailSend_), Reply-To the class teacher(s). Uses the standard APS
 *  email template (apsEmailShell_/sendApsHtmlEmail_). Names the class
 *  teacher(s) with email and tells students to contact them for any
 *  correction. Quota-aware and resumable: progress is kept per week in
 *  ATTENDANCE_REPORT_STATE_KEY, so a batch that hits the daily MailApp
 *  recipient quota continues on the next daily run (Tue/Wed) and a class is
 *  never emailed twice for the same week.
 *  Script Property ATTENDANCE_REPORT_AUDIENCE: 'CLASS' (default, as
 *  requested: the whole class sees the consolidated table) or 'PRIVATE'
 *  (teachers + CC get the consolidated table; each student gets only their
 *  own row).
 * ------------------------------------------------------------------- */
var ATTENDANCE_REPORT_STATE_KEY = 'attendanceReportState_v1';
var ATTENDANCE_REPORT_CC_DEFAULT_ = ['admin@avvaiyarpadasalai.org']; // r53: admin@ only (admin@ is always added — see attMailCc_)
var ATTENDANCE_REPORT_TIME_BUDGET_MS = 5 * 60 * 1000;

function getAttendanceReportCc_() {
  var list = getConfigList_('ATTENDANCE_REPORT_CC', ATTENDANCE_REPORT_CC_DEFAULT_);
  return list.map(normalizeEmail_).filter(isSyntacticallyValidEmail_);
}

function getAttendanceReportAudience_() {
  return String(PropertiesService.getScriptProperties().getProperty('ATTENDANCE_REPORT_AUDIENCE') || 'CLASS').toUpperCase() === 'PRIVATE' ? 'PRIVATE' : 'CLASS';
}

/* ---------------------------------------------------------------------
 * r53 — ATTENDANCE MAIL (weekly class attendance report + Teacher Availability report)
 * Sent From attendance@avvaiyarpadasalai.org through the Gmail API (mail profile ATTENDANCE —
 * credentials ATTENDANCE_OAUTH_CLIENT_ID / _SECRET / ATTENDANCE_REFRESH_TOKEN live only in Script
 * Properties). admin@ is always CC. Never falls back to another sender: if attendance@ cannot sign in,
 * sending pauses (nothing is marked sent) and admin@ gets one alert (at most every 6 h).
 * Daily budget: ATTENDANCE_MAIL_DAILY_LIMIT recipients per day (default 1500), counted for attendance@
 * itself (Workspace mailboxes allow ~2,000/day) instead of the dashboard account's MailApp quota.
 * ------------------------------------------------------------------- */
var ATTENDANCE_MAIL_ADMIN_CC_DEFAULT_ = 'admin@avvaiyarpadasalai.org';
var ATTENDANCE_MAIL_DAILY_LIMIT_DEFAULT_ = 1500;
var ATTENDANCE_MAIL_COUNT_KEY_ = 'ATT_MAIL_DAILY_COUNT';
var ATTENDANCE_MAIL_ALERT_KEY_ = 'ATT_MAIL_ALERT_AT';

function attMailAdminCc_() {
  var e = normalizeEmail_(rosterProp_('ATTENDANCE_MAIL_ADMIN_CC', ATTENDANCE_MAIL_ADMIN_CC_DEFAULT_));
  return isSyntacticallyValidEmail_(e) ? e : ATTENDANCE_MAIL_ADMIN_CC_DEFAULT_;
}
/** CC list with admin@ always present, de-duplicated, and never repeating an address that is already in To. */
function attMailCc_(cc, to) {
  var toSet = {}; (to || []).forEach(function (e) { toSet[normalizeEmail_(e)] = true; });
  var out = [];
  (cc || []).concat([attMailAdminCc_()]).forEach(function (e) { e = normalizeEmail_(e); if (e && !toSet[e] && out.indexOf(e) === -1 && isSyntacticallyValidEmail_(e)) out.push(e); });
  return out;
}
function attMailDay_() { return Utilities.formatDate(new Date(), APS_TZ, 'yyyy-MM-dd'); }
/** { limit, used, remaining } — recipients sent From attendance@ today (America/New_York day). */
function attMailBudget_() {
  var limit = Math.floor(Number(rosterProp_('ATTENDANCE_MAIL_DAILY_LIMIT', String(ATTENDANCE_MAIL_DAILY_LIMIT_DEFAULT_))));
  if (!(limit > 0)) limit = ATTENDANCE_MAIL_DAILY_LIMIT_DEFAULT_;
  var used = 0;
  try { var c = JSON.parse(PropertiesService.getScriptProperties().getProperty(ATTENDANCE_MAIL_COUNT_KEY_) || 'null'); if (c && c.day === attMailDay_()) used = Number(c.n) || 0; } catch (e) { used = 0; }
  return { limit: limit, used: used, remaining: Math.max(0, limit - used) };
}
function attMailCount_(n) {
  var b = attMailBudget_();
  PropertiesService.getScriptProperties().setProperty(ATTENDANCE_MAIL_COUNT_KEY_, JSON.stringify({ day: attMailDay_(), n: b.used + n }));
}
/** True when attendance@ credentials are present (does not test the sign-in). */
function attMailConfigured_() { return apsMailMode_('ATTENDANCE') !== 'NOT_CONFIGURED'; }
/**
 * Sends one attendance email From attendance@. m = { to:[], cc:[], replyTo, subject, html, text }.
 * Throws on failure: err.apsPaused = true when attendance@ could not sign in / is not configured;
 * err.apsQuota = true when today's ATTENDANCE_MAIL_DAILY_LIMIT would be exceeded.
 */
function attMailSend_(m) {
  var n = m.to.length + (m.cc || []).length + (m.bcc || []).length;
  if (attMailBudget_().remaining < n) { var q = new Error('daily attendance email limit reached (ATTENDANCE_MAIL_DAILY_LIMIT)'); q.apsQuota = true; throw q; }
  var r = apsGmailSend_('ATTENDANCE', m);
  if (!r.ok) { var e = new Error(r.error || 'email failed'); e.apsPaused = !!r.auth; throw e; }
  attMailCount_(n);
  return r;
}
/** One short alert to admin@ (sent by the dashboard account, since attendance@ is unavailable); at most every 6 h. Never includes secrets. */
function attMailAlertAdmin_(what, reason) {
  try {
    var props = PropertiesService.getScriptProperties();
    var last = Number(props.getProperty(ATTENDANCE_MAIL_ALERT_KEY_) || 0);
    if (Date.now() - last < 6 * 3600 * 1000) return false;
    props.setProperty(ATTENDANCE_MAIL_ALERT_KEY_, String(Date.now()));
    var from = apsMailFrom_('ATTENDANCE');
    var why = String(reason || '').replace(/(Bearer|token|secret|private_key)[^\s,)]*/gi, '$1 [hidden]').slice(0, 200);
    var body = 'The ' + what + ' could not be sent from ' + from + ', so sending is PAUSED (nothing was sent from any other address).\n\n' +
      'Reason: ' + why + '\n\nFix: in Apps Script > Project Settings > Script Properties, check ATTENDANCE_OAUTH_CLIENT_ID, ATTENDANCE_OAUTH_CLIENT_SECRET and ATTENDANCE_REFRESH_TOKEN ' +
      '(the refresh token must be issued while signed in as ' + from + ' with the gmail.send scope). Weekly attendance reports resume automatically on the next daily run (Tue/Wed); ' +
      'the Teacher Availability report is sent again at the next scheduled time.';
    sendApsHtmlEmail_({ to: attMailAdminCc_(), subject: 'ACTION NEEDED: APS attendance emails paused (' + from + ' sign-in)', body: body,
      htmlBody: apsEmailShell_('Attendance emails paused', body.split('\n\n').map(function (x) { return '<p>' + htmlEscape_(x) + '</p>'; }).join('')) });
    return true;
  } catch (e) { console.warn('[AttendanceMail] admin alert failed: ' + (e && e.message)); return false; }
}

/** The week the report covers: the week containing (today - 3 days) — on Monday that is the weekend that just ended. */
function attReportWeekId_(now) {
  return attWeekIdForDateStr_(attShiftDateStr_(Utilities.formatDate(now, APS_TZ, 'yyyy-MM-dd'), -3));
}

/**
 * Trigger entry point (daily ~7 AM ET, see createAttendanceSyncTrigger).
 * Monday: starts (or continues) this week's batch. Tue/Wed: only resumes an
 * unfinished Monday batch. Any other day / already finished: exits at once.
 * If no sync ran yet today, runs one first so the report has fresh data.
 */
function sendWeeklyAttendanceReports(e) {
  apsRequireOwnerOrTrigger_(e, 'sendWeeklyAttendanceReports'); // r55: own trigger or editor only
  var now = new Date();
  var dow = easternDayOfWeek_(now);
  var weekId = attReportWeekId_(now);
  var props = PropertiesService.getScriptProperties();
  var state = null;
  try { state = JSON.parse(props.getProperty(ATTENDANCE_REPORT_STATE_KEY) || 'null'); } catch (e) { state = null; }
  var sameWeek = state && state.weekId === weekId;
  if (dow === 1) {
    if (sameWeek && state.done) return { skipped: 'already sent for ' + weekId };
    if (!sameWeek) state = { weekId: weekId, sent: {}, startedAt: now.toISOString() };
  } else if (!(dow >= 2 && dow <= 3 && sameWeek && !state.done)) {
    return { skipped: 'not a report day' };
  }
  var todayStr = Utilities.formatDate(now, APS_TZ, 'yyyy-MM-dd');
  var last = null;
  try { last = JSON.parse(props.getProperty(ATTENDANCE_LAST_SYNC_SUMMARY_KEY) || 'null'); } catch (e2) { last = null; }
  if (!last || !last.at || Utilities.formatDate(new Date(last.at), APS_TZ, 'yyyy-MM-dd') !== todayStr) {
    try { syncAttendanceForAllCourses_(); } catch (syncErr) { logAttendanceSyncDiagnostic_('Pre-report sync failed (report uses existing data): ' + syncErr.message); }
  }
  var result = attSendAttendanceReportsForWeek_(weekId, state, {});
  props.setProperty(ATTENDANCE_REPORT_STATE_KEY, JSON.stringify(state));
  return result;
}

/**
 * Editor helper for testing: emails the report of ONE classroom (optionally
 * `courseId`) for the latest reported week ONLY to the account running it —
 * no students, no CC, nothing recorded as sent.
 */
function sendAttendanceReportPreviewToMe(courseId) {
  apsRequireOwnerOrTrigger_(null); // r55: editor (script owner) only — not callable from the web app
  var me = Session.getEffectiveUser().getEmail();
  if (!me) throw new Error('Could not determine your email address.');
  var weekId = attReportWeekId_(new Date());
  return attSendAttendanceReportsForWeek_(weekId, { weekId: weekId, sent: {} }, { previewTo: me, onlyCourseId: courseId ? String(courseId) : '', limit: 1 });
}

/** Core sender. Mutates `state.sent` / `state.done`; the caller persists it. */
function attSendAttendanceReportsForWeek_(weekId, state, opts) {
  var startedMs = Date.now();
  var week1 = getAttendanceWeek1Start_();
  var weekNo = attWeekNumberForWeekId_(weekId, week1);
  var out = { weekId: weekId, weekNo: weekNo, sent: 0, skippedNoData: 0, remaining: 0, quotaHit: false };
  if (!weekNo) { state.done = true; return out; }
  var records = attReadRecordsForFilters_({ weekOf: weekId }, null).filter(function (r) { return !apsLeaveSkip_('ATTENDANCE_REPORT', r.date); }); // r109
  var summaryMap = readAttendanceSummaryMap_();
  var coursesById = {};
  readAllCoursesFromCache_().forEach(function (c) { coursesById[String(c.id)] = c; });
  var byCourse = {};
  records.forEach(function (r) { (byCourse[r.courseId] = byCourse[r.courseId] || []).push(r); });
  var ids = Object.keys(byCourse).filter(function (id) { return !opts.onlyCourseId || id === opts.onlyCourseId; })
    .sort(function (a, b) { return String(byCourse[a][0].className).localeCompare(String(byCourse[b][0].className)); });
  var cc = opts.previewTo ? [] : getAttendanceReportCc_();
  if (!attMailConfigured_()) { // r53: attendance@ only — pause, never send from another address
    var why = apsMailProfile_('ATTENDANCE').notConfigured;
    if (opts.previewTo) throw new Error(why);
    out.paused = true; out.remaining = ids.filter(function (id) { return !state.sent[id]; }).length;
    logAttendanceSyncDiagnostic_('Weekly attendance report PAUSED: ' + why);
    attMailAlertAdmin_('weekly class attendance report', why);
    return out;
  }
  var audience = getAttendanceReportAudience_();
  var weekLabel = 'Week ' + weekNo + ' (' + getWeekLabel_(weekId).replace(/^Week of /, '') + ')';
  var sentThisRun = 0;

  for (var i = 0; i < ids.length; i++) {
    var id = ids[i];
    if (state.sent[id]) continue;
    if (opts.limit && sentThisRun >= opts.limit) break;
    if (Date.now() - startedMs > ATTENDANCE_REPORT_TIME_BUDGET_MS) break;
    var rows = byCourse[id];
    var course = coursesById[id] || { id: id, name: rows[0].className, teachers: [], students: [] };
    var teachers = (course.teachers || []).filter(function (t) { return t.email && !attIsExcludedEmail_(t.email); })
      .map(function (t) { return { name: t.name || t.email, email: normalizeEmail_(t.email) }; });
    if (!teachers.length) {
      rows.filter(function (r) { return r.role === ATTENDANCE_ROLE.TEACHER; }).forEach(function (r) { teachers.push({ name: r.personName || r.email, email: normalizeEmail_(r.email) }); });
    }
    var students = rows.filter(function (r) { return r.role === ATTENDANCE_ROLE.STUDENT; })
      .sort(function (a, b) { return String(a.personName).localeCompare(String(b.personName)) || String(a.date).localeCompare(String(b.date)); });
    if (!students.length) { out.skippedNoData++; state.sent[id] = 'no-students'; continue; }
    students.forEach(function (r) { r.overallPct = attOverallFor_(summaryMap, r); }); // r82: Re-Map safe
    var ctx = { className: course.name || rows[0].className, weekLabel: weekLabel, teachers: teachers, rows: rows, students: students };
    var subject = 'APS Weekly Class Attendance Report - ' + ctx.className + ' - ' + weekLabel;
    var teacherEmails = teachers.map(function (t) { return t.email; }).filter(isSyntacticallyValidEmail_);
    var studentEmails = [];
    students.forEach(function (r) { var e = normalizeEmail_(r.email); if (isSyntacticallyValidEmail_(e) && studentEmails.indexOf(e) === -1) studentEmails.push(e); });

    var messages = []; // [{to:[], cc:[], students:[rows]}]
    if (opts.previewTo) messages.push({ to: [opts.previewTo], cc: [], students: students });
    else if (audience === 'PRIVATE') {
      messages.push({ to: teacherEmails, cc: cc, students: students });
      studentEmails.forEach(function (e) { messages.push({ to: [e], cc: [], own: true, students: students.filter(function (r) { return normalizeEmail_(r.email) === e; }) }); });
    } else {
      messages.push({ to: teacherEmails.concat(studentEmails.filter(function (e) { return teacherEmails.indexOf(e) === -1; })), cc: cc, students: students });
    }
    messages = messages.filter(function (m) { return m.to.length; });
    var needed = messages.reduce(function (n, m) { return n + m.to.length + m.cc.length; }, 0);
    if (!opts.previewTo && attMailBudget_().remaining < needed) {
      out.quotaHit = true;
      logAttendanceSyncDiagnostic_('Weekly attendance report paused at "' + ctx.className + '": daily attendance@ email limit (ATTENDANCE_MAIL_DAILY_LIMIT) reached — the rest are sent on the next daily run.');
      break;
    }
    try {
      messages.forEach(function (m) {
        var built = attBuildAttendanceReportEmail_(ctx, m.students);
        attMailSend_({ to: m.to, cc: opts.previewTo || m.own ? [] : attMailCc_(m.cc, m.to), // PRIVATE per-student copies: no CC (admin@ already gets the full table)
          replyTo: teacherEmails.length ? teacherEmails.join(',') : apsMailFrom_('ATTENDANCE'),
          subject: subject, text: built.text, html: built.html });
      });
      if (!opts.previewTo) state.sent[id] = new Date().toISOString();
      out.sent++;
      sentThisRun++;
      if (!opts.previewTo) PropertiesService.getScriptProperties().setProperty(ATTENDANCE_REPORT_STATE_KEY, JSON.stringify(state)); // progress survives a timeout
    } catch (e) {
      logAttendanceSyncDiagnostic_('Weekly attendance report failed for "' + ctx.className + '": ' + ((e && e.message) ? e.message : String(e)));
      if (e && e.apsQuota) { out.quotaHit = true; break; }
      if (e && e.apsPaused) { // attendance@ cannot sign in — stop the batch, resume on the next run
        if (opts.previewTo) throw e;
        out.paused = true;
        attMailAlertAdmin_('weekly class attendance report', e.message);
        break;
      }
    }
  }
  out.remaining = ids.filter(function (id) { return !state.sent[id]; }).length;
  if (!opts.previewTo) {
    state.done = out.remaining === 0;
    logAttendanceSyncDiagnostic_('Weekly attendance report ' + weekLabel + ': ' + out.sent + ' classroom email(s) sent from ' + apsMailFrom_('ATTENDANCE') + ', ' + out.remaining + ' remaining' + (out.paused ? ' (PAUSED — attendance@ sign-in failed)' : '') + '.');
  }
  return out;
}

/** Builds the report (HTML in the standard APS template + plain-text alternative). */
function attBuildAttendanceReportEmail_(ctx, studentRows) {
  var esc = htmlEscape_;
  var teacherLine = ctx.teachers.length
    ? ctx.teachers.map(function (t) { return esc(t.name) + ' (<a href="mailto:' + esc(t.email) + '">' + esc(t.email) + '</a>)'; }).join(', ')
    : 'your class teacher (via the APS office)';
  var teacherText = ctx.teachers.length ? ctx.teachers.map(function (t) { return t.name + ' (' + t.email + ')'; }).join(', ') : 'your class teacher (via the APS office)';
  // Class call window per date (same for everyone in the class).
  var calls = {};
  ctx.rows.forEach(function (r) { if (!calls[r.date]) calls[r.date] = r; });
  var callLines = Object.keys(calls).sort().map(function (d) {
    var r = calls[d];
    return esc(d) + ' (' + esc(r.day || '') + '): ' + (Number(r.callMinutes) > 0 ? esc(r.callStart) + ' - ' + esc(r.callEnd) + ' EST — ' : 'no Google Meet call recorded — ') + esc(attClassMinutesLabel_(r));
  });
  var th = 'style="text-align:left;padding:6px 8px;border-bottom:2px solid #dadce0;font-size:12px;color:#5f6368;"';
  var td = 'style="padding:6px 8px;border-bottom:1px solid #eee;font-size:13px;"';
  var tableRows = studentRows.map(function (r, i) {
    var adjusted = r.overrideStatus ? ' <span style="font-size:11px;color:#5f6368;">(adjusted by teacher)</span>' : '';
    return '<tr><td ' + td + '>' + (i + 1) + '</td><td ' + td + '>' + esc(r.personName) + '<br><span style="font-size:11px;color:#5f6368;">' + esc(getAPSIdFromEmail(r.email)) + '</span></td><td ' + td + '>' + esc(r.date) + '</td><td ' + td + '>' +
      (r.firstJoin ? esc(r.firstJoin) + ' - ' + esc(r.lastLeave || '') : '<span style="color:#5f6368;">Did not join</span>') + '</td><td ' + td + '>' + esc(String(Number(r.activeMinutes) || 0)) + ' / ' + esc(String(Number(r.callMinutes) || 0)) + ' min</td><td ' + td + '>' +
      esc(String(r.attendedPct)) + '%</td><td ' + td + '><b>' + esc(String(attEffectiveScore_(r))) + '%</b></td><td ' + td + '>' + esc(r.status) + adjusted + '</td><td ' + td + '><b>' +
      (r.overallPct === null || r.overallPct === undefined ? '-' : esc(String(r.overallPct)) + '%') + '</b></td></tr>';
  }).join('');
  var html =
    '<h2 style="margin:0 0 6px;font-size:20px;">Weekly Class Attendance Report</h2>' +
    '<div style="font-size:14px;line-height:1.6;margin-bottom:14px;">' +
    '<b>Class:</b> ' + esc(ctx.className) + '<br><b>Week:</b> ' + esc(ctx.weekLabel) + '<br><b>Class Teacher:</b> ' + teacherLine + '</div>' +
    '<div style="font-size:13px;line-height:1.6;background:#f8f9fa;border-radius:8px;padding:10px 12px;margin-bottom:14px;"><b>Google Meet class</b> (teacher\'s first join to last leave):<br>' + callLines.join('<br>') + '</div>' +
    '<table style="border-collapse:collapse;width:100%;"><thead><tr><th ' + th + '>#</th><th ' + th + '>Student</th><th ' + th + '>Date</th><th ' + th + '>Joined - Left</th><th ' + th + '>Minutes</th><th ' + th + '>Attended</th><th ' + th + '>Week Score</th><th ' + th + '>Status</th><th ' + th + '>Overall (all weeks)</th></tr></thead><tbody>' + tableRows + '</tbody></table>' +
    '<div style="font-size:12px;color:#5f6368;line-height:1.6;margin-top:12px;"><b>How the score is calculated:</b> attended minutes / class minutes, where class minutes = the teacher\'s actual Meet time (first join to last leave) if under 90 minutes, otherwise 95 minutes (calculation maximum). Above 75% = 100, 60-75% = 90, 50-59% = 80, 40-49% = 70, 30-39% = 60, 20-29% = 50, below 20% = 0. ' +
    'Teacher adjustments: Present = 100, Partial = 70, Excused = 70, Absent = 0. Overall = all weeks, weighted by class call hours.</div>' +
    '<div style="font-size:14px;line-height:1.6;margin-top:16px;padding:12px;border-left:4px solid #1a73e8;background:#e8f0fe;border-radius:6px;">' +
    '<b>Need a change or correction?</b> Please contact your Class Teacher: ' + teacherLine + '.</div>';
  var text = 'APS Weekly Class Attendance Report\n\nClass: ' + ctx.className + '\nWeek: ' + ctx.weekLabel + '\nClass Teacher: ' + teacherText + '\n\n' +
    studentRows.map(function (r) { return r.personName + ' (' + getAPSIdFromEmail(r.email) + ') | ' + r.date + ' | ' + (Number(r.activeMinutes) || 0) + '/' + (Number(r.callMinutes) || 0) + ' min | attended ' + r.attendedPct + '% | week score ' + attEffectiveScore_(r) + '% | ' + r.status + ' | overall ' + (r.overallPct === null || r.overallPct === undefined ? '-' : r.overallPct + '%'); }).join('\n') +
    '\n\nNeed a change or correction? Please contact your Class Teacher: ' + teacherText + '.';
  return { html: apsEmailShell_('Weekly Class Attendance Report', html), text: text };
}

/**
 * One-time bootstrap (run manually from the Apps Script editor as the OWNER,
 * like createSyncTrigger() above). Idempotent — removes any previous
 * attendance triggers (including the old every-15-minutes one) first, then installs:
 *   - syncAttendanceForAllCourses   weekly, MONDAY ~5:00 AM America/New_York
 *   - sendWeeklyAttendanceReports   daily  ~7:00 AM America/New_York — it sends
 *     only on Monday (the weekly report); on Tue/Wed it only resumes a Monday
 *     batch that hit the daily email quota, otherwise it exits immediately.
 * Apps Script runs an atHour() trigger at a random minute inside that hour.
 */
function createAttendanceSyncTrigger() {
  apsRequireOwnerOrTrigger_(null); // r55: editor (script owner) only — not callable from the web app
  ScriptApp.getProjectTriggers().forEach(function (t) {
    var h = t.getHandlerFunction();
    if (h === 'syncAttendanceForAllCourses' || h === 'sendWeeklyAttendanceReports') ScriptApp.deleteTrigger(t);
  });
  ScriptApp.newTrigger('syncAttendanceForAllCourses')
    .timeBased().onWeekDay(ScriptApp.WeekDay.MONDAY).atHour(5).nearMinute(0).inTimezone(APS_TZ)
    .create();
  ScriptApp.newTrigger('sendWeeklyAttendanceReports')
    .timeBased().everyDays(1).atHour(7).nearMinute(0).inTimezone(APS_TZ)
    .create();
}

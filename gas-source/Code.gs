/** Keeps the one daily trigger in line with the Script Properties. Called from rosterEnsureTrigger_ (Admin visits, at most every 6 h). */
function ctaEnsureTrigger_() {
  try {
    var cfg = ctaConfig_();
    var mark = 'daily' + cfg.hour + 'h-' + cfg.tz;
    var props = PropertiesService.getScriptProperties();
    var mine = ScriptApp.getProjectTriggers().filter(function (t) { return t.getHandlerFunction() === CTA_HANDLER_; });
    if (cfg.enabled && mine.length === 1 && props.getProperty('CTA_EMAIL_TRIGGER_SPEC') === mark) return;
    if (!cfg.enabled && !mine.length) return;
    mine.forEach(function (t) { ScriptApp.deleteTrigger(t); });
    props.deleteProperty('CTA_EMAIL_TRIGGER_SPEC');
    if (!cfg.enabled) return;
    ScriptApp.newTrigger(CTA_HANDLER_).timeBased().everyDays(1).atHour(cfg.hour).nearMinute(0).inTimezone(cfg.tz).create();
    props.setProperty('CTA_EMAIL_TRIGGER_SPEC', mark);
    console.log('[TeacherAvailabilityEmail] trigger set: daily ' + cfg.hour + ':00 ' + cfg.tz + ' (sends Tue-Fri only)');
  } catch (e) { console.warn('[TeacherAvailabilityEmail] trigger check failed: ' + (e && e.message)); }
}


/* ---------- run ---------- */
function mhgRun_(now, trigger, by, opts) {
  opts = opts || {}; now = now || new Date();
  var cfg = mhgConfig_();
  if (!cfg.enabled && !opts.force) { console.log('[MissingGrading] switched OFF — nothing scanned'); return { skipped: 'OFF' }; }
  var lock = LockService.getScriptLock();
  if (!lock.tryLock(5000)) return { busy: true, message: 'The report is already running. Please try again in a few minutes.' };
  var run = { Run_ID: 'MHG-' + Utilities.formatDate(now, MHG_TZ_, 'yyyyMMdd-HHmmss') + '-' + Math.random().toString(36).slice(2, 6).toUpperCase(), Run_Date: mhgToday_(now), Started_At: Utilities.formatDate(now, MHG_TZ_, 'yyyy-MM-dd HH:mm:ss'), Trigger: trigger, Run_By: by || 'system', Result: 'RUNNING' };
  try {
    console.log('[MissingGrading] MISSING_HOMEWORK_GRADING_SCAN_START (' + trigger + ')');
    var scan = mhgCollect_(cfg, now);
    console.log('[MissingGrading] MISSING_HOMEWORK_GRADING_COURSE ' + scan.classes + ' class(es) with pending work');
    var stats = mhgUpdateLog_(scan, cfg, now);
    var kinds = { NOT_GRADED: 0, DRAFT_NOT_RETURNED: 0, GRADED_NOT_RETURNED: 0 }; scan.records.forEach(function (r) { kinds[r.kind]++; });
    Object.assign(run, { Classes: scan.classes, Assignments: scan.assignments, Submissions: scan.records.length, New_This_Week: stats.isNew, Cleared_Since_Last: stats.cleared,
      Not_Graded: kinds.NOT_GRADED, Draft_Not_Returned: kinds.DRAFT_NOT_RETURNED, Graded_Not_Returned: kinds.GRADED_NOT_RETURNED, Warnings: scan.warnings.join(' | ').slice(0, 2000) });
    if (scan.warnings.length) console.warn('[MissingGrading] scan warnings: ' + scan.warnings.length);
    if (!scan.records.length) {
      console.log('[MissingGrading] NO_MISSING_HOMEWORK_GRADING_FOUND');
      run.Email_Status = 'NONE'; run.Result = 'NO_MISSING_HOMEWORK_GRADING_FOUND';
      return { ok: true, found: 0, warnings: scan.warnings, email: 'NONE' };
    }
    console.log('[MissingGrading] MISSING_HOMEWORK_GRADING_FOUND ' + scan.records.length + ' submission(s)');
    var already = (typeof taReadTable_ === 'function' ? taReadTable_(MHG_RUNS_SHEET_, MHG_RUNS_HEADER_) : []).some(function (r) { return r.Run_Date === run.Run_Date && r.Email_Status === 'SENT'; });
    if (already && !opts.resend) { run.Email_Status = 'ALREADY_SENT_TODAY'; run.Result = 'COMPLETED'; return { ok: true, found: scan.records.length, email: 'ALREADY_SENT_TODAY' }; }
    var m = mhgEmail_(scan, stats, cfg, false);
    var att = scan.records.length > cfg.maxRowsInEmail ? [Utilities.newBlob(mhgCsv_(scan.records), 'text/csv', 'homework_pending_grading_' + scan.today + '.csv')] : [];
    var res;
    try { res = apsGmailSend_('TICKETS', { to: cfg.to, cc: cfg.cc, replyTo: attMailAdminCc_(), subject: m.subject, html: m.html, text: m.text, attachments: att }); }
    catch (eS) { res = { ok: false, error: saSafeErr_(eS) }; }
    run.Recipients = 'To ' + cfg.to.join(', ') + (cfg.cc.length ? ' · CC ' + cfg.cc.join(', ') : '');
    if (res && res.ok) { run.Email_Status = 'SENT'; run.Result = 'COMPLETED'; console.log('[MissingGrading] MISSING_HOMEWORK_GRADING_EMAIL_SENT'); }
    else { run.Email_Status = 'FAILED'; run.Result = 'EMAIL_FAILED'; run.Error = saSafeErr_(res && res.error || 'email failed'); console.error('[MissingGrading] MISSING_HOMEWORK_GRADING_ERROR email: ' + run.Error); }
    return { ok: run.Email_Status === 'SENT', found: scan.records.length, classes: scan.classes, warnings: scan.warnings, email: run.Email_Status, isNew: stats.isNew, cleared: stats.cleared };
  } catch (e) {
    run.Result = 'FAILED'; run.Error = srmSafeErr_(e);
    console.error('[MissingGrading] MISSING_HOMEWORK_GRADING_ERROR ' + run.Error);
    throw e;
  } finally {
    run.Finished_At = Utilities.formatDate(new Date(), MHG_TZ_, 'yyyy-MM-dd HH:mm:ss');
    try { taUpsert_(MHG_RUNS_SHEET_, MHG_RUNS_HEADER_, [run]); } catch (eL) { console.warn('[MissingGrading] run log not written: ' + srmSafeErr_(eL)); }
    lock.releaseLock();
  }
}


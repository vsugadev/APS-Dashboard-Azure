      var ti = String(x.ti || '').slice(0, 10); if (!/^\d{4}-\d{2}-\d{2}$/.test(ti)) return;
      var days = mhgDays_(ti, today); if (!(days > cfg.days)) return; // strictly more than N days
      var key = cid + '|' + w.id + '|' + (x.u || em); if (seen[key]) return; seen[key] = true;

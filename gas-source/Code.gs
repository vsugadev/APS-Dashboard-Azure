    log.appendRow(['RS-' + Utilities.formatDate(now, APS_TZ, 'yyyyMMdd-HHmmss'), ts, rosterTs_(new Date()), triggerType, runBy || 'system', summary.result,
      summary.activeClassrooms || 0, summary.teachersFound || 0, summary.studentsFound || 0, summary.studentEnrollments || 0, summary.newStudents || 0,
      summary.updatedStudents || 0, summary.removedInactive || 0, summary.newClassrooms || 0, summary.updatedClassrooms || 0,
      summary.classroomsProcessed || 0, summary.classroomsDeferred || 0, summary.errorCount, summary.duration, JSON.stringify(summary.errors).slice(0, 45000)]);
  } catch (e) { console.warn('[Roster] sync log write failed: ' + (e && e.message)); }
  if (written || summary.result !== 'FAILED') rosterInvalidate_(); // sheets changed -> readers must not keep the old cached copy
  var forProp = JSON.parse(JSON.stringify(summary));
  forProp.errors = (forProp.errors || []).slice(0, 25); // Script Property values are limited to 9 KB
  var propText = JSON.stringify(forProp);
  while (propText.length > 8500 && forProp.errors.length) { forProp.errors.pop(); propText = JSON.stringify(forProp); }
  props.setProperty('ROSTER_LAST_SYNC_JSON', propText);

        if (hasAccess(w.permission)) ev(w, 'CLASS_ACCESS_GRANTED'); else ev(w, 'CLASS_ACCESS_DENIED', { result: 'DENIED', error: 'not a Google Classroom teacher of this class' });
        if (w.source !== 'CLASSROOM' && w.member && !w.added) ev(w, 'CLASS_ACCESS_ALREADY_EXISTS');
      } else if (h.status !== 'ACTIVE') {
        ev(w, 'COURSE_ACCESS_MAPPING_UPDATED', { error: 'reactivated' });
        if (hasAccess(w.permission)) ev(w, 'CLASS_ACCESS_GRANTED');
      } else if (h.roles !== w.roles || h.classroomRole !== w.classroomRole || h.source !== w.source || h.permission !== w.permission || h.courseName !== w.courseName) {
        var note = h.source !== 'CLASSROOM' && w.source === 'CLASSROOM' ? ' | no longer named in the Description/Room but still a Google Classroom teacher — remove them in Classroom to end access' : '';
        ev(w, 'COURSE_ACCESS_MAPPING_UPDATED', { error: [h.roles + '>' + w.roles, h.classroomRole + '>' + w.classroomRole, h.source + '>' + w.source].join(' ') + note });
        if (!hasAccess(h.permission) && hasAccess(w.permission)) ev(w, 'CLASS_ACCESS_GRANTED');

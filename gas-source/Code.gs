  return isNaN(d.getTime()) || !/^\d{4}-\d{2}-\d{2}T/.test(String(v instanceof Date ? d.toISOString() : v)) ? String(v) : Utilities.formatDate(d, APS_TZ, 'MM/dd/yyyy h:mm a') + ' EST';
}
/** forHtml: Ticket Number / Priority / Status are already in the headline and badges, so the HTML table leaves them out (shorter on a phone). */
function tkEmailFacts_(event, t, parts, actor, forHtml) {
  var facts = [
    ['Ticket Number', t.Ticket_Number],
    ['Ticket Type', ((TK_TYPE_ICON_[t.Type] || '') + ' ' + tkTitleCase_(t.Type)).trim()],
    ['Subject', t.Subject],
    ['Priority', tkTitleCase_(t.Priority)],
    ['Status', tkTitleCase_(t.Status)],
    ['Raised By', t.Requester_Name || t.Requester_Email],
    ['Student', t.Student_Name ? t.Student_Name + (t.APSID ? ' (' + t.APSID + ')' : '') : ''],
    ['Google Classroom', t.Classroom],
    ['Primary Teacher', t.Primary_Teacher],
    ['Assigned To', tkAssigneeNames_(parts) || 'Not yet assigned'],
    ['Created', tkEmailWhen_(t.Created_At)]

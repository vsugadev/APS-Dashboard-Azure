function classSupportWriteMapping_(courses) {
  var events = CLASS_SUPPORT_SYNC_EVENTS_.splice(0);
  var exec = classSupportExecId_();
  CLASS_SUPPORT_EXEC_ID_ = '';
  try {
    var now = Utilities.formatDate(new Date(), APS_TZ, 'MM/dd/yyyy hh:mm:ss a');
    var want = {};
    var globalRole = function (e) { return isInEmailList_(e, ADMIN_EMAILS) || isInEmailList_(e, SUPERADMIN_EMAILS) ? 'ADMIN' : isInEmailList_(e, HEADMASTER_EMAILS) ? 'HM' : ''; };
    (courses || []).forEach(function (c) {
      var cid = String(c.id), named = {};
      (c.classSupport || []).forEach(function (s) {
        named[s.email] = true;
        var g = globalRole(s.email);
        var support = s.roles.indexOf('VP') > -1 || s.roles.indexOf('HM') > -1;
        var perm = g ? 'ALL_CLASSES' : s.member ? (support ? 'CLASS_SUPPORT' : 'CLASS_TEACHER')
          : s.roles.indexOf('PRIMARY_TEACHER') > -1 ? 'CLASS_TEACHER' : 'NONE (not a Classroom teacher)';
        want[s.email + '|' + cid] = { key: s.email + '|' + cid, email: s.email, roles: s.roles.join(' + '), primary: g || classRolesPrimary_(s.roles), courseId: cid, courseName: c.name || '',
          classroomRole: s.member ? 'TEACHER' : 'NONE', source: s.sources.join(' + '), permission: perm, member: s.member, added: s.added };
      });
      (c.teachers || []).forEach(function (t) {
        var e = normalizeEmail_(t.email);
        if (!e || named[e]) return;
        var g = globalRole(e);
        want[e + '|' + cid] = { key: e + '|' + cid, email: e, roles: 'TEACHER', primary: g || 'TEACHER', courseId: cid, courseName: c.name || '', classroomRole: 'TEACHER', source: 'CLASSROOM', permission: g ? 'ALL_CLASSES' : 'CLASS_TEACHER' };
      });
    });
    var sh = classAccessSheet_(CLASS_ACCESS_MAP_SHEET_, CLASS_ACCESS_MAP_HEADER_);
    var last = sh.getLastRow();
    var have = {}, order = [];
    if (last > 1) sh.getRange(2, 1, last - 1, CLASS_ACCESS_MAP_HEADER_.length).getValues().forEach(function (r) {
      var k = String(r[0] || ''); if (!k || have[k]) return;
      have[k] = { key: k, email: r[1], roles: r[2], primary: r[3], courseId: String(r[4]), courseName: r[5], classroomRole: r[6], source: r[7], permission: r[8], status: r[9], firstSeen: r[10], lastSynced: r[11] };
      order.push(k);

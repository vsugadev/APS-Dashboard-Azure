  });

  if (finalizedChanged) {
    // Keep only courses still in the cache so the property can never grow unbounded (~30 bytes/course).
    var live = {};
    courses.forEach(function (c) { if (finalized[String(c.id)]) live[String(c.id)] = finalized[String(c.id)]; });
    props.setProperty(ATTENDANCE_FINALIZED_PROP_KEY, JSON.stringify(live));
  }

  // 6) Full-refresh resume cursor.
  if (full) {
    if (summary.datesDeferred > 0 && fetchDates.length && !anySheetSkipped) {
      props.setProperty(ATTENDANCE_FULL_REFRESH_CURSOR_KEY, JSON.stringify({ through: fetchDates[fetchDates.length - 1], at: now.toISOString() }));
      summary.fullRefreshRemaining = summary.datesDeferred;
    } else if (!anySheetSkipped) {
      props.deleteProperty(ATTENDANCE_FULL_REFRESH_CURSOR_KEY);
    } else {
      summary.fullRefreshRemaining = summary.datesDeferred + 1;
    }
  }

  // 7) Overall % per student (Attendance_Summary) — rebuilt from every week sheet whenever something changed.
  if (summary.rowsWritten > 0 || !getAttendanceWorkbook_().getSheetByName(ATTENDANCE_SUMMARY_SHEET_NAME)) {
    try { rebuildAttendanceSummary_(); }
    catch (e) { logAttendanceSyncDiagnostic_('Attendance_Summary rebuild failed: ' + ((e && e.message) ? e.message : String(e))); }
  }

  props.setProperty(ATTENDANCE_SYNC_ERROR_KEY, summary.coursesFailed > 0 ? (summary.coursesFailed + ' course(s) failed this run — see getAttendanceSyncDiagnostics()') : '');
  summary.durationMs = Date.now() - startedMs;
  props.setProperty(ATTENDANCE_LAST_SYNC_SUMMARY_KEY, JSON.stringify(summary));
  return summary;
}

/** ---------------------------------------------------------------------
 *  OVERALL ATTENDANCE % (Attendance_Summary sheet)
 * ------------------------------------------------------------------- */
function getOrCreateAttendanceSummarySheet_() {
  var ss = getAttendanceWorkbook_();
  var sheet = ss.getSheetByName(ATTENDANCE_SUMMARY_SHEET_NAME);
  if (!sheet) {
    sheet = ss.insertSheet(ATTENDANCE_SUMMARY_SHEET_NAME);
    sheet.setFrozenRows(1);
  }
  ensureSheetHeader_(sheet, ATTENDANCE_SUMMARY_HEADER_ROW);
  return sheet;
}

function attSummaryKey_(courseId, email) { return String(courseId) + '|' + normalizeEmail_(email); }

function attSummaryOverall_(weightedSum, weightMinutes) {
  return weightMinutes > 0 ? Math.round((weightedSum / weightMinutes) * 10) / 10 : 0;
}

/**
 * Rebuilds Attendance_Summary from ALL week sheets (one batched read): per
 * classroom per person, weeks recorded, attended/call minutes, and overall %
 * = sum(effective week score x weight) / sum(weight), weight = call minutes
 * (see attRecordWeight_). Called by the sync only when rows changed.
 */
function rebuildAttendanceSummary_() {
  var names = attListWeekSheets_().map(function (w) { return w.name; });
  var bySheet = attReadRecordsForSheets_(names);
  var agg = {};
  var order = [];
  names.forEach(function (n) {
    (bySheet[n] || []).forEach(function (r) {
      if (attIsExcludedEmail_(r.email) || !r.courseId) return;
      var k = attSummaryKey_(r.courseId, r.email);
      var a = agg[k];
      if (!a) { a = agg[k] = { courseId: r.courseId, className: r.className, personName: r.personName, email: normalizeEmail_(r.email), role: r.role, weeks: 0, attended: 0, call: 0, wsum: 0, wmin: 0 }; order.push(k); }
      a.className = r.className || a.className; a.personName = r.personName || a.personName;
      var weight = attRecordWeight_(r);
      a.weeks++;
      a.attended += Number(r.activeMinutes) || 0;
      a.call += Number(r.callMinutes) || 0;
      a.wsum += attEffectiveScore_(r) * weight;
      a.wmin += weight;
    });
  });
  var stamp = Utilities.formatDate(new Date(), APS_TZ, 'MM/dd/yyyy h:mm a');
  var rows = order.map(function (k) { return agg[k]; })
    .sort(function (x, y) { return String(x.className).localeCompare(String(y.className)) || String(y.role).localeCompare(String(x.role)) || String(x.personName).localeCompare(String(y.personName)); })
    .map(function (a) { return [a.courseId, a.className, a.personName, a.email, a.role, a.weeks, a.attended, a.call, a.wsum, a.wmin, attSummaryOverall_(a.wsum, a.wmin), stamp].map(String); });
  var lock = LockService.getScriptLock();
  lock.waitLock(20000);
  try {
    var sheet = getOrCreateAttendanceSummarySheet_();
    var oldRows = Math.max(0, sheet.getLastRow() - 1);
    if (rows.length) attWriteTextRows_(sheet, 2, rows);
    if (oldRows > rows.length) sheet.getRange(2 + rows.length, 1, oldRows - rows.length, ATTENDANCE_SUMMARY_HEADER_ROW.length).clearContent();
  } finally {
    lock.releaseLock();
  }
  return rows.length;
}

/**
 * { 'courseId|email': { overallPct, weeks, attended, call, rowIndex, wsum, wmin } } — one range read.
 * r82: plus one STUDENT entry per person across ALL classrooms, key attStudentOverallKey_(email) — the same
 * weighted sums added together, so a re-mapped student's Overall keeps every week of every class attended.
 */
function readAttendanceSummaryMap_() {
  var sheet = getAttendanceWorkbook_().getSheetByName(ATTENDANCE_SUMMARY_SHEET_NAME);
  var map = {};
  if (!sheet || sheet.getLastRow() < 2) return map;
  sheet.getRange(2, 1, sheet.getLastRow() - 1, ATTENDANCE_SUMMARY_HEADER_ROW.length).getValues().forEach(function (row, i) {
    if (!row[0] || !row[3]) return;
    var e = map[attSummaryKey_(row[0], row[3])] = {
      weeks: Number(row[5]) || 0, attended: Number(row[6]) || 0, call: Number(row[7]) || 0,
      wsum: Number(row[8]) || 0, wmin: Number(row[9]) || 0, overallPct: Number(row[10]) || 0, rowIndex: i + 2
    };
    if (String(row[4]) !== ATTENDANCE_ROLE.STUDENT) return; // teachers keep the per-classroom figure (they teach several classes at once)
    var k = attStudentOverallKey_(row[3]), t = map[k] || (map[k] = { weeks: 0, attended: 0, call: 0, wsum: 0, wmin: 0, overallPct: 0, classes: 0 });
    t.weeks += e.weeks; t.attended += e.attended; t.call += e.call; t.wsum += e.wsum; t.wmin += e.wmin; t.classes++;
    t.overallPct = attSummaryOverall_(t.wsum, t.wmin);
  });
  return map;
}
/** r82: key of a student's all-classroom Overall (identity = APS email; never a Summary sheet row). */
function attStudentOverallKey_(email) { return '*STUDENT*|' + normalizeEmail_(email); }
/**
 * r82: Overall % for one attendance record. STUDENT → cumulative across every classroom the student attended
 * (survives Re-Map / class / grade changes); anyone else → that classroom, exactly as before.
 */
function attOverallFor_(summaryMap, r) {
  var sm = r.role === ATTENDANCE_ROLE.STUDENT ? summaryMap[attStudentOverallKey_(r.email)] : null;
  if (!sm) sm = summaryMap[attSummaryKey_(r.courseId, r.email)];
  return sm ? sm.overallPct : null;
}

/**
 * O(1) summary update after an override (no re-read of every week): adjusts
 * the person's weighted sum/weight by the difference between the record's
 * effective score/weight before and after. Caller holds the script lock.
 * If the person has no summary row yet, the next sync's rebuild adds it.
 */
function attApplyOverrideToSummary_(before, after, memo) {
  // r100: optional memo { sheet, map } — a caller adjusting several rows (Apply Leave) reads the summary once, not per row
  var sheet = memo && memo.sheet !== undefined ? memo.sheet : getAttendanceWorkbook_().getSheetByName(ATTENDANCE_SUMMARY_SHEET_NAME);
  if (memo && memo.sheet === undefined) memo.sheet = sheet;
  if (!sheet) return;
  var map = memo ? (memo.map || (memo.map = readAttendanceSummaryMap_())) : readAttendanceSummaryMap_();
  var entry = map[attSummaryKey_(after.courseId, after.email)];
  if (!entry) return;
  var wsum = entry.wsum - attEffectiveScore_(before) * attRecordWeight_(before) + attEffectiveScore_(after) * attRecordWeight_(after);
  var wmin = entry.wmin - attRecordWeight_(before) + attRecordWeight_(after);
  var seg = [String(wsum), String(wmin), String(attSummaryOverall_(wsum, wmin)), Utilities.formatDate(new Date(), APS_TZ, 'MM/dd/yyyy h:mm a')];
  if (memo) { entry.wsum = wsum; entry.wmin = wmin; } // keep the memo in step for the next row of the same student
  var range = sheet.getRange(entry.rowIndex, 9, 1, seg.length);
  range.setNumberFormat('@');
  range.setValues([seg]);
}

/**
 * ONE-TIME migration from the old one-sheet-per-CLASSROOM layout
 * (Course_AWK_Map: course -> AWKnnATT) to one-sheet-per-WEEK. The legacy
 * sheets use the same AWKnnATT names, so each is first renamed to
 * 'OLD_AWKnnATT' (kept forever as an untouched backup, never deleted),
 * then its rows are copied into the matching week sheet(s) — preserving any
 * overrides — before the regular capture refreshes them from Meet. Runs
 * under the script lock; guarded by ATTENDANCE_LAYOUT_PROP_KEY so it never
 * runs twice. Rows dated before Week 1 stay only in the backup.
 */
function migrateAttendanceToWeekSheets_(week1) {
  var props = PropertiesService.getScriptProperties();
  if (props.getProperty(ATTENDANCE_LAYOUT_PROP_KEY) === 'weekly') return null;
  var grouped = {};
  var renamed = [];
  var lock = LockService.getScriptLock();
  lock.waitLock(30000);
  try {
    if (props.getProperty(ATTENDANCE_LAYOUT_PROP_KEY) === 'weekly') return null; // another run finished it while we waited
    var ss = getAttendanceWorkbook_();
    var map = readCourseAwkMap_();
    var legacyNames = {};
    Object.keys(map).forEach(function (id) { legacyNames[map[id]] = true; });
    Object.keys(legacyNames).forEach(function (name) {
      var sheet = ss.getSheetByName(name);
      if (!sheet) return;
      attReadSheetRecords_(sheet).forEach(function (r) {
        var target = attWeekSheetNameForDate_(r.date, week1);
        if (!target || !r.courseId || !r.email) return;
        r.weekNo = attWeekNumberForWeekId_(attWeekIdForDateStr_(r.date), week1);
        (grouped[target] = grouped[target] || []).push(r);
      });
      var backupName = ATTENDANCE_LEGACY_SHEET_PREFIX_ + name;
      for (var i = 2; ss.getSheetByName(backupName); i++) backupName = ATTENDANCE_LEGACY_SHEET_PREFIX_ + name + '_' + i;
      sheet.setName(backupName);
      renamed.push(name + ' -> ' + backupName);
    });
    props.setProperty(ATTENDANCE_LAYOUT_PROP_KEY, 'weekly');
  } finally {
    lock.releaseLock();
  }
  var copied = 0;
  Object.keys(grouped).sort().forEach(function (target) {
    try { copied += upsertAttendanceRecordsForWeekSheet_(target, grouped[target]); }
    catch (e) { logAttendanceSyncDiagnostic_('Week-sheet migration: could not copy rows into ' + target + ' (they remain in the OLD_ backup): ' + ((e && e.message) ? e.message : String(e))); }
  });
  if (renamed.length) logAttendanceSyncDiagnostic_('Migrated to one AWK sheet per week: ' + renamed.length + ' classroom sheet(s) kept as OLD_ backups, ' + copied + ' row(s) copied into week sheets.');
  return { renamed: renamed, copied: copied };
}

/** Admin/HM-only manual trigger — the "Sync Attendance Now" button. */
function forceSyncAttendanceNow(sessionToken) {
  apsRequireTabForToken_(sessionToken, 'attendance'); // r56: Admin Control → Access Control

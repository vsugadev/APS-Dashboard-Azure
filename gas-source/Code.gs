    try { PropertiesService.getScriptProperties().setProperty(CLASS_MEET_LIVE_DIAGNOSTIC_KEY, JSON.stringify(diag)); } catch (eD) { /* diagnostics only */ }
    return out;
  } catch (e) {
    diag.error = String(e && e.message || e);
    console.warn('[Class Meet Live] ' + diag.error);
    try { PropertiesService.getScriptProperties().setProperty(CLASS_MEET_LIVE_DIAGNOSTIC_KEY, JSON.stringify(diag)); } catch (eD2) { /* diagnostics only */ }

/** ---------------------------------------------------------------------
 *  Retry/backoff wrapper for any Classroom API call.
 *  Retries on quota / rate-limit / transient backend errors only.
 * ------------------------------------------------------------------- */
function callWithBackoff_(fn) {
  var maxRetries = 6;
  var delay = 1000; // start at 1s, doubles each retry
  for (var i = 0; i < maxRetries; i++) {
    try {
      return fn();
    } catch (e) {
      var msg = (e && e.message) ? e.message : String(e);
      var isRetryable = /Quota exceeded|Rate Limit|rateLimitExceeded|userRateLimitExceeded|backendError|500|503/i.test(msg);
      if (!isRetryable || i === maxRetries - 1) throw e;
      Utilities.sleep(delay + Math.floor(Math.random() * 400));
      delay *= 2;
    }
  }
}
/** ---------------------------------------------------------------------
 *  SYNC JOB — the only place that talks to the Classroom API.
 *  Run manually once to test, then schedule with createSyncTrigger().
 * ------------------------------------------------------------------- */
/** Editor / own legacy trigger only (r55) — the dashboard's Force Sync and the daily 5 PM job call syncClassroomData_(). */
function syncClassroomData(e) {
  apsRequireOwnerOrTrigger_(e, 'syncClassroomData');
  return syncClassroomData_();
}
function syncClassroomData_() {
  try {
    var liveMap = getLiveMap_();
    var teacherNotInClassMap = getTeacherNotInClassMap_();
    var needsTechSupportMap = getNeedsTechSupportMap_();
    var classStatusOverrideMap = getClassStatusOverrideMap_(); // manual Cancel/Reschedule overrides — snapshotted into the Sheet only, see buildCourseRecord_
    var meetPresence = AUTO_LIVE_DETECTION ? getMeetPresenceMap_() : {};
    var classroomActivity = AUTO_CLASSROOM_PRESENCE_DETECTION ? getClassroomActivityMap_() : {};
    var courses = [];
    var onCallTeachers = {};
    var pageToken;

    do {
      var pt = pageToken;
      var resp = callWithBackoff_(function () {
        return Classroom.Courses.list({ courseStates: ['ACTIVE'], pageToken: pt, pageSize: 100 });
      });
      (resp.courses || []).forEach(function (course) {
        if (!courseNameMatches_(course.name)) return; // skip courses that don't end with COURSE_NAME_SUFFIX
        var courseRecord = buildCourseRecord_(course, liveMap, meetPresence, teacherNotInClassMap, needsTechSupportMap, classroomActivity, classStatusOverrideMap);
        courses.push(courseRecord);
        (courseRecord.onCallTeacherCandidates || []).forEach(function (teacher) {
          onCallTeachers[normalizeEmail_(teacher.email)] = teacher;
        });
        // r47: keep this class's on-call (TCS_ / TTS_ …) Classroom teachers in the cache as a slim, server-only list so
        // the Attendance sync (attRosterTeachers_) captures them as ROSTERED teachers of the class. Previously the
        // candidates were deleted here, so a non-Primary TCS_ / TTS_ teacher was only ever caught as a Meet guest.
        courseRecord.onCallRoster = (courseRecord.onCallTeacherCandidates || []).map(function (t) { return { name: t.name, email: t.email }; });
        delete courseRecord.onCallTeacherCandidates;
        Utilities.sleep(SYNC_THROTTLE_MS); // spread requests out to stay under per-minute quota
      });
      pageToken = resp.nextPageToken;
    } while (pageToken);

    writeCache_(courses);
    classSupportWriteMapping_(courses); // Class_Access_Map + Class_Access_Audit (own try/catch — never fails the sync)
    PropertiesService.getScriptProperties().setProperty(ON_CALL_TEACHERS_PROP_KEY, JSON.stringify(Object.keys(onCallTeachers).map(function (email) {
      return onCallTeachers[email];
    })));
    updateExternalActivityRealtimeCache_(meetPresence, classroomActivity);
    var props = PropertiesService.getScriptProperties();
    props.setProperty(LAST_SYNC_KEY, new Date().toISOString());
    props.deleteProperty(LAST_SYNC_ERROR_KEY); // clear any previous error now that it succeeded
    return courses.length;
  } catch (e) {
    var msg = (e && e.message) ? e.message : String(e);
    PropertiesService.getScriptProperties().setProperty(LAST_SYNC_ERROR_KEY, msg);
    throw e; // still surfaces in the Apps Script Executions log / trigger failure emails
  }
}

/** Returns the last sync error message, or null if the last sync succeeded. */

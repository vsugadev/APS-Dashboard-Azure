  return pre + '<div style="font-family:Arial,sans-serif;background:#f6f8fc;padding:24px;color:#202124;">' +
    '<div style="max-width:680px;margin:0 auto;background:#fff;border:1px solid #e0e0e0;border-radius:12px;overflow:hidden;">' +
    '<div style="padding:18px 22px;border-bottom:1px solid #e0e0e0;display:flex;align-items:center;gap:12px;">' +
    '<img src="' + APS_SCHOOL_LOGO_URL + '" alt="Avvaiyar Padasalai" style="height:54px;width:54px;object-fit:contain;border-radius:8px;">' +
    '<div><div style="font-size:18px;font-weight:700;">Avvaiyar Padasalai</div><div style="font-size:12px;color:#5f6368;">Classroom Dashboard</div></div></div>' +
    '<div style="padding:22px;">' + bodyHtml +
    '<div style="margin:24px 0;text-align:center;"><a href="' + htmlEscape_(buttonUrl) + '" style="display:inline-block;background:#1a73e8;color:#fff;text-decoration:none;padding:11px 20px;border-radius:8px;font-weight:700;">' + htmlEscape_(buttonLabel) + '</a></div>' +
    (opts.googleReview ? getGoogleReviewEmailFooter() : '') +
    '</div><div style="padding:16px 22px;border-top:1px solid #e0e0e0;font-size:12px;color:#5f6368;line-height:1.5;">' +
    '<b>Sugadev Velayutham</b> - Director of Technology and Public Relations<br>www.avvaiyarpadasalai.org<br><br>This is an auto-generated email. Please do not respond to this email; we will not monitor this email.</div>' +
    '</div></div>';
}

function sendApsHtmlEmail_(options) {
  var params = { to: options.to, subject: options.subject, htmlBody: options.htmlBody, body: options.body || 'Please view this message in an HTML-capable email client.' };
  if (options.cc) params.cc = options.cc;
  if (options.bcc) params.bcc = options.bcc;
  apsMailAppSend_(params); // r63: TEST guard
}

function notifyStaff_(subject, body) {
  try {
    var recipients = ADMIN_EMAILS.filter(function (e) { return e && e.indexOf('@') > -1; }).join(',');
    if (!recipients) return;
    var bodyHtml = apsEmailShell_('<b>' + htmlEscape_(subject) + '</b>', '<h2 style="margin-top:0;">' + htmlEscape_(subject) + '</h2><div style="white-space:pre-wrap;line-height:1.5;">' + htmlEscape_(body) + '</div>');
    sendApsHtmlEmail_({ to: recipients, subject: subject, body: body, htmlBody: bodyHtml });
  } catch (e) { /* best effort */ }
}

function gtrEmailHtml_(request, message) {
  // Keep APS Class/Grade Change emails concise. Do not append the legacy
  // gtrEmailBody_() text after these same request fields; that was the source
  // of the duplicated request details in notification emails.
  var status = request.requestStatus || '';
  var waiting = /PENDING|REQUEST SUBMITTED|AWAITING FINAL APPROVAL/.test(status);

  var lines = [
    '<p style="margin-top:0;font-size:18px;"><b>APS Class/Grade Change Request</b></p>',
    waiting ? '<div style="padding:12px;background:#e8f0fe;border-left:4px solid #1a73e8;border-radius:6px;margin-bottom:16px;"><b>Waiting for Approval</b></div>' : '',
    '<table style="width:100%;border-collapse:collapse;line-height:1.55;">',
    '<tr><td style="padding:4px 10px 4px 0;width:145px;"><b>Request ID</b></td><td style="padding:4px 0;">' + htmlEscape_(request.requestId) + '</td></tr>',
    '<tr><td style="padding:4px 10px 4px 0;"><b>Type</b></td><td style="padding:4px 0;">' + htmlEscape_(request.requestType) + '</td></tr>',
    '<tr><td style="padding:4px 10px 4px 0;"><b>Student</b></td><td style="padding:4px 0;">' + htmlEscape_(request.studentName) + ' (' + htmlEscape_(request.apsId) + ')</td></tr>',
    '<tr><td style="padding:4px 10px 4px 0;"><b>Student APS Email</b></td><td style="padding:4px 0;">' + htmlEscape_(request.studentEmail) + '</td></tr>',
    '<tr><td style="padding:4px 10px 4px 0;vertical-align:top;"><b>Current Class</b></td><td style="padding:4px 0;">' + htmlEscape_(request.currentGrade) + ' — ' + htmlEscape_(request.currentClassroom) + ' — ' + htmlEscape_(appendEstLabel_(request.currentClassTiming)) + '</td></tr>',
    '<tr><td style="padding:4px 10px 4px 0;vertical-align:top;"><b>Requested Class</b></td><td style="padding:4px 0;">' + htmlEscape_(request.requestedGrade) + ' — ' + htmlEscape_(request.requestedClassroom || '(not yet resolved)') + ' — ' + htmlEscape_(appendEstLabel_(request.requestedClassTiming)) + '</td></tr>',
    '<tr><td style="padding:4px 10px 4px 0;"><b>Status</b></td><td style="padding:4px 0;">' + htmlEscape_(status) + '</td></tr>',
    '</table>',
    '<div style="margin-top:16px;padding:12px;background:#f8f9fa;border-radius:8px;"><b>Reason / Comments</b><br>' +
      htmlEscape_(request.reasonComments || '(none)').replace(/\n/g, '<br>') +
    '</div>',
    '<p style="margin-bottom:0;"><b>Approver:</b> ' + htmlEscape_(request.approverEmail || '(pending)') + '</p>',
    '<p style="margin-top:6px;"><b>Final Approver:</b> ' + htmlEscape_(request.finalApproverEmail || '(pending)') + '</p>'
  ].join('');

  return apsEmailShell_('APS Class/Grade Change', lines);
}

function notifyGtrApprovers_(subject, body, request) {
  try {
    var recipients = GRADE_CHANGE_APPROVER_EMAILS.filter(function (e) { return e && e.indexOf('@') > -1; }).join(',');
    if (!recipients) return;
    var req = request || { requestStatus: '', requestId: '', requestType: '', studentName: '', apsId: '', studentEmail: '', parentEmail: '', currentGrade: '', currentClassroom: '', currentClassTiming: '', requestedGrade: '', requestedClassroom: '', requestedClassTiming: '', reasonComments: '', approverEmail: '', approverComments: '', finalApproverEmail: '', finalApproverComments: '' };
    sendApsHtmlEmail_({ to: recipients, subject: 'APS Class/Grade Change: ' + subject, body: body, htmlBody: gtrEmailHtml_(req, body) });
  } catch (e) { /* best-effort */ }
}

function notifyGtrStudent_(request, message) {
  try {
    var studentEmail = (request.studentEmail || '').trim();
    if (!studentEmail || !isSyntacticallyValidEmail_(studentEmail)) return;
    sendApsHtmlEmail_({
      to: studentEmail,
      subject: 'APS Class/Grade Change Request ' + request.requestId,
      body: message,
      htmlBody: gtrEmailHtml_(request, message)
    });
  } catch (e) { /* best-effort */ }
}

function gtrEmailBody_(request) {
  return [
    'APS Class/Grade Change Request',
    '',
    (/PENDING|REQUEST SUBMITTED|AWAITING FINAL APPROVAL/.test(request.requestStatus || '') ? 'Waiting for Approval' : ''),
    'Request ID: ' + request.requestId,
    'Type: ' + request.requestType,
    'Student: ' + request.studentName + ' (' + request.apsId + ')',
    'Student APS Email: ' + request.studentEmail,
    '',
    'Current Class: ' + request.currentGrade + ' — ' + request.currentClassroom + ' — ' + appendEstLabel_(request.currentClassTiming),
    'Requested Class: ' + request.requestedGrade + ' — ' + (request.requestedClassroom || '(not yet resolved)') + ' — ' + appendEstLabel_(request.requestedClassTiming),
    'Status: ' + request.requestStatus,
    '',
    'Reason / Comments: ' + (request.reasonComments || '(none)'),
    'Approver: ' + (request.approverEmail || '(pending)'),
    'Final Approver: ' + (request.finalApproverEmail || '(pending)'),
    '',
    'Open the APS Dashboard to view/manage this request.'
  ].filter(function (line, index, arr) {
    // Remove the empty waiting-status line when the request is not waiting.
    return !(index === 2 && line === '');
  }).join('\n');
}



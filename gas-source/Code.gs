function appreciationXmlEscape_(v) {
  return String(v == null ? '' : v).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;').replace(/'/g, '&apos;');
}
/**
 * r41 — merge for templates whose placeholders live in text boxes / drawings (Google Docs exposes those to
 * neither DocumentApp nor the Docs API). Read-only export of the master template as .docx (Drive API) →
 * replace the placeholders in word/*.xml (values XML-escaped; each placeholder must be found and none may
 * remain) → upload as a TEMPORARY Google Doc (Drive conversion) → PDF → the temporary Doc is trashed.
 * The master template itself is never modified. Uses the existing drive + script.external_request scopes.
 */
function appreciationPdfViaDocx_(baseName, values) {
  var token = ScriptApp.getOAuthToken();
  var auth = { Authorization: 'Bearer ' + token };
  var exp = UrlFetchApp.fetch('https://www.googleapis.com/drive/v3/files/' + encodeURIComponent(APPRECIATION_CERTIFICATE_TEMPLATE_ID) +
    '/export?mimeType=' + encodeURIComponent(MimeType.MICROSOFT_WORD), { headers: auth, muteHttpExceptions: true });
  if (exp.getResponseCode() !== 200) throw new Error('docx export failed: HTTP ' + exp.getResponseCode());
  var parts = Utilities.unzip(exp.getBlob().setContentType('application/zip'));
  var found = {};
  var merged = parts.map(function (part) {
    var name = part.getName();
    if (!/^word\/.*\.xml$/.test(name)) return part;
    var xml = part.getDataAsString('UTF-8');
    if (xml.indexOf('{{') === -1) return part;
    Object.keys(values).forEach(function (ph) {
      if (xml.indexOf(ph) > -1) { found[ph] = true; xml = xml.split(ph).join(appreciationXmlEscape_(values[ph])); }
    });
    var left = APPRECIATION_PLACEHOLDERS_.filter(function (ph) { return xml.indexOf(ph) > -1; });
    if (left.length) throw new Error('unresolved placeholders in ' + name + ': ' + left.join(', '));
    return Utilities.newBlob(xml, 'application/xml', name);
  });
  var missing = APPRECIATION_PLACEHOLDERS_.filter(function (ph) { return !found[ph]; });
  if (missing.length) throw new Error('placeholders not found in the template (they may be split by formatting): ' + missing.join(', '));
  var docx = Utilities.zip(merged, baseName + '.docx');
  var boundary = 'apsappr' + Utilities.getUuid().replace(/-/g, '');
  var meta = JSON.stringify({ name: baseName, mimeType: 'application/vnd.google-apps.document' });
  var payload = Utilities.newBlob('--' + boundary + '\r\nContent-Type: application/json; charset=UTF-8\r\n\r\n' + meta + '\r\n--' + boundary +
      '\r\nContent-Type: ' + MimeType.MICROSOFT_WORD + '\r\n\r\n').getBytes()
    .concat(docx.getBytes())
    .concat(Utilities.newBlob('\r\n--' + boundary + '--').getBytes());
  var up = UrlFetchApp.fetch('https://www.googleapis.com/upload/drive/v3/files?uploadType=multipart&fields=id', {
    method: 'post', contentType: 'multipart/related; boundary=' + boundary, payload: payload, headers: auth, muteHttpExceptions: true });
  if (up.getResponseCode() !== 200) throw new Error('temporary Doc upload failed: HTTP ' + up.getResponseCode());
  var tempId = JSON.parse(up.getContentText()).id;
  try {
    return DriveApp.getFileById(tempId).getAs(MimeType.PDF);
  } finally {
    try { DriveApp.getFileById(tempId).setTrashed(true); } catch (eT) { /* best-effort cleanup */ }
  }
}

/** Replaces every placeholder in body, headers and footers of an OPENED COPY; returns the placeholders still present (should be none). */
function appreciationFillDoc_(doc, values) {
  var parts = [doc.getBody(), doc.getHeader(), doc.getFooter()].filter(Boolean);
  parts.forEach(function (part) {
    Object.keys(values).forEach(function (ph) {
      part.replaceText(ph.replace(/[{}]/g, '\\$&'), docReplacementSafe_(values[ph]));
    });
  });
  var text = parts.map(function (p) { return p.getText(); }).join('\n');
  return APPRECIATION_PLACEHOLDERS_.filter(function (ph) { return text.indexOf(ph) > -1; });
}

/**

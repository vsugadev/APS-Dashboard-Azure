function gradesCategory_(title) {
  var t = String(title || '').trim().toUpperCase();
  for (var i = 0; i < GRADES_CATEGORY_PREFIXES_.length; i++) if (t.indexOf(GRADES_CATEGORY_PREFIXES_[i][0]) === 0) return GRADES_CATEGORY_PREFIXES_[i][1];

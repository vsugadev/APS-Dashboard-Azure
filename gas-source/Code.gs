/** Saves one user-submitted idea. Name/email/timestamp are NEVER taken from the client. */
function submitUserIdea(sessionToken, idea) {
  var user = getAuthenticatedAPSUser(sessionToken);
  if (!user.authenticated) {
    throw new Error('Unauthorized');
  }

  var trimmed = (idea || '').toString().trim();
  if (!trimmed) {
    throw new Error('Please enter your idea or suggestion.');
  }

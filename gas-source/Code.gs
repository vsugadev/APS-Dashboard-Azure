/**
 * Called (fire-and-forget) when someone presses "Join to Google Meet" on a class card. Records a
 * real-time "joined" signal for that class's CURRENT occurrence — only for the class's own teacher
 * or student (never admin / HM / support accounts), only inside the class window. Session-verified:
 * the email always comes from the server session, never from the browser.
 */
function recordMeetJoinClick(sessionToken, courseId) {
  var session = requireValidSession_(sessionToken);
  var course = readAllCoursesFromCache_().filter(function (c) { return String(c.id) === String(courseId); })[0];
  if (!course) return { recorded: false };
  var role = classMeetRoleOf_(course, session.email);
  if (!role) return { recorded: false };
  var now = new Date();
  var occ = classMeetOccurrence_(parseCourseSchedule_(course.name), now);
  if (!occ || now.getTime() < occ.winStartMs || now.getTime() > occ.hardStopMs) return { recorded: false };
  var lock = LockService.getScriptLock();
  if (!lock.tryLock(3000)) return { recorded: false };
  try {
    var cache = CacheService.getScriptCache();
    var key = CLASS_MEET_JOIN_CACHE_PREFIX_ + course.id;
    var list = (classMeetJsonGet_(cache, key) || []).filter(function (x) { return x && x.o === occ.startIso; });
    var email = normalizeEmail_(session.email);
    var existing = list.filter(function (x) { return x.e === email; })[0];
    if (existing) existing.at = now.getTime(); else list.push({ e: email, r: role, at: now.getTime(), o: occ.startIso });
    cache.put(key, JSON.stringify(list.slice(-300)), 21600);
  } finally { lock.releaseLock(); }

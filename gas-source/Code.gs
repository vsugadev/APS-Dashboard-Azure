var REFERENCE_LETTER_PDF_ARCHIVE_FOLDER_ID = getConfigString_('REFERENCE_LETTER_PDF_ARCHIVE_FOLDER_ID', '');

var REFERENCE_LETTER_MIN_REASON_WORDS = 20;
var REFERENCE_LETTER_MAX_REASON_WORDS = 150;

// Isolated status vocabulary — never reuses GTR_STATUS.

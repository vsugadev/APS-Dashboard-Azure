/** Lets a Student cancel their OWN request while it's still awaiting Stage 1 — not available once Stage 1 has already acted. */
function cancelMyClassChangeRequest(sessionToken, requestId) {
  apsRequireTabForToken_(sessionToken, 'classChange'); // r56: Admin Control → Access Control
  var session = requireValidSession_(sessionToken);
  var email = session.email;
  var lock = LockService.getScriptLock();
  try { lock.waitLock(10000); } catch (e) { /* proceed best-effort */ }
  try {
    var request = findGtrRequestById_(requestId);
    if (!request) throw new Error('Request not found.');
    if (normalizeEmail_(request.studentEmail) !== email) throw new Error('You can only cancel your own request.');
    var cancellable = [GTR_STATUS.REQUEST_SUBMITTED, GTR_STATUS.PENDING_GRADE_APPROVAL];
    if (cancellable.indexOf(request.requestStatus) === -1) {
      throw new Error('This request can no longer be cancelled (current status: ' + request.requestStatus + ').');
    }
    request.requestStatus = GTR_STATUS.CANCELLED;
    request.processedDateTime = new Date().toISOString();
    request.processedBy = email;
    writeGtrRequestRow_(request._row, request);
    notifyGtrApprovers_('Request cancelled by student (' + requestId + ')', gtrEmailBody_(request), request);
    return request;
  } finally {
    try { lock.releaseLock(); } catch (e) { /* best-effort */ }
  }
}


/* ----------------------------- security ----------------------------- */
/**
 * Who is looking, and at whose journey — decided on the server from the session, never from the browser.
 *  - student: always their OWN journey (any student / email parameter is ignored).
 *  - r75 Admin / Super Admin: READ-ONLY view of one student they choose (opts.studentEmail must be a student of an
 *    active class); every look-up is written to TAMIL_THADAM_VIEW_AUDIT. Nothing can be changed by anyone.
 *  - every other role (HM, Teacher, VP, BOD, authorized): refused.
 */
function tdViewer_(sessionToken, opts) {
  var s = requireValidSession_(sessionToken), me = normalizeEmail_(s.email);
  if (s.role === 'student') { apsRequireTabForToken_(sessionToken, 'tamilThadam'); return { email: me, admin: false }; }
  if (!isAdminRole_(s.role)) throw new Error('Tamil Thadam is available to students (and to APS Admin for read-only support) only.');
  apsRequireTabForToken_(sessionToken, 'tamilThadam');
  var target = normalizeEmail_(opts && opts.studentEmail);
  if (!target) throw new Error('Choose a student to view.');
  var isStudent = readAllCoursesFromCache_().some(function (c) { return courseNameMatches_(c.name) && courseHasStudentEmail_(c, target); });
  if (!isStudent) throw new Error('That person is not a student of an active class.');
  return { email: target, admin: true, by: me, role: s.role };
}
function tdViewAudit_(v, ay) {

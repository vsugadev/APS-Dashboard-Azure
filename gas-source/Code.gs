}

/** Admin/HM/SuperAdmin-only: the attendance edit audit log, most recent first, optionally filtered to one course. Capped to the most recent 500 entries on READ only for UI responsiveness — the underlying sheet itself keeps every entry ever recorded, forever. */
function getAttendanceAuditLog(sessionToken, filters) {
  apsRequireTabForToken_(sessionToken, 'attendance'); // r56: Admin Control → Access Control
  var session = requireValidSession_(sessionToken);
  var viewer = { email: session.email, role: session.role };
  if (!isAdminOrHm_(viewer.role) && viewer.role !== VCFO_AMCHSTS_BOD_ROLE) throw new Error('Only Admin/Headmaster/Super Admin can view the attendance audit log.');
  filters = filters || {};
  var sheet = getOrCreateAttendanceAuditLogSheet_();
  var lastRow = sheet.getLastRow();
  if (lastRow < 2) return [];
  var tz = getAttendanceWorkbook_().getSpreadsheetTimeZone();
  var values = sheet.getRange(2, 1, lastRow - 1, Math.min(ATTENDANCE_AUDIT_LOG_HEADER_ROW.length, sheet.getMaxColumns())).getValues();
  var txt = function (v, kind) { return attCellToText_(v, kind || '', tz); };
  var out = values.map(function (row) {
    return {
      editedAt: txt(row[0]), editedByEmail: txt(row[1]), editedByRole: txt(row[2]), courseId: txt(row[3]), className: txt(row[4]),
      date: txt(row[5], 'date'), personName: txt(row[6]), personEmail: txt(row[7]), personRole: txt(row[8]),
      oldStatus: txt(row[9]), newStatus: txt(row[10]), reason: txt(row[11]),
      action: txt(row[12]), autoStatus: txt(row[13]),
      personApsId: getAPSIdFromEmail(txt(row[7])), editedByApsId: getAPSIdFromEmail(txt(row[1]))
    };
  });
  if (filters.courseId) out = out.filter(function (r) { return r.courseId === String(filters.courseId); });
  out.sort(function (a, b) { return String(b.editedAt).localeCompare(String(a.editedAt)); });
  return out.slice(0, 500);
}

/**
 * Overrides the STATUS of ONE existing attendance record — never the
 * Meet-captured Active Minutes/session data — and appends an audit-log
 * entry (see ATTENDANCE_AUDIT_LOG_SHEET_NAME above). Allowed for:
 *   - admin/headmaster/superadmin: any record, any course, any role
 *     (student OR teacher row).
 *   - teacher: only a STUDENT-role record, only in a course this teacher
 *     teaches (courseHasTeacherEmail_) — never their own TEACHER-role row,
 *     never another course's data.
 * A student can never call this successfully, regardless of what the
 * client sends — SERVER-SIDE enforced, matching this project's existing
 * "never trust the client" convention (see setTeacherAvailabilityStatus
 * above for the same pattern).
 * Weekly-attendance round: the value is stored as an OVERRIDE (Override
 * Status/By/At/Reason columns) that the sync preserves; 'Attendance Status'
 * becomes the override. newStatus 'AUTO' clears the override and restores
 * the captured Auto Status. EXCUSED is now allowed. Runs under the same
 * script lock as the sync upsert.
 */
function editAttendanceRecordStatus(sessionToken, courseId, dateStr, email, role, newStatus, reason) {
  apsRequireTabForToken_(sessionToken, 'attendance'); // r56: Admin Control → Access Control
  var session = requireValidSession_(sessionToken);
  var courses = readAllCoursesFromCache_();
  var viewer = { email: session.email, role: session.role };
  requireDashboardMutationPermission_(viewer, 'edit an attendance record');

  newStatus = String(newStatus || '').toUpperCase();
  var isClear = newStatus === ATTENDANCE_CLEAR_OVERRIDE;
  if (!isClear && ATTENDANCE_OVERRIDE_STATUSES.indexOf(newStatus) === -1) throw new Error('Unknown attendance status: ' + newStatus);
  if (!courseId || !dateStr || !email || !role) throw new Error('Course, date, person, and role are required to edit an attendance record.');
  reason = attValidateOverrideReason_(reason); // mandatory, 5-25 words

  var course = courses.filter(function (c) { return String(c.id) === String(courseId); })[0];
  var isStaff = isAdminOrHm_(viewer.role) || classSupportElevated_(viewer, course); // VP/HM of this class may edit any row of it
  var isTeacherEditingOwnStudent = false;
  if (!isStaff && viewer.role === 'teacher') {
    isTeacherEditingOwnStudent = !!course && userHasCourseAccess_(viewer.email, course) && role === ATTENDANCE_ROLE.STUDENT;
    if (!isTeacherEditingOwnStudent && course) classAccessDenied_(viewer, course, 'edit attendance');
  }
  if (!isStaff && !isTeacherEditingOwnStudent) {
    throw new Error("Only an Admin, Headmaster, Super Admin, or this class's own teacher (editing a student's record) can edit attendance.");
  }

  var awkSheet = attWeekSheetNameForDate_(String(dateStr), getAttendanceWeek1Start_());
  var sheet = awkSheet ? getAttendanceWorkbook_().getSheetByName(awkSheet) : null;
  if (!sheet) {
    // Internal AWK sheet name (e.g. "AWK01ATT") logged server-side only — a Teacher can
    // reach this branch, so the thrown message stays generic (see getAttendanceWorkbook_ above).
    console.error('[Attendance] Week sheet "' + awkSheet + '" for ' + dateStr + ' (course ' + courseId + ') was not found.');
    throw new Error('No attendance has been captured yet for that week.');
  }

  var lock = LockService.getScriptLock();
  lock.waitLock(20000);
  try {
    ensureSheetHeader_(sheet, ATTENDANCE_HEADER_ROW);
    var records = attReadSheetRecords_(sheet);
    if (!records.length) throw new Error('No attendance rows exist yet for that week.');
    var normalizedEmail = normalizeEmail_(email);
    var idx = -1;
    for (var i = 0; i < records.length; i++) {
      var r = records[i];
      if (r.courseId === String(courseId) && r.date === dateStr && normalizeEmail_(r.email) === normalizedEmail && r.role === role) { idx = i; break; }
    }
    if (idx === -1) throw new Error('Could not find that attendance record (it may not have been captured yet for this date).');
    var rec = records[idx];
    var oldStatus = rec.status;
    var targetStatus = isClear ? (rec.autoStatus || rec.status) : newStatus;
    if (isClear && !rec.overrideStatus) {
      return { courseId: String(courseId), date: dateStr, email: normalizedEmail, role: role, status: rec.status, unchanged: true };
    }
    if (!isClear && rec.overrideStatus === newStatus && rec.status === newStatus) {
      return { courseId: String(courseId), date: dateStr, email: normalizedEmail, role: role, status: newStatus, unchanged: true };
    }

    var now = new Date();
    var stamp = Utilities.formatDate(now, APS_TZ, 'MM/dd/yyyy h:mm a');
    var C = ATTENDANCE_COL_;
    // One contiguous write: Status .. Override Reason (cols 20-26, 1-based).
    var seg = [
      targetStatus, stamp, rec.autoStatus || oldStatus,
      isClear ? '' : newStatus, isClear ? '' : viewer.email, isClear ? '' : stamp, isClear ? '' : reason
    ];
    var segRange = sheet.getRange(idx + 2, C.STATUS + 1, 1, seg.length);
    segRange.setNumberFormat('@');
    segRange.setValues([seg]);
    // Score column: override -> fixed score (PRESENT 100, PARTIAL/EXCUSED 70, ABSENT 0); cleared -> captured score.
    var after = {};
    Object.keys(rec).forEach(function (key) { after[key] = rec[key]; });
    after.overrideStatus = isClear ? '' : newStatus;
    after.status = targetStatus;
    after.score = attEffectiveScore_(after);
    if (sheet.getMaxColumns() >= C.SCORE + 1) {
      var scoreRange = sheet.getRange(idx + 2, C.SCORE + 1, 1, 1);
      scoreRange.setNumberFormat('@');
      scoreRange.setValues([[String(after.score)]]);
    }
    try { attApplyOverrideToSummary_(rec, after); } catch (sumErr) { console.warn('[Attendance] summary adjust failed (next sync rebuilds it): ' + sumErr.message); }

    appendAttendanceAuditLogEntry_({
      editedAt: now.toISOString(),
      editedByEmail: viewer.email,
      editedByRole: viewer.role,
      courseId: String(courseId),
      className: rec.className,
      date: dateStr,
      personName: rec.personName,
      personEmail: normalizedEmail,
      personRole: role,
      oldStatus: oldStatus,
      newStatus: targetStatus,
      reason: reason,
      action: isClear ? 'CLEAR_OVERRIDE' : 'OVERRIDE',
      autoStatus: rec.autoStatus || oldStatus
    });

    return { courseId: String(courseId), date: dateStr, email: normalizedEmail, role: role, status: targetStatus, oldStatus: oldStatus, unchanged: false, cleared: isClear, score: after.score };
  } finally {
    lock.releaseLock();
  }
}

/**
 * BULK OVERRIDE (Sept 27) — Admin / Super Admin only (server-enforced).
 * Overrides the Weekly Attendance of many records at once, across all
 * classes or one class, for Students, Teachers or both, in ONE week sheet.
 *
 * params: {
 *   weekOf: 'WK-yyyy-MM-dd' (required),
 *   courseId: '' (all classes) | one course id,
 *   roles: ['STUDENT'] | ['TEACHER'] | ['STUDENT','TEACHER'],
 *   onlyStatus: '' (any) | 'PRESENT' | 'PARTIAL' | 'ABSENT' | 'EXCUSED' (current effective status),
 *   newStatus: 'PRESENT' | 'PARTIAL' | 'ABSENT' | 'EXCUSED' | 'AUTO' (clear -> captured status),
 *   reason: 5-25 words (required),
 *   dryRun: true -> only count what WOULD change (no writes)
 * }
 * Same semantics as editAttendanceRecordStatus for every row (override
 * columns, fixed override score, sync preserves it); rows already at the
 * target are skipped. One sheet read + one sheet write + one audit write
 * (one audit row per changed record, action BULK_OVERRIDE / BULK_CLEAR_OVERRIDE),
 * then the overall % summary is rebuilt. Runs under the script lock.
 */
function bulkOverrideAttendance(sessionToken, params) {
  apsRequireTabForToken_(sessionToken, 'attendance'); // r56: Admin Control → Access Control
  var session = requireValidSession_(sessionToken);
  var viewer = { email: session.email, role: session.role };
  if (!isAdminRole_(viewer.role)) throw new Error('Only an Admin or Super Admin can bulk override attendance.');
  requireDashboardMutationPermission_(viewer, 'bulk override attendance');
  params = params || {};
  var newStatus = String(params.newStatus || '').toUpperCase();
  var isClear = newStatus === ATTENDANCE_CLEAR_OVERRIDE;
  if (!isClear && ATTENDANCE_OVERRIDE_STATUSES.indexOf(newStatus) === -1) throw new Error('Choose the new status to apply.');
  var roles = (params.roles || []).filter(function (r) { return r === ATTENDANCE_ROLE.STUDENT || r === ATTENDANCE_ROLE.TEACHER; });
  if (!roles.length) throw new Error('Choose Students, Teachers, or both.');
  var onlyStatus = String(params.onlyStatus || '').toUpperCase();
  if (onlyStatus && ATTENDANCE_OVERRIDE_STATUSES.indexOf(onlyStatus) === -1) throw new Error('Unknown current-status filter: ' + onlyStatus);
  var week1 = getAttendanceWeek1Start_();
  var weekNo = attWeekNumberForWeekId_(String(params.weekOf || ''), week1);
  if (!weekNo) throw new Error('Choose the week to override.');
  var reason = params.dryRun ? String(params.reason || '').trim() : attValidateOverrideReason_(params.reason);
  var courseId = params.courseId ? String(params.courseId) : '';

  var sheetName = formatAwkSheetName_(weekNo);
  var sheet = getAttendanceWorkbook_().getSheetByName(sheetName);
  var result = { weekOf: params.weekOf, weekNo: weekNo, dryRun: !!params.dryRun, matched: 0, changed: 0, students: 0, teachers: 0, classes: 0, unchanged: 0 };
  if (!sheet) return result;

  var lock = LockService.getScriptLock();
  lock.waitLock(30000);
  try {
    ensureSheetHeader_(sheet, ATTENDANCE_HEADER_ROW);
    var records = attReadSheetRecords_(sheet);
    var now = new Date();
    var stamp = Utilities.formatDate(now, APS_TZ, 'MM/dd/yyyy h:mm a');
    var classes = {}, audit = [];
    records.forEach(function (rec) {
      if (!rec.courseId || !rec.email || attIsExcludedEmail_(rec.email)) return;
      if (roles.indexOf(rec.role) === -1) return;
      if (courseId && rec.courseId !== courseId) return;
      if (onlyStatus && rec.status !== onlyStatus) return;
      result.matched++;
      var target = isClear ? (rec.autoStatus || rec.status) : newStatus;
      var noChange = isClear ? !rec.overrideStatus : (rec.overrideStatus === newStatus && rec.status === newStatus);
      if (noChange) { result.unchanged++; return; }
      result.changed++;
      if (rec.role === ATTENDANCE_ROLE.TEACHER) result.teachers++; else result.students++;
      classes[rec.courseId] = true;
      if (params.dryRun) return;
      var oldStatus = rec.status;
      rec.status = target;
      rec.lastUpdated = stamp;
      rec.overrideStatus = isClear ? '' : newStatus;
      rec.overrideBy = isClear ? '' : viewer.email;
      rec.overrideAt = isClear ? '' : stamp;
      rec.overrideReason = isClear ? '' : reason;
      rec.score = attEffectiveScore_(rec);
      audit.push({
        editedAt: now.toISOString(), editedByEmail: viewer.email, editedByRole: viewer.role, courseId: rec.courseId, className: rec.className,
        date: rec.date, personName: rec.personName, personEmail: normalizeEmail_(rec.email), personRole: rec.role,
        oldStatus: oldStatus, newStatus: target, reason: reason, action: isClear ? 'BULK_CLEAR_OVERRIDE' : 'BULK_OVERRIDE', autoStatus: rec.autoStatus || oldStatus
      });
    });
    result.classes = Object.keys(classes).length;
    if (!params.dryRun && audit.length) {
      attWriteTextRows_(sheet, 2, records.map(attRecordToRow_)); // one write: same row order, only the overridden rows' values differ
      appendAttendanceAuditLogEntries_(audit);
    }
  } finally {
    lock.releaseLock();
  }
  if (!params.dryRun && result.changed) {
    try { rebuildAttendanceSummary_(); } catch (e) { logAttendanceSyncDiagnostic_('Attendance_Summary rebuild after bulk override failed: ' + e.message); }
    logAttendanceSyncDiagnostic_('Bulk override by ' + viewer.email + ': ' + result.changed + ' record(s) in ' + sheetName + ' -> ' + (isClear ? 'captured status' : newStatus) + '.');
  }
  return result;
}

/** ---------------------------------------------------------------------
 *  GOOGLE MEET REST API INTEGRATION — real join/leave session data.
 *  Not exercised in this environment (no live Workspace/Meet access here
 *  to test against — see prerequisites 1 and 3 at the top of this
 *  module). Every call is wrapped so a permission/config/network problem
 *  degrades to an empty result plus a logged diagnostic, never a thrown
 *  error that would abort the rest of that course's (or another course's)
 *  sync (requirement 19).
 * ------------------------------------------------------------------- */
function logAttendanceSyncDiagnostic_(message) {
  console.error('[Attendance Sync] ' + message);
  try {
    var props = PropertiesService.getScriptProperties();
    var raw = props.getProperty(ATTENDANCE_SYNC_DIAGNOSTIC_KEY);
    var log = raw ? JSON.parse(raw) : [];
    log.push({ at: new Date().toISOString(), message: String(message) });
    if (log.length > 25) log = log.slice(log.length - 25); // Script Properties have a size limit — keep only the most recent 25
    props.setProperty(ATTENDANCE_SYNC_DIAGNOSTIC_KEY, JSON.stringify(log));
  } catch (e) { /* best-effort diagnostics only */ }
}

/** Admin/HM-only: the last 25 attendance-sync diagnostic entries, for the admin panel. */
function getAttendanceSyncDiagnostics(sessionToken) {
  apsRequireTabForToken_(sessionToken, 'attendance'); // r56: Admin Control → Access Control
  var session = requireValidSession_(sessionToken);
  var viewer = { email: session.email, role: session.role };
  if (!isAdminOrHm_(viewer.role) && viewer.role !== VCFO_AMCHSTS_BOD_ROLE) throw new Error('Only Admin/Headmaster/Super Admin can view attendance sync diagnostics.');
  var raw = PropertiesService.getScriptProperties().getProperty(ATTENDANCE_SYNC_DIAGNOSTIC_KEY);
  return raw ? JSON.parse(raw) : [];
}

/**
 * Resolves "users/{id}" (the Meet API's SignedinUser.user field — NOT an
 * email; see prerequisite 4 above) to a real APS email via
 * AdminDirectory.Users.get(id), the SAME Advanced Service + scope this
 * project already uses elsewhere (e.g. the staff display-name lookup).
 * Cached per-sync-run (via `cache`, passed in by the caller) so the same
 * person isn't looked up twice across multiple courses/sessions in one
 * run.
 */
function resolveSignedInUserEmail_(signedinUser, cache) {
  if (!signedinUser || !signedinUser.user) return null;
  var m = String(signedinUser.user).match(/^users\/(.+)$/);
  var userId = m ? m[1] : signedinUser.user;
  if (Object.prototype.hasOwnProperty.call(cache, userId)) return cache[userId];
  var email = null;
  try {
    var u = AdminDirectory.Users.get(userId);
    email = (u && u.primaryEmail) ? u.primaryEmail : null;
  } catch (e) {
    logAttendanceSyncDiagnostic_('resolveSignedInUserEmail_ failed for ' + userId + ': ' + (e && e.message ? e.message : String(e)));
  }
  cache[userId] = email;
  return email;
}

/** One participant's raw session list -> [{start: ms, end: ms|null}]. */
function fetchParticipantSessions_(participantName, token) {
  var out = [];
  var pageToken = '';
  do {
    var url = MEET_API_BASE_ + '/' + participantName + '/participantSessions?pageSize=100' + (pageToken ? '&pageToken=' + encodeURIComponent(pageToken) : '');
    var resp = UrlFetchApp.fetch(url, { headers: { Authorization: 'Bearer ' + token }, muteHttpExceptions: true });
    if (resp.getResponseCode() !== 200) {
      logAttendanceSyncDiagnostic_('participantSessions.list failed for ' + participantName + ' — HTTP ' + resp.getResponseCode() + ': ' + resp.getContentText());
      return out;
    }
    var body = JSON.parse(resp.getContentText());
    (body.participantSessions || []).forEach(function (s) {
      out.push({ start: new Date(s.startTime).getTime(), end: s.endTime ? new Date(s.endTime).getTime() : null });
    });
    pageToken = body.nextPageToken || '';
  } while (pageToken);
  return out;
}

/** For one conferenceRecord, lists its participants, resolves each to an APS email, and folds their raw sessions into `sessionsByEmail`. A participant the API can't resolve to a real email (e.g. a phone/anonymous join) is fetched but cannot be attributed to a roster member, so it's skipped rather than guessed at. */
function mergeParticipantSessionsIntoMap_(conferenceRecordName, token, sessionsByEmail, userIdEmailCache) {
  var pageToken = '';
  do {
    var url = MEET_API_BASE_ + '/' + conferenceRecordName + '/participants?pageSize=100' + (pageToken ? '&pageToken=' + encodeURIComponent(pageToken) : '');
    var resp = UrlFetchApp.fetch(url, { headers: { Authorization: 'Bearer ' + token }, muteHttpExceptions: true });
    if (resp.getResponseCode() !== 200) {
      logAttendanceSyncDiagnostic_('participants.list failed for ' + conferenceRecordName + ' — HTTP ' + resp.getResponseCode() + ': ' + resp.getContentText());
      return;
    }
    var body = JSON.parse(resp.getContentText());
    (body.participants || []).forEach(function (p) {
      var email = p.signedinUser ? resolveSignedInUserEmail_(p.signedinUser, userIdEmailCache) : null;
      if (!email) return; // phone/anonymous participant, or resolution failed — not attributable to a roster member
      var normalizedEmail = normalizeEmail_(email);
      if (!sessionsByEmail[normalizedEmail]) sessionsByEmail[normalizedEmail] = [];
      fetchParticipantSessions_(p.name, token).forEach(function (s) { sessionsByEmail[normalizedEmail].push(s); });
    });
    pageToken = body.nextPageToken || '';
  } while (pageToken);
}

/**
 * Resolves `meetCode`'s Meet space, lists its conferenceRecords within
 * [startDate, endDate], and returns every attributable participant's raw
 * join/leave sessions as { normalizedEmail: [{start, end|null}] }.
 */
function fetchMeetSessionsForCourse_(meetCode, startDate, endDate, userIdEmailCache) {
  var sessionsByEmail = {};
  if (!meetCode) return sessionsByEmail;
  try {
    var token = ScriptApp.getOAuthToken();
    var spaceResp = UrlFetchApp.fetch(MEET_API_BASE_ + '/spaces/' + encodeURIComponent(meetCode), {
      headers: { Authorization: 'Bearer ' + token },
      muteHttpExceptions: true
    });
    if (spaceResp.getResponseCode() !== 200) {
      logAttendanceSyncDiagnostic_('spaces.get failed for code ' + meetCode + ' — HTTP ' + spaceResp.getResponseCode() + ': ' + spaceResp.getContentText());
      return sessionsByEmail;
    }
    var space = JSON.parse(spaceResp.getContentText());
    var spaceName = space.name; // e.g. "spaces/abcdefgh"

    var pageToken = '';
    do {
      var filter = 'space.name="' + spaceName + '" AND start_time>="' + startDate.toISOString() + '" AND start_time<="' + endDate.toISOString() + '"';
      var url = MEET_API_BASE_ + '/conferenceRecords?filter=' + encodeURIComponent(filter) + (pageToken ? '&pageToken=' + encodeURIComponent(pageToken) : '');
      var crResp = UrlFetchApp.fetch(url, { headers: { Authorization: 'Bearer ' + token }, muteHttpExceptions: true });
      if (crResp.getResponseCode() !== 200) {
        logAttendanceSyncDiagnostic_('conferenceRecords.list failed for ' + spaceName + ' — HTTP ' + crResp.getResponseCode() + ': ' + crResp.getContentText());
        break;
      }
      var crBody = JSON.parse(crResp.getContentText());
      (crBody.conferenceRecords || []).forEach(function (record) {
        mergeParticipantSessionsIntoMap_(record.name, token, sessionsByEmail, userIdEmailCache);
      });
      pageToken = crBody.nextPageToken || '';
    } while (pageToken);
  } catch (e) {
    logAttendanceSyncDiagnostic_('fetchMeetSessionsForCourse_ threw for code ' + meetCode + ': ' + (e && e.message ? e.message : String(e)));
  }
  return sessionsByEmail;
}

/** ---------------------------------------------------------------------
 *  GOOGLE MEET AUDIT LOG (Admin Reports API) — primary capture source.
 *  Weekly-attendance round. The Meet REST API path above only returns
 *  conference data for Meet spaces the CALLING account organized or has
 *  explicit access to, so for teachers' own recurring Meets it came back
 *  empty and every student was recorded ABSENT. The Admin Reports "meet"
 *  audit log is domain-wide, needs no per-course Meet-link mapping, and is
 *  the SAME AdminReports service + owner identity this project already
 *  uses successfully every sync for Live/Started detection
 *  (getMeetPresenceMap_). Each 'call_ended' event is one participant
 *  session: leave = event time, join = start_timestamp_seconds (or leave -
 *  duration_seconds), with the meeting_code and organizer_email.
 * ------------------------------------------------------------------- */
function attAuditParam_(ev, name) {
  var params = ev.parameters || [];
  for (var i = 0; i < params.length; i++) {
    var p = params[i];
    if (p.name === name) return p.value !== undefined ? p.value : (p.intValue !== undefined ? p.intValue : (p.boolValue !== undefined ? p.boolValue : ''));
  }
  return '';
}

/** 'abc-defg-hij' / 'ABCDEFGHIJ' / meet URL -> 'abcdefghij' (letters only), so a mapped code and an audit-log code always compare equal. */
function attNormalizeMeetCode_(code) {
  var c = String(code || '');
  var fromUrl = extractMeetCode_(c);
  return (fromUrl || c).toLowerCase().replace(/[^a-z]/g, '');
}

/**
 * One Admin Reports query for 'call_ended' events whose end falls in
 * [startDate, endDate]. Only sessions of `rosterEmailSet` members are kept
 * (memory), and `fields` trims the payload. Returns
 * { ok, error, byEmail: { email: [{start, end, code, organizer}] } }.
 * `seen` dedupes events across overlapping queries within one run.
 */
function fetchMeetAuditSessions_(startDate, endDate, rosterEmailSet, seen) {
  var byEmail = {};
  try {
    var pageToken;
    do {
      var pt = pageToken;
      var resp = callWithBackoff_(function () {
        return AdminReports.Activities.list('all', 'meet', {
          eventName: 'call_ended',
          startTime: startDate.toISOString(),
          endTime: endDate.toISOString(),
          maxResults: 1000,
          pageToken: pt,
          fields: 'items(actor/email,id(time,uniqueQualifier),events(name,parameters(name,value,intValue,boolValue))),nextPageToken'
        });
      });
      (resp.items || []).forEach(function (item) {
        var endIso = item.id && item.id.time;
        if (!endIso) return;
        (item.events || []).forEach(function (ev) {
          if (ev.name !== 'call_ended') return;
          var identifier = String(attAuditParam_(ev, 'identifier') || '');
          var email = normalizeEmail_((item.actor && item.actor.email) || (identifier.indexOf('@') > -1 ? identifier : ''));
          if (!email || (!rosterEmailSet[email] && !attIsOnCallEmail_(email))) return; // on-call accounts kept even when not rostered
          var endMs = new Date(endIso).getTime();
          var startSec = Number(attAuditParam_(ev, 'start_timestamp_seconds'));
          var durSec = Number(attAuditParam_(ev, 'duration_seconds'));
          var startMs = isFinite(startSec) && startSec > 0 ? startSec * 1000 : (isFinite(durSec) && durSec >= 0 ? endMs - durSec * 1000 : NaN);
          if (!isFinite(startMs) || !isFinite(endMs) || endMs < startMs) return;
          var code = attNormalizeMeetCode_(attAuditParam_(ev, 'meeting_code'));
          var dedupeKey = email + '|' + code + '|' + startMs + '|' + endMs;
          if (seen[dedupeKey]) return;
          seen[dedupeKey] = true;
          if (!byEmail[email]) byEmail[email] = [];
          byEmail[email].push({ start: startMs, end: endMs, code: code, organizer: normalizeEmail_(attAuditParam_(ev, 'organizer_email')) });
        });
      });
      pageToken = resp.nextPageToken;
    } while (pageToken);
    return { ok: true, byEmail: byEmail };
  } catch (e) {
    return { ok: false, byEmail: {}, error: (e && e.message) ? e.message : String(e) };
  }
}

/**
 * Picks which of the roster's Meet sessions belong to THIS class occurrence
 * (a person can be in other Meets the same evening, so "any Meet" is not
 * good enough). Precedence:
 *   1. Admin-mapped Meet code (Course_Meet_Link_Map) — if it has activity.
 *   2. Codes the class's teacher(s) used, or organized, during the window
 *      (support/HM staff excluded — they hop between many classes).
 *   3. The code most roster students used during the window (teacher absent).
 * Returns { sessionsByEmail: {email: [{start,end}]}, source }.
 */
function attAttributeSessionsToClass_(course, window, auditByEmail, mappedCode) {
  // A session belongs to this class if it overlaps the scheduled time widened by the same
  // early/late bounds as the call-window guard (30 min before .. 60 min after), so a class that
  // runs long — including a teacher/student REJOIN after the scheduled end — is kept.
  var winStart = window.startDate.getTime() - ATTENDANCE_CALL_WINDOW_EARLY_MIN * 60000;
  var winEnd = window.endDate.getTime() + ATTENDANCE_CALL_WINDOW_LATE_MIN * 60000;
  var overlapping = {};
  var roster = [];
  (course.teachers || []).forEach(function (t) { if (t.email && !attIsExcludedEmail_(t.email)) roster.push({ email: normalizeEmail_(t.email), isTeacher: true }); });
  (course.students || []).forEach(function (st) { if (st.email && !attIsExcludedEmail_(st.email)) roster.push({ email: normalizeEmail_(st.email), isTeacher: false }); });
  roster.forEach(function (p) {
    overlapping[p.email] = (auditByEmail[p.email] || []).filter(function (x) { return x.start < winEnd && x.end > winStart; });
  });

  var pick = function (codeSet) {

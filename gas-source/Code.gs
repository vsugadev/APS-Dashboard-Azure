  if (!sheet || sheet.getLastRow() < 2) return map;
  sheet.getRange(2, 1, sheet.getLastRow() - 1, 2).getValues().forEach(function (row) {
    if (row[0] && row[1]) map[String(row[0])] = String(row[1]);
  });
  return map;
}

function formatAwkSheetName_(n) {
  var padded = n < 100 ? ('0' + n).slice(-2) : String(n);
  return ATTENDANCE_SHEET_PREFIX + padded + 'ATT';
}

/** Week 1's Friday ('yyyy-MM-dd'), from Script Property ATTENDANCE_WEEK1_START (snapped to that week's Friday), default 2026-09-11. */
function getAttendanceWeek1Start_() {
  var raw = String(PropertiesService.getScriptProperties().getProperty('ATTENDANCE_WEEK1_START') || '').trim();
  var wk = attWeekIdForDateStr_(raw);
  return wk ? wk.slice(3) : ATTENDANCE_WEEK1_START_DEFAULT_;
}

/** School week number (1-based) for a 'WK-yyyy-MM-dd' week id; 0 if before Week 1 or invalid. */
function attWeekNumberForWeekId_(weekId, week1Start) {
  var m = /^WK-(\d{4}-\d{2}-\d{2})$/.exec(weekId || '');
  if (!m) return 0;
  var days = Math.round((new Date(m[1] + 'T12:00:00Z') - new Date(week1Start + 'T12:00:00Z')) / 86400000);
  return days < 0 ? 0 : Math.floor(days / 7) + 1;
}

/** 'WK-yyyy-MM-dd' for school week number n (n >= 1). */
function attWeekIdForNumber_(n, week1Start) {
  return 'WK-' + attShiftDateStr_(week1Start, (n - 1) * 7);
}

/** AWK sheet name for a class date ('AWK01ATT' for Week 1), or '' if the date is before Week 1. */
function attWeekSheetNameForDate_(dateStr, week1Start) {
  var n = attWeekNumberForWeekId_(attWeekIdForDateStr_(dateStr), week1Start);
  return n ? formatAwkSheetName_(n) : '';
}

/** Get-or-create one week's AWKxxATT sheet, writing the header row exactly once. */
function getOrCreateAttendanceWeekSheet_(awkSheetName) {
  var ss = getAttendanceWorkbook_();
  var sheet = ss.getSheetByName(awkSheetName);
  var isNew = !sheet;
  if (isNew) sheet = ss.insertSheet(awkSheetName);
  ensureSheetHeader_(sheet, ATTENDANCE_HEADER_ROW); // adds columns first — a new sheet has only 26, the header needs 35
  if (isNew) sheet.setFrozenRows(1);
  return sheet;
}

/**
 * Upgrades an existing sheet created before columns were appended: adds
 * physical columns if the sheet has fewer than `header` needs, and rewrites
 * the header row. Two cheap metadata reads; writes only when needed.
 */
function ensureSheetHeader_(sheet, header) {
  var maxCols = sheet.getMaxColumns();
  if (maxCols < header.length) sheet.insertColumnsAfter(maxCols, header.length - maxCols);
  if (sheet.getLastColumn() < header.length) {
    sheet.getRange(1, 1, 1, header.length).setValues([header]).setFontWeight('bold');
  }
}

/** All existing week sheets, as [{name, weekNo}] sorted by week. One metadata call. */
function attListWeekSheets_() {
  return getAttendanceWorkbook_().getSheets().map(function (sh) {
    var m = ATTENDANCE_WEEK_SHEET_PATTERN_.exec(sh.getName());
    return m ? { name: sh.getName(), weekNo: Number(m[1]), sheet: sh } : null;
  }).filter(Boolean).sort(function (a, b) { return a.weekNo - b.weekNo; });
}

/**
 * Admin/HM/BOD: the Week <-> AWK sheet list for the admin panel (name kept
 * for client compatibility). Each entry: { awkSheet, weekNo, weekLabel, rows }.
 */
function getAttendanceCourseAwkMap(sessionToken) {
  apsRequireTabForToken_(sessionToken, 'attendance'); // r56: Admin Control → Access Control
  var session = requireValidSession_(sessionToken);
  var viewer = { email: session.email, role: session.role };
  if (!isAdminOrHm_(viewer.role) && viewer.role !== VCFO_AMCHSTS_BOD_ROLE) throw new Error('Only Admin/Headmaster/Super Admin can view the AWK mapping.');
  var week1 = getAttendanceWeek1Start_();
  return attListWeekSheets_().map(function (w) {
    var weekId = attWeekIdForNumber_(w.weekNo, week1);
    return { awkSheet: w.name, weekNo: w.weekNo, weekId: weekId, weekLabel: 'Week ' + w.weekNo + ' — ' + getWeekLabel_(weekId).replace(/^Week of /, ''), rows: Math.max(0, w.sheet.getLastRow() - 1) };
  });
}

/** ---------------------------------------------------------------------
 *  COURSE <-> MEET LINK MAPPING (Admin-maintained; see prerequisite #2 above)
 * ------------------------------------------------------------------- */
function getOrCreateMeetLinkMapSheet_() {
  var ss = getAttendanceWorkbook_();
  var sheet = ss.getSheetByName(ATTENDANCE_MEET_LINK_MAP_SHEET_NAME);
  if (!sheet) {
    sheet = ss.insertSheet(ATTENDANCE_MEET_LINK_MAP_SHEET_NAME);
    sheet.getRange(1, 1, 1, 5).setValues([['Course ID', 'Course Name', 'Meet Code', 'Updated At', 'Updated By']]).setFontWeight('bold');
    sheet.setFrozenRows(1);
  }
  return sheet;
}

/** Extracts the meeting code from a pasted Meet URL ("https://meet.google.com/abc-defg-hij") or accepts a bare "abc-defg-hij" code. Returns '' if unrecognized. */
function extractMeetCode_(input) {
  var s = String(input || '').trim();
  if (!s) return '';
  var m = s.match(/meet\.google\.com\/([a-z]{3}-[a-z]{4}-[a-z]{3})/i);
  if (m) return m[1].toLowerCase();
  if (/^[a-z]{3}-[a-z]{4}-[a-z]{3}$/i.test(s)) return s.toLowerCase();
  return '';
}

function readCourseMeetLinkMap_() {
  var sheet = getOrCreateMeetLinkMapSheet_();
  var lastRow = sheet.getLastRow();
  var map = {};
  if (lastRow < 2) return map;
  sheet.getRange(2, 1, lastRow - 1, 3).getValues().forEach(function (row) {
    if (row[0] && row[2]) map[String(row[0])] = String(row[2]);
  });
  return map;
}

/** Admin/HM only. Saves/updates the Meet code for a course so the sync can resolve its Meet space. Safe to call repeatedly — updates the existing row for that Course ID rather than adding a duplicate. */
function saveCourseMeetLinkMapping(sessionToken, courseId, meetLinkOrCode, courseName) {
  apsRequireTabForToken_(sessionToken, 'attendance'); // r56: Admin Control → Access Control
  var session = requireValidSession_(sessionToken);
  var viewer = { email: session.email, role: session.role };
  requireDashboardMutationPermission_(viewer, 'update the Course-Meet Link mapping');
  if (!isAdminOrHm_(viewer.role)) throw new Error('Only Admin/Headmaster/Super Admin can map a course to its Meet link.');
  if (!courseId) throw new Error('Course ID is required.');
  var code = extractMeetCode_(meetLinkOrCode);
  if (!code) throw new Error('Could not recognize a Google Meet link/code (expected e.g. "abc-defg-hij" or a meet.google.com URL).');

  var sheet = getOrCreateMeetLinkMapSheet_();
  var lastRow = sheet.getLastRow();
  var rowIndex = -1;
  if (lastRow >= 2) {
    var ids = sheet.getRange(2, 1, lastRow - 1, 1).getValues();
    for (var i = 0; i < ids.length; i++) {
      if (String(ids[i][0]) === String(courseId)) { rowIndex = i + 2; break; }
    }
  }
  var row = [courseId, courseName || '', code, new Date().toISOString(), viewer.email, 'MANUAL', ''];
  classMeetMapEnsureHeader_(sheet);
  if (rowIndex > -1) sheet.getRange(rowIndex, 1, 1, row.length).setValues([row]);
  else sheet.appendRow(row);
  classMeetLinksInvalidate_(); // the Classes tab shows the new link on the next poll
  return { courseId: courseId, meetCode: code };
}

/** Admin/HM-only read of the current Course<->Meet mapping, for the admin panel. */
function getCourseMeetLinkMappings(sessionToken) {
  apsRequireTabForToken_(sessionToken, 'attendance'); // r56: Admin Control → Access Control
  var session = requireValidSession_(sessionToken);
  var viewer = { email: session.email, role: session.role };
  if (!isAdminOrHm_(viewer.role) && viewer.role !== VCFO_AMCHSTS_BOD_ROLE) throw new Error('Only Admin/Headmaster/Super Admin can view the Course-Meet Link mapping.');
  var sheet = getOrCreateMeetLinkMapSheet_();
  var lastRow = sheet.getLastRow();
  if (lastRow < 2) return [];
  return sheet.getRange(2, 1, lastRow - 1, 7).getValues().filter(function (r) { return r[0]; }).map(function (r) {
    return { courseId: String(r[0]), courseName: r[1] || '', meetCode: r[2] || '', updatedAt: r[3] || '', updatedBy: r[4] || '',
      source: String(r[5] || 'MANUAL'), joinLink: String(r[6] || '') };
  });
}

/** ---------------------------------------------------------------------
 *  COURSE NAME PARSING (reuses parseClassroomTitle_ + parseCourseSchedule_
 *  verbatim — see this module's header; neither is duplicated or modified)
 * ------------------------------------------------------------------- */
function parseAttendanceCourseInfo_(course) {
  var titleParts = parseClassroomTitle_(course.name);
  var schedule = parseCourseSchedule_(course.name);
  return {
    level: titleParts ? titleParts.grade : '',
    section: titleParts ? titleParts.section : '',
    academicYear: titleParts ? titleParts.academicYear : '',
    dayOfWeek: schedule ? schedule.dayOfWeek : null,
    dayLabel: (schedule && schedule.dayOfWeek != null) ? ATTENDANCE_DAY_LABELS_[schedule.dayOfWeek] : '',
    start: schedule ? schedule.start : null,
    end: schedule ? schedule.end : null,
    timezoneRaw: (schedule && schedule.timezoneRaw) ? schedule.timezoneRaw : 'EST'
  };
}

/** Resolves the actual scheduled start/end UTC instants for `scheduleInfo`'s class occurring on Eastern calendar date `dateStr` ('yyyy-MM-dd'), DST-aware (reuses easternWallTimeToDate_ verbatim — see Part 1's timezone helpers). Returns null if the course's schedule couldn't be parsed from its name. */
function attendanceScheduledWindowForDate_(scheduleInfo, dateStr) {
  if (!scheduleInfo || !scheduleInfo.start || !scheduleInfo.end) return null;
  var startDate = easternWallTimeToDate_(dateStr, scheduleInfo.start.hour, scheduleInfo.start.minute);
  var endDate = easternWallTimeToDate_(dateStr, scheduleInfo.end.hour, scheduleInfo.end.minute);
  if (endDate.getTime() <= startDate.getTime()) endDate = new Date(endDate.getTime() + 24 * 60 * 60000); // defensive only — an overnight-spanning class isn't expected in practice
  return { startDate: startDate, endDate: endDate };
}

/** Pure string date math on an Eastern calendar date: 'yyyy-MM-dd' +/- days -> 'yyyy-MM-dd' (UTC-noon anchor, so DST can never skip or repeat a date). */
function attShiftDateStr_(dateStr, days) {
  var d = new Date(dateStr + 'T12:00:00Z');
  d.setUTCDate(d.getUTCDate() + days);
  return d.toISOString().slice(0, 10);
}

/** Week key for an Eastern class date — same Friday-anchored 'WK-yyyy-MM-dd' semantics as getCurrentWeekId_(), computed with pure string math (no Utilities calls, so it is cheap enough to run per row on read). */
function attWeekIdForDateStr_(dateStr) {
  if (!/^\d{4}-\d{2}-\d{2}$/.test(String(dateStr || ''))) return '';
  var dow = new Date(dateStr + 'T12:00:00Z').getUTCDay();
  var offsetToFridayByDow = [-2, 4, 3, 2, 1, 0, -1]; // identical table to getCurrentWeekId_()
  return 'WK-' + attShiftDateStr_(dateStr, offsetToFridayByDow[dow]);
}

/**
 * Every occurrence of this course's weekly class from `fromDateStr` (the
 * Week 1 anchor, or a later date) through today that has already STARTED
 * and is not yet finalized. Replaces the old "today, within 6h of start"
 * check, which permanently lost a week's attendance whenever no sync
 * happened to run inside that window. Pure string date math; finalized
 * weeks are skipped without any work.
 * Returns [{ dateStr, window, finalizeEligible }], oldest first.
 */
function attendancePendingOccurrences_(scheduleInfo, now, finalizedThrough, fromDateStr) {
  var out = [];
  if (!scheduleInfo || scheduleInfo.dayOfWeek === null || scheduleInfo.dayOfWeek === undefined || !scheduleInfo.start || !scheduleInfo.end) return out;
  var todayStr = Utilities.formatDate(now, APS_TZ, 'yyyy-MM-dd');
  var startStr = (finalizedThrough && finalizedThrough >= fromDateStr) ? attShiftDateStr_(finalizedThrough, 1) : fromDateStr;
  // Jump straight to the first matching weekday, then step a week at a time.
  var firstDow = new Date(startStr + 'T12:00:00Z').getUTCDay();
  var dateStr = attShiftDateStr_(startStr, (scheduleInfo.dayOfWeek - firstDow + 7) % 7);
  for (; dateStr <= todayStr; dateStr = attShiftDateStr_(dateStr, 7)) {
    if (apsLeaveSkip_('ATTENDANCE_CAPTURE', dateStr)) continue; // r109: approved school leave — no class, no rows (not ABSENT)
    var window = attendanceScheduledWindowForDate_(scheduleInfo, dateStr);
    if (!window || now.getTime() < window.startDate.getTime()) continue; // not started yet
    out.push({
      dateStr: dateStr,
      window: window,
      finalizeEligible: now.getTime() >= window.endDate.getTime() + ATTENDANCE_FINALIZE_AFTER_END_HOURS * 3600000
    });
  }
  return out;
}

/** ---------------------------------------------------------------------
 *  PURE LOGIC — interval merging, active-minutes, status (verified against
 *  all 10 spec test cases in /tmp/gs_check/verify_attendance_capture.js;
 *  kept intentionally free of any Sheets/Meet-API calls so it can be
 *  tested standalone).
 * ------------------------------------------------------------------- */
/**
 * rawSessions: [{start: ms, end: ms|null}] (end null = still active/no
 * leave time yet — requirement 14). Clips every session to
 * [scheduleStartMs, scheduleEndMs] (requirements 12/13: joining early or
 * staying late never inflates official attendance), merges overlapping or
 * touching clipped intervals (requirement 6: no double-counting), and sums
 * the merged minutes. sessionCount is the number of RAW sessions passed in
 * (i.e. how many times the person actually joined/reconnected —
 * requirement 23's "how many times did they reconnect", not the merged
 * interval count, which can be lower when sessions overlap).
 */
function attMergeAndBoundSessions_(rawSessions, scheduleStartMs, scheduleEndMs, nowMs) {
  var clipped = [];
  (rawSessions || []).forEach(function (s) {
    var isOpen = (s.end === null || s.end === undefined);
    var effEnd = isOpen ? Math.min(nowMs, scheduleEndMs) : Math.min(s.end, scheduleEndMs);
    var effStart = Math.max(s.start, scheduleStartMs);
    if (effEnd <= effStart) return; // entirely outside the scheduled window — contributes 0
    clipped.push({ start: effStart, end: effEnd, isOpen: isOpen });
  });
  clipped.sort(function (a, b) { return a.start - b.start; });
  var merged = [];
  clipped.forEach(function (iv) {
    var last = merged[merged.length - 1];
    if (last && iv.start <= last.end) {
      last.end = Math.max(last.end, iv.end);
      last.isOpen = last.isOpen || iv.isOpen;
    } else {
      merged.push({ start: iv.start, end: iv.end, isOpen: iv.isOpen });
    }
  });
  var activeMs = merged.reduce(function (sum, iv) { return sum + (iv.end - iv.start); }, 0);
  return { mergedIntervals: merged, activeMinutes: Math.round(activeMs / 60000), sessionCount: (rawSessions || []).length };
}

/** Idempotency key: Course ID + Attendance Date + Person Email + Role, exactly as suggested by the spec. */
function attRecordKey_(courseId, dateStr, email, role) {
  return courseId + '|' + dateStr + '|' + normalizeEmail_(email) + '|' + role;
}

function attFormatSessionDetails_(mergedIntervals) {
  if (!mergedIntervals || !mergedIntervals.length) return '';
  return mergedIntervals.map(function (iv) {
    var startLabel = Utilities.formatDate(new Date(iv.start), APS_TZ, 'h:mm a');
    var endLabel = iv.isOpen ? '(ongoing)' : Utilities.formatDate(new Date(iv.end), APS_TZ, 'h:mm a');
    var minutes = Math.round((iv.end - iv.start) / 60000);
    return startLabel + ' - ' + endLabel + ' (' + minutes + 'm)';
  }).join('\n');
}

/** Builds one full attendance record (student or teacher) for one class date. */
function attBuildRecord_(opts) {
  // Minutes are counted inside the CLASS WINDOW — the teacher's first valid
  // join -> last valid leave (attClassWindowForOccurrence_; falls back to the
  // whole class's call window only when no teacher joined). Actual class
  // minutes are kept for audit; the denominator is the EFFECTIVE minutes
  // (actual < 90 -> actual, else 95 — getEffectiveClassMinutes). No call -> 0.
  var cw = opts.callWindow;
  var merge = cw ? attMergeAndBoundSessions_(opts.rawSessions, cw.startMs, cw.endMs, opts.now.getTime())
                 : { mergedIntervals: [], activeMinutes: 0, sessionCount: (opts.rawSessions || []).length };
  var actualClassMinutes = cw ? Math.round((cw.endMs - cw.startMs) / 60000) : 0;
  var callMinutes = getEffectiveClassMinutes(actualClassMinutes);
  var attendedPct = attAttendedPct_(merge.activeMinutes, callMinutes);
  var autoScore = attScoreForPct_(attendedPct);
  var status = attStatusForScore_(autoScore);
  var firstJoin = merge.mergedIntervals.length ? Utilities.formatDate(new Date(merge.mergedIntervals[0].start), APS_TZ, 'h:mm a') : '';
  var lastIv = merge.mergedIntervals[merge.mergedIntervals.length - 1];
  var lastLeave = lastIv ? (lastIv.isOpen ? '(ongoing)' : Utilities.formatDate(new Date(lastIv.end), APS_TZ, 'h:mm a')) : '';
  return {
    date: opts.dateStr,
    courseId: String(opts.course.id),
    className: opts.course.name,
    level: opts.scheduleInfo.level,
    section: opts.scheduleInfo.section,
    day: opts.scheduleInfo.dayLabel,
    schedStart: Utilities.formatDate(opts.window.startDate, APS_TZ, 'h:mm a'),
    schedEnd: Utilities.formatDate(opts.window.endDate, APS_TZ, 'h:mm a'),
    tz: opts.scheduleInfo.timezoneRaw,
    academicYear: opts.scheduleInfo.academicYear,
    personName: opts.person.name,
    apsId: getAPSIdFromEmail(opts.person.email),
    email: opts.person.email,
    role: opts.role,
    sessionCount: merge.sessionCount,
    sessionDetails: attFormatSessionDetails_(merge.mergedIntervals),
    firstJoin: firstJoin,
    lastLeave: lastLeave,
    activeMinutes: merge.activeMinutes,
    status: status,
    lastUpdated: Utilities.formatDate(opts.now, APS_TZ, 'MM/dd/yyyy h:mm a'),
    autoStatus: status,
    overrideStatus: '', overrideBy: '', overrideAt: '', overrideReason: '',
    captureSource: opts.captureSource || '',
    weekOf: attWeekIdForDateStr_(opts.dateStr),
    weekNo: opts.weekNo || '',
    callStart: cw ? Utilities.formatDate(new Date(cw.startMs), APS_TZ, 'h:mm a') : '',
    callEnd: cw ? Utilities.formatDate(new Date(cw.endMs), APS_TZ, 'h:mm a') : '',
    callMinutes: callMinutes,
    attendedPct: attendedPct,
    autoScore: autoScore,
    score: autoScore,
    actualClassMinutes: actualClassMinutes,
    effectiveClassMinutes: callMinutes,
    classWindowBasis: cw ? (cw.basis || 'CLASS') : ''
  };
}

function attRecordToRow_(r) {
  return [
    r.date, r.courseId, r.className, r.level, r.section, r.day,
    r.schedStart, r.schedEnd, r.tz, r.academicYear,
    r.personName, r.apsId, r.email, r.role,
    r.sessionCount, r.sessionDetails, r.firstJoin, r.lastLeave,
    r.activeMinutes, r.status, r.lastUpdated,
    r.autoStatus || '', r.overrideStatus || '', r.overrideBy || '', r.overrideAt || '', r.overrideReason || '',
    r.captureSource || '', r.weekOf || '', r.weekNo || '',
    r.callStart || '', r.callEnd || '', r.callMinutes, r.attendedPct, r.autoScore, r.score,
    r.actualClassMinutes, r.effectiveClassMinutes, r.classWindowBasis || ''
  ].map(function (v) { return (v === null || v === undefined) ? '' : String(v); }); // every cell written as plain text (see attWriteTextRows_)
}

/**
 * Converts one raw cell to the plain string the rest of the module expects.
 * WHY: rows written before this round were NOT text-formatted, so Sheets
 * auto-converted '2026-09-25', '7:30 PM' and 'MM/dd/yyyy h:mm a' into Date
 * cells. getValues() then returned Date objects, which (a) broke every
 * `r.date === dateStr` match (edits failed with "record not found", upserts
 * duplicated rows each run), (b) threw in the `.localeCompare` sort, and
 * (c) are illegal google.script.run return values — so the Attendance tab
 * silently showed nothing. Handles both a Date (SpreadsheetApp path, `tz` =
 * the spreadsheet's zone) and a serial number (Sheets API SERIAL_NUMBER path).
 */
function attCellToText_(v, kind, tz) {
  if (v === null || v === undefined) return '';
  var pattern = kind === 'date' ? 'yyyy-MM-dd' : (kind === 'time' ? 'h:mm a' : (kind === 'datetime' ? 'MM/dd/yyyy h:mm a' : ''));
  if (Object.prototype.toString.call(v) === '[object Date]') return pattern ? Utilities.formatDate(v, tz || APS_TZ, pattern) : v.toISOString();
  if (typeof v === 'number' && pattern) {
    // Sheets serial: days since 1899-12-30, wall-clock (no zone) — decode with UTC getters.
    var d = new Date(Math.round((v - 25569) * 86400000));
    var ymd = d.toISOString().slice(0, 10);
    var h = d.getUTCHours(), m = d.getUTCMinutes();
    var hm = ((h % 12) || 12) + ':' + ('0' + m).slice(-2) + ' ' + (h < 12 ? 'AM' : 'PM');
    if (kind === 'date') return ymd;
    if (kind === 'time') return hm;
    return ymd.slice(5, 7) + '/' + ymd.slice(8, 10) + '/' + ymd.slice(0, 4) + ' ' + hm;
  }
  return String(v);
}

function attRowToRecord_(row, tz) {
  var C = ATTENDANCE_COL_;
  var cell = function (i) { return (row && row[i] !== undefined) ? row[i] : ''; };
  var date = attCellToText_(cell(C.DATE), 'date', tz);
  var status = attCellToText_(cell(C.STATUS), '', tz);
  return attApplyClassDurationRule_({
    date: date, courseId: attCellToText_(cell(C.COURSE_ID), '', tz), className: attCellToText_(cell(C.CLASS_NAME), '', tz),
    level: attCellToText_(cell(C.LEVEL), '', tz), section: attCellToText_(cell(C.SECTION), '', tz), day: attCellToText_(cell(C.DAY), '', tz),
    schedStart: attCellToText_(cell(C.SCHED_START), 'time', tz), schedEnd: attCellToText_(cell(C.SCHED_END), 'time', tz),
    tz: attCellToText_(cell(C.TZ), '', tz), academicYear: attCellToText_(cell(C.ACADEMIC_YEAR), '', tz),
    personName: attCellToText_(cell(C.PERSON_NAME), '', tz), apsId: getAPSIdFromEmail(attCellToText_(cell(C.EMAIL), '', tz)), // always the centralized derivation
    email: attCellToText_(cell(C.EMAIL), '', tz), role: attCellToText_(cell(C.ROLE), '', tz),
    sessionCount: Number(cell(C.SESSION_COUNT)) || 0, sessionDetails: attCellToText_(cell(C.SESSION_DETAILS), '', tz),
    firstJoin: attCellToText_(cell(C.FIRST_JOIN), 'time', tz), lastLeave: attCellToText_(cell(C.LAST_LEAVE), 'time', tz),
    activeMinutes: Number(cell(C.ACTIVE_MINUTES)) || 0, status: status,
    lastUpdated: attCellToText_(cell(C.LAST_UPDATED), 'datetime', tz),
    autoStatus: attCellToText_(cell(C.AUTO_STATUS), '', tz) || status, // legacy rows: captured status was the only status
    overrideStatus: attCellToText_(cell(C.OVERRIDE_STATUS), '', tz),
    overrideBy: attCellToText_(cell(C.OVERRIDE_BY), '', tz),
    overrideAt: attCellToText_(cell(C.OVERRIDE_AT), 'datetime', tz),
    overrideReason: attCellToText_(cell(C.OVERRIDE_REASON), '', tz),
    captureSource: attCellToText_(cell(C.CAPTURE_SOURCE), '', tz),
    weekOf: attCellToText_(cell(C.WEEK_OF), '', tz) || attWeekIdForDateStr_(date),
    weekNo: Number(cell(C.WEEK_NO)) || '',
    callStart: attCellToText_(cell(C.CALL_START), 'time', tz),
    callEnd: attCellToText_(cell(C.CALL_END), 'time', tz),
    callMinutes: Number(cell(C.CALL_MINUTES)) || 0,
    attendedPct: Number(cell(C.ATTENDED_PCT)) || 0,
    autoScore: cell(C.AUTO_SCORE) === '' ? null : (Number(cell(C.AUTO_SCORE)) || 0), // null = legacy row, not yet scored
    score: cell(C.SCORE) === '' ? null : (Number(cell(C.SCORE)) || 0),
    actualClassMinutes: cell(C.ACTUAL_CLASS_MINUTES) === '' ? null : (Number(cell(C.ACTUAL_CLASS_MINUTES)) || 0), // null = captured before the class-duration rule
    effectiveClassMinutes: cell(C.EFFECTIVE_CLASS_MINUTES) === '' ? (Number(cell(C.CALL_MINUTES)) || 0) : (Number(cell(C.EFFECTIVE_CLASS_MINUTES)) || 0),
    classWindowBasis: attCellToText_(cell(C.CLASS_WINDOW_BASIS), '', tz)
  });
}

/**
 * Applies the class-duration rule on EVERY read, so no stored value can put
 * the wrong denominator on screen. Rows captured before the rule have no
 * Actual/Effective columns and carry the raw class minutes in 'Call Minutes'
 * (e.g. 155): their actual = that value, effective = getEffectiveClassMinutes()
 * (155 -> 95), and Attended % / captured score / status are recomputed
 * against the effective minutes (an override is left untouched). Such rows
 * are flagged `legacyDuration` so the next sync rewrites them in the sheet.
 */
function attApplyClassDurationRule_(r) {
  var stored = r.effectiveClassMinutes;
  r.legacyDuration = (r.actualClassMinutes === null || r.actualClassMinutes === undefined);
  var actual = r.legacyDuration ? (Number(r.callMinutes) || 0) : (Number(r.actualClassMinutes) || 0);
  var eff = getEffectiveClassMinutes(actual);
  r.actualClassMinutes = actual;
  if (!r.legacyDuration && eff === Number(stored) && eff === Number(r.callMinutes)) return r;
  r.effectiveClassMinutes = eff;
  r.callMinutes = eff;
  if (r.autoScore !== null && r.autoScore !== undefined) {
    r.attendedPct = attAttendedPct_(r.activeMinutes, eff);
    r.autoScore = attScoreForPct_(r.attendedPct);
    r.autoStatus = attStatusForScore_(r.autoScore);
    if (!r.overrideStatus) r.status = r.autoStatus;
    r.score = attEffectiveScore_(r);
  }
  return r;
}

/** Reads every data row of one AWK sheet via SpreadsheetApp, width-guarded so a pre-upgrade sheet with fewer physical columns can never throw. */
function attReadSheetRecords_(sheet) {
  var lastRow = sheet.getLastRow();
  if (lastRow < 2) return [];
  var width = Math.min(ATTENDANCE_HEADER_ROW.length, sheet.getMaxColumns());
  var tz = getAttendanceWorkbook_().getSpreadsheetTimeZone();
  return sheet.getRange(2, 1, lastRow - 1, width).getValues().map(function (row) { return attRowToRecord_(row, tz); });
}

/** Writes rows starting at `startRow` with the block text-formatted first, so Sheets never auto-converts dates/times/IDs again. */
function attWriteTextRows_(sheet, startRow, rows) {
  if (!rows.length) return;
  var range = sheet.getRange(startRow, 1, rows.length, rows[0].length);
  range.setNumberFormat('@');
  range.setValues(rows);
}

/** Captured-data fingerprint (excludes Last Updated) — lets the upsert skip rows, and whole-sheet writes, that did not actually change. */
function attCaptureSignature_(r) {
  return [r.courseId, r.date, r.personName, r.role, r.sessionCount, r.sessionDetails, r.firstJoin, r.lastLeave, r.activeMinutes, r.autoStatus, r.captureSource, r.className, r.schedStart, r.schedEnd, r.callStart, r.callEnd, r.callMinutes, r.attendedPct, r.autoScore, r.score, r.actualClassMinutes, r.effectiveClassMinutes, r.classWindowBasis, r.apsId].join('\u0001');
}

/**
 * Idempotent upsert for one WEEK's AWK sheet (all classrooms). Keyed by attRecordKey_()
 * (Course ID + Date + Email + Role). Changes vs. the original version:
 *  - a manual override on an existing row is PRESERVED — the new capture
 *    only refreshes the auto/captured fields, and Status stays the override;
 *  - rows whose captured data did not change keep their Last Updated, and
 *    if nothing changed at all the sheet is not written (most 15-minute runs);
 *  - no up-front clearContent(): rows are never removed, so the rewrite covers
 *    every existing row (no window where a concurrent reader sees an empty
 *    sheet); only a tail left over from collapsing legacy duplicates is cleared;
 *  - runs under the script lock shared with editAttendanceRecordStatus(), so
 *    an override saved mid-sync can no longer be overwritten by stale data.
 * Returns the number of new or changed rows.
 */
function upsertAttendanceRecordsForWeekSheet_(awkSheetName, records) {
  if (!records || !records.length) return 0;
  var lock = LockService.getScriptLock();
  lock.waitLock(20000);
  try {
    var sheet = getOrCreateAttendanceWeekSheet_(awkSheetName);
    var existing = attReadSheetRecords_(sheet);
    var byKey = {};
    var order = [];
    existing.forEach(function (r) {
      if (attIsExcludedEmail_(r.email)) return; // Admin/HM/hidden-prefix accounts are purged on every write
      var k = attRecordKey_(r.courseId, r.date, r.email, r.role);
      if (byKey[k]) return; // collapse legacy duplicates created by the old Date-cell key mismatch
      byKey[k] = r;
      order.push(k);
    });
    var changed = existing.length !== order.length ? 1 : 0; // duplicates collapsed or excluded rows purged -> must rewrite
    records.forEach(function (r) {
      if (attIsExcludedEmail_(r.email)) return;
      var k = attRecordKey_(r.courseId, r.date, r.email, r.role);
      var prev = byKey[k];
      if (!prev) { order.push(k); byKey[k] = r; changed++; return; } // new person/date -> append (never a duplicate: same key updates)
      if (prev.overrideStatus) {
        r.overrideStatus = prev.overrideStatus; r.overrideBy = prev.overrideBy;
        r.overrideAt = prev.overrideAt; r.overrideReason = prev.overrideReason;
        r.status = prev.overrideStatus;
        r.score = attEffectiveScore_(r);
      }
      var legacyNeedsUpgrade = !prev.weekOf || !prev.captureSource || !prev.weekNo || prev.autoScore === null || prev.legacyDuration;
      if (!legacyNeedsUpgrade && attCaptureSignature_(prev) === attCaptureSignature_(r) && prev.status === r.status) return; // unchanged
      byKey[k] = r;
      changed++;
    });
    if (!changed) return 0;
    // Week sheets hold every classroom: keep them readable — class, date, teachers first, then students A-Z.
    var sorted = order.map(function (k) { return byKey[k]; }).sort(attCompareRecordsForSheet_);
    var rows = sorted.map(attRecordToRow_);
    attWriteTextRows_(sheet, 2, rows); // whole block (incl. Course ID) text-formatted — same long-digit-ID trick as writeCache_
    if (rows.length < existing.length) {
      // Only when legacy duplicates were collapsed: blank the now-stale tail rows.
      sheet.getRange(2 + rows.length, 1, existing.length - rows.length, Math.min(ATTENDANCE_HEADER_ROW.length, sheet.getMaxColumns())).clearContent();
    }
    return changed;
  } finally {
    lock.releaseLock();
  }
}

/**
 * Batched read of many AWK sheets for the Attendance tab. One
 * Sheets.Spreadsheets.Values.batchGet (Sheets Advanced Service, already
 * enabled in appsscript.json) replaces the previous 2 calls PER COURSE
 * (getSheetByName + getRange/getValues), i.e. ~200 round trips for 100
 * courses -> 2. Falls back to per-sheet SpreadsheetApp reads if the
 * Advanced Service call fails for any reason, so behaviour never depends on it.
 * Returns { awkSheetName: [record, ...] }.
 */
function attReadRecordsForSheets_(sheetNames) {
  var out = {};
  if (!sheetNames.length) return out;
  var ss = getAttendanceWorkbook_();
  var existingNames = {};
  ss.getSheets().forEach(function (sh) { existingNames[sh.getName()] = true; });
  var names = sheetNames.filter(function (n) { return existingNames[n]; });
  if (!names.length) return out;
  var lastColLetter = attColumnLetter_(ATTENDANCE_HEADER_ROW.length);
  try {
    var resp = Sheets.Spreadsheets.Values.batchGet(ATTENDANCE_SPREADSHEET_ID, {
      ranges: names.map(function (n) { return "'" + n.replace(/'/g, "''") + "'!A2:" + lastColLetter; }),
      valueRenderOption: 'UNFORMATTED_VALUE',
      dateTimeRenderOption: 'SERIAL_NUMBER',
      majorDimension: 'ROWS'
    });
    (resp.valueRanges || []).forEach(function (vr, i) {
      out[names[i]] = (vr.values || []).filter(function (row) { return row && row.length && row[0] !== ''; })
        .map(function (row) { return attRowToRecord_(row, null); });
    });
    return out;
  } catch (e) {
    console.warn('[Attendance] batchGet failed, falling back to per-sheet reads: ' + (e && e.message ? e.message : String(e)));
  }
  names.forEach(function (n) { out[n] = attReadSheetRecords_(ss.getSheetByName(n)); });
  return out;
}

function attColumnLetter_(n) {
  var s = '';
  while (n > 0) { var m = (n - 1) % 26; s = String.fromCharCode(65 + m) + s; n = Math.floor((n - 1) / 26); }
  return s;
}

/** Sheet order for a week sheet: class, date, teachers first, then students by name. */
function attCompareRecordsForSheet_(a, b) {
  return String(a.className || '').localeCompare(String(b.className || '')) ||
    String(a.date || '').localeCompare(String(b.date || '')) ||
    String(b.role || '').localeCompare(String(a.role || '')) ||
    String(a.personName || '').localeCompare(String(b.personName || ''));
}

/** Newest date first, then class, then role (teachers first), then name. Safe on any value type. */
function attCompareRecords_(a, b) {
  return String(b.date || '').localeCompare(String(a.date || '')) ||
    String(a.className || '').localeCompare(String(b.className || '')) ||
    String(b.role || '').localeCompare(String(a.role || '')) ||
    String(a.personName || '').localeCompare(String(b.personName || ''));
}

// r69: getAttendanceRecordsForAdmin() removed — never called; every role (Admin / HM included) uses the role-aware
// read below, which applies the same server-side scope rules.

/**
 * Shared week-sheet reader for the read endpoints. Picks the fewest sheets
 * the filters need — one sheet for a week or a date filter, otherwise every
 * existing week sheet — reads them in ONE batched call, then keeps only rows
 * for `allowedCourseIds` (null = every course) and the filters' course/date/week.
 * Each record gets awkSheet and weekNo.
 */
function attReadRecordsForFilters_(filters, allowedCourseIds) {
  var week1 = getAttendanceWeek1Start_();
  var names;
  if (filters.weekOf) {
    var n = attWeekNumberForWeekId_(filters.weekOf, week1);
    names = n ? [formatAwkSheetName_(n)] : [];
  } else if (filters.date) {
    var byDate = attWeekSheetNameForDate_(filters.date, week1);
    names = byDate ? [byDate] : [];
  } else {
    names = attListWeekSheets_().map(function (w) { return w.name; });
  }
  var bySheet = attReadRecordsForSheets_(names);
  var out = [];
  names.forEach(function (name) {
    var weekNo = Number((ATTENDANCE_WEEK_SHEET_PATTERN_.exec(name) || [])[1]) || '';
    (bySheet[name] || []).forEach(function (r) {
      if (attIsExcludedEmail_(r.email)) return; // never shown, even before the next sync purges the row
      if (allowedCourseIds && !allowedCourseIds[r.courseId]) return;
      if (filters.courseId && r.courseId !== String(filters.courseId)) return;
      if (filters.date && r.date !== filters.date) return;
      if (filters.weekOf && r.weekOf !== filters.weekOf) return;
      r.awkSheet = name;
      r.weekNo = r.weekNo || weekNo;
      r.score = attEffectiveScore_(r); // always the effective (override-aware) score
      out.push(r);
    });
  });
  return out;
}

/**
 * NEW (Sept 2026 addendum) — role-aware attendance read callable by every
 * recognized role, not just Admin/HM/SuperAdmin. (The older Admin/HM-only
 * getAttendanceRecordsForAdmin was removed in r69 — it had no caller); this
 * is an additive sibling the Dashboard's Attendance tab now calls for
 * EVERY role, with the record set scoped server-side (never trusting a
 * client-supplied filter to widen access — see the module header comment
 * above ATTENDANCE_AUDIT_LOG_SHEET_NAME for the exact per-role scope rules).
 * Each returned record also carries `editable` (true/false) so the client
 * knows whether to show an Edit button — this is a display convenience
 * only; editAttendanceRecordStatus() below re-derives and enforces the same
 * rule server-side regardless of what the client sends.
 * Weekly-attendance round: supports filters.weekOf ('WK-yyyy-MM-dd'), reads
 * all in-scope sheets in one batched call, and for a Student strips the
 * override author/reason (they see only that the status was adjusted).
 */
function getAttendanceRecordsForViewer(sessionToken, filters) {
  apsRequireTabForToken_(sessionToken, 'attendance'); // r56: Admin Control → Access Control
  var session = requireValidSession_(sessionToken);
  var courses = readAllCoursesFromCache_();
  var viewer = { email: session.email, role: session.role };
  filters = filters || {};
  var allowed = null; // null = every course (Admin/HM/SuperAdmin/BOD)
  var canEditAny = isAdminOrHm_(viewer.role);
  // Sept 2026 addendum: BOD (vcfo_amchsts_bod) sees the same unrestricted course scope
  // as Admin/HM/SuperAdmin, but canEditAny (above) deliberately stays false for BOD —
  // every row it sees comes back with editable:false, and editAttendanceRecordStatus()
  // below is unchanged (still isAdminOrHm_-or-teacher-only), so this is read-only.
  var canSeeAll = canEditAny || viewer.role === VCFO_AMCHSTS_BOD_ROLE;

  if (canSeeAll) {
    // unrestricted — identical course scope to getAttendanceRecordsForAdmin
  } else if (viewer.role === 'teacher') {
    allowed = {};
    var elevatedCourse = {}; // VP / HM of the class (Class Support): every row of it, editable — HM-level for that class only
    courses.forEach(function (c) { if (userHasCourseAccess_(viewer.email, c)) allowed[String(c.id)] = true; if (classSupportElevated_(viewer, c)) elevatedCourse[String(c.id)] = true; });
    // r108: students CURRENTLY in this viewer's classes — their earlier attendance in a previous or closed class
    // (class move, merged / archived class) is shown too, view-only. Other students' rows of that class never are.
    var myStudents = {};
    courses.forEach(function (c) { if (allowed[String(c.id)]) (c.students || []).forEach(function (s) { var e = normalizeEmail_(s.email); if (e) myStudents[e] = true; }); });
  } else if (viewer.role === 'student') {
    allowed = {};
    courses.forEach(function (c) { if (courseHasStudentEmail_(c, viewer.email)) allowed[String(c.id)] = true; });
  } else {
    throw new Error('Only a recognized Admin, Headmaster, BOD, Teacher, or Student can view attendance.');
  }
  // Read-only for everyone when the role's dashboard permission is read-only (same gate the edit endpoint enforces).
  var mutationAllowed = true;
  try { requireDashboardMutationPermission_(viewer, 'edit attendance'); } catch (permErr) { mutationAllowed = false; }

  var out = [];
  var summaryMap = readAttendanceSummaryMap_(); // overall % per student per classroom (one small range read)
  // Class teacher(s) per course from the already-loaded cache — powers the tab's Teacher filter (no extra reads).
  var classTeachersByCourse = {};
  courses.forEach(function (c) {
    classTeachersByCourse[String(c.id)] = (c.teachers || []).filter(function (t) { return t.email && !attIsExcludedEmail_(t.email); })
      .map(function (t) { return { name: t.name || t.email, email: normalizeEmail_(t.email), apsId: getAPSIdFromEmail(t.email) }; });
  });
  var readScope = viewer.role === 'teacher' && filters.scope !== 'mine' ? null : allowed; // r108: teachers read every class, then keep only their scope + their students' history
  attReadRecordsForFilters_(filters, readScope).forEach(function (r) {
      if (readScope === null && allowed && !allowed[r.courseId]) {
        if (r.role !== ATTENDANCE_ROLE.STUDENT || !myStudents[normalizeEmail_(r.email)]) return; // not one of my students → never shown
        r.previousClass = true; // earlier class of a student now in my class — view-only (the edit endpoint refuses it too)
      }
      r.overallPct = attOverallFor_(summaryMap, r); // r82: students — across every class they attended (Re-Map safe)
      r.classTeachers = classTeachersByCourse[r.courseId] || [];
      var editable = false;
      if (canSeeAll) {
        editable = canEditAny; // Admin/HM/SuperAdmin may edit any row; BOD sees the same rows but never edits
        if (filters.role && r.role !== filters.role) return;
      } else if (viewer.role === 'teacher' && r.previousClass) {
        if (filters.role && r.role !== filters.role) return;
        editable = false; // r108: history from a previous / closed class is view-only
        r.overrideBy = ''; // who overrode it in the other class is not shown outside that class
      } else if (viewer.role === 'teacher' && elevatedCourse[r.courseId] && filters.scope !== 'mine') {
        editable = mutationAllowed;
        if (filters.role && r.role !== filters.role) return;
      } else if (viewer.role === 'teacher') {
        if (filters.scope === 'mine') {
          // "My Attendance": this teacher's own captured rows only, always view-only.
          if (r.role !== ATTENDANCE_ROLE.TEACHER || normalizeEmail_(r.email) !== viewer.email) return;
          editable = false;
        } else {
          // Default teacher view: their students' rows only, in courses they teach.
          if (r.role !== ATTENDANCE_ROLE.STUDENT) return;
          editable = true;
        }
      } else if (viewer.role === 'student') {
        // Own rows only, whatever role they're recorded under — always view-only.
        if (normalizeEmail_(r.email) !== viewer.email) return;
        editable = false;
        r.overrideBy = '';
        r.overrideReason = '';
      }
      // No other branch is reachable here: the course-scope check above already
      // restricted the allowed courses (and therefore viewer.role) to canSeeAll/teacher/student,
      // throwing for anyone else before this per-row loop ever runs.

      r.editable = editable && mutationAllowed;
      r.isOverridden = !!r.overrideStatus;
      out.push(r);
  });
  out.sort(attCompareRecords_);
  return out;
}

/**
 * ON-CALL TEACHER ATTENDANCE (Sept 27) — Admin / SuperAdmin / Headmaster /
 * BOD only (server-enforced). Every captured row of a TCS_ / TTS_ account
 * (see attIsOnCallEmail_) from the week sheets: classes where they are on
 * the roster AND classes whose Meet they joined without being rostered
 * (captureSource ON_CALL_GUEST). filters: { weekOf?: 'WK-…' (default all
 * weeks), includeNotJoined?: bool (default false — only classes they
 * actually joined or that were overridden, which keeps the payload small
 * since on-call accounts sit on many rosters) }.
 * Returns { rows, teachers (per-teacher summary), prefixes, generatedAt }.
 */
function getOnCallTeacherAttendance(sessionToken, filters) {
  apsRequireTabForToken_(sessionToken, 'attendance'); // r56: Admin Control → Access Control
  var session = requireValidSession_(sessionToken);
  var role = session.role;
  if (!isAdminOrHm_(role) && role !== VCFO_AMCHSTS_BOD_ROLE) throw new Error('Only Admin, Super Admin, Headmaster or BOD can view On-Call Teacher Attendance.');
  filters = filters || {};
  var rows = attReadRecordsForFilters_({ weekOf: filters.weekOf || '' }, null).filter(function (r) {
    if (r.role !== ATTENDANCE_ROLE.TEACHER || !attIsOnCallEmail_(r.email)) return false;
    return filters.includeNotJoined ? true : ((Number(r.activeMinutes) || 0) > 0 || !!r.overrideStatus);
  }).map(function (r) {
    return {
      date: r.date, weekNo: r.weekNo, weekOf: r.weekOf, day: r.day, courseId: r.courseId, className: r.className,
      personName: r.personName, email: normalizeEmail_(r.email), apsId: getAPSIdFromEmail(r.email),
      firstJoin: r.firstJoin, lastLeave: r.lastLeave, activeMinutes: Number(r.activeMinutes) || 0,
      countedMinutes: attCountedMinutes_(r), effectiveClassMinutes: r.effectiveClassMinutes, actualClassMinutes: r.actualClassMinutes,
      callStart: r.callStart, callEnd: r.callEnd, attendedPct: r.attendedPct, score: r.score, status: r.status,
      overrideStatus: r.overrideStatus || '', onRoster: r.captureSource !== ATTENDANCE_SOURCE.ON_CALL_GUEST,
      captureSource: r.captureSource, classWindowBasis: r.classWindowBasis || ''
    };
  });
  rows.sort(function (a, b) {
    return String(b.date).localeCompare(String(a.date)) || String(a.personName).localeCompare(String(b.personName)) || String(a.className).localeCompare(String(b.className));
  });
  var byTeacher = {};
  rows.forEach(function (r) {
    var t = byTeacher[r.email] || (byTeacher[r.email] = { email: r.email, name: r.personName, apsId: r.apsId, classesJoined: 0, classesRecorded: 0, meetMinutes: 0, countedMinutes: 0, pctSum: 0, weeks: {}, lastDate: '' });
    t.classesRecorded++;
    if (r.activeMinutes > 0) { t.classesJoined++; t.weeks[r.weekNo] = true; }
    t.meetMinutes += r.activeMinutes;
    t.countedMinutes += r.countedMinutes;
    t.pctSum += Number(r.attendedPct) || 0;
    if (r.date > t.lastDate) t.lastDate = r.date;
  });
  var teachers = Object.keys(byTeacher).map(function (k) {
    var t = byTeacher[k];
    return { email: t.email, name: t.name, apsId: t.apsId, classesJoined: t.classesJoined, classesRecorded: t.classesRecorded,
      weeksActive: Object.keys(t.weeks).length, meetMinutes: t.meetMinutes, countedMinutes: t.countedMinutes,
      avgAttendedPct: t.classesRecorded ? Math.round((t.pctSum / t.classesRecorded) * 100) / 100 : 0, lastDate: t.lastDate };
  }).sort(function (a, b) { return String(a.name).localeCompare(String(b.name)); });
  return { rows: rows, teachers: teachers, prefixes: attOnCallPrefixes_(), weekOf: filters.weekOf || '', includeNotJoined: !!filters.includeNotJoined,
    generatedAt: Utilities.formatDate(new Date(), APS_TZ, 'MM/dd/yyyy h:mm a') + ' EST' };
}

/**
 * Week picker options for the Attendance tab: every school week from Week 1
 * through the current Friday-anchored week (getCurrentWeekId_), newest
 * first, labelled "Week N — Sep 11 - Sep 13, 2026 (AWK01ATT)".
 * `defaultWeekId` is the most recent week that has already started — on
 * Mon-Thu getCurrentWeekId_() rolls FORWARD to the upcoming weekend (no
 * attendance yet), so the default falls back one week there. No Sheet reads.
 */
function getAttendanceWeekOptions(sessionToken) {
  apsRequireTabForToken_(sessionToken, 'attendance'); // r56: Admin Control → Access Control
  requireValidSession_(sessionToken);
  var now = new Date();
  var week1 = getAttendanceWeek1Start_();
  var currentId = getCurrentWeekId_(now);
  var todayStr = Utilities.formatDate(now, APS_TZ, 'yyyy-MM-dd');
  var currentNo = Math.max(1, attWeekNumberForWeekId_(currentId, week1));
  var weeks = [];
  for (var n = currentNo; n >= 1; n--) {
    var id = attWeekIdForNumber_(n, week1);
    weeks.push({ id: id, weekNo: n, awkSheet: formatAwkSheetName_(n), label: 'Week ' + n + ' — ' + getWeekLabel_(id).replace(/^Week of /, '') + ' (' + formatAwkSheetName_(n) + ')' });
  }
  var defaultWeekId = (currentId.slice(3) > todayStr && weeks.length > 1) ? weeks[1].id : weeks[0].id;
  return { weeks: weeks, defaultWeekId: defaultWeekId, currentWeekId: currentId, week1Start: week1 };
}

function getOrCreateAttendanceAuditLogSheet_() {
  var ss = getAttendanceWorkbook_();
  var sheet = ss.getSheetByName(ATTENDANCE_AUDIT_LOG_SHEET_NAME);
  if (!sheet) {
    sheet = ss.insertSheet(ATTENDANCE_AUDIT_LOG_SHEET_NAME);
    sheet.getRange(1, 1, 1, ATTENDANCE_AUDIT_LOG_HEADER_ROW.length).setValues([ATTENDANCE_AUDIT_LOG_HEADER_ROW]).setFontWeight('bold');
    sheet.setFrozenRows(1);
  }
  ensureSheetHeader_(sheet, ATTENDANCE_AUDIT_LOG_HEADER_ROW);
  return sheet;
}

/**
 * Appends one row to Attendance_Audit_Log — never edits or removes a prior
 * entry, so the log is a permanent, append-only trail of every Status edit.
 * Written text-formatted (not appendRow) so 'Attendance Date' stays a string
 * — an auto-converted Date cell made getAttendanceAuditLog()'s return value
 * illegal for google.script.run. Caller holds the script lock.
 */
function appendAttendanceAuditLogEntry_(entry) {
  appendAttendanceAuditLogEntries_([entry]);
}

/** Appends many audit rows in ONE write (bulk override). Same columns/format as appendAttendanceAuditLogEntry_. Caller holds the script lock. */
function appendAttendanceAuditLogEntries_(entries) {
  if (!entries || !entries.length) return;
  var sheet = getOrCreateAttendanceAuditLogSheet_();

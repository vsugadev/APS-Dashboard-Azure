 * request = { courseId, studentId, studentName, appreciationMessage } — studentId is the roster key from
 * getAppreciationCertificateStudents(); the destination email is ALWAYS taken from the server-side roster.
 * Returns { success, message, studentName, fileName }.
 */
function generateAppreciationCertificate(sessionToken, request) {
  apsRequireTabForToken_(sessionToken, 'letters.appreciation'); // r56: Admin Control → Access Control
  var session = requireValidSession_(sessionToken);
  var viewer = { email: session.email, role: session.role };
  requireDashboardMutationPermission_(viewer, 'generate certificates');
  var teacherEmail = normalizeEmail_(session.email);
  request = request || {};
  var audit = { teacherEmail: teacherEmail, studentId: String(request.studentId || '').slice(0, 200), courseId: String(request.courseId || '').slice(0, 60), senderRole: session.role };

  // 1–2. Teacher + authorized course + student on that course's roster (browser values are only lookup keys).
  var courses = appreciationTeacherCourses_(session);
  if (request.manual === true) {
    return appreciationManualIssue_(session, request, audit, 'student', request.studentName,
      'APS Appreciation Certificate', APPRECIATION_LETTER_TYPE, courses);
  }
  var studentKey = normalizeEmail_(request.studentId);
  if (!studentKey) throw new Error(APPRECIATION_MSG_.noStudent);
  var course = courses.filter(function (c) { return String(c.id) === audit.courseId; })[0];
  var student = course && (course.students || []).filter(function (s) { return normalizeEmail_(s.email) === studentKey; })[0];
  if (!course || !student) {
    audit.result = 'DENIED'; audit.details = 'student/course not in the teacher’s authorized roster';
    appendAppreciationAudit_(audit);
    throw new Error(APPRECIATION_MSG_.unauthorized);
  }
  var studentEmail = normalizeEmail_(student.email);
  audit.studentEmail = studentEmail; audit.courseName = course.name;
  // 3–5. Inputs
  var studentName = validateAppreciationStudentName_(request.studentName);
  var message = validateAppreciationMessage_(request.appreciationMessage);
  audit.studentName = studentName;
  if (!isApsEmailAllowed_(studentEmail)) { audit.result = 'REJECTED'; audit.details = 'no valid APS email'; appendAppreciationAudit_(audit); throw new Error(APPRECIATION_MSG_.badEmail); }

  return appreciationIssue_({ kind: 'student', recipientEmail: studentEmail, displayName: studentName, message: message,
    ccList: [teacherEmail, APPRECIATION_CERTIFICATE_CC_EMAIL], senderEmail: teacherEmail, dupScope: String(course.id), audit: audit,
    title: 'APS Appreciation Certificate' });
}

/**
 * Shared issue pipeline (student certificate + teacher letter): duplicate guard → server issue date → copy the
 * template (never edited) → fill + verify placeholders → PDF (copy trashed) → email → audit. Friendly errors only.
 */
function appreciationIssue_(o) {
  var audit = o.audit, cache = CacheService.getScriptCache();
  var dupKey = 'aps_appr_' + Utilities.base64EncodeWebSafe(o.senderEmail + '|' + o.recipientEmail + '|' + o.dupScope).slice(0, 200);
  var lock = LockService.getScriptLock();
  if (!lock.tryLock(10000)) throw new Error(APPRECIATION_MSG_.busy);
  try {
    if (cache.get(dupKey)) throw new Error(APPRECIATION_MSG_.busy);
    cache.put(dupKey, '1', 120); // same recipient again within 2 minutes = double click / resend
  } finally { lock.releaseLock(); }

  var issueDate = appreciationIssueDate_(new Date());
  var baseName = o.title + ' - ' + appreciationSafeFileName_(o.displayName) + ' - ' + issueDate;
  var fileName = baseName + '.pdf';
  audit.fileName = fileName;

  var templateFile;
  try { templateFile = DriveApp.getFileById(APPRECIATION_CERTIFICATE_TEMPLATE_ID); }
  catch (eT) {
    console.error('[Appreciation] template not accessible by the script owner (share template ' + APPRECIATION_CERTIFICATE_TEMPLATE_ID + ' with the deploying account): ' + (eT && eT.message));
    cache.remove(dupKey);
    audit.result = 'FAILED'; audit.details = 'template not accessible'; appendAppreciationAudit_(audit);
    throw new Error(APPRECIATION_MSG_.template);
  }
  var pdfBlob, copyId = '';
  try {
    var values = { '{{STUDENT_FULLNAME}}': o.displayName, '{{TEACHER_MESSAGE}}': o.message, '{{ISSUE_DATE}}': issueDate };
    var copy = templateFile.makeCopy(baseName);
    copyId = copy.getId();
    var doc = DocumentApp.openById(copyId);
    if (appreciationPlaceholdersInText_(doc).length === APPRECIATION_PLACEHOLDERS_.length) {
      // Placeholders are ordinary document text — fill them in place.
      var left = appreciationFillDoc_(doc, values);
      doc.saveAndClose();
      if (left.length) throw new Error('unresolved placeholders: ' + left.join(', '));
      pdfBlob = DriveApp.getFileById(copyId).getAs(MimeType.PDF).setName(fileName);
    } else {
      // r41: the placeholders sit inside text boxes / drawings (the certificate design), which
      // DocumentApp and the Docs API cannot read or edit — merge them through a .docx export instead.
      doc.saveAndClose();
      pdfBlob = appreciationPdfViaDocx_(baseName, values).setName(fileName);
    }
    if (APPRECIATION_CERTIFICATE_ARCHIVE_FOLDER_ID) {
      try { DriveApp.getFolderById(APPRECIATION_CERTIFICATE_ARCHIVE_FOLDER_ID).createFile(pdfBlob); } catch (eA) { console.warn('[Appreciation] archive copy failed: ' + (eA && eA.message)); }
    }
  } catch (eG) {
    console.error('[Appreciation] generation failed: ' + (eG && eG.message));
    cache.remove(dupKey);
    audit.result = 'FAILED'; audit.details = 'generation: ' + String(eG && eG.message || eG).slice(0, 200); appendAppreciationAudit_(audit);
    throw new Error(o.kind === 'teacher' ? APPRECIATION_MSG_.generateLetter : APPRECIATION_MSG_.generate);
  } finally {
    if (copyId) { try { DriveApp.getFileById(copyId).setTrashed(true); } catch (eC) { /* best-effort cleanup */ } }
  }

  try {
    sendAppreciationCertificateEmail_(o.recipientEmail, o.ccList, o.displayName, pdfBlob, o.kind);
  } catch (eM) {
    console.error('[Appreciation] email failed: ' + (eM && eM.message));
    audit.result = 'GENERATED_EMAIL_FAILED'; audit.details = String(eM && eM.message || eM).slice(0, 200); appendAppreciationAudit_(audit);
    throw new Error(o.kind === 'teacher' ? APPRECIATION_MSG_.emailLetter : APPRECIATION_MSG_.email);
  }
  audit.result = 'SENT'; appendAppreciationAudit_(audit);
  return { success: true, message: o.title + ' generated and emailed successfully to ' + o.displayName + '.', studentName: o.displayName, recipientName: o.displayName, fileName: fileName };
}

/** Professional APS email in the shared apsEmailShell_ style; PDF attached. */
function sendAppreciationCertificateEmail_(to, ccList, studentName, pdfBlob, kind) {
  var seen = {};
  var cc = (ccList || []).map(normalizeEmail_).filter(function (e) { if (!e || e === to || seen[e] || !isSyntacticallyValidEmail_(e)) return false; seen[e] = true; return true; }).join(',');
  var isTeacher = kind === 'teacher';

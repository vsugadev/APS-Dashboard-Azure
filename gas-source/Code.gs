  var hmvp = {};
  courses.forEach(function (c) {
    var name = String(c.name || '').trim();
    if (!courseNameMatches_(name) || (c.courseState && c.courseState !== 'ACTIVE')) return;
    var p = examQpParseClassName_(name);
    if (ex.test(name)) { out.excluded.push({ name: name.split('|')[0].trim(), reason: 'Test / staff classroom' }); return; }
    if (p.dayOfWeek === null || !p.start || !p.end) { out.excluded.push({ name: name.split('|')[0].trim(), reason: 'Day / time not readable from the class name' }); return; }
    var t = srmClassTeacher_(c, courses), chain = tkClassChain_(c, courses);
    chain.hm.concat(chain.vp).forEach(function (x) { if (x.email) hmvp[normalizeEmail_(x.email)] = true; });
    var cls = { id: String(c.id), name: name, nilai: p.grade, section: p.section, day: p.day, dow: p.dayOfWeek, start: p.startLabel, end: p.endLabel,
      startMin: p.start.hour * 60 + p.start.minute, endMin: p.end.hour * 60 + p.end.minute, n: (c.students || []).length,
      teacher: t && t.email ? { email: normalizeEmail_(t.email), name: t.name || t.email, apsId: adsApsId_(t.email) } : null };
    cls.slot = [cls.nilai.toUpperCase(), cls.dow, cls.startMin, cls.endMin].join('|');
    cls.code = (/^NILAI\s+\d+$/i.test(cls.nilai) ? cls.nilai.replace(/^NILAI\s+/i, 'Nilai ') : cls.nilai) + ' ' + cls.section;
    cls.band = ccwBand_(cls.n);
    if (!cls.teacher) out.reviewNotes.push(cls.code + ' (' + cls.day + ' ' + cls.start + '): no primary teacher found — Review Required.');
    out.classes.push(cls);
  });
  // teachers
  var byT = {};
  out.classes.forEach(function (c) { if (!c.teacher) return; var e = c.teacher.email; (byT[e] = byT[e] || { email: e, name: c.teacher.name, apsId: c.teacher.apsId, classes: [] }).classes.push(c); });
  Object.keys(byT).forEach(function (e) {
    var t = byT[e]; t.count = t.classes.length; t.students = t.classes.reduce(function (s, c) { return s + c.n; }, 0);
    if (t.count < 2) return;
    t.sameTime = false;
    t.classes.forEach(function (c, i) { t.classes.slice(i + 1).forEach(function (x) { if (ccwOverlap_(c, x)) t.sameTime = true; }); });
    out.multi.push({ email: e, name: t.name, apsId: t.apsId, count: t.count, students: t.students, sameTime: t.sameTime,
      classes: t.classes.map(function (c) { return { id: c.id, code: c.code, nilai: c.nilai, day: c.day, start: c.start, end: c.end, n: c.n }; }) });
  });
  out.multi.sort(function (a, b) { return b.count - a.count || b.students - a.students || String(a.name).localeCompare(String(b.name)); });
  // merges per slot (each class at most once)
  var slots = {};
  out.classes.forEach(function (c) { (slots[c.slot] = slots[c.slot] || []).push(c); });
  var used = {};
  Object.keys(slots).forEach(function (k) {
    ccwBestPartition_(slots[k]).forEach(function (g) {
      var m = ccwMergeRecord_(g, byT);
      g.forEach(function (c) { used[c.id] = true; });
      out.merges.push(m);
    });
  });
  out.merges.sort(function (a, b) { return (a.priority === b.priority ? 0 : a.priority === 'HIGH' ? -1 : 1) || a.combined - b.combined || String(a.nilai).localeCompare(String(b.nilai), undefined, { numeric: true }); });
  out.merges.forEach(function (m, i) { m.rank = i + 1; });
  // LOW / explore: a small class (≤4) with no same-time partner and a same-Nilai class at another time, combined ≤ 7
  out.classes.filter(function (c) { return c.n <= 4 && !used[c.id]; }).forEach(function (c) {
    var opts = out.classes.filter(function (x) { return x.id !== c.id && !used[x.id] && x.nilai.toUpperCase() === c.nilai.toUpperCase() && x.slot !== c.slot && x.n + c.n <= CCW_TARGET_; })
      .sort(function (a, b) { return (a.dow === c.dow ? 0 : 1) - (b.dow === c.dow ? 0 : 1) || b.n - a.n; }).slice(0, 3);
    opts = opts.filter(function (x) { return !out.explore.some(function (p) { return p.id === x.id && p.options.some(function (o) { return o.id === c.id; }); }); });
    if (opts.length) out.explore.push({ id: c.id, code: c.code, nilai: c.nilai, day: c.day, start: c.start, end: c.end, n: c.n, teacher: c.teacher ? c.teacher.name : '',
      options: opts.map(function (x) { return { id: x.id, code: x.code, day: x.day, start: x.start, end: x.end, n: x.n, combined: x.n + c.n }; }) });
  });
  // counts + impact
  var bands = { CRITICAL: 0, REVIEW: 0, NEAR_TARGET: 0, TARGET: 0, MAXIMUM: 0, OVER: 0 };
  out.classes.forEach(function (c) { bands[c.band]++; });
  var high = out.merges.filter(function (m) { return m.priority === 'HIGH'; }), med = out.merges.filter(function (m) { return m.priority === 'MEDIUM'; });
  var reduced = function (list) { return list.reduce(function (s, m) { return s + m.classes.length - 1; }, 0); };
  var released = function (list) { // teachers whose every class is merged away
    var gone = {}; list.forEach(function (m) { m.classes.forEach(function (c) { if (!c.continuing && c.teacherEmail) gone[c.teacherEmail] = (gone[c.teacherEmail] || 0) + 1; }); });
    return Object.keys(gone).filter(function (e) { return byT[e] && gone[e] >= byT[e].count; }).length;
  };
  out.bands = bands;
  out.counts = { classes: out.classes.length, students: out.classes.reduce(function (s, c) { return s + c.n; }, 0), teachers: Object.keys(byT).length, multi: out.multi.length,
    high: high.length, medium: med.length, low: out.explore.length };
  out.impact = { classesReducedHigh: reduced(high), classesReducedAll: reduced(out.merges), assignmentsReducedHigh: reduced(high), assignmentsReducedAll: reduced(out.merges),
    teachersReleasedHigh: released(high), teachersReleasedAll: released(out.merges) };
  out.target7 = out.classes.filter(function (c) { return c.n === CCW_TARGET_; }).map(function (c) { return c.code + ' (' + c.day + ' ' + c.start + ')'; });
  out.max8 = out.classes.filter(function (c) { return c.n === CCW_MAX_; }).map(function (c) { return c.code + ' (' + c.day + ' ' + c.start + ')'; });
  out.small = out.classes.filter(function (c) { return c.n <= 5; }).sort(function (a, b) { return a.n - b.n || String(a.code).localeCompare(String(b.code), undefined, { numeric: true }); })
    .map(function (c) { return { code: c.code, day: c.day, start: c.start, end: c.end, n: c.n, band: c.band, teacher: c.teacher ? c.teacher.name : 'Review Required', merged: !!used[c.id] }; });
  var rec = {};
  Object.keys(hmvp).forEach(function (e) { rec[e] = true; });
  (HEADMASTER_EMAILS || []).forEach(function (e) { e = normalizeEmail_(e); if (e) rec[e] = true; });
  ccwFixedRecipients_().forEach(function (e) { rec[e] = true; });
  out.recipients = Object.keys(rec).filter(isSyntacticallyValidEmail_).sort();
  out.classes = out.classes.map(function (c) { return { id: c.id, code: c.code, nilai: c.nilai, day: c.day, start: c.start, end: c.end, n: c.n, teacher: c.teacher ? c.teacher.email : '' }; }); // compact for storage
  return out;
}
/** Best non-overlapping groups (2–3 classes, combined ≤ 8) of one slot: most classes removed, then most exact-7, then fewest 8s. */
function ccwBestPartition_(cls) {
  var cand = cls.filter(function (c) { return c.n >= 1 && c.n <= CCW_MAX_ - 1; }).sort(function (a, b) { return a.n - b.n; }).slice(0, 14);
  var best = { key: [0, 0, 0], groups: [] };
  var better = function (a, b) { for (var i = 0; i < a.length; i++) { if (a[i] !== b[i]) return a[i] > b[i]; } return false; };
  var rec = function (rem, groups) {
    var key = [groups.reduce(function (s, g) { return s + g.length - 1; }, 0),
      groups.filter(function (g) { return ccwSum_(g) === CCW_TARGET_; }).length, -groups.filter(function (g) { return ccwSum_(g) === CCW_MAX_; }).length];
    if (better(key, best.key)) best = { key: key, groups: groups.map(function (g) { return g.slice(); }) };
    if (!rem.length) return;

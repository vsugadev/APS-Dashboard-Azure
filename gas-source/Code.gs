/**
 * SETUP — run ONCE from the Apps Script editor (script owner). Removes any existing Parent-Teacher Arranged triggers
 * and creates exactly three weekly triggers in America/New_York: Fri ~5:30 PM, Sat ~11:30 AM, Sun ~6:30 PM.
 * Safe to run again (never creates duplicates).
 */
function createParentTeacherArrangedCoverageTriggers() {
  apsRequireOwnerOrTrigger_(null);
  var removed = ptaDeleteTriggers_(), made = [];
  Object.keys(PTA_WINDOWS_).forEach(function (k) {
    var w = PTA_WINDOWS_[k];
    ScriptApp.newTrigger(w.handler).timeBased().onWeekDay(ScriptApp.WeekDay[w.weekDay]).atHour(w.hour).nearMinute(w.minute).inTimezone(APS_TZ).create();
    made.push(w.handler + ' — ' + w.label + ' ' + APS_TZ);

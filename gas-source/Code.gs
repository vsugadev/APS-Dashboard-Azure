    examQpAudit_(v, [{ type: EXAM_QP_EVENTS.UNAUTHORIZED_DOWNLOAD_ATTEMPT, examId: r ? r.Exam_ID : '', qpId: examQpClean_(req.questionPaperId, 40), className: r ? r.Class_Name : '', result: 'TEACHER_COPY_REFUSED', reason: acc.reason }]);
    throw new Error(acc.message);
  }
  const now = new Date();
  const block = examQpTeacherCopyBlock_(r, now.getTime());
  if (block) {
    examQpAudit_(v, [{ type: EXAM_QP_EVENTS.TEACHER_COPY_DENIED, examId: r.Exam_ID, qpId: r.Question_Paper_ID, className: r.Class_Name, result: 'DENIED', reason: block, metadata: { role: acc.label } }]);
    throw new Error(block);
  }
  const who = examQpPersonName_(course, v.email);
  const stamp = { name: 'TEACHER COPY - ' + who, apsId: getAPSIdFromEmail(v.email), email: v.email, className: r.Class_Name, shortClass: String(r.Class_Name).split('|')[0].trim(),
    examTitle: r.Exam_Title, downloadedLabel: examQpLabel_(now), questionPaperId: r.Question_Paper_ID, downloadKey: '', watermark: 'TEACHER COPY' };
  const fileName = 'TEACHER_COPY_' + examQpFileName_(r, who, stamp.apsId, now);
  examQpPutTicket_(ticket, { ticket: ticket, state: 'PENDING', email: v.email });
  const src = Utilities.base64Encode(DriveApp.getFileById(r.Question_Paper_File).getBlob().getBytes());
  return examQpPersonalizePdf_(src, stamp).then(function (b64) {
    let fileId = '';
    try { fileId = examQpFolders_().personalized.createFile(Utilities.newBlob(Utilities.base64Decode(b64), 'application/pdf', fileName)).getId(); } catch (e) { console.error('[ExamQP] teacher copy not archived: ' + (e && e.message)); }
    examQpAudit_(v, [{ type: EXAM_QP_EVENTS.TEACHER_COPY_DOWNLOADED, examId: r.Exam_ID, qpId: r.Question_Paper_ID, className: r.Class_Name, result: 'SUCCESS', metadata: { role: acc.label, fileId: fileId } }]);
    examQpPutTicket_(ticket, { ticket: ticket, kind: 'TEACHER', qpId: r.Question_Paper_ID, state: 'READY', fileId: fileId, fileName: fileName, downloadedLabel: stamp.downloadedLabel, studentName: stamp.name, apsId: stamp.apsId, email: v.email });
    return { ticket: ticket, state: 'READY', fileName: fileName, base64: b64, downloadedLabel: stamp.downloadedLabel };
  }).catch(function (e) {
    examQpAudit_(v, [{ type: EXAM_QP_EVENTS.TEACHER_COPY_DOWNLOADED, examId: r.Exam_ID, qpId: r.Question_Paper_ID, className: r.Class_Name, result: 'FAILED', reason: String(e && e.message || e) }]);
    const out = { ticket: ticket, state: 'FAILED', message: EXAM_QP_TCOPY_MSG_.FAILED };
    examQpPutTicket_(ticket, Object.assign({ email: v.email }, out));
    return out;
  });
}

function examQpSendAudit_(row) {
  try {
    const meta = examQpSheet_(EXAM_QP_SEND_SHEET_, EXAM_QP_SEND_HEADER_);
    examQpAppendAtomic_(meta, [examQpRowFromObject_(meta, row)]);

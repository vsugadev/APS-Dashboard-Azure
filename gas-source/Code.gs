  return grPromptState_(s.email, s.role);
}
/** event = GOOGLE_REVIEW_PROMPT_SHOWN | GOOGLE_REVIEW_CLICKED | GOOGLE_REVIEW_DISMISSED; place = POPUP | HEADER_BUTTON. Identity comes from the session only. */
function recordGoogleReviewEvent(sessionToken, event, place) {
  var s = requireValidSession_(sessionToken);
  event = String(event || '');
  if (!GR_EVENTS_[event]) throw new Error('Unknown event.');
  var email = normalizeEmail_(s.email);
  if (event === 'GOOGLE_REVIEW_PROMPT_SHOWN') {
    if (s.role !== 'student') return { recorded: false };
    var key = GR_PROMPT_PROP_PREFIX_ + email, month = grMonth_();
    if (apsBigGet_(key) === month) return { recorded: false, duplicate: true }; // once per month — a second "shown" is ignored
    apsBigSetSafe_(key, month, 'Google Review prompt'); // r103: second store; a failed write at most shows the popup again
  } else {
    var cache = CacheService.getScriptCache(), ck = 'gr_evt_' + Utilities.base64EncodeWebSafe(email + '|' + event).slice(0, 200);
    if (cache.get(ck)) return { recorded: false, throttled: true }; // a burst of clicks is logged once
    cache.put(ck, '1', 20);
  }
  var name = '';
  try { name = findDisplayName_(readAllCoursesFromCache_(), email) || ''; } catch (e) { /* name is optional */ }
  var apsId = extractAPSID_(email);
  try {
    ctaSheet_(GR_EVENT_SHEET_, GR_EVENT_HEADER_).appendRow([new Date().toISOString(), apsId === 'NA' ? 'APSXXX' : apsId, email, name || localPartOfEmail_(email), s.role, event, 'Dashboard', GR_PLACES_[place] || '']);
  } catch (e2) { console.warn('[GoogleReview] event not logged: ' + (e2 && e2.message)); }
  return { recorded: true };
}

/* ==========================================================================
 *  r84 — ASSIGN CLASSROOM → ADD/REMOVE STUDENT (the r60 "Remove Student" sub-tab, renamed)
 *  ADD: Admin / Super Admin ("Sub-Admin" = Admin; there is no separate role) add a student,
 *  by APS email, to ONE active AY26-27 Google Classroom WITHOUT removing any other membership.
 *    - Every current Google Classroom membership is shown (live Courses.list?studentId,
 *      dashboard roster as the fallback) with its type REGULAR_ACADEMIC / SPECIAL_CLASS / OTHER
 *      (Special Classes sheet Google Classroom IDs + Script Properties SPECIAL_CLASS_COURSE_IDS /
 *      CLASSROOM_TYPE_OVERRIDES, then the course name as the fallback).
 *    - Regular + Special, Special + Special: allowed. Regular + Regular: allowed only after the
 *      admin ticks the acknowledgement (ADMIN_OVERRIDE). Same classroom: ALREADY_ENROLLED, no change.
 *    - Server re-checks role, student, classroom and membership on Confirm; the add goes through
 *      Classroom.Courses.Students.create (same call Re-Map uses) and is verified with Students.get.
 *    - Audit sheet Student_Add_Audit (request fields immutable, Request_ID = idempotency key) and a
 *      one-line copy in the existing Assign Classroom audit log.
 *    - Email From donotreply@ to the Primary Teacher, HM(s), VP(s) — admin@ CC — after a verified add.
 *      An email failure never rolls the add back; a dashboard-cache update failure shows the
 *      "synchronization pending — do not retry" warning.
 *  WEEKLY: Monday ~7:30 AM America/New_York, one email to admin@ listing every student in 2+ active
 *  classrooms (Regular + Regular flagged "requires review"). Never removes anyone.
 * ========================================================================== */
var ADS_SHEET_ = 'Student_Add_Audit';
var ADS_HEADER_ = ['Request_ID', 'Requested_At', 'Requested_By', 'Requested_By_Role', 'Action', 'Student_Name', 'Student_APSID', 'Student_Email',
  'Existing_Classroom_Count', 'Existing_Classroom_Names', 'Existing_Classroom_Types', 'New_Classroom_Name', 'New_Course_ID', 'New_Classroom_Type', 'Override_Reason', 'Source',
  'Status', 'Verification_Status', 'Sheet_Update_Status', 'Email_Status', 'Email_Recipients', 'Result_Message', 'Error', 'Completed_At', 'Zoho_Student_ID'];
// Status values (picklist): SUCCESS, FAILED, CANCELLED, ALREADY_ASSIGNED, ALREADY_ENROLLED, VALIDATION_FAILED, IN_PROGRESS (transient)
var ADS_ACTIONS_ = { ADD: 'ADD_STUDENT_TO_CLASSROOM', ADD_MULTI: 'ADD_STUDENT_TO_MULTIPLE_CLASSROOMS', REMOVE: 'REMOVE_STUDENT_FROM_CLASSROOM', WEEKLY: 'WEEKLY_MULTIPLE_CLASSROOM_REPORT' };
var ADS_TYPES_ = { REGULAR_ACADEMIC: 'Regular Academic', SPECIAL_CLASS: 'Special Class', OTHER: 'Other' };
var ADS_NO_PERMISSION_ = 'You do not have permission to perform this action.';
var ADS_MULTI_ACK_ = 'I understand this student will be enrolled in more than one Regular Academic Classroom.';
var ADS_SOURCE_ = 'Dashboard – Assign Classroom → Add/Remove Student';
var ADS_SPECIAL_NAME_RE_ = /special|workshop|camp\b|club\b|summer|spelling|competition|சிறப்பு/i;
var ADS_INVALID_EMAIL_ = 'Please enter a valid APS email address (for example name_aps1234@avvaiyarpadasalai.org).';
var ADS_NOT_FOUND_ = 'Student not found. Please verify the APS email address.';
var ADS_CLASS_UNAVAILABLE_ = 'The selected Google Classroom is not available. Please choose another classroom.';

/** Admin / Super Admin (forChange) — BOD may only read the audit (through getRemovalContext). Access Control row: assignClassroom.remove. */
function adsViewer_(sessionToken, forChange) {
  var s = requireValidSession_(sessionToken);
  var admin = isAdminRole_(s.role);
  if (!admin && (forChange || s.role !== VCFO_AMCHSTS_BOD_ROLE)) throw new Error(ADS_NO_PERMISSION_);
  if (!apsTabAllowed_(s.role, 'assignClassroom.remove')) throw new Error(AC_OFF_MSG_);
  if (forChange) requireDashboardMutationPermission_({ email: s.email, role: s.role }, 'add a student to a Google Classroom');
  return { email: normalizeEmail_(s.email), role: s.role, canAdd: admin };
}
/** Trim + lowercase + an approved APS domain (APS_ALLOWED_DOMAINS). */
function adsNormalizeApsEmail_(raw) {
  var e = String(raw || '').trim().toLowerCase();
  if (!e) throw new Error('Enter the student\'s APS email address.');
  if (e.length > 254 || !isSyntacticallyValidEmail_(e) || APS_ALLOWED_DOMAINS.indexOf(e.split('@')[1]) === -1) throw new Error(ADS_INVALID_EMAIL_);
  return e;
}
function adsApsId_(email) { var a = extractAPSID_(email); return a === 'NA' ? 'APSXXX' : a; }
function adsIsNotFound_(e) { return /not ?found|404|NOT_FOUND|Resource Not Found|does not exist/i.test(String(e && e.message || e)); }
/** The student account: dashboard roster first (no API call), then Admin Directory, then the Classroom user profile. Throws friendly messages only. */
function adsResolveStudent_(email, courses) {
  var name = '', hit = false;
  (courses || []).some(function (c) {
    var s = (c.students || []).filter(function (x) { return normalizeEmail_(x.email) === email; })[0];
    if (s) { name = s.name || ''; hit = true; }
    return hit;
  });
  if (!hit) {
    var user = null, dirErr = null;
    try { user = AdminDirectory.Users.get(email); } catch (e) { dirErr = e; }
    if (user) {
      if (user.suspended || user.archived) throw new Error('This student account cannot be used (it is suspended or archived). Please verify the APS email address.');
      name = (user.name && user.name.fullName) || '';
    } else if (dirErr && adsIsNotFound_(dirErr)) {
      throw new Error(ADS_NOT_FOUND_);
    } else {
      var prof = null;
      try { prof = callWithBackoff_(function () { return Classroom.UserProfiles.get(email); }); }
      catch (e2) {
        if (adsIsNotFound_(e2)) throw new Error(ADS_NOT_FOUND_);
        console.warn('[AddStudent] account check unavailable: ' + srmSafeErr_(e2));
        throw new Error('The student account could not be verified right now. Please try again later.');
      }
      name = (prof && prof.name && prof.name.fullName) || '';
    }
  }
  name = splitNameAndPhone_(name || '').name || localPartOfEmail_(email);
  return { email: email, name: name, apsId: adsApsId_(email), onDashboard: hit };
}
/** Google Classroom IDs that are Special Classes: the Special Classes sheet (Google Classroom ID + Enrollment Options) and Script Property SPECIAL_CLASS_COURSE_IDS. */
function adsSpecialIds_() {
  var ids = {};
  String(rosterProp_('SPECIAL_CLASS_COURSE_IDS', '')).split(/[\s,;]+/).forEach(function (x) { if (/^\d{1,30}$/.test(x)) ids[x] = 'SPECIAL_CLASS'; });
  try { scRecords_().forEach(function (p) { if (p.classroomId) ids[p.classroomId] = 'SPECIAL_CLASS'; (p.options || []).forEach(function (o) { if (o.classroomId) ids[o.classroomId] = 'SPECIAL_CLASS'; }); }); }
  catch (e) { /* Special Classes sheet unavailable — the name fallback still applies */ }
  try { // CLASSROOM_TYPE_OVERRIDES = {"<courseId>": "REGULAR_ACADEMIC" | "SPECIAL_CLASS" | "OTHER"} wins over everything
    var ov = JSON.parse(String(rosterProp_('CLASSROOM_TYPE_OVERRIDES', '{}')) || '{}');
    Object.keys(ov || {}).forEach(function (k) { if (ADS_TYPES_[ov[k]]) ids[String(k)] = ov[k]; });
  } catch (e2) { console.warn('[AddStudent] CLASSROOM_TYPE_OVERRIDES is not valid JSON — ignored'); }
  return ids;
}
function adsClassify_(id, name, specialIds) {
  if (specialIds && specialIds[String(id)]) return specialIds[String(id)];
  var n = String(name || '');
  if (ADS_SPECIAL_NAME_RE_.test(n)) return 'SPECIAL_CLASS';
  if (extractNilaiFromCourseName_(n) && parseCourseSchedule_(n)) return 'REGULAR_ACADEMIC';
  return 'OTHER';
}
/** "FRI 6:30 - 8:00 PM EST" from "NILAI 3 - EF | FRI 6:30 - 8:00 PM EST | AY26-27" ('' when the name has no schedule). */
function adsSchedule_(name) { var p = String(name || '').split('|'); return p.length >= 2 ? p[1].trim() : ''; }
function adsClassInfo_(c, courses, specialIds) {
  var name = String(c.name || ''), head = name.split('|')[0], sched = adsSchedule_(name), t = srmClassTeacher_(c, courses), type = adsClassify_(c.id, name, specialIds);
  var dash = head.lastIndexOf(' - ');
  return { courseId: String(c.id), name: name, nilai: extractNilaiFromCourseName_(name) || (dash > 0 ? head.slice(0, dash).trim() : head.trim()), section: dash > 0 ? head.slice(dash + 3).trim() : '',
    day: sched.split(/\s+/)[0] || '', time: sched.split(/\s+/).slice(1).join(' '), schedule: sched, teacher: t ? t.name : '', count: (c.students || []).length, status: 'ACTIVE', type: type, typeLabel: ADS_TYPES_[type] };
}
/** Every ACTIVE Google Classroom the student is in (live; the dashboard roster when the live list is unavailable). */
function adsMemberships_(email, courses, specialIds) {
  var byId = {}; (courses || []).forEach(function (c) { byId[String(c.id)] = c; });
  var list = [], live = true;
  try {
    var tok = null, guard = 0;
    do {
      var pt = tok;
      var r = callWithBackoff_(function () { return Classroom.Courses.list(pt ? { studentId: email, courseStates: ['ACTIVE'], pageSize: 100, pageToken: pt } : { studentId: email, courseStates: ['ACTIVE'], pageSize: 100 }); });
      (r && r.courses || []).forEach(function (c) { list.push({ id: String(c.id), name: String(c.name || ''), state: String(c.courseState || 'ACTIVE') }); });
      tok = r && r.nextPageToken;
    } while (tok && ++guard < 10);
  } catch (e) {
    console.warn('[AddStudent] live membership list unavailable — dashboard roster used: ' + srmSafeErr_(e));
    live = false; list = [];
    (courses || []).forEach(function (c) { if (courseHasStudentEmail_(c, email)) list.push({ id: String(c.id), name: String(c.name || ''), state: 'ACTIVE' }); });
  }
  var seen = {};
  return { live: live, items: list.filter(function (m) { if (seen[m.id]) return false; seen[m.id] = true; return true; }).map(function (m) {
    var c = byId[m.id], info = c ? adsClassInfo_(c, courses, specialIds) : null, type = info ? info.type : adsClassify_(m.id, m.name, specialIds);
    return { courseId: m.id, name: m.name, type: type, typeLabel: ADS_TYPES_[type], teacher: info ? info.teacher : '', schedule: adsSchedule_(m.name), status: m.state, onDashboard: !!c };
  }) };
}
function adsRoleLabel_(role) { return role === SUPERADMIN_ROLE ? 'Super Admin' : 'Admin'; }

/* ---------- audit sheet (Student_Removal_Audit pattern: request fields written once, status columns later) ---------- */
function adsSheet_() { return ctaSheet_(ADS_SHEET_, ADS_HEADER_); }
function adsRows_() {
  var sh = getWorkbook_().getSheetByName(ADS_SHEET_);
  if (!sh || sh.getLastRow() < 2) return [];
  return sh.getRange(2, 1, sh.getLastRow() - 1, ADS_HEADER_.length).getValues().map(function (r, i) {
    var o = { _row: i + 2 }; ADS_HEADER_.forEach(function (h, j) { o[h] = r[j] instanceof Date ? r[j].toISOString() : String(r[j] === null || r[j] === undefined ? '' : r[j]); }); return o;
  });
}
function adsWrite_(rec) {
  var sh = adsSheet_();
  var row = ADS_HEADER_.map(function (h) { var v = rec[h] === undefined ? '' : String(rec[h]); return /^[=+\-@]/.test(v) ? "'" + v : v; }); // never a formula
  if (!rec._row) { rec._row = sh.getLastRow() + 1; sh.getRange(rec._row, 1, 1, row.length).setNumberFormat('@').setValues([row]); return rec; }
  var first = ADS_HEADER_.indexOf('Status');
  sh.getRange(rec._row, first + 1, 1, row.length - first).setNumberFormat('@').setValues([row.slice(first)]);
  return rec;
}
/** Browser view of one audit row (the technical Error column is never sent to the browser). */
function adsPublic_(r) {
  return { requestId: r.Request_ID, requestedAt: srmFmt_(r.Requested_At), requestedAtIso: r.Requested_At, requestedBy: r.Requested_By, role: r.Requested_By_Role, action: r.Action,
    studentName: r.Student_Name, apsId: r.Student_APSID, studentEmail: r.Student_Email, existingCount: r.Existing_Classroom_Count, existingNames: r.Existing_Classroom_Names,
    existingTypes: r.Existing_Classroom_Types, newClassroom: r.New_Classroom_Name, newCourseId: r.New_Course_ID, newType: r.New_Classroom_Type, overrideReason: r.Override_Reason,
    status: r.Status, verification: r.Verification_Status, sheetUpdate: r.Sheet_Update_Status, emailStatus: r.Email_Status, recipients: r.Email_Recipients, message: r.Result_Message };
}
function adsAudit_(rows) { return (rows || adsRows_()).slice().sort(function (a, b) { return a.Requested_At < b.Requested_At ? 1 : -1; }).slice(0, 300).map(adsPublic_); }
/** One line in the existing Assign Classroom audit log (Assignment_Audit sheet) — "ACTION · STATUS" in its Action column. */
function adsMirror_(actor, action, status, studentName, studentEmail, fromText, toName, toTiming, count, reason) {
  try {
    getOrCreateAssignmentAuditSheet_().appendRow([new Date().toISOString(), actor || '', studentName || '', studentEmail || '', fromText || '', '', toName || '', toTiming ? appendEstLabel_(toTiming) : '', count === undefined ? '' : count, action + ' · ' + status, reason || '']);
  } catch (e) { console.warn('[AddStudent] assignment audit copy failed: ' + (e && e.message)); }
}
function adsFinish_(rec, status, message) {
  rec.Status = status; rec.Result_Message = message; rec.Completed_At = rec.Completed_At || new Date().toISOString();
  adsWrite_(rec);
  adsMirror_(rec.Requested_By, rec.Action, status, rec.Student_Name, rec.Student_Email, rec.Existing_Classroom_Names, rec.New_Classroom_Name, adsSchedule_(rec.New_Classroom_Name), rec._countAfter, rec.Override_Reason || message);
  return rec;
}
function adsResult_(rec, extra) {
  var out = { ok: rec.Status === 'SUCCESS', status: rec.Status, message: rec.Result_Message, record: adsPublic_(rec), audit: adsAudit_() };
  Object.keys(extra || {}).forEach(function (k) { out[k] = extra[k]; });
  return out;
}

/** Step 1–3 of Add Student: validate the APS email, check the account, list its memberships + the AY classrooms to pick from. */
function getAddStudentContext(sessionToken, studentEmail) {
  adsViewer_(sessionToken, true);
  var email = adsNormalizeApsEmail_(studentEmail);
  var courses = readAllCoursesFromCache_();
  var st = adsResolveStudent_(email, courses);
  var special = adsSpecialIds_();
  var mem = adsMemberships_(email, courses, special), inIds = {};
  mem.items.forEach(function (m) { inIds[m.courseId] = true; });
  var classes = courses.filter(function (c) { return courseNameMatches_(c.name); }).map(function (c) { var o = adsClassInfo_(c, courses, special); o.alreadyEnrolled = !!inIds[o.courseId]; return o; })
    .sort(function (a, b) { return naturalCompareJs_(a.name, b.name); });
  return { student: st, memberships: mem.items, membershipsLive: mem.live, hasRegular: mem.items.some(function (m) { return m.type === 'REGULAR_ACADEMIC'; }), classes: classes,
    maxStudents: APS_CLASS_TIMINGS.MAX_STUDENTS, multiAck: ADS_MULTI_ACK_, mailReady: apsMailMode_('TICKETS') !== 'NOT_CONFIGURED' };
}
function adsClassroomError_(e) {
  var raw = String(e && e.message || e);
  if (/ALREADY_EXISTS|already exists|409/i.test(raw)) return { status: 'ALREADY_ASSIGNED', msg: 'Student Already Enrolled — Google Classroom reports that this student is already a member of this classroom. No changes were made.' };
  if (/PERMISSION_DENIED|permission|forbidden|403|The caller does not have/i.test(raw)) return { status: 'FAILED', msg: 'The dashboard does not have permission to add students to this Google Classroom. Please contact APS Tech Support. No changes were made.' };
  if (/not ?found|404|NOT_FOUND|FAILED_PRECONDITION|INVALID_ARGUMENT|UserInIllegalDomain|invalid/i.test(raw)) return { status: 'FAILED', msg: 'This student account could not be added to the Google Classroom. Please verify the APS email address. No changes were made.' };
  return { status: 'FAILED', msg: 'Google Classroom is temporarily unavailable. Please try again later. No changes were made.' };
}
/** Adds the new student to the course's cached row (Detail JSON + Student Count) so the dashboard shows it before the next sync. */
function adsPatchCourseCache_(courseId, st) {
  var sheet = getOrCreateCacheSheet_(), data = sheet.getDataRange().getValues();
  for (var i = 1; i < data.length; i++) {
    if (String(data[i][0]) !== String(courseId) || !data[i][17]) continue;
    var c = JSON.parse(data[i][17]);
    c.students = c.students || [];
    if (!c.students.some(function (x) { return normalizeEmail_(x.email) === st.email; })) c.students.push(st);
    c.studentCount = c.students.length; c.noStudents = c.students.length === 0;
    sheet.getRange(i + 1, 7).setValue(c.studentCount);
    sheet.getRange(i + 1, 18).setValue(JSON.stringify(c));
    invalidateCoursesMemo_();
    return c.studentCount;
  }
  throw new Error('The classroom row was not found in the dashboard cache.');
}
/**
 * Confirm & Add. req = { studentEmail, courseId, requestId, confirmed: true, confirmMultiRegular }.
 * Never removes anyone. Same Request_ID again → the stored result (no second add).
 */
function addStudentToClassroom(sessionToken, req) {
  var v = adsViewer_(sessionToken, true);
  req = req || {};
  var requestId = String(req.requestId || '').replace(/[^A-Za-z0-9_-]/g, '').slice(0, 64);
  if (!requestId) throw new Error('Missing request id — reload the page and try again.');
  if (req.confirmed !== true) throw new Error('Please review and confirm the addition first.');
  var email = adsNormalizeApsEmail_(req.studentEmail), courseId = String(req.courseId || '').trim();
  if (!/^\d{1,30}$/.test(courseId)) throw new Error('Select a Google Classroom.');
  var lock = LockService.getScriptLock();
  if (!lock.tryLock(25000)) throw new Error('Another change is being processed — please try again in a moment.');
  var rec, course, courses;
  try {
    var rows = adsRows_();
    var same = rows.filter(function (r) { return r.Request_ID === requestId; })[0];
    if (same) return adsResult_(same, { duplicate: true, message: 'This request was already submitted. ' + same.Result_Message });
    var tenMin = new Date(Date.now() - 10 * 60000).toISOString();
    var busy = rows.filter(function (r) { return r.Student_Email === email && r.New_Course_ID === courseId && r.Status === 'IN_PROGRESS' && r.Requested_At > tenMin; })[0];
    if (busy) throw new Error('Adding this student to this classroom is already in progress (' + busy.Request_ID + '). Please wait and refresh.');
    courses = readAllCoursesFromCache_();
    course = findCourseById_(courses, courseId);
    var special = adsSpecialIds_();
    var now = new Date().toISOString();
    rec = { Request_ID: requestId, Requested_At: now, Requested_By: v.email, Requested_By_Role: adsRoleLabel_(v.role), Action: ADS_ACTIONS_.ADD, Student_Name: email, Student_APSID: adsApsId_(email), Student_Email: email,
      Existing_Classroom_Count: '', Existing_Classroom_Names: '', Existing_Classroom_Types: '', New_Classroom_Name: course ? course.name : '', New_Course_ID: courseId,
      New_Classroom_Type: course ? adsClassify_(courseId, course.name, special) : '', Override_Reason: '', Source: ADS_SOURCE_,
      Status: 'IN_PROGRESS', Verification_Status: '', Sheet_Update_Status: '', Email_Status: '', Email_Recipients: '', Result_Message: '', Error: '', Completed_At: '', Zoho_Student_ID: '' };
    // 1) classroom — on the dashboard (active AY) AND active in Google Classroom right now
    if (!course || !courseNameMatches_(course.name)) return adsResult_(adsFinish_(rec, 'VALIDATION_FAILED', ADS_CLASS_UNAVAILABLE_));
    var live;
    try { live = callWithBackoff_(function () { return Classroom.Courses.get(courseId); }); } catch (eC) { rec.Error = 'Courses.get: ' + srmSafeErr_(eC); }
    if (!live || live.courseState !== 'ACTIVE') return adsResult_(adsFinish_(rec, 'VALIDATION_FAILED', ADS_CLASS_UNAVAILABLE_));
    // 2) student account
    var st;
    try { st = adsResolveStudent_(email, courses); } catch (eS) { return adsResult_(adsFinish_(rec, 'VALIDATION_FAILED', String(eS && eS.message || ADS_NOT_FOUND_))); }
    rec.Student_Name = st.name;
    // 3) current memberships
    var mem = adsMemberships_(email, courses, special);
    var others = mem.items.filter(function (m) { return m.courseId !== courseId; });
    rec.Existing_Classroom_Count = String(others.length);
    rec.Existing_Classroom_Names = others.map(function (m) { return m.name; }).join(' | ');

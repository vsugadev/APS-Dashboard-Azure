      resolved.primaryTeacher.forEach(function (p) { add(p.email, p.name, 'PRIMARY_TEACHER'); });
      resolved.headmaster.forEach(function (p) { add(p.email, p.name, 'HEADMASTER'); });
      resolved.vp.forEach(function (p) { add(p.email, p.name, 'VP'); });

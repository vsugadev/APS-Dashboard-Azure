    var partResp = [];
    if (partReq.length) { try { partResp = UrlFetchApp.fetchAll(partReq); } catch (ePart) { partResp = []; } }
    var userIdEmailCache = {};
    partResp.forEach(function (r, k) {
      var a = active[partIdx[k]];

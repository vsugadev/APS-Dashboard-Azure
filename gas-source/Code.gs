  });
  rows.forEach(function (o) {
    if (o.Status === 'PENDING' && !current[o.Record_Key]) { o.Status = 'CLEARED'; o.Cleared_At = today; cleared++; }
    if (o.Status === 'CLEARED' && o.Cleared_At && mhgDays_(o.Cleared_At, today) > cfg.keepClearedDays) return; // pruned
    if (!current[o.Record_Key]) out.push(o);
  });
  scan.records.forEach(function (r) {

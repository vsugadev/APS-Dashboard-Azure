/** 📧 Send to Student. req = { questionPaperId, studentEmail, confirmed:true, requestId }. Returns { ok, status, message }. */
function sendExamQuestionPaperToStudent(sessionToken, req) {
  const v = examQpStaffViewer_(sessionToken);
  requireDashboardMutationPermission_({ email: v.email, role: v.role }, 'email a question paper');
  req = req || {};
  if (req.confirmed !== true) throw new Error('Please confirm before sending the question paper.');
  const requestId = String(req.requestId || '').replace(/[^A-Za-z0-9_-]/g, '').slice(0, 64);
  if (!requestId) throw new Error('Missing request id — reload the page and try again.');
  const cache = CacheService.getScriptCache(), dupKey = 'examQpSend_' + requestId;
  const prior = cache.get(dupKey);
  if (prior) { try { const p = JSON.parse(prior); p.duplicate = true; return p; } catch (eP) { /* fall through */ } }
  const now = new Date();
  const r = examQpFindRecord_(String(req.questionPaperId || ''), true);
  const course = examQpCourseFor_(r);
  const acc = examQpStaffAccess_(v, r, course);
  const email = normalizeEmail_(req.studentEmail);
  const st = course ? (course.students || []).filter(function (x) { return normalizeEmail_(x.email) === email; })[0] : null;
  const base = {
    Send_ID: examQpNewId_('EQS', 8), Sent_Date_Time_EST: examQpTs_(now), Sender_Email: v.email, Sender_Role: acc ? acc.label : v.role,
    Student_Name: st ? st.name || email : '', Student_APSID: email ? getAPSIdFromEmail(email) : '', Student_Email: email,
    Exam_Title: r ? r.Exam_Title : '', Exam_ID: r ? r.Exam_ID : '', Question_Paper_ID: r ? r.Question_Paper_ID : examQpClean_(req.questionPaperId, 40),
    Class_Grade: r ? String(r.Class_Name).split('|')[0].trim() : '', Email_Status: '', Error_Message: '', Request_ID: requestId
  };
  const finish = function (ok, message, extra) {
    const row = Object.assign({}, base, { Email_Status: ok ? 'SENT' : 'FAILED', Error_Message: ok ? '' : String(message || '').slice(0, 500) });
    examQpSendAudit_(row);
    examQpAudit_(v, [{ type: EXAM_QP_EVENTS.QUESTION_PAPER_EMAILED, examId: base.Exam_ID, qpId: base.Question_Paper_ID, className: r ? r.Class_Name : '', studentName: base.Student_Name, apsId: base.Student_APSID, result: row.Email_Status, reason: row.Error_Message, metadata: { to: email, role: base.Sender_Role } }]);
    const out = Object.assign({ ok: ok, status: row.Email_Status, message: message, sentAt: row.Sent_Date_Time_EST }, extra || {});
    try { cache.put(dupKey, JSON.stringify(out), 600); } catch (eC) { /* ignore */ }
    return out;
  };
  if (!acc) return finish(false, EXAM_QP_MESSAGES_.UNAUTHORIZED);
  if (!st) return finish(false, 'This student is not on the roster of ' + (r ? base.Class_Grade : 'this class') + ' for this question paper.');
  if (!isSyntacticallyValidEmail_(email) || email.slice(-EXAM_QP_APS_DOMAIN_.length) !== EXAM_QP_APS_DOMAIN_)
    return finish(false, 'This student does not have a valid APS email address (' + (email || 'none') + '). The question paper was not sent.');
  const block = examQpStaffPaperBlock_(r, now.getTime());
  if (block) return finish(false, block);
  const studentName = st.name || email, apsId = getAPSIdFromEmail(email), downloadKey = examQpDownloadKey_(r.Question_Paper_ID, email);
  const stamp = { name: studentName, apsId: apsId, email: email, className: r.Class_Name, shortClass: base.Class_Grade, examTitle: r.Exam_Title,
    downloadedLabel: examQpLabel_(now), questionPaperId: r.Question_Paper_ID, downloadKey: downloadKey };
  const fileName = examQpFileName_(r, studentName, apsId, now);
  let src;
  try { src = Utilities.base64Encode(DriveApp.getFileById(r.Question_Paper_File).getBlob().getBytes()); }
  catch (eSrc) { return finish(false, 'The question paper PDF could not be read. Please try again or contact APS Tech Support.'); }
  return examQpPersonalizePdf_(src, stamp).then(function (b64) {
    const bytes = Utilities.base64Decode(b64);
    if (bytes.length > EXAM_QP_SEND_MAX_BYTES_) return finish(false, 'The question paper is too large to email (' + Math.round(bytes.length / 1048576) + ' MB). Please use ⬇️ Download Teacher Copy and share it another way.');
    try { examQpFolders_().personalized.createFile(Utilities.newBlob(bytes, 'application/pdf', 'EMAILED_' + fileName)); } catch (eArc) { console.error('[ExamQP] emailed copy not archived: ' + (eArc && eArc.message)); }
    const d = { studentName: studentName, apsId: apsId, examTitle: r.Exam_Title, classGrade: base.Class_Grade, senderName: examQpPersonName_(course, v.email), senderEmail: v.email, senderRole: acc.label,
      sentLabel: examQpLabel_(now), downloadKey: downloadKey };
    try {
      attMailSend_({ to: [email], cc: [], replyTo: v.email, subject: '[APS] Examination Question Paper – ' + r.Exam_Title + ' – ' + base.Class_Grade,
        html: examQpSendEmailHtml_(d), text: examQpSendEmailText_(d), attachments: [Utilities.newBlob(bytes, 'application/pdf', fileName)] });
    } catch (eMail) {
      if (eMail && eMail.apsPaused) attMailAlertAdmin_('Examination question paper email', eMail.message);
      return finish(false, 'The email could not be sent: ' + String(eMail && eMail.message || eMail).slice(0, 200) + '. Nothing was delivered — please try again later or use ⬇️ Download Teacher Copy.');
    }
    return finish(true, 'Question paper sent to ' + studentName + ' (' + email + ').');
  }).catch(function (e) {
    console.error('[ExamQP] send personalization failed: ' + (e && e.stack || e));
    return finish(false, EXAM_QP_MESSAGES_.DOWNLOAD_FAILED.replace('\n', ' '));
  });
}

/* ==========================================================================
 *  r99 — EXAM QUESTION PAPER: AUTOMATIC EMAIL FALLBACK
 *  The APS Dashboard download stays the official delivery. Per exam, Admin switches ON
 *  "Send Email to Student After [X] Minutes" (OFF by default; X = 1–120, stored on each paper record:
 *  Auto_Email_Enabled / Auto_Email_Minutes). From the exam start time + X minutes until the class end
 *  time, a 5-minute trigger looks at every published, unlocked paper with the setting ON and, for each
 *  enrolled student with an APS email:
 *    downloaded on the Dashboard            → nothing sent (NOT_REQUIRED, logged once)
 *    staff-marked ABSENT for that class date → NOT sent, UNREPORTED_ABSENCE (attendance never changed)
 *    confirmed in this class's Google Meet   → the student's own personalized copy (same Download Key,
 *        same watermark) is emailed to the student only — AUTO_EMAIL_SENT, once
 *    otherwise (offline / not seen / Meet status unknown) → NOT sent, STUDENT_NOT_ONLINE; re-checked
 *        on the next run until the class ends, so a student confirmed later still gets it.
 *  Google Meet participation = the existing live Meet monitor (classMeetLiveSnapshot_): a live
 *  participant now, or a Meet audit-log session in this class's Meet that reaches the exam start.
 *  A dashboard "Join to Google Meet" click alone is not proof.
 *  Reuses: examQpReadRecords_, examQpWindowOf_, examQpSummariesFor_, examQpDownloadKey_,
 *  examQpPersonalizePdf_, attMailSend_ (attendance@ — the existing exam sender), examQpSendAudit_,
 *  examQpAudit_, classMeetLiveSnapshot_, attReadSheetRecords_. One log row per student per state
 *  change in EXAM_QUESTION_PAPER_AUTO_EMAIL_LOG (key reference masked; the full key is only in the email).
 *  Script Property EXAM_QP_AUTO_EMAIL_ENABLED = 'false' turns the fallback off.
 * ========================================================================== */
const EXAM_QP_AUTO_ = {
  HANDLER: 'processExamQuestionPaperAutoEmail', SHEET: 'EXAM_QUESTION_PAPER_AUTO_EMAIL_LOG', ENABLED_PROP: 'EXAM_QP_AUTO_EMAIL_ENABLED',
  DEFAULT_MINUTES: 20, MIN_MINUTES: 1, MAX_MINUTES: 120, EVERY_MINUTES: 5, MAX_FAILS: 3, RUN_BUDGET_MS: 240000, MAX_SENDS_PER_RUN: 40, METHOD: 'AUTO_EMAIL_FALLBACK',
  RUN_KEY: 'examQpAuto_run_v1', CLAIM_PREFIX: 'examQpAuto_claim_'
};
const EXAM_QP_AUTO_HEADER_ = ['Log_ID', 'Evaluated_Date_Time_EST', 'Exam_ID', 'Exam_Title', 'Exam_Date', 'Exam_Start_Time', 'Question_Paper_ID', 'Course_ID', 'Class_Name',
  'Student_Name', 'Student_APSID', 'Student_Email', 'Configured_Minutes', 'Download_Status', 'Meet_Status', 'Attendance_Status', 'Eligibility', 'Email_Status', 'Delivery_Method',
  'Key_Reference', 'Result', 'Reason', 'Error_Message', 'Attempt'];
const EXAM_QP_AUTO_REASON_ = {
  SENT: 'NOT_DOWNLOADED_AFTER_CONFIGURED_TIME', NOT_ONLINE: 'STUDENT_NOT_ONLINE', UA: 'UNREPORTED_ABSENCE',
  DOWNLOADED: 'DASHBOARD_DOWNLOADED', NO_EMAIL: 'NO_VALID_APS_EMAIL', FAILED: 'EMAIL_DELIVERY_FAILED',
  MEET_UNKNOWN: 'MEET_STATUS_UNKNOWN' // r100: no Google Meet data for this class at the exam time (e.g. a custom-time exam) — never sent
};
function examQpAutoEnabled_() {
  return String(PropertiesService.getScriptProperties().getProperty(EXAM_QP_AUTO_.ENABLED_PROP) || 'true').trim().toLowerCase() !== 'false';
}
/** Configured minutes of one paper (1–120), or 0 when unset / invalid. */
function examQpAutoMinutesOf_(r) {
  const m = Number(r && r.Auto_Email_Minutes);
  return Math.floor(m) === m && m >= EXAM_QP_AUTO_.MIN_MINUTES && m <= EXAM_QP_AUTO_.MAX_MINUTES ? m : 0;
}
/** Installs the 5-minute check while a published paper with the setting ON is still upcoming; removes it otherwise. */
function examQpAutoSyncTrigger_() {
  const nowMs = Date.now();
  const recs = examQpReadRecords_(true);
  const need = (examQpAutoEnabled_() && recs.some(function (r) {
    if (r.Status !== EXAM_QP_STATUS.PUBLISHED || !examQpBool_(r.Auto_Email_Enabled)) return false;
    const w = examQpWindowOf_(r); return !!w && w.end.getTime() > nowMs;
  })) || recs.some(function (r) { return examQpTeacherCopyEmailPending_(r, nowMs); }); // r104: the same 5-minute run sends the Teacher Copy email
  return examQpAutoEnsureTrigger_(need);
}
/**
 * "Send Email to Student After [X] Minutes" for one exam (every class paper of that Exam_ID).
 * req = { examId, enabled: bool, minutes: 1-120 }. Same permission as managing question papers (Admin; HM only
 * when EXAM_QUESTION_PAPER_HM_CAN_MANAGE=true) — Teacher / Student / BOD can never change it.
 */
function setExamQuestionPaperAutoEmail(sessionToken, req) {
  apsRequireTabForToken_(sessionToken, 'exam.questionPaper');
  const v = examQpViewer_(sessionToken);
  examQpRequireManage_(v);
  requireDashboardMutationPermission_({ email: v.email, role: v.role }, 'change the automatic question paper email');
  req = req || {};
  const examId = String(req.examId || '');
  if (!EXAM_QP_EXAM_ID_RE_.test(examId)) throw new Error('Select an exam.');
  const enabled = req.enabled === true;
  const raw = req.minutes === undefined || req.minutes === null ? '' : String(req.minutes).trim();
  const minutes = Number(raw);
  if (enabled && (!/^\d+$/.test(raw) || minutes < EXAM_QP_AUTO_.MIN_MINUTES || minutes > EXAM_QP_AUTO_.MAX_MINUTES)) {
    throw new Error('Please enter a valid number of minutes (a whole number from ' + EXAM_QP_AUTO_.MIN_MINUTES + ' to ' + EXAM_QP_AUTO_.MAX_MINUTES + ').');
  }
  const recs = examQpReadRecords_(true).filter(function (r) { return r.Exam_ID === examId; });
  if (!recs.length) throw new Error('Exam not found.');
  const nowTs = examQpTs_(new Date());
  const changed = recs.filter(function (r) {
    const before = { on: examQpBool_(r.Auto_Email_Enabled), m: Number(r.Auto_Email_Minutes) || 0 };
    if (before.on === enabled && (!enabled || before.m === minutes)) return false;
    examQpTrack_(r); r.__before = before;
    r.Auto_Email_Enabled = String(enabled); r.Auto_Email_Minutes = String(enabled ? minutes : (before.m || ''));
    r.Updated_By = v.email; r.Updated_Date_Time = nowTs;
    return true;
  });
  if (changed.length) {
    examQpWriteRecords_(changed);
    examQpAudit_(v, changed.map(function (r) { return { type: EXAM_QP_EVENTS.SETTINGS_UPDATED, examId: r.Exam_ID, qpId: r.Question_Paper_ID, className: r.Class_Name, result: 'SUCCESS',
      reason: 'Send Email to Student After X Minutes: ' + (enabled ? 'ON, ' + minutes + ' minutes' : 'OFF'), metadata: { setting: 'AUTO_EMAIL_FALLBACK', before: r.__before, after: { on: enabled, minutes: enabled ? minutes : null } } }; }));
  }
  let trigger = false;
  try { trigger = examQpAutoSyncTrigger_(); } catch (eT) { console.warn('[ExamQP auto] trigger: ' + (eT && eT.message)); }
  // r100: the Google Meet check only covers each class's regular class time — warn for custom-time papers
  const custom = enabled ? recs.filter(function (r) { return examQpScheduleModeOf_(r) === 'CUSTOM'; }).length : 0;
  return { ok: true, examId: examId, enabled: enabled, minutes: enabled ? minutes : null, papers: recs.length, changed: changed.length, scheduler: trigger, customTimePapers: custom,
    message: (enabled ? 'ON — ' + minutes + ' minutes after the exam start, students who have not downloaded and are in the class Google Meet get their question paper by email.' : 'OFF — no automatic email for this exam.') +
      (custom ? ' Note: ' + custom + ' class paper(s) of this exam use a custom date/time; Google Meet participation can only be confirmed during a class\'s regular class time, so those students may not be emailed.' : '') };
}
/** "***-***-9M2": enough to match an answer sheet in the log; the full key is never stored here. */
function examQpAutoKeyRef_(key) { return key ? '***-***-' + String(key).slice(-3) : ''; }
/** Latest state per "qpId|email": { sent, fails, last:{Result,Reason,...}, sentAt } from the log sheet (one read).
 *  r100: strict = rethrow a read failure (the run must never treat "unreadable" as "never sent"). */
function examQpAutoState_(qpSet, strict) {
  const out = {};
  try {
    const ss = examQpSpreadsheet_(), sh = ss.getSheetByName(EXAM_QP_AUTO_.SHEET);
    if (!sh || sh.getLastRow() < 2) return out;
    const meta = examQpSheet_(EXAM_QP_AUTO_.SHEET, EXAM_QP_AUTO_HEADER_);
    meta.sheet.getRange(2, 1, meta.sheet.getLastRow() - 1, meta.width).getValues().forEach(function (row) {
      const o = examQpObjectFromRow_(meta, row);
      if (qpSet && !qpSet[o.Question_Paper_ID]) return;
      const k = o.Question_Paper_ID + '|' + normalizeEmail_(o.Student_Email);
      const s = out[k] || (out[k] = { sent: false, fails: 0, last: null, sentAt: '' });
      if (o.Result === 'AUTO_EMAIL_SENT') { s.sent = true; s.sentAt = String(o.Evaluated_Date_Time_EST); }
      if (o.Result === 'AUTO_EMAIL_FAILED') s.fails++;
      s.last = o;
    });
  } catch (e) { console.warn('[ExamQP auto] log read: ' + (e && e.message)); if (strict) throw e; }
  return out;
}
/** Google Meet participation of one student for this exam, from the existing live Meet monitor snapshot. */
function examQpAutoMeet_(snapshot, courseId, email, startMs) {
  const entry = snapshot && snapshot.byCourse ? snapshot.byCourse[String(courseId)] : null;
  if (!entry) return 'UNKNOWN'; // the class is not in its Meet window, or no Meet data for it
  const p = (entry.people || {})[email];
  if (p && p.r === 'S' && p.live) return 'ONLINE';
  if (p && p.r === 'S' && Number(p.last) >= startMs) return 'JOINED';
  return 'NOT_SEEN';
}
/** Attendance rows of one class date: { ok, byEmail: { email: { override, status } } } (read once per class date per run). */
function examQpAutoAttendance_(courseId, dateStr, memo) {
  const k = courseId + '|' + dateStr;
  if (memo[k]) return memo[k];
  const res = { ok: true, byEmail: {} };
  try {
    const name = attWeekSheetNameForDate_(dateStr, getAttendanceWeek1Start_());
    const sheet = name ? getAttendanceWorkbook_().getSheetByName(name) : null;
    if (sheet) attReadSheetRecords_(sheet).forEach(function (r) {
      if (String(r.courseId) !== String(courseId) || r.date !== dateStr || String(r.role).toUpperCase() !== ATTENDANCE_ROLE.STUDENT) return;
      res.byEmail[normalizeEmail_(r.email)] = { override: String(r.overrideStatus || '').toUpperCase(), status: String(r.status || '').toUpperCase() };
    });
  } catch (e) { res.ok = false; console.warn('[ExamQP auto] attendance read: ' + (e && e.message)); }
  memo[k] = res;
  return res;
}
function examQpAutoEmailHtml_(d) {

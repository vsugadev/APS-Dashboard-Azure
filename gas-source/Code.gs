const EXAM_QP_MESSAGES_ = {
  UNAUTHORIZED: 'You are not authorized to access this question paper.',
  INVALID_CLASS: 'This question paper is not assigned to your class.',
  INVALID_STUDENT: 'You are not enrolled in an eligible class for this question paper.',
  INVALID_APSID: 'The APSID entered does not match your student account.\nPlease verify your APSID and try again.',
  QUESTION_PAPER_NOT_FOUND: 'This question paper could not be found.',
  QUESTION_PAPER_CANCELLED: 'This question paper has been cancelled.',
  INVALID_EXAM: 'This question paper is not available.',
  QUESTION_PAPER_LOCKED: 'This question paper is temporarily unavailable. Please contact your Class Teacher.',
  CONFIRMATION_REQUIRED: 'Please confirm that you will not share this question paper with any other student.',
  VERIFICATION_FAILED: 'Please confirm your name to continue.',
  DOWNLOAD_WINDOW_CLOSED: 'The download window for this question paper has closed. Please contact your Class Teacher.',
  DOWNLOAD_FAILED: 'We could not generate your personalized question paper.\nPlease try again or contact APS Tech Support.'
};

/** General-audit event type for each download outcome. */
function examQpEventTypeFor_(status) {
  switch (status) {
    case EXAM_QP_DOWNLOAD_STATUS.DOWNLOAD_COMPLETED: return EXAM_QP_EVENTS.DOWNLOAD_COMPLETED;
    case EXAM_QP_DOWNLOAD_STATUS.DOWNLOAD_FAILED: return EXAM_QP_EVENTS.DOWNLOAD_FAILED;
    case EXAM_QP_DOWNLOAD_STATUS.INVALID_APSID: return EXAM_QP_EVENTS.INVALID_APSID;
    case EXAM_QP_DOWNLOAD_STATUS.DOWNLOAD_WINDOW_CLOSED: return EXAM_QP_EVENTS.LATE_DOWNLOAD_ATTEMPT;
    case EXAM_QP_DOWNLOAD_STATUS.INVALID_CLASS: case EXAM_QP_DOWNLOAD_STATUS.UNAUTHORIZED: case EXAM_QP_DOWNLOAD_STATUS.INVALID_STUDENT:
    case EXAM_QP_DOWNLOAD_STATUS.QUESTION_PAPER_NOT_FOUND: case EXAM_QP_DOWNLOAD_STATUS.INVALID_EXAM:
      return EXAM_QP_EVENTS.UNAUTHORIZED_DOWNLOAD_ATTEMPT;
    default: return EXAM_QP_EVENTS.DOWNLOAD_ATTEMPTED;
  }
}

/**
 * Writes ONE download-event row (LIVE_QUESTION_PAPER_DOWNLOAD_LINK), updates the
 * per-student summary and mirrors the event into the general audit — all under
 * one short script lock so simultaneous downloads never collide or lose counts.
 * If the lock is busy the event is still appended atomically (appendRow); the
 * summary can be rebuilt from events (rebuildExamQuestionPaperSummary).
 */
function examQpRecordAttempt_(ctx, status, reason, extra) {
  extra = extra || {};
  const now = extra.at || new Date();
  const r = ctx.qp || {};
  const w = ctx.qp ? examQpWindowOf_(ctx.qp) : null;
  const v = ctx.viewer;
  const completed = status === EXAM_QP_DOWNLOAD_STATUS.DOWNLOAD_COMPLETED;
  const ev = {
    Audit_ID: examQpNewId_('EQD', 8), Question_Paper_ID: r.Question_Paper_ID || ctx.requestedId || '', Exam_ID: r.Exam_ID || '',
    Exam_Title: r.Exam_Title || '', Academic_Year: r.Academic_Year || '', Grade: r.Grade || '', Class_Name: r.Class_Name || '', Section: r.Section || '',
    Class_Start_Date: r.Class_Date || '', Class_Start_Time: r.Class_Start_Time || '', Release_Date_Time: w ? examQpTs_(w.release) : '',
    Student_Full_Name: ctx.studentName || '', APSID: ctx.accountApsId || '', Student_Email: v.isStudent ? v.email : '',
    Teacher_Name: r.Teacher_Name || '', Teacher_APSID: r.Teacher_APSID || '', Authenticated_User_Email: v.email,
    Verification_Status: ctx.verification || '', Confirmation_Checked: ctx.confirmed ? 'TRUE' : 'FALSE', Download_Status: status,
    Download_Date: completed ? Utilities.formatDate(now, APS_TZ, 'yyyy-MM-dd') : '', Download_Time: completed ? Utilities.formatDate(now, APS_TZ, 'HH:mm:ss') : '',
    Download_Date_Time_EST: completed ? examQpTs_(now) : '', IP_Address: 'Not available (Apps Script does not expose client IP)',
    Session_ID: examQpSessionHash_(v.token), User_Agent: examQpClean_(ctx.userAgent, 300), File_Name: extra.fileName || '',
    Personalized_File_ID: extra.fileId || '', Created_Date_Time: examQpTs_(now), Created_By: v.email, Reason: examQpClean_(reason, 500),
    User_Role: v.role, Entered_APSID: examQpClean_(ctx.enteredApsId, 20), Question_Paper_Version: r.Version || '', Course_ID: r.Course_ID || '',
    Download_Key: completed ? (ctx.downloadKey || '') : ''
  };
  const auditEvent = { type: examQpEventTypeFor_(status), examId: ev.Exam_ID, qpId: ev.Question_Paper_ID, apsId: ev.APSID, studentName: ev.Student_Full_Name, className: ev.Class_Name, result: status, reason: reason, metadata: { enteredApsId: ev.Entered_APSID, session: ev.Session_ID, fileId: ev.Personalized_File_ID, downloadKey: ev.Download_Key } };
  // Open everything BEFORE taking the lock; the lock only covers the summary read-modify-write.
  const dlMeta = examQpSheet_(EXAM_QP_CONFIG.SHEET_DOWNLOADS, EXAM_QP_DOWNLOAD_HEADER);
  let summaryOk = true;
  if (v.isStudent && ev.Question_Paper_ID) {
    const sumMeta = examQpSheet_(EXAM_QP_CONFIG.SHEET_SUMMARY, EXAM_QP_SUMMARY_HEADER);
    const res = examQpWithLock_(function () { return examQpUpsertSummary_(ev, completed, now, sumMeta); }, 10000);
    if (res.locked) { ev.Download_Attempt_Count = String(res.value.count); ev.Last_Download_Date_Time = res.value.last; }
    else { summaryOk = false; ev.Reason = (ev.Reason ? ev.Reason + ' | ' : '') + 'summary pending (busy)'; }
  }
  try {
    examQpAppendAtomic_(dlMeta, [examQpRowFromObject_(dlMeta, ev)]); // atomic: never overwritten by a concurrent writer
  } catch (e) {
    console.error('[ExamQP] download audit write failed: ' + (e && e.message) + ' :: ' + JSON.stringify(ev).slice(0, 1500));
  }
  examQpAudit_(v, [auditEvent]);
  if (!summaryOk) console.warn('[ExamQP] summary skipped for ' + ev.Question_Paper_ID + ' (lock busy); rebuildExamQuestionPaperSummary() restores it from the events.');
  return ev;
}

/** Caller holds the lock. One row per (paper, student): first/last download, count, failed attempts. */
function examQpUpsertSummary_(ev, completed, now, meta) {
  const key = ev.Question_Paper_ID + '|' + ev.Student_Email;
  const last = meta.sheet.getLastRow();
  let rowIndex = -1, cur = null;
  if (last >= 2) {
    const keys = meta.sheet.getRange(2, meta.col.Summary_Key + 1, last - 1, 1).getValues();
    for (let i = 0; i < keys.length; i++) if (String(keys[i][0]) === key) { rowIndex = i + 2; break; }
    if (rowIndex > -1) cur = examQpObjectFromRow_(meta, meta.sheet.getRange(rowIndex, 1, 1, meta.width).getValues()[0]);
  }
  const ts = examQpTs_(now);
  const o = cur || { Summary_Key: key, Question_Paper_ID: ev.Question_Paper_ID, Exam_ID: ev.Exam_ID, Exam_Title: ev.Exam_Title, Class_Name: ev.Class_Name, Course_ID: ev.Course_ID,
    Student_Full_Name: ev.Student_Full_Name, APSID: ev.APSID, Student_Email: ev.Student_Email, Teacher_Name: ev.Teacher_Name, First_Download_Date_Time: '', Last_Download_Date_Time: '', Download_Count: '0', Failed_Attempts: '0' };
  if (completed) {
    o.Download_Count = String(Number(o.Download_Count || 0) + 1);
    if (!o.First_Download_Date_Time) o.First_Download_Date_Time = ts;
    o.Last_Download_Date_Time = ts;
  } else {
    o.Failed_Attempts = String(Number(o.Failed_Attempts || 0) + 1);
  }
  if (ev.Student_Full_Name) o.Student_Full_Name = ev.Student_Full_Name;
  if (ev.Download_Key) o.Download_Key = ev.Download_Key;
  o.Last_Status = ev.Download_Status;
  o.Updated_Date_Time = ts;
  const row = examQpRowFromObject_(meta, o);
  if (rowIndex > -1) { const range = meta.sheet.getRange(rowIndex, 1, 1, meta.width); range.setNumberFormat('@'); range.setValues([row]); }
  else examQpAppendRows_(meta, [row]);
  return { count: Number(o.Download_Count || 0), last: o.Last_Download_Date_Time };
}

/**
 * Validates EVERYTHING on the server (never trusts the browser): signed-in
 * student, paper exists + published + not cancelled/locked, class is AY26-27
 * and the student is enrolled in exactly that class, optional browser-sent
 * exam/grade/class values must match, server time inside [release, close),
 * non-sharing confirmation, APSID matches the APS account. Every outcome is
 * audited. Returns a structured context; ok=false carries a friendly message.
 */
function examQpValidateDownload_(ctx) {
  const v = ctx.viewer, req = ctx.req, S = EXAM_QP_DOWNLOAD_STATUS;
  const fail = function (status, reason, message) { return { ok: false, status: status, reason: reason, message: message || EXAM_QP_MESSAGES_[status] || EXAM_QP_MESSAGES_.UNAUTHORIZED }; };
  if (!v.isStudent) return fail(S.UNAUTHORIZED, 'Role ' + v.role + ' cannot download student question papers.');
  ctx.requestedId = examQpClean_(req.questionPaperId, 40);
  if (!EXAM_QP_ID_RE_.test(ctx.requestedId)) return fail(S.QUESTION_PAPER_NOT_FOUND, 'Malformed Question_Paper_ID.');
  const r = examQpFindRecord_(ctx.requestedId, true); // fresh: Cancel / Lock / Unpublish apply immediately
  if (!r) return fail(S.QUESTION_PAPER_NOT_FOUND, 'Unknown Question_Paper_ID.');
  ctx.qp = r;
  ctx.accountApsId = getAPSIdFromEmail(v.email);
  const courses = readAllCoursesFromCache_();
  const course = courses.filter(function (c) { return String(c.id) === r.Course_ID; })[0];
  const student = course ? (course.students || []).filter(function (s) { return normalizeEmail_(s.email) === v.email; })[0] : null;
  if (student) ctx.studentName = examQpClean_(student.name, 120);
  if (r.Status === EXAM_QP_STATUS.CANCELLED) return fail(S.QUESTION_PAPER_CANCELLED, 'Paper cancelled: ' + (r.Cancel_Reason || ''));
  if (r.Status !== EXAM_QP_STATUS.PUBLISHED) return fail(S.INVALID_EXAM, 'Paper status ' + r.Status + ' (not published).');
  if (!course || !examIsAllowedCourseName_(course.name) || r.Academic_Year !== EXAM_QP_CONFIG.SUPPORTED_ACADEMIC_YEAR) {
    return fail(S.INVALID_CLASS, 'Class ' + r.Course_ID + ' is not an active ' + EXAM_QP_CONFIG.SUPPORTED_ACADEMIC_YEAR + ' class.');
  }
  if (!student) {
    const elsewhere = courses.filter(function (c) { return examIsAllowedCourseName_(c.name) && courseHasStudentEmail_(c, v.email); });
    return elsewhere.length
      ? fail(S.INVALID_CLASS, 'Student is enrolled in ' + elsewhere.map(function (c) { return String(c.name).split('|')[0].trim(); }).join(', ') + ', not ' + String(r.Class_Name).split('|')[0].trim() + '.')
      : fail(S.INVALID_STUDENT, 'No active ' + EXAM_QP_CONFIG.SUPPORTED_ACADEMIC_YEAR + ' enrollment for this account.');
  }
  // Browser-sent context is never trusted — any mismatch is a tampering signal.
  if (req.examId && String(req.examId) !== r.Exam_ID) return fail(S.INVALID_EXAM, 'Exam_ID mismatch (sent ' + examQpClean_(req.examId, 40) + ').');
  if (req.className && String(req.className).trim() !== String(r.Class_Name).trim()) return fail(S.INVALID_CLASS, 'Class name mismatch (sent ' + examQpClean_(req.className, 120) + ').');
  if (req.grade && examNormKey_(req.grade) !== examNormKey_(r.Grade)) return fail(S.INVALID_CLASS, 'Grade mismatch (sent ' + examQpClean_(req.grade, 30) + ').');
  if (req.studentEmail && normalizeEmail_(req.studentEmail) !== v.email) return fail(S.UNAUTHORIZED, 'Student/account mismatch (sent ' + examQpClean_(req.studentEmail, 80) + ').');
  if (examQpBool_(r.Locked)) return fail(S.QUESTION_PAPER_LOCKED, 'Paper locked by Admin.');
  const w = examQpWindowOf_(r);
  const nowMs = ctx.now.getTime();
  if (!w) return fail(S.INVALID_EXAM, 'Paper schedule incomplete.');
  if (nowMs < w.release.getTime()) return fail(S.NOT_YET_AVAILABLE, 'Attempt ' + Math.ceil((w.release.getTime() - nowMs) / 60000) + ' min before release.', 'The question paper is not available yet.\n\nIt will become available at:\n' + examQpLongLabel_(w.release));
  if (nowMs >= w.close.getTime()) return fail(S.DOWNLOAD_WINDOW_CLOSED, 'Attempt ' + Math.floor((nowMs - w.close.getTime()) / 60000) + ' min after close (' + examQpLabel_(w.close) + ').');
  ctx.confirmed = req.confirmed === true;
  if (!ctx.confirmed) return fail(S.CONFIRMATION_REQUIRED, 'Non-sharing confirmation not checked.');
  ctx.enteredApsId = String(req.apsId || '').trim().toUpperCase().replace(/\s+/g, '');
  const expected = extractAPSID_(v.email);
  if (expected !== 'NA') {
    if (ctx.enteredApsId !== expected) { ctx.verification = 'APSID_MISMATCH'; return fail(S.INVALID_APSID, 'Entered ' + (ctx.enteredApsId || '(blank)') + ', account ' + expected + '.'); }
    ctx.verification = 'VERIFIED';
  } else {
    if (!/^APS[0-9A-Z]{1,10}$/.test(ctx.enteredApsId)) { ctx.verification = 'APSID_INVALID_FORMAT'; return fail(S.INVALID_APSID, 'Entered ' + (ctx.enteredApsId || '(blank)') + ' (account email has no APSID).'); }
    ctx.verification = 'APSID_NOT_VERIFIABLE_FROM_EMAIL';
    ctx.accountApsId = ctx.enteredApsId;
  }
  if (!ctx.studentName) {
    ctx.studentName = examQpClean_(req.fullName, 120);
    if (!ctx.studentName) { ctx.verification = 'NAME_MISSING'; return fail(S.VERIFICATION_FAILED, 'No roster name and no name entered.'); }
    ctx.verification += '+NAME_ENTERED';
  }
  return { ok: true, window: w };
}

/** WinAnsi-safe text for the standard PDF font (accents folded, anything else '?'). */
function examQpPdfText_(s) {
  return String(s || '').normalize('NFKD').replace(/[̀-ͯ]/g, '').replace(/[–—]/g, '-').replace(/[^\x20-\x7E]/g, '?');
}

/**
 * Personalizes the ORIGINAL (read-only) PDF: every page gets a header line, a
 * footer band and two light diagonal lines with Student / APSID / Class /
 * Exam / Downloaded (EST). Returns a Promise of base64. The source file is
 * never written to.
 */
/**
 * DOWNLOAD KEY (a.k.a. answer-sheet key): a short unique code per STUDENT + QUESTION PAPER,
 * printed in red at the top and bottom of every page of that student's copy. Students
 * writing on plain paper copy it onto their answer sheet; when the answer-sheet photo is
 * uploaded to Google Classroom, the teacher compares it with the Download_Key recorded in
 * EXAM_QUESTION_PAPER_DOWNLOAD_AUDIT / the Students view (search accepts the key).
 * Deterministic (HMAC-SHA256 with a private Script Property secret), so re-downloads keep
 * the same key and it cannot be guessed from the name/APSID. Format: XXX-XXX-XXX using
 * characters that cannot be confused when handwritten (no 0/O, 1/I/L).
 */
const EXAM_QP_KEY_ALPHABET_ = 'ABCDEFGHJKMNPQRSTUVWXYZ23456789';
function examQpKeySecret_() {
  if (EXAM_QP_MEMO_.keySecret) return EXAM_QP_MEMO_.keySecret;
  const props = PropertiesService.getScriptProperties();
  let secret = props.getProperty('EXAM_QP_DOWNLOAD_KEY_SECRET');
  if (!secret) {
    // Created once, under the script lock, so two first downloads can never get different secrets.
    examQpWithLock_(function () {
      secret = props.getProperty('EXAM_QP_DOWNLOAD_KEY_SECRET');
      if (!secret) { secret = Utilities.getUuid() + Utilities.getUuid(); props.setProperty('EXAM_QP_DOWNLOAD_KEY_SECRET', secret); }
    }, 20000);
    secret = secret || props.getProperty('EXAM_QP_DOWNLOAD_KEY_SECRET');
    if (!secret) throw new Error('Could not create the download key secret (busy). Please try again.');
  }
  EXAM_QP_MEMO_.keySecret = secret;
  return secret;
}
function examQpDownloadKey_(questionPaperId, email) {
  const sig = Utilities.computeHmacSha256Signature(String(questionPaperId) + '|' + normalizeEmail_(email), examQpKeySecret_());
  let k = '';
  for (let i = 0; i < 9; i++) k += EXAM_QP_KEY_ALPHABET_.charAt(((sig[i] % 256) + 256) % 256 % EXAM_QP_KEY_ALPHABET_.length);
  return k.slice(0, 3) + '-' + k.slice(3, 6) + '-' + k.slice(6, 9);
}
/** "k7f 3qx-9m2" -> "K7F3QX9M2" (for comparing a key copied from an answer sheet). */
function examQpNormDownloadKey_(v) { return String(v || '').toUpperCase().replace(/[^A-Z0-9]/g, ''); }

function examQpPersonalizePdf_(sourceBase64, stamp) {
  const L = examQpPdfLib_();
  let doc, font, bold;
  return L.PDFDocument.load(sourceBase64, { updateMetadata: false }).then(function (d) {
    doc = d;
    return doc.embedFont(L.StandardFonts.Helvetica);
  }).then(function (f) {
    font = f;
    return doc.embedFont(L.StandardFonts.HelveticaBold);
  }).then(function (b) {
    bold = b;
    const line1 = examQpPdfText_('Student: ' + stamp.name + '   |   APSID: ' + stamp.apsId + '   |   Downloaded: ' + stamp.downloadedLabel);
    const line2 = examQpPdfText_('Class: ' + stamp.className + '   |   Exam: ' + stamp.examTitle);
    const line3 = examQpPdfText_((stamp.email ? 'Account: ' + stamp.email + '   |   ' : '') + (stamp.questionPaperId ? 'Paper: ' + stamp.questionPaperId : ''));
    const diag1 = examQpPdfText_(stamp.name + '  ' + stamp.apsId);
    const diag2 = examQpPdfText_(stamp.downloadedLabel + '  ' + stamp.shortClass);
    const gray = L.rgb(0.35, 0.35, 0.35);
    const red = L.rgb(0.8, 0, 0);
    const keyText = stamp.downloadKey ? examQpPdfText_('DOWNLOAD KEY: ' + stamp.downloadKey) : '';
    const keyHint = examQpPdfText_('Write this key at the top of your answer sheet');
    doc.getPages().forEach(function (page) {
      // Drawn relative to the page's MediaBox origin (not always 0,0). No opaque band: the stamp never hides exam content.
      const box = page.getMediaBox();
      const x0 = box.x, y0 = box.y, w = box.width, h = box.height;
      const fit = function (text, f, max, want) { let s = want; while (s > 4 && f.widthOfTextAtSize(text, s) > max) s -= 0.5; return s; };
      const s1 = fit(line1, bold, w - 30, 8), s2 = fit(line2, font, w - 30, 7.5), s3 = fit(line3, font, w - 30, 6.5);
      page.drawText(line1, { x: x0 + 15, y: y0 + 16, size: s1, font: bold, color: gray, opacity: 0.9 });
      page.drawText(line2, { x: x0 + 15, y: y0 + 7, size: s2, font: font, color: gray, opacity: 0.9 });
      page.drawText(line1, { x: x0 + 15, y: y0 + h - 11, size: Math.min(s1, 7), font: font, color: gray, opacity: 0.8 });
      if (line3) page.drawText(line3, { x: x0 + 15, y: y0 + h - 19, size: s3, font: font, color: gray, opacity: 0.7 });
      if (keyText) {
        // Download key in RED, large and readable (14 pt, never below 11 pt), centred at the top and bottom of every page,
        // inside a thin red frame (no fill, so exam content is never hidden). The hint sits to its right when it fits.
        const ks = fit(keyText, bold, w - 40, 14);
        const hs = 8;
        const kw = bold.widthOfTextAtSize(keyText, Math.max(ks, 11));
        const hw = font.widthOfTextAtSize(keyHint, hs);
        const withHint = kw + 14 + hw <= w - 40;
        const total = withHint ? kw + 14 + hw : kw;
        const kx = x0 + (w - total) / 2;
        [y0 + h - 40, y0 + 29].forEach(function (ky) {
          page.drawRectangle({ x: kx - 6, y: ky - 4, width: kw + 12, height: Math.max(ks, 11) + 7, borderColor: red, borderWidth: 1, opacity: 0, borderOpacity: 0.9 });
          page.drawText(keyText, { x: kx, y: ky, size: Math.max(ks, 11), font: bold, color: red });
          if (withHint) page.drawText(keyHint, { x: kx + kw + 14, y: ky + 2, size: hs, font: font, color: red });
        });
      }
      if (stamp.watermark) {
        // r67: "TEACHER COPY" — large red label centred near the top of every page + a faint diagonal mark. Only when asked; student copies never set it.
        const wm = examQpPdfText_(stamp.watermark), wms = fit(wm, bold, w - 60, 22), wmw = bold.widthOfTextAtSize(wm, wms);
        page.drawRectangle({ x: x0 + (w - wmw) / 2 - 8, y: y0 + h - 58, width: wmw + 16, height: wms + 10, borderColor: red, borderWidth: 1.5, opacity: 0, borderOpacity: 0.9 });
        page.drawText(wm, { x: x0 + (w - wmw) / 2, y: y0 + h - 52, size: wms, font: bold, color: red });
        page.drawText(wm, { x: x0 + w * 0.2, y: y0 + h * 0.55, size: Math.max(28, Math.min(w, h) / 9), font: bold, color: red, opacity: 0.08, rotate: L.degrees(35) });
      }
      const ds = fit(diag1, bold, Math.sqrt(w * w + h * h) * 0.7, Math.max(18, Math.min(w, h) / 12));
      page.drawText(diag1, { x: x0 + w * 0.12, y: y0 + h * 0.30, size: ds, font: bold, color: L.rgb(0.6, 0.6, 0.6), opacity: 0.16, rotate: L.degrees(35) });
      page.drawText(diag2, { x: x0 + w * 0.18, y: y0 + h * 0.22, size: Math.max(10, ds * 0.45), font: font, color: L.rgb(0.6, 0.6, 0.6), opacity: 0.16, rotate: L.degrees(35) });
    });
    doc.setTitle(examQpPdfText_((stamp.watermark ? stamp.watermark + ' - ' : '') + stamp.examTitle + ' - ' + stamp.name + ' (' + stamp.apsId + ')'));
    doc.setSubject(examQpPdfText_('Personalized copy for ' + stamp.name + ' ' + stamp.apsId + ' - ' + stamp.className + ' - downloaded ' + stamp.downloadedLabel));
    doc.setKeywords([examQpPdfText_(stamp.apsId), examQpPdfText_(stamp.questionPaperId), 'APS personalized']);
    doc.setProducer('APS Classroom Dashboard');
    doc.setCreator('APS Classroom Dashboard - Exam Question Paper');
    return doc.saveAsBase64({ useObjectStreams: true });
  });
}

function examQpFileName_(r, name, apsId, now) {
  const grade = String(r.Class_Name || '').split('|')[0];
  return [examQpSafeFilePart_(r.Exam_Title), examQpSafeFilePart_(grade), examQpSafeFilePart_(name), examQpSafeFilePart_(apsId),
    Utilities.formatDate(now, APS_TZ, 'yyyyMMdd-HHmm') + '-EST'].join('_') + '.pdf';
}

function examQpTicketKey_(ticket) { return 'examQpTicket_' + ticket; }
function examQpPutTicket_(ticket, obj) { try { CacheService.getScriptCache().put(examQpTicketKey_(ticket), JSON.stringify(obj), EXAM_QP_CONFIG.TICKET_SECONDS); } catch (e) { /* ignore */ } }

/**
 * STUDENT DOWNLOAD. The browser sends a random ticket with the request; the
 * outcome (success or a friendly failure) is ALWAYS stored under that ticket,
 * so fetchExamQuestionPaperDownload() can pick it up even if this call's
 * return value does not reach the browser. The PDF itself is personalized
 * asynchronously (pdf-lib), saved to the private Personalized folder
 * (Personalized_File_ID) and returned as base64 — no URL is ever exposed.
 */
function downloadExamQuestionPaper(sessionToken, req) {
  apsRequireTabForToken_(sessionToken, 'exam.questionPaper'); // r56: Admin Control → Access Control
  req = req || {};
  const ticket = /^[A-Za-z0-9_-]{16,64}$/.test(String(req.ticket || '')) ? String(req.ticket) : '';
  try {
    return examQpDownload_(sessionToken, req);
  } catch (e) {
    // Never leave the browser polling a ticket that will never be written.
    if (!/SESSION_EXPIRED/.test(String(e && e.message))) console.error('[ExamQP] download error: ' + (e && e.stack || e));
    const out = { ticket: ticket, state: 'FAILED', code: /SESSION_EXPIRED/.test(String(e && e.message)) ? 'SESSION_EXPIRED' : 'DOWNLOAD_FAILED', message: /SESSION_EXPIRED/.test(String(e && e.message)) ? 'Your session has expired. Please sign in again.' : EXAM_QP_MESSAGES_.DOWNLOAD_FAILED };
    if (ticket && !CacheService.getScriptCache().get(examQpTicketKey_(ticket))) examQpPutTicket_(ticket, Object.assign({ email: '' }, out));
    if (/SESSION_EXPIRED/.test(String(e && e.message))) throw e; // let the dashboard show its sign-in screen
    return out;
  }
}

function examQpDownload_(sessionToken, req) {
  const session = requireValidSession_(sessionToken);
  // Same access policy as the tab: a student may download only when EXAM_QUESTION_PAPER_STUDENT_TEACHER_ACCESS is enabled.
  const viewer = { email: normalizeEmail_(session.email), role: session.role, isStudent: session.role === 'student' && examinationAccessForRole_(session.role) === 'QUESTION_PAPER', token: sessionToken };
  const ticket = /^[A-Za-z0-9_-]{16,64}$/.test(String(req.ticket || '')) ? String(req.ticket) : Utilities.getUuid().replace(/-/g, '');
  const ctx = { viewer: viewer, req: req, now: new Date(), userAgent: req.userAgent, confirmed: req.confirmed === true, verification: '' };
  const cache = CacheService.getScriptCache();
  if (cache.get(examQpTicketKey_(ticket))) {
    examQpAudit_(viewer, [{ type: EXAM_QP_EVENTS.UNAUTHORIZED_DOWNLOAD_ATTEMPT, qpId: examQpClean_(req.questionPaperId, 40), result: 'TICKET_REUSED', reason: 'A download ticket was presented a second time.' }]);
    return { ticket: ticket, state: 'FAILED', code: 'UNAUTHORIZED', message: 'This download request was already used. Please start again.' };
  }
  const check = examQpValidateDownload_(ctx);
  if (!check.ok) {
    examQpRecordAttempt_(ctx, check.status, check.reason);
    const out = { ticket: ticket, state: 'FAILED', code: check.status, message: check.message, email: viewer.email };
    examQpPutTicket_(ticket, out);
    return out;
  }
  const r = ctx.qp;
  examQpPutTicket_(ticket, { ticket: ticket, state: 'PENDING', email: viewer.email });
  const downloadedLabel = examQpLabel_(ctx.now);
  ctx.downloadKey = examQpDownloadKey_(r.Question_Paper_ID, viewer.email); // same key on every re-download of this paper by this student
  // The authenticated account email is stamped too, so a copy is always traceable even if the APSID or name could not be verified.
  const stamp = { name: ctx.studentName, apsId: ctx.accountApsId, email: viewer.email, className: r.Class_Name, shortClass: String(r.Class_Name).split('|')[0].trim(), examTitle: r.Exam_Title, downloadedLabel: downloadedLabel, questionPaperId: r.Question_Paper_ID, downloadKey: ctx.downloadKey };
  const fileName = examQpFileName_(r, ctx.studentName, ctx.accountApsId, ctx.now);
  let sourceB64;
  try {
    sourceB64 = Utilities.base64Encode(DriveApp.getFileById(r.Question_Paper_File).getBlob().getBytes());
  } catch (e) {
    console.error('[ExamQP] source read failed ' + r.Question_Paper_ID + ': ' + (e && e.message));
    examQpRecordAttempt_(ctx, EXAM_QP_DOWNLOAD_STATUS.DOWNLOAD_FAILED, 'Source PDF unreadable: ' + (e && e.message));
    const out = { ticket: ticket, state: 'FAILED', code: 'DOWNLOAD_FAILED', message: EXAM_QP_MESSAGES_.DOWNLOAD_FAILED, email: viewer.email };
    examQpPutTicket_(ticket, out);
    return out;
  }
  return examQpPersonalizePdf_(sourceB64, stamp).then(function (b64) {
    let fileId = '';
    try {
      const file = examQpFolders_().personalized.createFile(Utilities.newBlob(Utilities.base64Decode(b64), 'application/pdf', fileName));
      fileId = file.getId();
    } catch (e) { console.error('[ExamQP] personalized copy not archived: ' + (e && e.message)); }
    const ev = examQpRecordAttempt_(ctx, EXAM_QP_DOWNLOAD_STATUS.DOWNLOAD_COMPLETED, check.window && ctx.now.getTime() >= check.window.start.getTime() ? 'Downloaded after class start (policy allows)' : '', { fileName: fileName, fileId: fileId, at: ctx.now });
    const out = { ticket: ticket, state: 'READY', fileName: fileName, base64: b64, downloadedLabel: downloadedLabel, studentName: ctx.studentName, apsId: ctx.accountApsId, downloadCount: Number(ev.Download_Attempt_Count || 0), downloadKey: ctx.downloadKey, email: viewer.email };
    examQpPutTicket_(ticket, { ticket: ticket, kind: 'STUDENT', qpId: r.Question_Paper_ID, state: 'READY', fileId: fileId, fileName: fileName, downloadedLabel: downloadedLabel, studentName: ctx.studentName, apsId: ctx.accountApsId, downloadCount: out.downloadCount, downloadKey: ctx.downloadKey, email: viewer.email });
    delete out.email;
    return out;
  }).catch(function (e) {
    console.error('[ExamQP] personalization failed ' + r.Question_Paper_ID + ': ' + (e && e.stack || e));
    examQpRecordAttempt_(ctx, EXAM_QP_DOWNLOAD_STATUS.DOWNLOAD_FAILED, 'Personalization error: ' + (e && e.message ? e.message : String(e)));
    const out = { ticket: ticket, state: 'FAILED', code: 'DOWNLOAD_FAILED', message: EXAM_QP_MESSAGES_.DOWNLOAD_FAILED };
    examQpPutTicket_(ticket, Object.assign({ email: viewer.email }, out));
    return out;
  });
}

/** Second half of the download (polling path): only the same signed-in student can read their ticket; READY returns the personalized copy's bytes. */
function fetchExamQuestionPaperDownload(sessionToken, ticket) {
  apsRequireTabForToken_(sessionToken, 'exam.questionPaper'); // r56: Admin Control → Access Control
  const session = requireValidSession_(sessionToken);
  const email = normalizeEmail_(session.email);
  if (!/^[A-Za-z0-9_-]{16,64}$/.test(String(ticket || ''))) return { state: 'FAILED', message: EXAM_QP_MESSAGES_.UNAUTHORIZED };
  const raw = CacheService.getScriptCache().get(examQpTicketKey_(ticket));
  if (!raw) return { state: 'PENDING' };
  const t = JSON.parse(raw);
  if (t.state === 'FAILED' && !t.email) return { ticket: ticket, state: 'FAILED', code: t.code || '', message: t.message || EXAM_QP_MESSAGES_.DOWNLOAD_FAILED };
  if (t.email !== email) return { state: 'FAILED', message: EXAM_QP_MESSAGES_.UNAUTHORIZED };
  if (t.state === 'SERVED') return { state: 'FAILED', message: 'This download was already delivered. Press Download Question Paper again for a new copy (each download is recorded).' };
  const out = { ticket: ticket, state: t.state, code: t.code || '', message: t.message || '', fileName: t.fileName || '', downloadedLabel: t.downloadedLabel || '', studentName: t.studentName || '', apsId: t.apsId || '', downloadCount: t.downloadCount || 0, downloadKey: t.downloadKey || '' };
  if (t.state === 'READY') {
    if (!t.fileId) return { state: 'FAILED', message: EXAM_QP_MESSAGES_.DOWNLOAD_FAILED };
    // Re-check on delivery: the role is still allowed and the paper was not cancelled / locked meanwhile.

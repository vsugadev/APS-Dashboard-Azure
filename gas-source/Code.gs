    pollMs: liveStatus && Object.keys(liveStatus).length ? 45000 : APS_IDLE_POLL_MS_, // r96: 45 s while a class is in its live window, slower otherwise
    serverTime: new Date().toISOString()
  };
  } finally { APS_REQ_MEMO_ = null; }
}

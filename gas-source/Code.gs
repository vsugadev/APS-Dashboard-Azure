var CCW_FIXED_RECIPIENTS_DEFAULT_ = ['admin@avvaiyarpadasalai.org', 'Vasuki_APS999@avvaiyarpadasalai.org', 'tcs_asvika_aps8112@avvaiyarpadasalai.org'];

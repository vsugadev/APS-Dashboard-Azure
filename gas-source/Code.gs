function appendEstLabel_(label) {
  var text = String(label || '').trim();
  if (!text) return '';
  return /\bEST\b/i.test(text) ? text : text + ' ' + APS_TIMEZONE_LABEL;
}

function countWords_(text) {
  var cleaned = String(text || '').trim();
  if (!cleaned) return 0;
  return cleaned.split(/\s+/).filter(function (w) { return !!w; }).length;
}

function validateGtrReasonComments_(reasonComments) {
  var text = String(reasonComments || '').trim();
  var words = countWords_(text);
  if (words < 15) throw new Error('Reason / Comments is required and must contain at least 15 words.');
  if (words > 2000) throw new Error('Reason / Comments must not exceed 2000 words.');
  return text;
}

function submitTimingChangeRequest(sessionToken, targetCourseId, parentEmail, reasonComments) {
  apsRequireTabForToken_(sessionToken, 'classChange'); // r56: Admin Control → Access Control
  var lock = LockService.getScriptLock();
  try { lock.waitLock(15000); } catch (e) { /* proceed best-effort */ }
  try {
    var session = requireValidSession_(sessionToken);
    var allCourses = readAllCoursesFromCache_();
    var viewer = { email: session.email, role: session.role };
    if (viewer.role !== 'student') throw new Error('Only a Student account can request a class/timing change.');
    if (!isTimingChangeWindowOpen_()) {
      throw new Error('The window for Timing Change requests closed on ' + APS_CLASS_TIMINGS.TIMING_CHANGE_DEADLINE + '.');
    }
    if (hasActiveGtrRequest_(viewer.email)) throw new Error(GTR_MESSAGES.DUPLICATE_ACTIVE_REQUEST);

    var myCourses = allCourses.filter(function (c) { return courseHasStudentEmail_(c, viewer.email); });
    if (myCourses.length === 0) throw new Error('No enrolled class found for your account.');
    var currentCourse = myCourses[0];
    var parsedCurrent = parseClassroomTitle_(currentCourse.name);
    if (!parsedCurrent) throw new Error('Your current class title could not be parsed — contact APS Tech Support.');

    var candidates = findTimingChangeCandidates_(currentCourse, allCourses);
    var chosen = null;
    for (var i = 0; i < candidates.length; i++) { if (candidates[i].courseId === targetCourseId) { chosen = candidates[i]; break; } }
    if (!chosen || !chosen.hasCapacity) throw new Error(GTR_MESSAGES.NO_TIMING_CLASS_AVAILABLE);

    var targetCourse = findCourseById_(allCourses, chosen.courseId);
    var parentEmailTrimmed = (parentEmail || '').trim();
    if (parentEmailTrimmed && !isSyntacticallyValidEmail_(parentEmailTrimmed)) throw new Error('Parent Email is optional. If provided, enter a valid email address.');
    var validatedReason = validateGtrReasonComments_(reasonComments);

    var requestId = generateGtrRequestId_();
    var obj = {
      requestId: requestId,
      requestDateTime: new Date().toISOString(),
      studentName: findDisplayName_(allCourses, viewer.email),
      apsId: deriveApsId_(viewer.email),
      studentEmail: viewer.email,
      parentEmail: parentEmailTrimmed,
      requestType: GTR_REQUEST_TYPE.TIMING,
      currentGrade: parsedCurrent.grade,
      currentClassroom: currentCourse.name,
      currentClassTiming: currentCourse.section,
      requestedGrade: parsedCurrent.grade,
      requestedClassTiming: chosen.timingLabel,
      requestedClassroom: targetCourse ? targetCourse.name : '',
      currentStudentCount: chosen.studentCount,
      requestStatus: GTR_STATUS.REQUEST_SUBMITTED,
      acknowledgement: GTR_MESSAGES.ACKNOWLEDGEMENT_TEXT,
      reasonComments: validatedReason,
      approverEmail: '', approverComments: '', processedDateTime: '', processedBy: '',
      finalApproverEmail: '', finalApproverComments: '', finalApprovedAt: '', processingNotes: ''
    };
    appendGtrRequestRow_(obj);
    notifyGtrApprovers_('New Timing Change request — ' + obj.studentName, gtrEmailBody_(obj), obj);
    notifyGtrStudent_(obj, 'Your Timing Change request (' + requestId + ') has been submitted and is awaiting review.');
    return obj;
  } finally {
    try { lock.releaseLock(); } catch (e) { /* best-effort */ }
  }
}


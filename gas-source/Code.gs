}

/**
 * Merges the live snapshot + join clicks into the course's status for today's occurrence (called
 * from applyClassStatus_). Mutates: person.inMeet / online for people seen in THIS class's Meet,
 * and returns { code, detail } or null when there is nothing live to apply.
 */
function classMeetApplyLive_(c, schedule, now, snapshot, cache, startedMark, endedMark) {
  var occ = classMeetOccurrence_(schedule, now);
  if (!occ) return null;
  var nowMs = now.getTime();
  if (nowMs < occ.winStartMs) return null;
  var entry = (snapshot.byCourse || {})[String(c.id)] || { people: {}, live: null, sources: [] };
  var people = {};
  Object.keys(entry.people || {}).forEach(function (e) { people[e] = entry.people[e]; });
  var sources = (entry.sources || []).slice();
  classMeetJoinClicks_(cache, c.id, occ.startIso).forEach(function (x) {
    if (!people[x.e]) people[x.e] = { r: x.r, first: x.at, last: x.at, live: false };
    else { people[x.e].first = Math.min(people[x.e].first, x.at); people[x.e].last = Math.max(people[x.e].last, x.at); }
    if (sources.indexOf('Dashboard Join') === -1) sources.push('Dashboard Join');
  });
  var teacherFirst = null, studentFirst = null, students = 0, teachers = 0, lastActivity = 0, liveTeacher = false, liveStudents = 0;
  Object.keys(people).forEach(function (e) {
    var p = people[e];
    lastActivity = Math.max(lastActivity, p.last);
    if (p.r === 'T') { teachers++; teacherFirst = teacherFirst === null ? p.first : Math.min(teacherFirst, p.first); if (p.live) liveTeacher = true; }
    else { students++; studentFirst = studentFirst === null ? p.first : Math.min(studentFirst, p.first); if (p.live) liveStudents++; }
  });
  var startedNow = teachers > 0 && students > 0;
  var key = String(c.id);
  if (startedNow && startedMark[key] !== occ.startIso) { startedMark[key] = occ.startIso; startedMark.__changed = true; }
  var hasStarted = startedNow || startedMark[key] === occ.startIso;
  var ended = endedMark[key] === occ.startIso;
  if (hasStarted && !ended) {
    var restEnded = entry.live === false && nowMs >= occ.startMs; // Meet REST: the conference is no longer running
    var quietAfterEnd = nowMs >= occ.endMs + CLASS_MEET_ENDED_GRACE_MIN * 60000 && entry.live !== true &&
      nowMs - lastActivity >= CLASS_MEET_ENDED_GRACE_MIN * 60000;
    if (restEnded || quietAfterEnd || nowMs >= occ.hardStopMs) { endedMark[key] = occ.startIso; endedMark.__changed = true; ended = true; }
  }
  // People seen in THIS class's Meet light up "in Meet" until the class ends.
  if (!ended) {
    (c.teachers || []).concat(c.students || []).forEach(function (p) {
      var e = normalizeEmail_(p.email);
      var x = e && people[e];
      if (x && (x.live || entry.live !== false)) { p.inMeet = true; p.online = true; p.meetSince = p.meetSince || new Date(x.first).toISOString(); }
    });
  }
  var code;
  if (ended) code = 'completed';
  else if (hasStarted) code = 'started';
  else if (nowMs < occ.startMs) code = 'scheduled';
  else if (nowMs >= occ.endMs + CLASS_MEET_ENDED_GRACE_MIN * 60000) code = 'completed';
  else code = 'yet_to_start';
  var fmt = function (ms) { return ms ? Utilities.formatDate(new Date(ms), LAST_LOGIN_TIMEZONE, 'h:mm a') : ''; };
  var detail = {
    meetStarted: teachers > 0 || students > 0,
    teacherJoined: teachers > 0, teacherJoinedAt: fmt(teacherFirst),
    studentsJoined: students, firstStudentAt: fmt(studentFirst),
    liveNow: entry.live === true, liveTeacher: liveTeacher, liveStudents: liveStudents,
    endedAt: ended ? fmt(lastActivity || nowMs) : '',
    sources: sources, checkedAt: snapshot.at ? fmt(snapshot.at) : ''
  };
  var text;
  if (code === 'completed') text = hasStarted ? 'Class ended' + (detail.endedAt ? ' around ' + detail.endedAt : '') : 'No Google Meet activity was detected for this class today';
  else if (code === 'started') text = 'Teacher joined' + (detail.teacherJoinedAt ? ' ' + detail.teacherJoinedAt : '') + ' · ' + students + ' student' + (students === 1 ? '' : 's') + ' joined';
  else if (teachers > 0) text = 'Meet started — teacher joined' + (detail.teacherJoinedAt ? ' ' + detail.teacherJoinedAt : '') + ', waiting for students';
  else if (students > 0) text = students + ' student' + (students === 1 ? '' : 's') + ' in Meet — waiting for the teacher';
  // r65: during class time with NO evidence at all, only say "not started" when the live Meet check could
  // actually see this class (Meet REST: no active conference). Otherwise the dashboard simply cannot tell —
  // Classroom Meet links belong to the teachers, and the Meet audit log only records people when they LEAVE.
  else if (code === 'yet_to_start' && entry.live === true) { text = 'Google Meet is running — participants not identified yet'; detail.statusUnknown = true; }
  else if (code === 'yet_to_start' && entry.live !== false) { text = 'Live Google Meet status not available for this class'; detail.statusUnknown = true; }
  else text = 'Google Meet not started yet';
  detail.liveKnown = entry.live === true || entry.live === false; // r65: the live Meet check can see this class
  detail.text = text;
  return { code: code, detail: detail };
}


  TYPE: 11, NAME: 12, GRADING: 13, POINTS: 14, SCHEDULED: 15, DUE: 16, STATUS: 17, CLASSROOM_ID: 18, MESSAGE: 19, ERROR: 20, PREVIEW: 21, APSID: 22 };

const EXAM_ANNOUNCEMENT_ID_RE_ = /^ANN\d{8}_\d{4}$/;

/* ------------------------------ access ------------------------------ */

/**
 * Examination tab access (Sept 28, 2026 policy):
 *   READ_WRITE — Admin, Super Admin
 *   READ_ONLY  — VCFO_AMCHATS_BOD (view announcements / classwork history / question-paper monitoring; no changes)
 *   QUESTION_PAPER — HM / Teacher / Student, ONLY when Script Property
 *                    EXAM_QUESTION_PAPER_STUDENT_TEACHER_ACCESS = 'true' (Exam Question Paper sub-tab only)
 *   ''         — everyone else: the tab is hidden and every endpoint refuses.
 * Sent to the browser as currentUser.examinationAccess (display only) and
 * re-checked by every server endpoint.
 */
function examinationAccessForRole_(role) {
  if (isAdminRole_(role)) return 'READ_WRITE';
  if (role === VCFO_AMCHSTS_BOD_ROLE) return 'READ_ONLY';
  if ((role === 'headmaster' || role === 'teacher' || role === 'student') && examQpStudentTeacherAccessEnabled_()) return 'QUESTION_PAPER';
  return '';
}
function examQpStudentTeacherAccessEnabled_() {
  return String(PropertiesService.getScriptProperties().getProperty('EXAM_QUESTION_PAPER_STUDENT_TEACHER_ACCESS') || 'false').trim().toLowerCase() === 'true';
}

/** Server-side gate for Announcements / Classwork / History — Admin & Super Admin read-write, BOD read-only (never trusts the client). */
function examRequireAccess_(sessionToken, forMutation) {
  const session = requireValidSession_(sessionToken);
  const viewer = { email: session.email, role: session.role };
  const access = examinationAccessForRole_(viewer.role);
  if (access !== 'READ_WRITE' && access !== 'READ_ONLY') throw new Error('Only Admin / Super Admin (read-write) and VCFO/AMCHATS BOD (read-only) can use the Examination tab.');
  if (forMutation) {
    if (access !== 'READ_WRITE') throw new Error('Read-only access: this account cannot publish Examination content.');
    requireDashboardMutationPermission_(viewer, 'publish Examination content');
  }
  return viewer;
}

/* ----------------------------- courses ------------------------------ */

/** Exact, case-sensitive AY26-27 rule shared by Announcements AND Classwork. */
function examIsAllowedCourseName_(name) {
  return String(name || '').trim().endsWith(EXAMINATION_CONFIG.COURSE_SUFFIX);
}

function examCourseSummary_(course) {
  const name = String(course.name || '').trim();
  return {
    id: String(course.id),
    name: name,
    shortName: name.split('|')[0].trim() || name,
    grade: extractNilaiFromCourseName_(name) || 'OTHER',
    link: course.alternateLink || ''
  };
}

/**
 * Every ACTIVE AY26-27 classroom, following nextPageToken until the last
 * page (never just the first 100). Cached 10 minutes in the script cache;
 * forceRefresh re-reads Classroom.
 */
function getExaminationCourses_(forceRefresh) {
  const cache = CacheService.getScriptCache();
  if (!forceRefresh) {
    const hit = cache.get(EXAMINATION_CONFIG.COURSE_CACHE_KEY);
    if (hit) { try { return JSON.parse(hit); } catch (e) { /* re-read */ } }
  }
  const out = [];
  let pageToken;
  do {
    const pt = pageToken;
    const resp = callWithBackoff_(function () {
      return Classroom.Courses.list({ courseStates: ['ACTIVE'], pageSize: 100, pageToken: pt, fields: 'courses(id,name,alternateLink),nextPageToken' });
    }) || {};
    (resp.courses || []).forEach(function (c) { if (examIsAllowedCourseName_(c.name)) out.push(examCourseSummary_(c)); });
    pageToken = resp.nextPageToken;
  } while (pageToken);
  out.sort(function (a, b) { return a.name.localeCompare(b.name, undefined, { numeric: true, sensitivity: 'base' }); });
  try { cache.put(EXAMINATION_CONFIG.COURSE_CACHE_KEY, JSON.stringify(out), EXAMINATION_CONFIG.COURSE_CACHE_SECONDS); } catch (e) { /* >100KB: just skip caching */ }
  return out;
}

/** Splits requested ids into AY26-27 courses (validated against the server list) and rejected ids. Deduplicates. */
function examResolveCourses_(courseIds, allCourses) {
  const byId = {};
  allCourses.forEach(function (c) { byId[c.id] = c; });
  const seen = {};
  const courses = [];
  const rejected = [];
  (courseIds || []).forEach(function (raw) {
    const id = String(raw || '').trim();
    if (!id || seen[id]) return;
    seen[id] = true;
    if (byId[id]) courses.push(byId[id]); else rejected.push(id);
  });
  return { courses: courses, rejected: rejected };
}

/** Grade groups in the dashboard's existing NILAI order (NILAI_FILTER_OPTIONS), unknown grades last. */
function examGradeGroups_(courses) {
  const order = NILAI_FILTER_OPTIONS.slice(1).concat(['OTHER']);
  const groups = {};
  courses.forEach(function (c) { (groups[c.grade] = groups[c.grade] || []).push(c.id); });
  return Object.keys(groups).sort(function (a, b) {
    const ia = order.indexOf(a), ib = order.indexOf(b);
    return (ia === -1 ? 999 : ia) - (ib === -1 ? 999 : ib) || a.localeCompare(b);
  }).map(function (g) { return { grade: g, courseIds: groups[g] }; });
}

/** Client bootstrap: courses, grade groups, topics, names per topic, types, presets and rule constants — one call. */
function getExaminationCourseOptions(sessionToken, opts) {
  apsRequireTabForToken_(sessionToken, 'exam'); // r56: Admin Control → Access Control
  const viewer = examRequireAccess_(sessionToken, false);
  const courses = getExaminationCourses_(!!(opts && opts.forceRefresh) && isAdminRole_(viewer.role)); // re-reading Classroom (API quota) is Admin-only; others get the cached list
  const types = Object.keys(EXAMINATION_CLASSWORK_TYPES).map(function (k) {
    const t = EXAMINATION_CLASSWORK_TYPES[k];
    return { key: k, label: t.label, gradable: !!t.gradable, dueDate: !!t.dueDate, needsChoices: !!t.needsChoices, quizMaterial: !!t.quizMaterial, material: t.api === 'COURSE_WORK_MATERIAL' };
  });
  let canPublish = true;
  try { requireDashboardMutationPermission_(viewer, 'publish'); } catch (e) { canPublish = false; }
  return {
    suffix: EXAMINATION_CONFIG.COURSE_SUFFIX,
    timezone: EXAMINATION_CONFIG.TIMEZONE,
    courses: courses,
    grades: examGradeGroups_(courses),
    topics: EXAMINATION_CONFIG.TOPICS.slice(),
    assignmentNames: EXAMINATION_CONFIG.ASSIGNMENT_NAMES,
    types: types,
    presets: EXAMINATION_CONFIG.PRESETS,
    announcementHeader: EXAMINATION_CONFIG.ANNOUNCEMENT_HEADER,
    announcementIdLabel: EXAMINATION_CONFIG.ANNOUNCEMENT_ID_LABEL,
    signature: EXAMINATION_CONFIG.SIGNATURE,
    minLeadMinutes: EXAMINATION_CONFIG.MIN_SCHEDULE_LEAD_MINUTES,
    maxPoints: EXAMINATION_CONFIG.MAX_POINTS,
    chunkSize: EXAMINATION_CONFIG.COURSES_PER_CALL,
    canPublish: canPublish,
    loadedAt: Utilities.formatDate(new Date(), EXAMINATION_CONFIG.TIMEZONE, 'MM/dd/yyyy h:mm a') + ' EST'
  };
}

/* ----------------------------- helpers ------------------------------ */

function examText_(v) { return String(v === null || v === undefined ? '' : v).replace(/\r\n?/g, '\n'); }
function examNowLabel_(d) { return Utilities.formatDate(d || new Date(), EXAMINATION_CONFIG.TIMEZONE, 'yyyy-MM-dd HH:mm:ss'); }
function examFormatInstant_(date) { return Utilities.formatDate(date, EXAMINATION_CONFIG.TIMEZONE, 'MM/dd/yyyy hh:mm a') + ' EST'; }
function examFormatIso_(iso) {
  if (!iso) return '';
  const d = new Date(iso);
  return isNaN(d.getTime()) ? String(iso) : examFormatInstant_(d);
}
function examNewBatchId_() {
  return 'EXB' + Utilities.formatDate(new Date(), EXAMINATION_CONFIG.TIMEZONE, 'yyyyMMddHHmmss') + '_' + Math.random().toString(36).slice(2, 6).toUpperCase();
}
function examSafeBatchId_(v) {
  const s = String(v || '').trim();
  return /^EXB\d{14}_[A-Z0-9]{1,8}$/.test(s) ? s : examNewBatchId_();
}
function examCounts_(results) {
  const c = { total: results.length, success: 0, failed: 0, skipped: 0, alreadyExists: 0 };
  results.forEach(function (r) {
    if (r.status === EXAMINATION_STATUS.SUCCESS) c.success++;
    else if (r.status === EXAMINATION_STATUS.FAILED) c.failed++;
    else if (r.status === EXAMINATION_STATUS.ALREADY_EXISTS) c.alreadyExists++;
    else c.skipped++;
  });
  return c;
}

/** Maps raw Classroom/Apps Script errors to a readable reason; the raw text still goes to the audit log. */
function examFriendlyError_(e) {
  const raw = (e && e.message) ? e.message : String(e);
  const rules = [
    [/scheduled time must be in the future/i, 'The scheduled time must be in the future.'],
    [/ProjectPermissionDenied|@ProjectPermissionDenied|created by a different (developer )?project/i, 'This item was not created by the dashboard, so Google Classroom does not allow the dashboard to change it.'],
    [/not found|NOT_FOUND|Requested entity was not found/i, 'The classroom or item was not found (it may have been deleted or archived).'],
    [/permission|PERMISSION_DENIED|forbidden|The caller does not have/i, 'The dashboard account does not have permission to post in this classroom.'],
    [/Quota|Rate Limit|rateLimitExceeded|RESOURCE_EXHAUSTED|429/i, 'Google Classroom is busy (rate limit). Use Retry Failed in a minute.'],
    [/driveFile|Drive file|attachment|material/i, 'The attachment could not be added (check the Drive file exists and is shared with the dashboard account).'],
    [/Invalid|INVALID_ARGUMENT|Bad Request|FAILED_PRECONDITION/i, 'Google Classroom rejected the request details.'],
    [/timed out|timeout|Service unavailable|backendError|503|500/i, 'Google Classroom did not respond in time. Use Retry Failed.']
  ];
  for (let i = 0; i < rules.length; i++) if (rules[i][0].test(raw)) return { friendly: rules[i][1], raw: raw };
  return { friendly: 'Google Classroom could not complete the request.', raw: raw };
}

/**
 * Best-effort cross-user guard against a double click / two admins hitting
 * the same classroom at the same instant: a short-lived CacheService marker
 * set under a very brief script lock. The Classroom duplicate re-check that
 * follows is the real idempotency guarantee.
 */
function examAcquireInflight_(key) {
  const cache = CacheService.getScriptCache();
  const lock = LockService.getScriptLock();
  if (!lock.tryLock(5000)) return false; // cannot guarantee exclusivity -> caller reports a retryable FAILED
  try {
    if (cache.get(key)) return false;
    cache.put(key, '1', EXAMINATION_CONFIG.INFLIGHT_SECONDS);
    return true;
  } finally {
    lock.releaseLock();
  }
}
function examReleaseInflight_(key) { try { CacheService.getScriptCache().remove(key); } catch (e) { /* expires anyway */ } }
function examInflightKey_(courseId, a, b) {
  return 'examInflight_' + courseId + '_' + Utilities.base64EncodeWebSafe(String(a || '') + '|' + String(b || '')).slice(0, 80);
}

/**
 * Create calls retry ONLY on quota/rate-limit errors (rejected before any
 * write). callWithBackoff_ also retries 500/503, which for a create could
 * mean "it worked but the response was lost" -> a duplicate, so it is used
 * for reads/updates/deletes only.
 */
function examCallCreate_(fn) {
  let delay = 1000;
  for (let i = 0; i < 5; i++) {
    try { return fn(); } catch (e) {
      const msg = (e && e.message) ? e.message : String(e);
      if (!/Quota exceeded|Rate Limit|rateLimitExceeded|userRateLimitExceeded|RESOURCE_EXHAUSTED/i.test(msg) || i === 4) throw e;
      Utilities.sleep(delay + Math.floor(Math.random() * 400));
      delay *= 2;
    }
  }
}

/* ------------------------------ audit ------------------------------ */

function getOrCreateExaminationAuditSheet_() {
  const ss = getWorkbook_();
  let sheet = ss.getSheetByName(EXAMINATION_CONFIG.AUDIT_SHEET_NAME);
  if (!sheet) {
    try { sheet = ss.insertSheet(EXAMINATION_CONFIG.AUDIT_SHEET_NAME); } catch (e) {
      sheet = ss.getSheetByName(EXAMINATION_CONFIG.AUDIT_SHEET_NAME); // another request created it first
      if (!sheet) throw e;
      return sheet;
    }
    ensureSheetHeader_(sheet, EXAMINATION_AUDIT_HEADER);
    sheet.getRange(1, 1, 1, EXAMINATION_AUDIT_HEADER.length).setValues([EXAMINATION_AUDIT_HEADER]).setFontWeight('bold');
    sheet.setFrozenRows(1);
    // Whole columns text-formatted once, so ids / "2026-10-15 19:00" never auto-convert to numbers or Dates.
    sheet.getRange(1, 1, sheet.getMaxRows(), EXAMINATION_AUDIT_HEADER.length).setNumberFormat('@');
  }
  ensureSheetHeader_(sheet, EXAMINATION_AUDIT_HEADER);
  return sheet;
}

/** Appends one row per classroom result in ONE write (append-only, never edited). */
function examAppendAudit_(viewer, base, results) {
  try { examWriteAudit_(viewer, base, results); } catch (e) {
    // The Classroom work is already done; never turn it into a client-side "FAILED" (which a retry would repeat).
    console.error('[Examination] audit write failed: ' + (e && e.message ? e.message : e) + ' :: ' + JSON.stringify(results).slice(0, 2000));
  }
}

function examWriteAudit_(viewer, base, results) {
  if (!results.length) return;
  const ts = examNowLabel_(new Date());
  const rows = results.map(function (r) {
    const row = new Array(EXAMINATION_AUDIT_HEADER.length).fill('');
    row[EXAM_AUDIT_COL.TS] = ts;
    row[EXAM_AUDIT_COL.USER] = viewer.email;
    row[EXAM_AUDIT_COL.ROLE] = viewer.role;
    row[EXAM_AUDIT_COL.ACTION] = base.action;
    row[EXAM_AUDIT_COL.OP] = base.operation;
    row[EXAM_AUDIT_COL.BATCH] = base.batchId || '';
    row[EXAM_AUDIT_COL.ANN_ID] = base.announcementId || '';
    row[EXAM_AUDIT_COL.COURSE_ID] = r.courseId;
    row[EXAM_AUDIT_COL.COURSE_NAME] = r.courseName || '';
    row[EXAM_AUDIT_COL.TOPIC] = base.topic || '';
    row[EXAM_AUDIT_COL.TOPIC_ID] = r.topicId || '';
    row[EXAM_AUDIT_COL.TYPE] = base.typeLabel || '';
    row[EXAM_AUDIT_COL.NAME] = base.assignmentName || '';
    row[EXAM_AUDIT_COL.GRADING] = base.grading || '';
    row[EXAM_AUDIT_COL.POINTS] = base.points === undefined || base.points === null ? '' : base.points;
    row[EXAM_AUDIT_COL.SCHEDULED] = base.scheduledLabel || '';
    row[EXAM_AUDIT_COL.DUE] = base.dueLabel || '';
    row[EXAM_AUDIT_COL.STATUS] = r.status;
    row[EXAM_AUDIT_COL.CLASSROOM_ID] = r.classroomId || '';
    row[EXAM_AUDIT_COL.MESSAGE] = r.message || '';
    row[EXAM_AUDIT_COL.ERROR] = String(r.error || '').slice(0, 1000);
    row[EXAM_AUDIT_COL.PREVIEW] = String(base.preview || '').slice(0, 200);
    row[EXAM_AUDIT_COL.APSID] = getAPSIdFromEmail(viewer.email);
    return row.map(function (v) { return String(v); });
  });
  const sheet = getOrCreateExaminationAuditSheet_();
  const lock = LockService.getScriptLock();
  if (lock.tryLock(20000)) {
    try {
      const start = sheet.getLastRow() + 1;
      const range = sheet.getRange(start, 1, rows.length, EXAMINATION_AUDIT_HEADER.length);
      range.setNumberFormat('@');
      range.setValues(rows);
    } finally { lock.releaseLock(); }
  } else {
    rows.forEach(function (row) { sheet.appendRow(row); }); // appendRow is atomic, so no row is ever overwritten
  }
}

/** All audit rows for one Announcement ID (reads one column, then only the block that contains matches). */
function examAuditRowsForAnnouncement_(announcementId) {
  const sheet = getOrCreateExaminationAuditSheet_();
  const last = sheet.getLastRow();
  if (last < 2) return [];
  const ids = sheet.getRange(2, EXAM_AUDIT_COL.ANN_ID + 1, last - 1, 1).getValues();
  let lo = -1, hi = -1;
  for (let i = 0; i < ids.length; i++) {
    if (String(ids[i][0]).trim() === announcementId) { if (lo === -1) lo = i; hi = i; }
  }
  if (lo === -1) return [];
  const block = sheet.getRange(2 + lo, 1, hi - lo + 1, EXAMINATION_AUDIT_HEADER.length).getValues();
  return block.filter(function (row) { return String(row[EXAM_AUDIT_COL.ANN_ID]).trim() === announcementId; });
}

/* ---------------------------- schedule ------------------------------ */

/**
 * America/New_York wall-clock date + time -> real instant, via the existing
 * DST-aware easternWallTimeToDate_(). Rejects anything not at least
 * MIN_SCHEDULE_LEAD_MINUTES ahead so Classroom never answers "Scheduled
 * time must be in the future" (and no API call is made when it would).
 */
function validateExaminationSchedule_(dateStr, timeStr, nowMs) {
  const date = String(dateStr || '').trim();
  const time = String(timeStr || '').trim();
  if (!date) return { ok: false, message: 'Please select a schedule date.' };
  if (!time) return { ok: false, message: 'Please select a schedule time.' };
  const at = examWallTime_(date, time);
  if (!at) return { ok: false, message: 'The schedule date/time is not valid.' };
  const now = nowMs || Date.now();
  if (at.getTime() <= now + EXAMINATION_CONFIG.MIN_SCHEDULE_LEAD_MINUTES * 60000) {
    return { ok: false, code: 'PAST', message: 'Scheduled time must be in the future.\n\nPlease select a future date/time.' };
  }
  return { ok: true, date: at, iso: at.toISOString(), label: examFormatInstant_(at) };
}

function examWallTime_(date, time) {
  const dm = /^(\d{4})-(\d{2})-(\d{2})$/.exec(date);
  const tm = /^(\d{1,2}):(\d{2})$/.exec(time);
  if (!dm || !tm) return null;
  const y = Number(dm[1]), mo = Number(dm[2]), d = Number(dm[3]), h = Number(tm[1]), mi = Number(tm[2]);
  const check = new Date(Date.UTC(y, mo - 1, d));
  if (check.getUTCFullYear() !== y || check.getUTCMonth() !== mo - 1 || check.getUTCDate() !== d || h > 23 || mi > 59) return null;
  const at = easternWallTimeToDate_(date, h, mi);
  return isNaN(at.getTime()) ? null : at;
}

/** Optional due date/time (default 11:59 PM EST) — must be after the scheduled time. Classroom wants UTC date + time parts. */
function examValidateDue_(dueDateStr, dueTimeStr, scheduledAt) {
  const date = String(dueDateStr || '').trim();
  if (!date) return { ok: true, none: true };
  const at = examWallTime_(date, String(dueTimeStr || '').trim() || '23:59');
  if (!at) return { ok: false, message: 'The due date/time is not valid.' };
  if (scheduledAt && at.getTime() <= scheduledAt.getTime()) return { ok: false, message: 'The due date/time must be after the scheduled time.' };
  return {
    ok: true, at: at, label: examFormatInstant_(at),
    dueDate: { year: at.getUTCFullYear(), month: at.getUTCMonth() + 1, day: at.getUTCDate() },
    dueTime: { hours: at.getUTCHours(), minutes: at.getUTCMinutes() }
  };
}

/* ----------------------------- topics ------------------------------- */

function examListTopics_(courseId) {
  const topics = [];
  let pageToken;
  do {
    const pt = pageToken;
    const resp = callWithBackoff_(function () {
      return Classroom.Courses.Topics.list(courseId, { pageSize: 100, pageToken: pt, fields: 'topic(topicId,name),nextPageToken' });
    }) || {};
    (resp.topic || []).forEach(function (t) { topics.push({ topicId: String(t.topicId), name: String(t.name || '') }); });
    pageToken = resp.nextPageToken;
  } while (pageToken);
  return topics;
}

/**
 * Exact topic name first, then a case-insensitive match (so an existing
 * "Homework" is reused instead of creating a second "HOMEWORK"). relatedIds
 * = every topic that counts as the same topic for duplicate detection,
 * including the legacy "EXAMNIATION" spelling.
 */
function examMatchTopic_(topics, topicName) {
  const want = String(topicName).trim();
  const upper = want.toUpperCase();
  const aliases = (EXAMINATION_CONFIG.TOPIC_ALIASES[want] || []).map(function (a) { return a.toUpperCase(); });
  let exact = null, loose = null;
  const related = [];
  topics.forEach(function (t) {
    const n = t.name.trim();
    const nu = n.toUpperCase();
    if (n === want && !exact) exact = t;
    else if (nu === upper && !loose) loose = t;
    if (nu === upper || aliases.indexOf(nu) > -1) related.push(t.topicId);
  });
  return { topic: exact || loose, relatedIds: related };
}

/** getOrCreateTopic(courseId, topicName): lists every topic page, reuses an existing match, otherwise creates exactly one. */
function getOrCreateExaminationTopic_(courseId, topicName, knownTopics) {
  if (EXAMINATION_CONFIG.TOPICS.indexOf(topicName) === -1) throw new Error('Unknown topic: ' + topicName);
  const match = examMatchTopic_(knownTopics || examListTopics_(courseId), topicName);
  if (match.topic) return { topicId: match.topic.topicId, name: match.topic.name, created: false };
  const created = examCallCreate_(function () { return Classroom.Courses.Topics.create({ name: topicName }, courseId); });
  return { topicId: String(created.topicId), name: created.name || topicName, created: true };
}

/* -------------------------- duplicate check ------------------------- */

/** Same classroom + same topic (or its legacy alias) + same name (trimmed, case-insensitive) among assignments/questions AND materials, published or scheduled. */
function checkExistingExaminationClasswork_(courseId, relatedTopicIds, assignmentName) {
  if (!relatedTopicIds.length) return null; // topic does not exist yet -> nothing can be filed under it; saves two list calls
  const wanted = String(assignmentName).trim().toUpperCase();
  const topicSet = {};
  relatedTopicIds.forEach(function (id) { topicSet[id] = true; });
  const isDup = function (item) { return item && topicSet[String(item.topicId || '')] && String(item.title || '').trim().toUpperCase() === wanted; };
  let pageToken, found = null;
  do {
    const pt = pageToken;
    const resp = callWithBackoff_(function () {
      return Classroom.Courses.CourseWork.list(courseId, { courseWorkStates: ['PUBLISHED', 'DRAFT'], pageSize: 100, pageToken: pt, fields: 'courseWork(id,title,topicId,state,scheduledTime,alternateLink),nextPageToken' });
    }) || {};
    (resp.courseWork || []).some(function (w) { if (isDup(w)) { found = { id: w.id, kind: 'COURSE_WORK', link: w.alternateLink || '', state: w.state }; return true; } return false; });
    pageToken = found ? null : resp.nextPageToken;
  } while (pageToken);
  if (found) return found;
  do {
    const pt = pageToken;
    const resp = callWithBackoff_(function () {
      return Classroom.Courses.CourseWorkMaterials.list(courseId, { courseWorkMaterialStates: ['PUBLISHED', 'DRAFT'], pageSize: 100, pageToken: pt, fields: 'courseWorkMaterial(id,title,topicId,state,alternateLink),nextPageToken' });
    }) || {};
    (resp.courseWorkMaterial || []).some(function (m) { if (isDup(m)) { found = { id: m.id, kind: 'COURSE_WORK_MATERIAL', link: m.alternateLink || '', state: m.state }; return true; } return false; });
    pageToken = found ? null : resp.nextPageToken;
  } while (pageToken);
  return found;
}

/* ---------------------- attachments / quiz material ------------------- */

/** Drive file id from a Drive/Docs URL, ?id=, or a bare id (same rules as the manual quiz script's extractGoogleDriveFileId). */
function examDriveFileId_(value) {
  const text = String(value || '').trim();
  if (!text) return '';
  let m = text.match(/(?:drive|docs)\.google\.com\/(?:drive\/u\/\d+\/)?(?:file|document|spreadsheets|presentation|forms)\/d\/(?!e\/)([a-zA-Z0-9_-]{10,})/i);
  if (m) return m[1];
  m = text.match(/[?&]id=([a-zA-Z0-9_-]{10,})/i);
  if (m) return m[1];
  return /^[a-zA-Z0-9_-]{25,}$/.test(text) ? text : '';
}

/** One Classroom material from a link: Drive file (view-only) when it is a Drive/Docs link, otherwise a plain link. Extensible — more sources can be added here without touching the publishing engine. */
function examMaterialFromLink_(link) {
  const url = String(link || '').trim();
  if (!url) return null;
  const fileId = examDriveFileId_(url);
  if (fileId) return { driveFile: { driveFile: { id: fileId }, shareMode: 'VIEW' } };
  if (/^https?:\/\//i.test(url)) return { link: { url: url } };
  return null;
}

function examNormKey_(v) { return String(v || '').toUpperCase().replace(/[^A-Z0-9]+/g, ''); }

/**
 * Quiz material index from the school's KAHOOT sheet (NILAI | TITLE |
 * GOOGLE_DRIVE_LINK). Sheet id = Script Property EXAM_QUIZ_MATERIAL_SHEET_ID
 * (falls back to the id used by the manual script). One read per batch call.
 */
function examLoadQuizMaterialIndex_() {
  const sheetId = getConfigString_(EXAMINATION_CONFIG.QUIZ_MATERIAL_SHEET_ID_PROP, EXAMINATION_CONFIG.QUIZ_MATERIAL_SHEET_ID_DEFAULT);
  const sheet = openSpreadsheetByIdWithRetry_(sheetId, '[Examination]').getSheetByName(EXAMINATION_CONFIG.QUIZ_MATERIAL_SHEET_NAME);
  if (!sheet) throw new Error('Quiz material sheet "' + EXAMINATION_CONFIG.QUIZ_MATERIAL_SHEET_NAME + '" was not found.');
  const data = sheet.getDataRange().getValues();
  const index = {};
  if (data.length < 2) return index;
  const headers = data[0].map(function (h) { return String(h || '').trim().toUpperCase(); });
  const iNilai = headers.indexOf('NILAI'), iTitle = headers.indexOf('TITLE'), iLink = headers.indexOf('GOOGLE_DRIVE_LINK');
  if (iNilai < 0 || iTitle < 0 || iLink < 0) throw new Error('Quiz material sheet needs NILAI, TITLE and GOOGLE_DRIVE_LINK columns.');
  for (let i = 1; i < data.length; i++) {
    const link = String(data[i][iLink] || '').trim();
    const key = examNormKey_(data[i][iNilai]) + '|' + examNormKey_(data[i][iTitle]);
    if (link && key !== '|' && !index[key]) index[key] = link;
  }
  return index;
}

/* ------------------------ classwork validation ----------------------- */

/** Validates a classwork request (no Classroom calls). Returns { errors, value }. */
function examNormalizeClasswork_(p, nowMs) {
  p = p || {};
  const errors = [];
  const typeKey = String(p.type || '');
  const type = EXAMINATION_CLASSWORK_TYPES[typeKey];
  const topic = String(p.topic || '');
  const name = String(p.assignmentName || '').trim();
  if (!type) errors.push('Please select a classwork type.');
  if (EXAMINATION_CONFIG.TOPICS.indexOf(topic) === -1) errors.push('Please select a topic.');
  else if ((EXAMINATION_CONFIG.ASSIGNMENT_NAMES[topic] || []).indexOf(name) === -1) errors.push('Please select a valid assignment name for ' + topic + '.');
  const graded = !!(type && type.gradable) && p.graded !== false && String(p.graded) !== 'false';
  let points = null;
  if (graded) {
    points = Number(p.points);
    if (!(points >= 1 && points <= EXAMINATION_CONFIG.MAX_POINTS && Math.floor(points) === points)) {
      errors.push('Points must be a whole number from 1 to ' + EXAMINATION_CONFIG.MAX_POINTS + ' when GRADED.');
    }
  }
  const instructions = examText_(p.instructions).replace(/\s+$/, '');
  if (instructions.length > EXAMINATION_CONFIG.MAX_TEXT_CHARS) errors.push('Instructions are too long.');
  let choices = [];
  if (type && type.needsChoices) {
    const seen = {};
    choices = examText_(Array.isArray(p.choices) ? p.choices.join('\n') : p.choices).split('\n')
      .map(function (c) { return c.trim(); })
      .filter(function (c) { const k = c.toUpperCase(); if (!c || seen[k]) return false; seen[k] = true; return true; });
    if (choices.length < 2 || choices.length > 20) errors.push('Multiple choice questions need 2 to 20 distinct choices (one per line).');
  }
  const attachmentUrl = String(p.attachmentUrl || '').trim();
  if (attachmentUrl && !examMaterialFromLink_(attachmentUrl)) errors.push('The attachment must be a Google Drive link or an http(s) URL.');
  const schedule = validateExaminationSchedule_(p.scheduleDate, p.scheduleTime, nowMs);
  if (!schedule.ok) errors.push(schedule.message);
  let due = { ok: true, none: true };
  if (type && type.dueDate) {
    due = examValidateDue_(p.dueDate, p.dueTime, schedule.ok ? schedule.date : null);
    if (!due.ok) errors.push(due.message);
  }
  return {
    errors: errors,
    scheduleCode: schedule.code || '',
    value: {
      typeKey: typeKey, type: type, typeLabel: type ? type.label : '', topic: topic, assignmentName: name,
      graded: graded, points: points, instructions: instructions, choices: choices, attachmentUrl: attachmentUrl,
      scheduleDate: String(p.scheduleDate || ''), scheduleTime: String(p.scheduleTime || ''),
      dueDate: String(p.dueDate || ''), dueTime: String(p.dueTime || ''),
      schedule: schedule, due: due
    }
  };
}

function examDescriptionFor_(v, materialLink) {
  const body = examStripSignature_(v.instructions
    .split('{TITLE}').join(v.assignmentName)
    .split('{MATERIAL_LINK}').join(materialLink || 'Material not available.'));
  return (body ? body + '\n\n' : '') + EXAMINATION_CONFIG.SIGNATURE;
}

/** Removes a trailing signature block (whitespace-tolerant) so it is never doubled on modify/re-use. */
function examStripSignature_(text) {
  const lines = EXAMINATION_CONFIG.SIGNATURE.split('\n').map(function (l) { return l.trim().replace(/[.*+?^${}()|[\]\\]/g, '\\$&'); });
  const re = new RegExp('(?:\\s*' + lines.join('[ \\t]*\\n[ \\t]*') + '[ \\t]*)+\\s*$');
  return examText_(text).replace(/\s+$/, '').replace(re, '').replace(/\s+$/, '');
}

/** Builds the exact Classroom request body for one classroom (server decides the endpoint and fields). */
function examBuildClassworkResource_(v, topicId, materialLink) {
  const resource = {
    title: v.assignmentName,
    description: examDescriptionFor_(v, materialLink),
    state: 'DRAFT',                        // + scheduledTime = "Scheduled" in Classroom
    scheduledTime: v.schedule.iso,
    topicId: topicId
  };
  const materials = [];
  const quizMat = materialLink ? examMaterialFromLink_(materialLink) : null;
  if (quizMat) materials.push(quizMat);
  const extra = examMaterialFromLink_(v.attachmentUrl);
  if (extra && (!quizMat || JSON.stringify(extra) !== JSON.stringify(quizMat))) materials.push(extra);
  if (materials.length) resource.materials = materials;
  if (v.type.api === 'COURSE_WORK') {
    resource.workType = v.type.workType;
    resource.assigneeMode = 'ALL_STUDENTS';
    if (v.graded) resource.maxPoints = v.points;   // omitted = ungraded
    if (v.type.needsChoices) resource.multipleChoiceQuestion = { choices: v.choices };
    if (v.due && !v.due.none) { resource.dueDate = v.due.dueDate; resource.dueTime = v.due.dueTime; }
  }
  return resource;
}

function createExaminationAssignment_(courseId, resource) { return examCallCreate_(function () { return Classroom.Courses.CourseWork.create(resource, courseId); }); }
function createExaminationMaterial_(courseId, resource) { return examCallCreate_(function () { return Classroom.Courses.CourseWorkMaterials.create(resource, courseId); }); }

/** Assignment / Quiz Assignment / Question -> courseWork.create; Material -> courseWorkMaterials.create. */
function createExaminationClasswork_(courseId, v, topicId, materialLink) {
  const resource = examBuildClassworkResource_(v, topicId, materialLink);
  return v.type.api === 'COURSE_WORK_MATERIAL' ? createExaminationMaterial_(courseId, resource) : createExaminationAssignment_(courseId, resource);
}

function examClassworkAuditBase_(v, batchId) {
  return {
    action: EXAMINATION_ACTIONS.CLASSWORK_CREATE, operation: 'CLASSWORK', batchId: batchId, topic: v.topic,
    typeLabel: v.typeLabel, assignmentName: v.assignmentName, grading: v.graded ? 'GRADED' : 'UNGRADED',
    points: v.graded ? v.points : '', scheduledLabel: v.schedule.ok ? v.schedule.label : (v.scheduleDate + ' ' + v.scheduleTime),
    dueLabel: v.due && !v.due.none && v.due.label ? v.due.label : '', preview: v.instructions
  };
}

/* ------------------------ classwork endpoints ------------------------ */

/** PREVIEW (no Classroom writes): validates everything and returns the summary + the validated classroom list. */
function previewExaminationClasswork(sessionToken, payload) {
  apsRequireTabForToken_(sessionToken, 'exam.classwork'); // r56: Admin Control → Access Control
  examRequireAccess_(sessionToken, true);
  payload = payload || {};
  const norm = examNormalizeClasswork_(payload);
  const all = getExaminationCourses_(false);
  const target = payload.targetMode === 'ALL' ? { courses: all, rejected: [] } : examResolveCourses_(payload.courseIds, all);
  if (!target.courses.length) norm.errors.push('Please select at least one classroom.');
  const v = norm.value;
  return {
    ok: norm.errors.length === 0,
    errors: norm.errors,
    batchId: examNewBatchId_(),
    preview: {
      type: v.typeLabel, topic: v.topic, assignmentName: v.assignmentName,
      grading: v.graded ? 'GRADED' : 'UNGRADED', points: v.graded ? v.points : '',
      schedule: v.schedule.ok ? v.schedule.label : '', due: v.due && !v.due.none && v.due.label ? v.due.label : '',
      target: payload.targetMode === 'ALL' ? 'All ' + EXAMINATION_CONFIG.COURSE_SUFFIX + ' Classrooms' : 'Selected classes',
      selectedCount: target.courses.length, choices: v.choices,
      attachment: v.attachmentUrl, quizMaterial: !!(v.type && v.type.quizMaterial),
      sampleInstructions: v.type ? examDescriptionFor_(v, v.type.quizMaterial ? '(per-NILAI Drive link from the quiz sheet)' : '') : ''
    },
    courseIds: target.courses.map(function (c) { return c.id; }),
    rejectedCount: target.rejected.length
  };
}

/**
 * PUBLISH one chunk of classrooms (the browser sends COURSES_PER_CALL at a
 * time so it can show progress, and no call gets near the 6-minute limit).
 * Each classroom is independent: SUCCESS / FAILED / SKIPPED / ALREADY_EXISTS.
 * Idempotent — re-running (double click, Retry Failed) re-checks Classroom
 * for Course + Topic + Name before creating anything.
 */
function publishExaminationToCourses(sessionToken, payload) {
  apsRequireTabForToken_(sessionToken, 'exam.classwork'); // r56: Admin Control → Access Control
  const viewer = examRequireAccess_(sessionToken, true);
  payload = payload || {};
  if ((payload.courseIds || []).length > EXAMINATION_CONFIG.MAX_COURSES_PER_CALL) throw new Error('Too many classrooms in one request.');
  const batchId = examSafeBatchId_(payload.batchId);
  const norm = examNormalizeClasswork_(payload);
  const v = norm.value;
  const all = getExaminationCourses_(false);
  const target = examResolveCourses_(payload.courseIds, all);
  const results = [];
  target.rejected.forEach(function (id) {
    results.push({ courseId: id, courseName: '', status: EXAMINATION_STATUS.SKIPPED, message: 'Not an active ' + EXAMINATION_CONFIG.COURSE_SUFFIX + ' classroom.' });
  });
  if (norm.errors.length) {
    // Fail every classroom WITHOUT any Classroom API call (e.g. the schedule passed while a long batch was running).
    target.courses.forEach(function (c) {
      results.push({ courseId: c.id, courseName: c.name, status: EXAMINATION_STATUS.FAILED, message: norm.errors.join(' '), error: 'VALIDATION: ' + norm.errors.join(' | ') });
    });
    examAppendAudit_(viewer, examClassworkAuditBase_(v, batchId), results);
    return { batchId: batchId, results: results.map(examClientResult_), counts: examCounts_(results), validationErrors: norm.errors };
  }
  let quizIndex = null, quizIndexError = '';
  if (v.type.quizMaterial) {
    try { quizIndex = examLoadQuizMaterialIndex_(); } catch (e) { quizIndexError = examFriendlyError_(e).raw; }
  }
  target.courses.forEach(function (course) {
    const key = examInflightKey_(course.id, 'CW', v.topic); // per classroom + topic: also serialises topic get-or-create
    if (!examAcquireInflight_(key)) {
      results.push({ courseId: course.id, courseName: course.name, status: EXAMINATION_STATUS.FAILED, message: 'Another publish to this classroom is in progress. Use Retry Failed shortly.', error: 'IN_FLIGHT' });
      return;
    }
    try {
      const topics = examListTopics_(course.id);
      const match = examMatchTopic_(topics, v.topic);
      const existing = checkExistingExaminationClasswork_(course.id, match.relatedIds, v.assignmentName);
      if (existing) {
        results.push({ courseId: course.id, courseName: course.name, status: EXAMINATION_STATUS.ALREADY_EXISTS, message: v.assignmentName + ' already exists under ' + v.topic + '.', classroomId: existing.id, link: existing.link });
        return;
      }
      let materialLink = '';
      if (v.type.quizMaterial) {
        if (!quizIndex) {
          results.push({ courseId: course.id, courseName: course.name, status: EXAMINATION_STATUS.FAILED, message: 'The quiz material sheet could not be read.', error: quizIndexError });
          return;
        }
        materialLink = quizIndex[examNormKey_(extractNilaiFromCourseName_(course.name)) + '|' + examNormKey_(v.assignmentName)] || '';
        if (!materialLink) {
          results.push({ courseId: course.id, courseName: course.name, status: EXAMINATION_STATUS.SKIPPED, message: 'No quiz material in the sheet for ' + (course.grade || 'this NILAI') + ' + ' + v.assignmentName + '.' });
          return;
        }
      }
      const topic = getOrCreateExaminationTopic_(course.id, v.topic, topics);
      const created = createExaminationClasswork_(course.id, v, topic.topicId, materialLink);
      results.push({ courseId: course.id, courseName: course.name, status: EXAMINATION_STATUS.SUCCESS, message: 'Scheduled for ' + v.schedule.label + (topic.created ? ' (topic created)' : ''), classroomId: created && created.id ? String(created.id) : '', topicId: topic.topicId, link: (created && created.alternateLink) || '' });
    } catch (e) {
      const fe = examFriendlyError_(e);
      results.push({ courseId: course.id, courseName: course.name, status: EXAMINATION_STATUS.FAILED, message: fe.friendly, error: fe.raw });
    } finally {
      examReleaseInflight_(key);
    }
  });
  examAppendAudit_(viewer, examClassworkAuditBase_(v, batchId), results);
  return { batchId: batchId, results: results.map(examClientResult_), counts: examCounts_(results) };
}

/** Retry Failed: same engine, only the classrooms passed in (the browser keeps the failed list). Duplicate checks guarantee a success is never re-created. */
function retryFailedExaminationPublish(sessionToken, payload) {
  apsRequireTabForToken_(sessionToken, 'exam.classwork'); // r56: Admin Control → Access Control
  return publishExaminationToCourses(sessionToken, payload);
}

/** Result row sent to the browser — the raw API error stays in the audit log only. */
function examClientResult_(r) {
  return { courseId: r.courseId, courseName: r.courseName, status: r.status, message: r.message || '', classroomId: r.classroomId || '', link: r.link || '' };
}

/* ------------------------- announcements ---------------------------- */

/**
 * ANNYYYYMMDD_NNNN, unique across the system: a per-day counter in Script
 * Properties, incremented under the script lock (two admins can never get
 * the same number). On the first id of a day the counter is also
 * reconciled with the audit log, so a lost/reset property cannot reissue
 * an id that was already used.
 */
function generateAnnouncementId_() {
  const lock = LockService.getScriptLock();
  if (!lock.tryLock(20000)) throw new Error('The dashboard is busy. Please try posting again in a few seconds.');
  try {
    const props = PropertiesService.getScriptProperties();
    const today = Utilities.formatDate(new Date(), EXAMINATION_CONFIG.TIMEZONE, 'yyyyMMdd');
    let state = {};
    try { state = JSON.parse(props.getProperty(EXAMINATION_CONFIG.ANNOUNCEMENT_SEQ_PROP_KEY) || '{}') || {}; } catch (e) { state = {}; }
    let seq = state.date === today ? Number(state.seq) || 0 : examMaxAuditSeqForDay_(today);
    seq += 1;
    if (seq > 9999) throw new Error('Daily announcement limit reached (9999).');
    props.setProperty(EXAMINATION_CONFIG.ANNOUNCEMENT_SEQ_PROP_KEY, JSON.stringify({ date: today, seq: seq }));
    const id = EXAMINATION_CONFIG.ANNOUNCEMENT_ID_PREFIX + today + '_' + ('000' + seq).slice(-4);
    CacheService.getScriptCache().put('examAnnKnown_' + id, '1', 21600);
    return id;
  } finally {
    lock.releaseLock();
  }
}

function examMaxAuditSeqForDay_(yyyymmdd) {
  const sheet = getOrCreateExaminationAuditSheet_();
  const last = sheet.getLastRow();
  if (last < 2) return 0;
  const prefix = EXAMINATION_CONFIG.ANNOUNCEMENT_ID_PREFIX + yyyymmdd + '_';
  let max = 0;
  sheet.getRange(2, EXAM_AUDIT_COL.ANN_ID + 1, last - 1, 1).getValues().forEach(function (r) {
    const s = String(r[0]);
    if (s.indexOf(prefix) === 0) max = Math.max(max, Number(s.slice(prefix.length)) || 0);
  });
  return max;
}

/** Public wrapper (spec name) — Admin/HM with publish permission only. Normally the id is generated inside postExaminationAnnouncement. */
function generateAnnouncementId(sessionToken) {
  apsRequireTabForToken_(sessionToken, 'exam.announcements'); // r56: Admin Control → Access Control
  examRequireAccess_(sessionToken, true);
  return generateAnnouncementId_();
}

function examAnnouncementIdLine_(id) { return EXAMINATION_CONFIG.ANNOUNCEMENT_ID_LABEL + ': ' + id; }

/** Removes any ANNOUNCEMENT_ID line the user may have pasted, and trailing blank space. */
function examStripAnnouncementId_(text) {
  return examText_(text).replace(/^[ \t]*ANNOUNCEMENT_ID:[ \t]*\S*[ \t]*$/gm, '').replace(/\s+$/, '');
}

/** Text the user edits: no ANNOUNCEMENT_ID line, no signature (both are added back by the server). */
function examAnnouncementEditableBody_(text) { return examStripSignature_(examStripAnnouncementId_(text)); }

/** body + signature + the ID as the LAST line; modify keeps the same ID. */
function examComposeAnnouncementText_(body, id) {
  return examAnnouncementEditableBody_(body) + '\n\n' + EXAMINATION_CONFIG.SIGNATURE + '\n\n' + examAnnouncementIdLine_(id);
}

/** Exact ID on the LAST line only — "ANN20260928" or "ANN20260928_000" never match. */
function examExtractAnnouncementId_(text) {
  const m = /(?:^|\n)[ \t]*ANNOUNCEMENT_ID:[ \t]*(ANN\d{8}_\d{4})[ \t]*$/.exec(examText_(text).replace(/\s+$/, ''));
  return m ? m[1] : '';
}

function examValidAnnouncementId_(raw) {
  const id = String(raw || '').trim().toUpperCase();
  if (!EXAM_ANNOUNCEMENT_ID_RE_.test(id)) throw new Error('Enter a full Announcement ID like ANN20260928_0001.');
  return id;
}

function examAnnouncementBody_(payload) {
  let body = examAnnouncementEditableBody_(payload.text);
  const header = EXAMINATION_CONFIG.ANNOUNCEMENT_HEADER;
  if (payload.includeHeader && body && body.indexOf(header) !== 0) body = header + '\n\n' + body;
  return body;
}

/** Server-side preview for Post (no id is consumed until the post is confirmed). */
function previewExaminationAnnouncement(sessionToken, payload) {
  apsRequireTabForToken_(sessionToken, 'exam.announcements'); // r56: Admin Control → Access Control
  examRequireAccess_(sessionToken, true);
  payload = payload || {};
  const errors = [];
  const body = examAnnouncementBody_(payload);
  if (!examAnnouncementEditableBody_(payload.text).trim()) errors.push('Announcement text cannot be empty.');
  if (body.length > EXAMINATION_CONFIG.MAX_TEXT_CHARS) errors.push('Announcement text is too long.');
  const all = getExaminationCourses_(false);
  const target = payload.targetMode === 'ALL' ? { courses: all, rejected: [] } : examResolveCourses_(payload.courseIds, all);
  if (!target.courses.length) errors.push('Please select at least one classroom.');
  const today = Utilities.formatDate(new Date(), EXAMINATION_CONFIG.TIMEZONE, 'yyyyMMdd');
  return {
    ok: !errors.length, errors: errors, batchId: examNewBatchId_(),
    previewText: body + '\n\n' + EXAMINATION_CONFIG.SIGNATURE + '\n\n' + examAnnouncementIdLine_('ANN' + today + '_####'),
    idNote: 'The real ID (ANN' + today + '_NNNN) is assigned when you confirm.',
    target: payload.targetMode === 'ALL' ? 'All ' + EXAMINATION_CONFIG.COURSE_SUFFIX + ' Classrooms' : 'Selected classes',
    selectedCount: target.courses.length,
    courseIds: target.courses.map(function (c) { return c.id; })
  };
}

function examListAnnouncementsWithId_(courseId, announcementId, maxPages) {
  let pageToken, found = null, pages = 0;
  do {
    pages++;
    const pt = pageToken;
    const resp = callWithBackoff_(function () {
      return Classroom.Courses.Announcements.list(courseId, { announcementStates: ['PUBLISHED', 'DRAFT'], pageSize: 100, pageToken: pt, fields: 'announcements(id,text,state,creationTime,updateTime,alternateLink),nextPageToken' });
    }) || {};
    (resp.announcements || []).some(function (a) { if (examExtractAnnouncementId_(a.text) === announcementId) { found = a; return true; } return false; });
    pageToken = found || (maxPages && pages >= maxPages) ? null : resp.nextPageToken;
  } while (pageToken);
  return found;
}

/**
 * POST one chunk. The browser gets the ID first (generateAnnouncementId) and
 * passes it with every chunk and Retry Failed; without one, an ID is
 * generated here. A supplied ID must be one this system issued, and every
 * classroom is re-checked in Classroom for that exact ID before posting, so a
 * double click, a timed-out chunk or a retry never double-posts.
 */
function postExaminationAnnouncement(sessionToken, payload) {
  apsRequireTabForToken_(sessionToken, 'exam.announcements'); // r56: Admin Control → Access Control
  const viewer = examRequireAccess_(sessionToken, true);
  payload = payload || {};
  if ((payload.courseIds || []).length > EXAMINATION_CONFIG.MAX_COURSES_PER_CALL) throw new Error('Too many classrooms in one request.');
  const body = examAnnouncementBody_(payload);
  if (!examAnnouncementEditableBody_(payload.text).trim()) throw new Error('Announcement text cannot be empty.');
  if (body.length > EXAMINATION_CONFIG.MAX_TEXT_CHARS) throw new Error('Announcement text is too long.');
  const all = getExaminationCourses_(false);
  const target = examResolveCourses_(payload.courseIds, all);
  if (!target.courses.length && !target.rejected.length) throw new Error('Please select at least one classroom.');
  const batchId = examSafeBatchId_(payload.batchId);
  let id, priorCourseIds = {};
  if (payload.announcementId) {
    id = examValidAnnouncementId_(payload.announcementId);
    const rows = examAuditRowsForAnnouncement_(id);
    if (!rows.length && !CacheService.getScriptCache().get('examAnnKnown_' + id)) throw new Error('Unknown Announcement ID ' + id + ' — it was not issued by this dashboard.');
    rows.forEach(function (r) { priorCourseIds[String(r[EXAM_AUDIT_COL.COURSE_ID])] = true; });
  } else {
    id = generateAnnouncementId_();
  }
  const text = examComposeAnnouncementText_(body, id);
  const results = target.rejected.map(function (cid) {
    return { courseId: cid, courseName: '', status: EXAMINATION_STATUS.SKIPPED, message: 'Not an active ' + EXAMINATION_CONFIG.COURSE_SUFFIX + ' classroom.' };
  });
  target.courses.forEach(function (course) {
    const key = examInflightKey_(course.id, 'ANN', id);
    if (!examAcquireInflight_(key)) {
      results.push({ courseId: course.id, courseName: course.name, status: EXAMINATION_STATUS.FAILED, message: 'Another post to this classroom is in progress. Use Retry Failed shortly.', error: 'IN_FLIGHT' });
      return;
    }
    try {
      // Any supplied ID is re-checked in Classroom before posting: a full scan where the audit log already
      // shows an attempt, otherwise the newest page (a lost audit write or a timed-out chunk can never double-post).
      if (payload.announcementId) {
        const existing = examListAnnouncementsWithId_(course.id, id, priorCourseIds[course.id] ? 0 : 1);
        if (existing) {
          results.push({ courseId: course.id, courseName: course.name, status: EXAMINATION_STATUS.ALREADY_EXISTS, message: id + ' is already posted here.', classroomId: String(existing.id), link: existing.alternateLink || '' });
          return;
        }
      }
      const created = examCallCreate_(function () {
        return Classroom.Courses.Announcements.create({ text: text, state: 'PUBLISHED', assigneeMode: 'ALL_STUDENTS' }, course.id);
      });
      results.push({ courseId: course.id, courseName: course.name, status: EXAMINATION_STATUS.SUCCESS, message: 'Posted', classroomId: created && created.id ? String(created.id) : '', link: (created && created.alternateLink) || '' });
    } catch (e) {
      const fe = examFriendlyError_(e);
      results.push({ courseId: course.id, courseName: course.name, status: EXAMINATION_STATUS.FAILED, message: fe.friendly, error: fe.raw });
    } finally {
      examReleaseInflight_(key);
    }
  });
  examAppendAudit_(viewer, { action: EXAMINATION_ACTIONS.ANNOUNCEMENT_POST, operation: 'ANNOUNCEMENT', batchId: batchId, announcementId: id, preview: body }, results);
  return { announcementId: id, batchId: batchId, text: text, results: results.map(examClientResult_), counts: examCounts_(results) };
}

function examAnnouncementRow_(course, status, a, message) {
  return {
    courseId: course.id, courseName: course.name, status: status, message: message || '',
    classroomId: a ? String(a.id) : '', state: a ? (a.state || '') : '',
    text: a ? examText_(a.text) : '', bodyText: a ? examAnnouncementEditableBody_(a.text) : '',
    created: a ? examFormatIso_(a.creationTime) : '', updated: a ? examFormatIso_(a.updateTime) : '', link: a ? (a.alternateLink || '') : ''
  };
}

/**
 * SEARCH an exact Announcement ID.
 *  - default (fast): uses the audit log to know which classrooms got it and
 *    fetches each one directly (1 call per classroom) -> FOUND / MISSING /
 *    DELETED. registryEmpty=true tells the browser to fall back to a deep scan.
 *  - deep (courseIds chunk): lists announcements of every classroom in the
 *    chunk and matches the exact ID on the last line.
 */
function searchExaminationAnnouncement(sessionToken, payload) {
  apsRequireTabForToken_(sessionToken, 'exam.announcements'); // r56: Admin Control → Access Control
  examRequireAccess_(sessionToken, false);
  payload = payload || {};
  const id = examValidAnnouncementId_(payload.announcementId);
  const all = getExaminationCourses_(false);
  const byId = {};
  all.forEach(function (c) { byId[c.id] = c; });
  const rows = [];
  if (payload.deep) {
    const target = examResolveCourses_(payload.courseIds, all);
    if (target.courses.length > EXAMINATION_CONFIG.MAX_COURSES_PER_CALL) throw new Error('Too many classrooms in one request.');
    target.courses.forEach(function (course) {
      try {
        const a = examListAnnouncementsWithId_(course.id, id);
        if (a) rows.push(examAnnouncementRow_(course, 'FOUND', a));
      } catch (e) {
        rows.push(examAnnouncementRow_(course, 'ERROR', null, examFriendlyError_(e).friendly));
      }
    });
    return { announcementId: id, deep: true, rows: rows };
  }
  const audit = examAuditRowsForAnnouncement_(id);
  if (!audit.length) return { announcementId: id, registryEmpty: true, rows: [] };
  const state = {}; // courseId -> { name, classroomId, deleted }
  audit.forEach(function (r) {
    const cid = String(r[EXAM_AUDIT_COL.COURSE_ID]);
    const s = state[cid] = state[cid] || { name: String(r[EXAM_AUDIT_COL.COURSE_NAME] || ''), classroomId: '', deleted: false };
    const action = String(r[EXAM_AUDIT_COL.ACTION]);
    const status = String(r[EXAM_AUDIT_COL.STATUS]);
    const gid = String(r[EXAM_AUDIT_COL.CLASSROOM_ID] || '');
    if ((status === EXAMINATION_STATUS.SUCCESS || status === EXAMINATION_STATUS.ALREADY_EXISTS) && gid) {
      if (action === EXAMINATION_ACTIONS.ANNOUNCEMENT_DELETE) s.deleted = true;
      else { s.classroomId = gid; s.deleted = false; }
    }
  });
  Object.keys(state).forEach(function (cid) {
    const s = state[cid];
    const course = byId[cid] || { id: cid, name: s.name || cid };
    if (!byId[cid]) { rows.push(examAnnouncementRow_(course, 'NOT_AY', null, 'Not an active ' + EXAMINATION_CONFIG.COURSE_SUFFIX + ' classroom any more — left untouched.')); return; }
    if (s.deleted) { rows.push(examAnnouncementRow_(course, 'DELETED', null, 'Deleted from this classroom by the dashboard.')); return; }
    if (!s.classroomId) { rows.push(examAnnouncementRow_(course, 'MISSING', null, 'Never posted here (the original post failed or was skipped).')); return; }
    try {
      const a = callWithBackoff_(function () { return Classroom.Courses.Announcements.get(cid, s.classroomId, { fields: 'id,text,state,creationTime,updateTime,alternateLink' }); });
      if (a && examExtractAnnouncementId_(a.text) === id) rows.push(examAnnouncementRow_(course, 'FOUND', a));
      else rows.push(examAnnouncementRow_(course, 'MISSING', null, 'The announcement no longer carries this ID.'));
    } catch (e) {
      const fe = examFriendlyError_(e);
      rows.push(examAnnouncementRow_(course, /not found/i.test(fe.raw) ? 'MISSING' : 'ERROR', null, /not found/i.test(fe.raw) ? 'Deleted in Google Classroom.' : fe.friendly));
    }
  });
  rows.sort(function (a, b) { return a.courseName.localeCompare(b.courseName, undefined, { numeric: true }); });
  return { announcementId: id, rows: rows };
}

/** Re-reads one target and confirms the exact ID before any change/delete — never trusts the browser's copy. */
function examVerifiedAnnouncement_(courseId, classroomId, id) {
  const a = callWithBackoff_(function () { return Classroom.Courses.Announcements.get(courseId, classroomId, { fields: 'id,text,state,alternateLink' }); });
  return a && examExtractAnnouncementId_(a.text) === id ? a : null;
}

function examAnnouncementTargets_(payload, all) {
  const targets = (payload.targets || []).slice(0, EXAMINATION_CONFIG.MAX_COURSES_PER_CALL + 1);
  if (targets.length > EXAMINATION_CONFIG.MAX_COURSES_PER_CALL) throw new Error('Too many classrooms in one request.');
  const byId = {};
  all.forEach(function (c) { byId[c.id] = c; });
  return targets.map(function (t) {
    const cid = String((t && t.courseId) || '');
    return { course: byId[cid] || null, courseId: cid, classroomId: String((t && t.classroomId) || '') };
  });
}

/** MODIFY: same ID stays at the end; only classrooms that already have it are updated (never creates). */
function modifyExaminationAnnouncement(sessionToken, payload) {
  apsRequireTabForToken_(sessionToken, 'exam.announcements'); // r56: Admin Control → Access Control
  const viewer = examRequireAccess_(sessionToken, true);
  payload = payload || {};
  const id = examValidAnnouncementId_(payload.announcementId);
  const body = examAnnouncementEditableBody_(payload.text);
  if (!body.trim()) throw new Error('Announcement text cannot be empty.');
  if (body.length > EXAMINATION_CONFIG.MAX_TEXT_CHARS) throw new Error('Announcement text is too long.');
  const text = examComposeAnnouncementText_(body, id);
  const batchId = examSafeBatchId_(payload.batchId);
  const results = [];
  examAnnouncementTargets_(payload, getExaminationCourses_(false)).forEach(function (t) {
    if (!t.course) { results.push({ courseId: t.courseId, courseName: '', status: EXAMINATION_STATUS.SKIPPED, message: 'Not an active ' + EXAMINATION_CONFIG.COURSE_SUFFIX + ' classroom.' }); return; }
    try {
      const a = examVerifiedAnnouncement_(t.courseId, t.classroomId, id);
      if (!a) { results.push({ courseId: t.courseId, courseName: t.course.name, status: EXAMINATION_STATUS.SKIPPED, message: 'This announcement no longer carries ' + id + '.' }); return; }
      if (examText_(a.text) === text) { results.push({ courseId: t.courseId, courseName: t.course.name, status: EXAMINATION_STATUS.SKIPPED, message: 'Already up to date.', classroomId: t.classroomId, link: a.alternateLink || '' }); return; }
      const updated = callWithBackoff_(function () { return Classroom.Courses.Announcements.patch({ text: text }, t.courseId, t.classroomId, { updateMask: 'text' }); });
      results.push({ courseId: t.courseId, courseName: t.course.name, status: EXAMINATION_STATUS.SUCCESS, message: 'Updated', classroomId: t.classroomId, link: (updated && updated.alternateLink) || a.alternateLink || '' });
    } catch (e) {
      const fe = examFriendlyError_(e);
      results.push({ courseId: t.courseId, courseName: t.course.name, status: EXAMINATION_STATUS.FAILED, message: fe.friendly, error: fe.raw, classroomId: t.classroomId });
    }
  });
  examAppendAudit_(viewer, { action: EXAMINATION_ACTIONS.ANNOUNCEMENT_MODIFY, operation: 'ANNOUNCEMENT', batchId: batchId, announcementId: id, preview: body }, results);
  return { announcementId: id, batchId: batchId, text: text, results: results.map(examClientResult_), counts: examCounts_(results) };
}

/** DELETE: exact-ID verified per classroom, then removed. Already-gone items are SKIPPED (safe to retry). */
function deleteExaminationAnnouncement(sessionToken, payload) {
  apsRequireTabForToken_(sessionToken, 'exam.announcements'); // r56: Admin Control → Access Control
  const viewer = examRequireAccess_(sessionToken, true);
  payload = payload || {};
  const id = examValidAnnouncementId_(payload.announcementId);
  const batchId = examSafeBatchId_(payload.batchId);
  const results = [];
  examAnnouncementTargets_(payload, getExaminationCourses_(false)).forEach(function (t) {
    if (!t.course) { results.push({ courseId: t.courseId, courseName: '', status: EXAMINATION_STATUS.SKIPPED, message: 'Not an active ' + EXAMINATION_CONFIG.COURSE_SUFFIX + ' classroom.' }); return; }
    try {
      let a = null;
      try { a = examVerifiedAnnouncement_(t.courseId, t.classroomId, id); } catch (ge) { if (!/not found/i.test(String(ge && ge.message))) throw ge; }
      if (!a) { results.push({ courseId: t.courseId, courseName: t.course.name, status: EXAMINATION_STATUS.SKIPPED, message: 'Already deleted, or it no longer carries ' + id + '.' }); return; }
      callWithBackoff_(function () { return Classroom.Courses.Announcements.remove(t.courseId, t.classroomId); });
      results.push({ courseId: t.courseId, courseName: t.course.name, status: EXAMINATION_STATUS.SUCCESS, message: 'Deleted', classroomId: t.classroomId });
    } catch (e) {
      const fe = examFriendlyError_(e);
      results.push({ courseId: t.courseId, courseName: t.course.name, status: EXAMINATION_STATUS.FAILED, message: fe.friendly, error: fe.raw, classroomId: t.classroomId });
    }
  });
  examAppendAudit_(viewer, { action: EXAMINATION_ACTIONS.ANNOUNCEMENT_DELETE, operation: 'ANNOUNCEMENT', batchId: batchId, announcementId: id }, results);
  return { announcementId: id, batchId: batchId, results: results.map(examClientResult_), counts: examCounts_(results) };
}

/* ------------------------------ history ----------------------------- */

/**
 * Examination history, newest first. Scans only the last HISTORY_SCAN_ROWS
 * rows (the sheet itself keeps everything) and returns at most
 * HISTORY_MAX_RESULTS. Filters: search (Announcement ID / Assignment Name /
 * Course Name / Batch ID), action, status, topic, date (yyyy-MM-dd, EST).
 */
function getExaminationHistory(sessionToken, filters) {
  apsRequireTabForToken_(sessionToken, 'exam'); // r56: Admin Control → Access Control
  examRequireAccess_(sessionToken, false);
  filters = filters || {};
  const sheet = getOrCreateExaminationAuditSheet_();
  const last = sheet.getLastRow();
  if (last < 2) return { rows: [], scanned: 0, truncated: false };
  const count = Math.min(last - 1, EXAMINATION_CONFIG.HISTORY_SCAN_ROWS);
  const values = sheet.getRange(last - count + 1, 1, count, EXAMINATION_AUDIT_HEADER.length).getDisplayValues();
  const q = String(filters.search || '').trim().toUpperCase();
  const action = String(filters.action || ''), status = String(filters.status || ''), topic = String(filters.topic || ''), date = String(filters.date || '').trim();
  const out = [];
  for (let i = values.length - 1; i >= 0 && out.length < EXAMINATION_CONFIG.HISTORY_MAX_RESULTS; i--) {
    const r = values[i];
    if (action && r[EXAM_AUDIT_COL.ACTION] !== action) continue;
    if (status && r[EXAM_AUDIT_COL.STATUS] !== status) continue;
    if (topic && r[EXAM_AUDIT_COL.TOPIC] !== topic) continue;
    if (date && String(r[EXAM_AUDIT_COL.TS]).indexOf(date) !== 0) continue;
    if (q) {
      const hay = [r[EXAM_AUDIT_COL.ANN_ID], r[EXAM_AUDIT_COL.NAME], r[EXAM_AUDIT_COL.COURSE_NAME], r[EXAM_AUDIT_COL.BATCH], r[EXAM_AUDIT_COL.TOPIC]].join(' ').toUpperCase();
      if (hay.indexOf(q) === -1) continue;
    }
    out.push({
      timestamp: r[EXAM_AUDIT_COL.TS], user: r[EXAM_AUDIT_COL.USER], userApsId: r[EXAM_AUDIT_COL.APSID] || getAPSIdFromEmail(r[EXAM_AUDIT_COL.USER]),
      action: r[EXAM_AUDIT_COL.ACTION], batchId: r[EXAM_AUDIT_COL.BATCH], announcementId: r[EXAM_AUDIT_COL.ANN_ID],
      courseId: r[EXAM_AUDIT_COL.COURSE_ID], courseName: r[EXAM_AUDIT_COL.COURSE_NAME], topic: r[EXAM_AUDIT_COL.TOPIC],
      type: r[EXAM_AUDIT_COL.TYPE], assignmentName: r[EXAM_AUDIT_COL.NAME], grading: r[EXAM_AUDIT_COL.GRADING], points: r[EXAM_AUDIT_COL.POINTS],
      scheduled: r[EXAM_AUDIT_COL.SCHEDULED], due: r[EXAM_AUDIT_COL.DUE], status: r[EXAM_AUDIT_COL.STATUS],
      classroomId: r[EXAM_AUDIT_COL.CLASSROOM_ID], message: r[EXAM_AUDIT_COL.MESSAGE]
    });
  }
  return { rows: out, scanned: count, truncated: last - 1 > count || out.length >= EXAMINATION_CONFIG.HISTORY_MAX_RESULTS };
}

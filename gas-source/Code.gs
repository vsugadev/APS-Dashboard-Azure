function sendWeeklyClassTeacherAvailabilityTestEmail(sessionToken) {
  if (sessionToken) apsRequireTabForToken_(sessionToken, 'classes.teacherAvail'); // editor runs (no token) go to the owner only // r56: Admin Control → Access Control
  var to, runBy;
  if (sessionToken) {
    var session = requireValidSession_(sessionToken);

function getOrCreateAssignmentAuditSheet_() {
  var ss = getWorkbook_();
  var sheet = ss.getSheetByName(ASSIGN_CLASSROOM_AUDIT_SHEET_NAME);
  if (sheet) {
    var lastCol = sheet.getLastColumn();
    if (lastCol < 11) {
      sheet.insertColumnsAfter(lastCol, 11 - lastCol);
      sheet.getRange(1, lastCol + 1, 1, 1).setValue('Reason');
      sheet.getRange(2, lastCol + 1, Math.max(1, sheet.getLastRow() - 1), 1).setValue('');
      lastCol = 11;
    }
    if (lastCol < 12) { // r112: Re-Map grade transfer result (older rows stay empty)
      if (sheet.getMaxColumns() < 12) sheet.insertColumnsAfter(sheet.getMaxColumns(), 12 - sheet.getMaxColumns());
      sheet.getRange(1, 12).setValue('Grade Transfer').setFontWeight('bold');
    }
    return sheet;
  }
  sheet = ss.insertSheet(ASSIGN_CLASSROOM_AUDIT_SHEET_NAME);
  sheet.getRange(1,1,1,12).setValues([['Timestamp','Admin Email','Student Name','Student APS Email','From Classroom','From Timing','To Classroom','To Timing','Student Count After','Action','Reason','Grade Transfer']]).setFontWeight('bold');
  sheet.setFrozenRows(1);
  return sheet;
}

/** Sept 2026 addendum: also readable by BOD (vcfo_amchsts_bod) for read-only visibility — assignStudentToClassroom() below is unchanged and still requires isAdminRole_(), so this alone grants no write access. */
function getAdminClassroomAssignments(sessionToken) {
  apsRequireTabForToken_(sessionToken, 'assignClassroom.remap'); // r60: Assign Classroom → Re-Map Student (parent checked too)
  // r56: Admin Control → Access Control
  var session = requireValidSession_(sessionToken);
  var courses = readAllCoursesFromCache_();
  var viewer = { email: session.email, role: session.role };
  if (!isAdminRole_(viewer.role) && viewer.role !== VCFO_AMCHSTS_BOD_ROLE) throw new Error('Only Admin users can access Assign Classroom.');
  var students = {};
  courses.forEach(function(c) {
    (c.students || []).forEach(function(st) {
      var email = normalizeEmail_(st.email); if (!email) return;
      if (!students[email]) students[email] = { email: email, name: st.name || email, apsId: st.apsId || extractAPSID_(email), classrooms: [] }; // r60: APSID for search
      students[email].classrooms.push({ courseId: c.id, name: c.name, section: c.section || '', count: c.studentCount || 0 });
    });
  });
  var classes = courses.map(function(c) { return { courseId: c.id, name: c.name, section: c.section || '', count: c.studentCount || 0 }; });
  // Round 36: upgraded from plain localeCompare to the numeric-aware
  // naturalCompareJs_ for consistency with the main classroom list's
  // Ascending order (so "NILAI - 10" still sorts after "NILAI - 2").
  var studentList = Object.keys(students).map(function(k){ return students[k]; }).sort(function(a,b){ return naturalCompareJs_(a.name, b.name); });
  classes.sort(function(a,b){ return naturalCompareJs_(a.name, b.name); });
  return { students: studentList, classes: classes, maxStudents: APS_CLASS_TIMINGS.MAX_STUDENTS };
}

/** Sept 2026 addendum: also readable by BOD (vcfo_amchsts_bod) for read-only visibility. */
function getAdminAssignmentAuditLog(sessionToken) {
  apsRequireTabForToken_(sessionToken, 'assignClassroom'); // r56: Admin Control → Access Control
  var session = requireValidSession_(sessionToken);
  var courses = readAllCoursesFromCache_();
  var viewer = { email: session.email, role: session.role };
  if (!isAdminRole_(viewer.role) && viewer.role !== VCFO_AMCHSTS_BOD_ROLE) throw new Error('Only Admin users can access assignment history.');
  var gtr = readAllGtrRequests_().map(function(r){ return { type:'Class/Grade Change', timestamp:r.requestDateTime, studentName:r.studentName, studentEmail:r.studentEmail, from:r.currentClassroom, to:r.requestedClassroom, timing:appendEstLabel_(r.requestedClassTiming), status:r.requestStatus, reason:r.reasonComments || '' }; });
  var sheet = getOrCreateAssignmentAuditSheet_();
  var rows = [];
  if (sheet.getLastRow() >= 2) rows = sheet.getRange(2,1,sheet.getLastRow()-1,12).getValues().map(function(r){ var act = String(r[9] || ''), k = act.indexOf(' · '); return { type: k > 0 ? act.slice(0, k) : 'Assign Classroom', timestamp:r[0], studentName:r[2], studentEmail:r[3], from:r[4], to:r[6], timing:appendEstLabel_(r[7]), status: k > 0 ? act.slice(k + 3) : r[9], reason:r[10] || '', gradeTransfer: String(r[11] || '') }; }); // r84: Add/Remove Student rows carry "ACTION · STATUS"
  return gtr.concat(rows).sort(function(a,b){ return String(b.timestamp).localeCompare(String(a.timestamp)); });
}

function assignStudentToClassroom(sessionToken, studentEmail, targetCourseId, reasonText) {
  apsRequireTabForToken_(sessionToken, 'assignClassroom.remap'); // r60: Assign Classroom → Re-Map Student (parent checked too)
  // r56: Admin Control → Access Control
  var lock = LockService.getScriptLock();
  try { lock.waitLock(30000); } catch (e) {}
  try {
    var session = requireValidSession_(sessionToken);
    var courses = readAllCoursesFromCache_();
    var viewer = { email: session.email, role: session.role };
    if (!isAdminRole_(viewer.role)) throw new Error('Only Admin users can re-map students.');
    var email = normalizeEmail_(studentEmail);
    if (!isSyntacticallyValidEmail_(email)) throw new Error('Invalid student APS email.');
    var reason = String(reasonText || '').trim();
    if (!reason) throw new Error('A reason is required before re-mapping a student.');
    var target = findCourseById_(courses, targetCourseId);
    if (!target) throw new Error('Target classroom was not found.');
    var current = null;
    courses.some(function(c){ if (courseHasStudentEmail_(c,email)) { current=c; return true; } return false; });
    if (current && String(current.id) === String(target.id)) throw new Error('Student is already assigned to that classroom.');
    var liveCount = getLiveStudentCount_(target.id);
    var warning = liveCount >= APS_CLASS_TIMINGS.MAX_STUDENTS ? ('Warning: target class currently has ' + liveCount + '/' + APS_CLASS_TIMINGS.MAX_STUDENTS + ' students. Admin override allowed.') : '';
    // r111: save the student's grades in the old classroom BEFORE removing them (Classroom hides that work afterwards).
    var gt = null;
    if (current) {
      try { gt = gtCapture_(current, target, email, viewer.email, reason, courses); }
      catch (eGT) {
        var whyGT = srmSafeErr_(eGT);
        if (gtRequired_()) throw new Error('Re-Map stopped: the student\'s grades in ' + current.name + ' could not be saved first (' + whyGT + '). Nothing was changed — please try again.');
        gt = { error: whyGT }; console.warn('[GradeTransfer] capture failed, move continues (GRADE_TRANSFER_REQUIRED=false): ' + whyGT);
      }
    }
    try { if (current) callWithBackoff_(function(){ return Classroom.Courses.Students.remove(current.id, email); }); }
    catch (eRm) { if (gt && gt.transferId) gtVoid_(gt.transferId, viewer.email, 'remove failed: ' + srmSafeErr_(eRm)); throw eRm; }
    try {
      callWithBackoff_(function(){ return Classroom.Courses.Students.create({userId: email}, target.id); });
    } catch (e) {
      if (gt && gt.transferId) gtVoid_(gt.transferId, viewer.email, 'add to new classroom failed: ' + srmSafeErr_(e)); // r111
      // Safety rollback: do not intentionally leave the student in neither class.
      if (current) {
        try { callWithBackoff_(function(){ return Classroom.Courses.Students.create({userId: email}, current.id); }); } catch (rollbackError) {
          throw new Error('Student was removed from the old classroom and the new-class add failed. Automatic rollback also failed: ' + rollbackError.message + '. Manual Admin intervention is required. Original error: ' + e.message);
        }
      }
      throw new Error('Student was not moved because the new-class add failed; the original classroom assignment was restored. Error: ' + e.message);
    }
    var afterCount = liveCount + 1;
    var gradeNote = !gt ? '' : gt.error ? 'Grades from the previous class could NOT be saved (' + gt.error + ').' : 'Grades saved from the previous class: ' + gt.items + ' assignment(s), ' + gt.graded + ' graded (see Examination → Grading).'; // r111
    var audit = getOrCreateAssignmentAuditSheet_();
    var studentName = findDisplayName_(courses, email) || email;
    audit.appendRow([new Date().toISOString(), viewer.email, studentName, email, current ? current.name : '(none)', current ? appendEstLabel_(current.section) : '', target.name, appendEstLabel_(target.section), afterCount, 'COMPLETED', reason,
      gradeNote ? gradeNote.replace(' (see Examination → Grading).', '.') + (gt && gt.transferId ? ' Transfer ID: ' + gt.transferId : '') : '']); // r112: grade transfer result in the audit log
    var message = 'Student ' + studentName + ' was successfully moved from ' + (current ? current.name : '(none)') + ' to ' + target.name + '. Current class total: ' + afterCount + ' students.' + (warning ? ' ' + warning : '');
    // r66: the old and the new class teacher (Primary Teacher from the Course Description, else the first class teacher) are copied too.
    var oldTeacher = current ? srmClassTeacher_(current, courses) : null, newTeacher = srmClassTeacher_(target, courses);
    var asgCc = [], asgSeen = {};
    [APS_DASHBOARD_EMAIL_CC].concat(oldTeacher ? [oldTeacher.email] : [], newTeacher ? [newTeacher.email] : []).forEach(function (x) {
      String(x || '').split(',').forEach(function (e) { e = normalizeEmail_(e); if (e && e !== email && !asgSeen[e] && isSyntacticallyValidEmail_(e)) { asgSeen[e] = true; asgCc.push(e); } });
    });
    var asgNotice = ['Important: It is the parent\u2019s responsibility to ensure that the student completes all missed classwork and homework and attaches/submits them in the new Google Classroom.',
      'We will follow the APS Grading Policy for all academic and grading requirements.',
      'For a grade change, we can NOT guarantee a new set of books for the new grade.'];
    var bodyHtml = apsEmailShell_('Student Classroom Assignment', '<h2 style="margin-top:0;">Classroom Assignment Updated</h2><p>' + htmlEscape_(message) + '</p><p><b>Student:</b> ' + htmlEscape_(studentName) + '<br><b>APS Email:</b> ' + htmlEscape_(email) +
      '<br><b>Previous Classroom:</b> ' + htmlEscape_(current ? current.name : '(none)') + '<br><b>Previous Class Teacher:</b> ' + htmlEscape_(oldTeacher ? oldTeacher.name + ' (' + oldTeacher.email + ')' : '—') +
      '<br><b>New Classroom:</b> ' + htmlEscape_(target.name) + '<br><b>New Class Teacher:</b> ' + htmlEscape_(newTeacher ? newTeacher.name + ' (' + newTeacher.email + ')' : '—') +
      '<br><b>Teacher/HM:</b> ' + htmlEscape_(appendEstLabel_(target.section)) + '<br><b>Current Student Count:</b> ' + afterCount + '<br><b>Reason:</b> ' + htmlEscape_(reason) + '</p>' + (warning ? '<div style="padding:12px;background:#fce8e6;color:#d93025;border-radius:6px;font-weight:700;">' + htmlEscape_(warning) + '</div>' : '') +
      '<div style="margin-top:14px;padding:12px 14px;background:#fef7e0;border-left:4px solid #f9ab00;border-radius:6px;line-height:1.55;">' + asgNotice.map(function (x, i) { return '<p style="margin:' + (i ? '8px' : '0') + ' 0 0;">' + (i ? '' : '<b>Important:</b> ') + htmlEscape_(i ? x : x.replace(/^Important: /, '')) + '</p>'; }).join('') + '</div>', { googleReview: true }); // r84: Google Review footer (student-facing)
    try { sendApsHtmlEmail_({to: email, cc: asgCc.join(','), subject:'APS Classroom Assignment Updated - ' + target.name, body:message + ' Reason: ' + reason +
      '\n\nPrevious class teacher: ' + (oldTeacher ? oldTeacher.name + ' (' + oldTeacher.email + ')' : '-') + '\nNew class teacher: ' + (newTeacher ? newTeacher.name + ' (' + newTeacher.email + ')' : '-') + '\n\n' + asgNotice.join('\n') + grEmailFooterText_(), htmlBody:bodyHtml}); } catch (e) {}
    return { ok:true, message:message + (gradeNote ? ' ' + gradeNote : ''), gradeTransfer: gt, warning:warning, studentEmail:email, targetCourseId:target.id, targetClassroom:target.name, targetTiming:appendEstLabel_(target.section), studentCount:afterCount, reason:reason };
  } finally { try { lock.releaseLock(); } catch(e){} }
}

/** ---------------------------------------------------------------------
 *  ONE-TIME SETUP — run this once from the editor (select function in the
 *  dropdown next to Run, click Run, authorize). Schedules the sync job.
 * ------------------------------------------------------------------- */
function createSyncTrigger() {
  apsRequireOwnerOrTrigger_(null); // r55: editor (script owner) only — not callable from the web app
  var allowedIntervals = [1, 5, 10, 15, 30];
  if (allowedIntervals.indexOf(SYNC_INTERVAL_MINUTES) === -1) {
    throw new Error(
      'SYNC_INTERVAL_MINUTES is set to ' + SYNC_INTERVAL_MINUTES + ', but Apps Script time ' +
      'triggers only support running every ' + allowedIntervals.join(', ') + ' minutes. ' +
      'Set SYNC_INTERVAL_MINUTES to one of those values (top of Code.gs) and re-run createSyncTrigger().'
    );
  }
  ScriptApp.getProjectTriggers().forEach(function (t) {
    if (t.getHandlerFunction() === 'syncClassroomData') ScriptApp.deleteTrigger(t);
  });
  // r49: no longer installs an every-N-minutes Classroom sync (policy: Admin "Force Sync" + daily 5 PM apsDailyForceSync).
  // Running this function now only REMOVES any leftover syncClassroomData trigger.
  console.log('[Sync] createSyncTrigger: legacy interval trigger removed; Classroom sync runs daily at 5 PM and on Admin Force Sync.');
}



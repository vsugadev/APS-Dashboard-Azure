/**
 * Stage 1 — any ONE of the 9 GRADE_CHANGE_APPROVER_EMAILS approves or
 * rejects a request, identifying/confirming the target class. Does NOT
 * touch Google Classroom at all — that only ever happens at Stage 2 (see
 * decideGradeTimeChangeFinalApproval below). `decision` is 'approve' | 'reject'.
 */
function decideGradeTimeChangeStage1(sessionToken, requestId, decision, comments) {
  apsRequireTabForToken_(sessionToken, 'classChange'); // r56: Admin Control → Access Control
  var session = requireValidSession_(sessionToken);
  var email = session.email;
  if (isReadOnlyRole_(session.role)) throw new Error('Read-only access: approval actions are disabled.');
  if (!isInEmailList_(email, GRADE_CHANGE_APPROVER_EMAILS)) {
    throw new Error('You are not authorized to review Grade/Timing Change requests.');
  }
  var lock = LockService.getScriptLock();
  try { lock.waitLock(15000); } catch (e) { /* proceed best-effort */ }
  try {
    var request = findGtrRequestById_(requestId);
    if (!request) throw new Error('Request not found.');
    var expectedStatus = request.requestType === GTR_REQUEST_TYPE.GRADE ? GTR_STATUS.PENDING_GRADE_APPROVAL : GTR_STATUS.REQUEST_SUBMITTED;
    if (request.requestStatus !== expectedStatus) {
      throw new Error('This request is no longer awaiting Stage 1 review (current status: ' + request.requestStatus + ').');
    }

    request.approverEmail = email;
    request.approverComments = (comments || '').trim();
    request.processedDateTime = new Date().toISOString();
    request.processedBy = email;

    if (decision === 'approve') {
      // Recheck the target class is still resolvable before moving to the
      // final-approval queue — the DEFINITIVE, no-exceptions capacity
      // recheck is still the live one at Stage 2, right before the actual
      // Classroom write (see decideGradeTimeChangeFinalApproval).
      var allCourses = readAllCoursesFromCache_();
      var targetCourse = findCourseByName_(allCourses, request.requestedClassroom);
      if (!targetCourse) {
        request.requestStatus = request.requestType === GTR_REQUEST_TYPE.GRADE ? GTR_STATUS.CLASS_NO_LONGER_AVAILABLE : GTR_STATUS.NO_CLASS_AVAILABLE;
        writeGtrRequestRow_(request._row, request);
        notifyGtrStudent_(request, 'Your request (' + requestId + ') could not proceed — the target class is no longer available.');
        return request;
      }
      request.requestStatus = GTR_STATUS.AWAITING_FINAL_APPROVAL;
      writeGtrRequestRow_(request._row, request);
      notifyGtrApprovers_('Stage 1 approved — awaiting final sign-off (' + requestId + ')', gtrEmailBody_(request), request);
      notifyGtrStudent_(request, 'Your request (' + requestId + ') passed initial review and is awaiting final approval.');
    } else {
      request.requestStatus = request.requestType === GTR_REQUEST_TYPE.GRADE ? GTR_STATUS.REJECTED : GTR_STATUS.CLOSED;
      writeGtrRequestRow_(request._row, request);
      notifyGtrApprovers_('Request rejected (' + requestId + ')', gtrEmailBody_(request), request);
      notifyGtrStudent_(request, 'Your request (' + requestId + ') was not approved. Reason: ' + (request.approverComments || 'not specified') + '.');
    }
    return request;
  } finally {
    try { lock.releaseLock(); } catch (e) { /* best-effort */ }
  }
}

/**
 * Stage 2 — FINAL approval, ONLY FINAL_APPROVER_EMAIL, for BOTH request
 * types. This is the ONLY function in this whole feature that ever calls
 * Classroom.Courses.Students.remove()/.create() — nothing else touches the
 * live roster. `decision` is 'approve' | 'reject'.
 *
 * On 'approve': live-rechecks the target class's capacity ONE more time —
 * never trusting the Stage-1-time count ("always enforce the 7-student
 * cap, no exceptions") — immediately before mutating anything; if it's
 * full NOW, the student is NOT added and the request is marked
 * NO_CLASS_AVAILABLE/CLASS_NO_LONGER_AVAILABLE instead of proceeding.
 * Otherwise: PROCESSING -> remove from current course -> confirm -> add to
 * target course -> confirm -> COMPLETED. Per the spec's explicit failure
 * rules: if removal fails, the add is never attempted (PROCESSING_ERROR,
 * no auto-retry); if removal succeeds but the add fails, the student is
 * NOT auto-re-added to their old class and no alternative class is ever
 * substituted — PROCESSING_ERROR, requiring a manual ADMIN retry against
 * the SAME approved target Course ID.
 */
function decideGradeTimeChangeFinalApproval(sessionToken, requestId, decision, comments) {
  apsRequireTabForToken_(sessionToken, 'classChange'); // r56: Admin Control → Access Control
  var session = requireValidSession_(sessionToken);
  var email = session.email;
  if (isReadOnlyRole_(session.role)) throw new Error('Read-only access: approval actions are disabled.');
  if (email !== normalizeEmail_(FINAL_APPROVER_EMAIL)) {
    throw new Error('Only the final approver can complete this step.');
  }
  var lock = LockService.getScriptLock();
  try { lock.waitLock(30000); } catch (e) { /* proceed best-effort */ }
  try {
    var request = findGtrRequestById_(requestId);
    if (!request) throw new Error('Request not found.');
    if (request.requestStatus !== GTR_STATUS.AWAITING_FINAL_APPROVAL) {
      throw new Error('This request is not awaiting final approval (current status: ' + request.requestStatus + ').');
    }

    request.finalApproverEmail = email;
    request.finalApproverComments = (comments || '').trim();
    request.finalApprovedAt = new Date().toISOString();

    if (decision !== 'approve') {
      request.requestStatus = request.requestType === GTR_REQUEST_TYPE.GRADE ? GTR_STATUS.REJECTED : GTR_STATUS.CLOSED;
      writeGtrRequestRow_(request._row, request);
      notifyGtrApprovers_('Final approval declined (' + requestId + ')', gtrEmailBody_(request), request);
      notifyGtrStudent_(request, 'Your request (' + requestId + ') was not given final approval. Reason: ' + (request.finalApproverComments || 'not specified') + '.');
      return request;
    }

    request.requestStatus = GTR_STATUS.PROCESSING;
    writeGtrRequestRow_(request._row, request);

    var allCourses = readAllCoursesFromCache_();
    var currentCourse = findCourseByName_(allCourses, request.currentClassroom);
    var targetCourse = findCourseByName_(allCourses, request.requestedClassroom);
    if (!targetCourse) {
      request.requestStatus = request.requestType === GTR_REQUEST_TYPE.GRADE ? GTR_STATUS.CLASS_NO_LONGER_AVAILABLE : GTR_STATUS.NO_CLASS_AVAILABLE;
      request.processingNotes = 'Target classroom "' + request.requestedClassroom + '" was not found in the current synced course list.';
      writeGtrRequestRow_(request._row, request);
      notifyGtrStudent_(request, 'Your request (' + requestId + ') could not be completed — the target class is no longer available.');
      return request;
    }

    // ALWAYS enforce the cap, no exceptions — live recheck right now, the
    // moment before the real mutation. Wrapped in try/catch because this can
    // fail with a Classroom "Requested entity was not found" error if the
    // final-approver account isn't a teacher/co-teacher on the target course
    // (Classroom returns 404, not 403, when the caller lacks roster access) —
    // that should surface as a clean PROCESSING ERROR on the request, not a
    // raw exception thrown back at whoever is approving it.
    var liveCount;
    try {
      liveCount = getLiveStudentCount_(targetCourse.id);
    } catch (e) {
      request.requestStatus = GTR_STATUS.PROCESSING_ERROR;
      request.processingNotes = 'Could not verify live seat count for "' + request.requestedClassroom + '": ' + e.message +
        '. This usually means the final-approver account (' + FINAL_APPROVER_EMAIL + ') is not a teacher/co-teacher on that Classroom course. Add that account as a co-teacher on every APS class, then retry final approval.';
      writeGtrRequestRow_(request._row, request);
      notifyGtrApprovers_('PROCESSING ERROR — could not verify seat count (' + requestId + ')', gtrEmailBody_(request), request);
      return request;
    }
    if (liveCount >= APS_CLASS_TIMINGS.MAX_STUDENTS) {
      request.requestStatus = request.requestType === GTR_REQUEST_TYPE.GRADE ? GTR_STATUS.CLASS_NO_LONGER_AVAILABLE : GTR_STATUS.NO_CLASS_AVAILABLE;
      request.processingNotes = 'Target class reached ' + liveCount + '/' + APS_CLASS_TIMINGS.MAX_STUDENTS + ' students before the final mutation — student was NOT added.';
      writeGtrRequestRow_(request._row, request);
      notifyGtrApprovers_('Final approval blocked — class now full (' + requestId + ')', gtrEmailBody_(request), request);
      notifyGtrStudent_(request, 'Your request (' + requestId + ') could not be completed because the target class filled up. Please contact APS Tech Support.');
      return request;
    }

    try {
      if (currentCourse) {
        callWithBackoff_(function () { return Classroom.Courses.Students.remove(currentCourse.id, request.studentEmail); });
      }
    } catch (e) {
      request.requestStatus = GTR_STATUS.PROCESSING_ERROR;
      request.processingNotes = 'Removal from current class failed: ' + e.message + '. The add step was NOT attempted. Needs manual ADMIN retry.';
      writeGtrRequestRow_(request._row, request);
      notifyGtrApprovers_('PROCESSING ERROR — removal failed (' + requestId + ')', gtrEmailBody_(request), request);
      return request;
    }

    try {
      callWithBackoff_(function () { return Classroom.Courses.Students.create({ userId: request.studentEmail }, targetCourse.id); });
    } catch (e) {
      request.requestStatus = GTR_STATUS.PROCESSING_ERROR;
      request.processingNotes = 'Removed from "' + request.currentClassroom + '" but adding to "' + request.requestedClassroom +
        '" FAILED: ' + e.message + '. Student is currently in NEITHER class. No alternative class was substituted — an ADMIN must manually retry adding them to the SAME approved target course.';
      writeGtrRequestRow_(request._row, request);
      notifyGtrApprovers_('PROCESSING ERROR — add failed after removal (' + requestId + ')', gtrEmailBody_(request), request);
      return request;
    }

    request.requestStatus = GTR_STATUS.COMPLETED;
    request.processingNotes = 'Removed from "' + request.currentClassroom + '" and added to "' + request.requestedClassroom + '" successfully.';
    writeGtrRequestRow_(request._row, request);
    // Note: this codebase has no CacheService layer in front of the Courses
    // sheet (readAllCoursesFromCache_ always reads the sheet directly), so
    // there is no cache to invalidate here — the next getDashboardData()/
    // Force Sync call will simply see the moved student on its own.
    notifyGtrApprovers_('Request COMPLETED (' + requestId + ')', gtrEmailBody_(request), request);
    notifyGtrStudent_(request, 'Your request (' + requestId + ') is complete — you have been moved to "' + request.requestedClassroom + '".');
    return request;
  } finally {
    try { lock.releaseLock(); } catch (e) { /* best-effort */ }
  }
}

function apsDashboardUrl_() {
  return ScriptApp.getService().getUrl() || 'https://www.avvaiyarpadasalai.org';
}

function htmlEscape_(value) {
  return String(value == null ? '' : value)
    .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;').replace(/'/g, '&#39;');
}

function apsEmailShell_(title, bodyHtml, opts) {
  opts = opts || {}; // r54: optional { buttonUrl, buttonLabel, preheader } — without opts the output is unchanged; r84: googleReview adds the Google Review footer
  var buttonUrl = opts.buttonUrl || apsDashboardUrl_();

function saveDashboardRolePermissions(sessionToken, role, permissions) {
  requireSuperAdminViewer_(sessionToken);
  if (DASHBOARD_ROLES.indexOf(String(role || '').toLowerCase()) === -1) throw new Error('Unknown dashboard role.');
  var normalizedRole = String(role).toLowerCase();
  var defaults = defaultDashboardRolePermissions_()[normalizedRole];
  var next = {
    readOnly: !!(permissions && permissions.readOnly),
    buttons: !!(permissions && permissions.buttons),
    filters: !!(permissions && permissions.filters),
    tabs: !!(permissions && permissions.tabs)
  };
  if (isAdminRole_(normalizedRole)) next = defaults;
  if (normalizedRole === VCFO_AMCHSTS_BOD_ROLE) next.readOnly = true;
  var all = readDashboardRolePermissions_();
  all[normalizedRole] = next;
  PropertiesService.getScriptProperties().setProperty(ROLE_PERMISSION_PROP_KEY, JSON.stringify(all));
  CacheService.getScriptCache().remove(ROLE_PERMISSION_CACHE_KEY);
  return all;
}

function getDashboardRolePermissions(sessionToken) {
  requireSuperAdminViewer_(sessionToken);
  return readDashboardRolePermissions_();

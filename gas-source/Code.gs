}
function tkSaveAttachments_(list, v) {
  list = Array.isArray(list) ? list : [];
  if (!list.length) return [];
  if (list.length > TK_MAX_ATTACH_) throw new Error('You can attach at most ' + TK_MAX_ATTACH_ + ' files.');
  var folder = tkAttachFolder_();
  return list.map(function (a) {
    var name = String(a && a.name || 'file').replace(/[\\\/:*?"<>|]+/g, '_').slice(0, 120);
    var mime = String(a && a.mimeType || '');
    if (!TK_ATTACH_MIME_RE_.test(mime)) throw new Error('"' + name + '" is not an allowed file type (images, PDF, Word, Excel, PowerPoint, text).');
    var bytes = Utilities.base64Decode(String(a.base64 || ''));
    if (!bytes.length || bytes.length > TK_MAX_ATTACH_BYTES_) throw new Error('"' + name + '" must be smaller than 5 MB.');
    var file = folder.createFile(Utilities.newBlob(bytes, mime, name));
    return { id: file.getId(), name: name, size: bytes.length, mime: mime };
  });
}
/** Download an attachment (base64) — only for someone who can see that message. */
function getTicketAttachment(sessionToken, ticketId, fileId) {

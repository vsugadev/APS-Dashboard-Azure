  REPLY:          { label: 'New Reply',             head: 'There is a new reply on this ticket',  color: '#1a73e8' },
  INTERNAL_NOTE:  { label: 'Internal Note (staff only)', head: 'A staff-only internal note was added', color: '#b06000' },
  RESOLVED:       { label: 'Ticket Resolved',       head: 'This ticket has been resolved',        color: '#188038' },
  CLOSED:         { label: 'Ticket Closed',         head: 'This ticket has been closed',          color: '#5f6368' },
  REOPENED:       { label: 'Ticket Reopened',       head: 'This ticket has been reopened',        color: '#e8710a' },
  STATUS_CHANGED: { label: 'Status Updated',        head: 'The ticket status has changed',        color: '#1a73e8' }
};
var TK_PRIORITY_COLOR_ = { URGENT: ['#fce8e6', '#c5221f'], HIGH: ['#fef0e1', '#b06000'], NORMAL: ['#e8f0fe', '#1a56c4'], LOW: ['#f1f3f4', '#5f6368'] };
var TK_STATUS_COLOR_ = { NEW: ['#e8f0fe', '#1a56c4'], ASSIGNED: ['#e8f0fe', '#1a56c4'], 'IN PROGRESS': ['#fef7e0', '#8a5a00'], 'WAITING FOR USER': ['#fef0e1', '#b06000'], RESOLVED: ['#e6f4ea', '#137333'], CLOSED: ['#f1f3f4', '#5f6368'] };
/** "CLASS ROOM" -> "Class Room" (readable in subjects). */
function tkTitleCase_(v) { return String(v || '').toLowerCase().replace(/(^|[\s\-\/])([a-z])/g, function (m, a, b) { return a + b.toUpperCase(); }); }
function tkOneLine_(v) { return String(v == null ? '' : v).replace(/[\r\n\t]+/g, ' ').replace(/\s{2,}/g, ' ').trim(); }
function tkEventText_(event) { return TK_EVENT_TEXT_[event] || TK_EVENT_TEXT_.STATUS_CHANGED; }
function tkTicketUrl_(t) { return (ScriptApp.getService().getUrl() || '') + '?ticket=' + encodeURIComponent(t.Ticket_Number); }
function tkAssigneeNames_(parts) {
  return (parts || []).filter(function (p) { return p.Active === 'TRUE' && p.Participant_Type === 'ASSIGNEE'; }).map(function (p) { return p.Name || p.Email; }).join(', ');
}
/**
 * Subject: "[APS Ticket #APS-20261008-0001] Ticket Resolved - Class Room - Meena Raj".
 * Same tag on every email of a ticket (easy to search / group); the event comes right after it so it is
 * visible on a phone; one line, at most 120 characters.
 */
function tkSubject_(event, t) {
  var tag = '[APS Ticket #' + tkOneLine_(t.Ticket_Number) + '] ';
  var who = tkOneLine_(t.Student_Name || t.Subject);
  var type = tkTitleCase_(tkOneLine_(t.Type));
  var ev = tkEventText_(event).label;
  if (event === 'STATUS_CHANGED' || !TK_EVENT_TEXT_[event]) ev = 'Status Updated: ' + tkTitleCase_(t.Status);
  var subject = event === 'CREATED' ? tag + type + (who ? ' - ' + who : '') : tag + ev + ' - ' + type + (who ? ' - ' + who : '');
  return subject.length > 120 ? subject.slice(0, 119).replace(/\s+\S*$/, '') + '…' : subject;
}
function tkPill_(text, colors) {
  colors = colors || ['#f1f3f4', '#3c4043'];
  return '<span style="display:inline-block;margin:0 6px 6px 0;padding:4px 10px;border-radius:999px;background:' + colors[0] + ';color:' + colors[1] + ';font-size:12px;font-weight:700;letter-spacing:.3px;white-space:nowrap;">' + htmlEscape_(text) + '</span>';
}
/** The ticket's facts as [label, value] pairs (empty values left out so the email stays short on a phone). */
function tkEmailWhen_(v) {
  if (!v) return '';

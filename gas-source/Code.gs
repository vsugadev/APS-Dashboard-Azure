      sh.getRange(2, 1, sh.getLastRow() - 1, codeCol).getValues().forEach(function (r) {
        var url = r[0] !== '' ? classMeetUrl_(r[codeCol - 1]) : '';
        if (url) target[String(r[0])] = url;
      });
    };
    // Course_Meet_Link_Map: MANUAL rows (Admin/HM) win over everything; AUTO_CLASSROOM rows (auto-fill from the
    // Google Classroom stream) come after the class's own Description / Room / Section link.
    var mapSh = ss.getSheetByName(ATTENDANCE_MEET_LINK_MAP_SHEET_NAME);

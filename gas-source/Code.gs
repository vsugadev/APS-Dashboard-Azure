    var rows = order.map(function (k) { var h = have[k]; return [k, h.email, h.roles, h.primary, h.courseId, h.courseName, h.classroomRole, h.source, h.permission, h.status, h.firstSeen || now, h.lastSynced || now]; });
    if (rows.length) sh.getRange(2, 1, rows.length, CLASS_ACCESS_MAP_HEADER_.length).setValues(rows);
    if (last - 1 > rows.length) sh.getRange(rows.length + 2, 1, last - 1 - rows.length, CLASS_ACCESS_MAP_HEADER_.length).clearContent();
  } catch (e) {
    console.warn('[ClassSupport] mapping write failed: ' + (e && e.message));
    events.push({ exec: exec, action: 'COURSE_ACCESS_MAPPING_UPDATED', result: 'FAILED', error: String(e && e.message || e) });
  }
  classAccessAuditRows_(events);
}

/**
 * Normalized class authorization object for one course (for reports / support tools):
 * { courseId, courseName, users: { email: { roles, primaryRole, classroomRole } } }.
 */
function classAuthorizationFor_(course) {
  var users = {};
  (course.classSupport || []).forEach(function (s) { users[s.email] = { roles: s.roles.slice(), primaryRole: classRolesPrimary_(s.roles), classroomRole: s.member ? 'TEACHER' : 'NONE' }; });
  (course.teachers || []).forEach(function (t) { var e = normalizeEmail_(t.email); if (e && !users[e]) users[e] = { roles: ['TEACHER'], primaryRole: 'TEACHER', classroomRole: 'TEACHER' }; });

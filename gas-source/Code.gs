  var classrooms = rds.classrooms.filter(function (c) { return c.status === ROSTER_STATUS.ACTIVE; });
  if (!classrooms.length) throw new Error('No classrooms in the roster yet — run Sync Now with "Also refresh class rosters" first.');
  var byUser = {}; // courseId|userId -> roster student
  rds.students.forEach(function (s) { byUser[s.c + '|' + s.u] = s; });
  var W = rosterLoadTable_(GRADES_CONFIG.SHEET_WORK, GRADES_WORK_HEADER, 'Work_Key');
  var S = rosterLoadTable_(GRADES_CONFIG.SHEET_SUBS, GRADES_SUB_HEADER, 'Submission_Key');
  var wByCourse = {};

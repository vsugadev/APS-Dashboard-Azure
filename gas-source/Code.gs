    ') | teachers ' + (summary.teachersFound || 0) + ' | students ' + (summary.studentsFound || 0) + ' | enrollments ' + (summary.studentEnrollments || 0) +
    ' | new ' + (summary.newStudents || 0) + ' updated ' + (summary.updatedStudents || 0) + ' inactivated ' + (summary.removedInactive || 0) +
    ' | errors ' + summary.errorCount + ' | ' + summary.duration);
  if (written) { // r81: tell each class teacher about students who joined since the last run (never fails the sync)
    try { summary.newStudentEmails = nsaNotifyAfterSync_(S, now); } catch (eNsa) { console.error('[NewStudentEmail] skipped: ' + (eNsa && eNsa.message)); }

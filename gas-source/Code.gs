  if (!/@/.test(t) && !/\b(VP|HM)\s*e-?mails?\s*:/i.test(t)) return t;
  return t.replace(/\b(VP|HM)\s*e-?mails?\s*:/gi, ' ').replace(/[^\s;,|<>()\[\]"]+@[^\s;,|<>()\[\]"]+/g, ' ')
    .split('|').map(function (x) { return x.replace(/[;,]/g, ' ').replace(/\s+/g, ' ').trim(); }).filter(Boolean).join(' | ');
}

/** The viewer's access to one course: {roles, apsRole, label, permission, source}; null when none. */
function classAccessFor_(course, email) {

  var meta = null;
  msgs.some(function (m) { var a = []; try { a = JSON.parse(m.Attachments || '[]'); } catch (e) { a = []; } meta = a.filter(function (x) { return x.id === fileId; })[0] || null; return !!meta; });
  if (!meta) throw new Error('Attachment not found.');

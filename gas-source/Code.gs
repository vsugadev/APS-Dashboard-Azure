    runBy = session.email;
    to = ctaProp_('APS_CLASS_TEACHER_AVAILABILITY_TEST_EMAIL_TO', session.email).split(/[,;\s]+/).map(normalizeEmail_).filter(function (x) { return /^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(x); });
  } else {

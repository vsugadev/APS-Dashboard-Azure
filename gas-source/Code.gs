  });
}
function tkActiveEmails_(parts, type) { return parts.filter(function (p) { return p.Active === 'TRUE' && (!type || p.Participant_Type === type); }).map(function (p) { return p.Email; }); }

/* ------------------------------- status / priority / type (role-checked) ------------------------------- */
function updateTicket(sessionToken, input) {
  apsRequireTabForToken_(sessionToken, 'tickets'); // r56: Admin Control → Access Control
  var v = tkViewer_(sessionToken);
  input = input || {};
  return tkLocked_(function () {
    var L = tkLoad_(v, input.ticketId), t = L.t;
    var actor = { email: v.email, name: tkNameFor_(v.email, L.courses) };
    var reason = String(input.reason || '').trim().slice(0, 500);
    var changed = [], mails = [], now = tkNowIso_();
    if (input.priority !== undefined && input.priority !== t.Priority) {
      if (!L.acc.admin) throw new Error('Only Admin can change the priority.');
      if (TK_PRIORITIES_.indexOf(input.priority) < 0) throw new Error('Invalid priority.');
      tkAudit_(t, 'CHANGE_PRIORITY', t.Priority, input.priority, actor, reason); t.Priority = input.priority; changed.push('priority');
    }
    if (input.type !== undefined && input.type !== t.Type) {
      if (!L.acc.admin) throw new Error('Only Admin can change the ticket type.');
      if (TK_TYPES_.indexOf(input.type) < 0) throw new Error('Invalid ticket type.');
      tkAudit_(t, 'CHANGE_TYPE', t.Type, input.type, actor, reason); var oldType = t.Type; t.Type = input.type; changed.push('type');
      if (input.applyRules) {
        var resolved = null;
        if (t.Student_Email) { try { resolved = tkResolveStudent_({ email: v.email, role: v.role }, L.courses, t.Student_Email, t.Course_ID); } catch (e) { resolved = null; } }
        if (TK_CHAIN_TYPES_.indexOf(t.Type) > -1 && !resolved) throw new Error('This type needs a student with a current Google Classroom; the ticket has none.');
        var asg = tkAssignmentFor_(t.Type, resolved, tkConfig_());
        mails.push(tkSetAssignees_(t, L.parts, asg.assignees, actor, 'REASSIGN', 'type changed ' + oldType + ' → ' + t.Type + (reason ? ' · ' + reason : ''), now));
        t.Assignment_Flags = asg.flags.join(' | ');
      }
    }
    if (input.status !== undefined && input.status !== t.Status) {
      var target = input.status;
      if (target === 'REOPEN') {
        if (!L.acc.admin) throw new Error('Only Admin can reopen a ticket.');
        if (t.Status !== 'CLOSED' && t.Status !== 'RESOLVED') throw new Error('Only resolved or closed tickets can be reopened.');
        var hasAsg = tkActiveEmails_(L.parts, 'ASSIGNEE').length > 0;
        var from = t.Status; t.Status = hasAsg ? 'IN PROGRESS' : 'NEW'; t.Closed_At = ''; t.Resolved_At = '';
        tkAudit_(t, 'REOPEN', from, t.Status, actor, reason); changed.push('status');
        mails.push(tkNotify_('REOPENED', t, L.parts, { actor: actor, message: reason || 'The ticket was reopened.', recipients: [t.Requester_Email].concat(tkActiveEmails_(L.parts)) }));
      } else {
        if (TK_STATUSES_.indexOf(target) < 0) throw new Error('Invalid status.');
        var allowed = L.acc.admin ? TK_STATUSES_ : (L.acc.staff ? ['IN PROGRESS', 'WAITING FOR USER', 'RESOLVED'] : []);
        if (allowed.indexOf(target) < 0) { console.warn('[Tickets] status change denied ' + v.email + ' ' + t.Ticket_Number + ' -> ' + target); throw new Error('You are not allowed to set this status.'); }
        if (t.Status === 'CLOSED' && !L.acc.admin) throw new Error('This ticket is closed.');
        var prev = t.Status; t.Status = target;
        if (target === 'RESOLVED') t.Resolved_At = now;
        if (target === 'CLOSED') { t.Closed_At = now; if (!t.Resolved_At) t.Resolved_At = now; }
        if (prev === 'CLOSED' && target !== 'CLOSED') t.Closed_At = '';
        var act = target === 'RESOLVED' ? 'RESOLVE' : target === 'CLOSED' ? 'CLOSE' : (prev === 'CLOSED' ? 'REOPEN' : 'CHANGE_STATUS');
        tkAudit_(t, act, prev, target, actor, reason); changed.push('status');
        var ev = target === 'RESOLVED' ? 'RESOLVED' : target === 'CLOSED' ? 'CLOSED' : (prev === 'CLOSED' ? 'REOPENED' : 'STATUS_CHANGED');
        if (ev !== 'STATUS_CHANGED' || target === 'WAITING FOR USER') {
          mails.push(tkNotify_(ev, t, L.parts, { actor: actor, message: reason || ('Status changed from ' + prev + ' to ' + target + '.'), recipients: [t.Requester_Email].concat(tkActiveEmails_(L.parts, 'ASSIGNEE')).filter(function (e) { return normalizeEmail_(e) !== v.email; }) }));
        }
      }
    }
    if (!changed.length) return { ok: true, unchanged: true };
    t.Updated_At = now; t.Last_Activity_By = v.email;
    tkUpdateRow_('tickets', t);
    return { ok: true, status: t.Status, priority: t.Priority, type: t.Type, email: mails };
  });
}

/* ------------------------------- assignment / participants (Admin only) ------------------------------- */
function tkSetAssignees_(t, parts, newList, actor, action, reason, now) {
  var oldActive = parts.filter(function (p) { return p.Active === 'TRUE' && p.Participant_Type === 'ASSIGNEE'; });
  var oldEmails = oldActive.map(function (p) { return p.Email; });
  var newEmails = newList.map(function (a) { return a.email; });
  oldActive.forEach(function (p) { if (newEmails.indexOf(p.Email) < 0) { p.Active = 'FALSE'; p.Removed_By = actor.email; p.Removed_At = now; tkUpdateRow_('participants', p); } });
  var added = [];
  newList.forEach(function (a) {
    if (oldEmails.indexOf(a.email) > -1) return;
    var existing = parts.filter(function (p) { return p.Email === a.email; })[0];
    if (existing) { existing.Active = 'TRUE'; existing.Participant_Type = 'ASSIGNEE'; existing.Removed_By = ''; existing.Removed_At = ''; if (!existing.Name) existing.Name = a.name; if (existing.Role === 'REQUESTER') { /* keep requester role */ } else existing.Role = a.role || existing.Role; tkUpdateRow_('participants', existing); }
    else { var row = { Ticket_ID: t.Ticket_ID, Ticket_Number: t.Ticket_Number, Email: a.email, Name: a.name, Role: a.role || 'ASSIGNEE', Participant_Type: 'ASSIGNEE', Active: 'TRUE', Added_By: actor.email, Added_At: now }; tkAppend_('participants', [row]); parts.push(row); }
    added.push(a.email);
  });
  var removed = oldEmails.filter(function (e) { return newEmails.indexOf(e) < 0; });
  t.Assigned_To = newEmails.join('; ');
  if (newEmails.length && t.Status === 'NEW') t.Status = 'ASSIGNED';
  tkAudit_(t, action, oldEmails.join('; '), newEmails.join('; '), actor, reason || '');
  var ev = action === 'ADMIN_OVERRIDE' ? 'ADMIN_OVERRIDE' : (oldEmails.length ? 'REASSIGNED' : 'ASSIGNED');
  return tkNotify_(ev, t, parts, { actor: actor, message: (reason ? 'Reason: ' + reason + '\n' : '') + 'Assigned to: ' + newList.map(function (a) { return a.name || a.email; }).join(', '),
    recipients: added.concat(action === 'ADMIN_OVERRIDE' ? removed : []).concat(action === 'ADMIN_OVERRIDE' ? [t.Requester_Email] : []) });
}
/** Admin: assign / reassign / override. Rule-assigned tickets record ADMIN_OVERRIDE with previous/new assignees, admin, time, reason. */
function assignTicket(sessionToken, input) {
  apsRequireTabForToken_(sessionToken, 'tickets'); // r56: Admin Control → Access Control
  var v = tkViewer_(sessionToken);
  if (!tkIsAdmin_(v)) { console.warn('[Tickets] assign denied ' + v.email); throw new Error('Only Admin can assign or reassign tickets.'); }
  input = input || {};
  var emails = tkCleanEmails_(input.assignees || []);
  if (!emails.length) throw new Error('Choose at least one valid assignee email.');
  var bad = (input.assignees || []).filter(function (e) { return !TK_EMAIL_RE_.test(normalizeEmail_(e) || ''); });
  if (bad.length) throw new Error('Invalid email: ' + bad.join(', '));
  return tkLocked_(function () {
    var L = tkLoad_(v, input.ticketId), t = L.t;
    var actor = { email: v.email, name: tkNameFor_(v.email, L.courses) }, now = tkNowIso_();
    var hadRule = L.parts.some(function (p) { return p.Added_By === 'auto-rule'; });
    var hadAny = tkActiveEmails_(L.parts, 'ASSIGNEE').length > 0;
    var list = emails.map(function (e) { var p = L.parts.filter(function (x) { return x.Email === e; })[0]; return { email: e, name: (p && p.Name) || tkNameFor_(e, L.courses) || tkDeptName_(e), role: (p && p.Role !== 'REQUESTER' && p.Role) || 'ADMIN_ASSIGNED' }; });
    var action = hadRule ? 'ADMIN_OVERRIDE' : (hadAny ? 'REASSIGN' : 'ASSIGN');
    var mail = tkSetAssignees_(t, L.parts, list, actor, action, String(input.reason || '').trim().slice(0, 500), now);
    t.Updated_At = now; t.Last_Activity_By = v.email;
    if (t.Assignment_Flags && /Manual assignment|No assignee/.test(t.Assignment_Flags)) t.Assignment_Flags = t.Assignment_Flags.split(' | ').filter(function (f) { return !/Manual assignment|No assignee/.test(f); }).join(' | ');
    tkUpdateRow_('tickets', t);
    return { ok: true, action: action, assignees: list, status: t.Status, email: mail };
  });
}
function addTicketParticipant(sessionToken, input) {
  apsRequireTabForToken_(sessionToken, 'tickets'); // r56: Admin Control → Access Control
  var v = tkViewer_(sessionToken);
  if (!tkIsAdmin_(v)) throw new Error('Only Admin can manage participants.');
  input = input || {};
  var e = normalizeEmail_(input.email);
  if (!e || !TK_EMAIL_RE_.test(e)) throw new Error('Invalid email address.');
  return tkLocked_(function () {
    var L = tkLoad_(v, input.ticketId), t = L.t, now = tkNowIso_(), actor = { email: v.email, name: tkNameFor_(v.email, L.courses) };
    var p = L.parts.filter(function (x) { return x.Email === e; })[0];
    if (p && p.Active === 'TRUE') throw new Error('This person is already on the ticket.');
    if (p) { p.Active = 'TRUE'; p.Removed_By = ''; p.Removed_At = ''; tkUpdateRow_('participants', p); }
    else tkAppend_('participants', [{ Ticket_ID: t.Ticket_ID, Ticket_Number: t.Ticket_Number, Email: e, Name: String(input.name || '').trim() || tkNameFor_(e, L.courses), Role: 'WATCHER', Participant_Type: 'PARTICIPANT', Active: 'TRUE', Added_By: v.email, Added_At: now }]);
    tkAudit_(t, 'ADD_PARTICIPANT', '', e, actor, String(input.reason || ''));
    t.Updated_At = now; tkUpdateRow_('tickets', t);
    return { ok: true };
  });
}
function removeTicketParticipant(sessionToken, input) {
  apsRequireTabForToken_(sessionToken, 'tickets'); // r56: Admin Control → Access Control
  var v = tkViewer_(sessionToken);
  if (!tkIsAdmin_(v)) throw new Error('Only Admin can manage participants.');
  input = input || {};
  var e = normalizeEmail_(input.email);
  return tkLocked_(function () {
    var L = tkLoad_(v, input.ticketId), t = L.t, now = tkNowIso_(), actor = { email: v.email, name: tkNameFor_(v.email, L.courses) };
    var p = L.parts.filter(function (x) { return x.Email === e && x.Active === 'TRUE'; })[0];
    if (!p) throw new Error('This person is not an active participant.');
    if (p.Role === 'REQUESTER') throw new Error('The requester cannot be removed.');
    p.Active = 'FALSE'; p.Removed_By = v.email; p.Removed_At = now; tkUpdateRow_('participants', p);
    tkAudit_(t, 'REMOVE_PARTICIPANT', e, '', actor, String(input.reason || ''));
    if (p.Participant_Type === 'ASSIGNEE') t.Assigned_To = tkActiveEmails_(L.parts, 'ASSIGNEE').join('; ');
    t.Updated_At = now; tkUpdateRow_('tickets', t);
    return { ok: true };
  });
}

/* ------------------------------- email ------------------------------- */
/** Builds To/CC: validated, de-duplicated, admin CC always, never in both To and CC. */
function tkBuildRecipients_(toList, cfg) {
  var cc = tkCleanEmails_([cfg.adminCc]);
  var to = tkCleanEmails_(toList).filter(function (e) { return cc.indexOf(e) < 0; });
  var invalid = (toList || []).filter(function (e) { var n = normalizeEmail_(e); return e && (!n || !TK_EMAIL_RE_.test(n)); });
  if (!to.length && cc.length) { to = cc; cc = []; } // nobody else: admin receives it directly (still exactly once)
  return { to: to, cc: cc, invalid: invalid };
}

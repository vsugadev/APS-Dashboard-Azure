    rec.Recipients_Count = String(r.recipients.length); rec.Recipients = r.recipients.join(', ');
    rec.Error = res.ok ? '' : 'Email failed: ' + String(res.error || 'send failed').replace(/(Bearer\s+|access_token[=:]\s*|refresh_token[=:]\s*|client_secret[=:]\s*)[^\s,)]+/gi, '$1[hidden]').replace(/ya29\.[\w.-]+/g, '[hidden]').slice(0, 300);
    ccwWrite_(rec);

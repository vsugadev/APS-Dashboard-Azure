// --- Permanent, cross-source "Last Login" record (Classroom / Meet / Dashboard) ---
// Unlike presenceMap above (transient — true only while someone is detected
// online right now), this is a PERMANENT record of activity for each person,
// tracked as THREE INDEPENDENT timestamps — one per source, never confused
// with one another:
//   - Google Classroom activity (Admin Reports API, applicationName
//     'classroom') — labeled 'GC' — see getClassroomActivityMap_.
//   - Google Meet activity (Admin Reports API, applicationName 'meet') —
//     labeled 'GM' (NOT 'GC') — see getMeetPresenceMap_.
//   - A Dashboard visit/heartbeat OR sign-off (this person's own browser
//     loading/polling the dashboard, or reporting itself hidden/closed) —
//     labeled 'DB' — see recordHeartbeat_ and recordDashboardSignOff().
// Each of those three call sites merges its own freshest timestamp into this
// map via mergeLastLoginActivity_(), keyed by source ('gc'|'gm'|'db'), which
// enforces "this source's own timestamp only ever moves forward" — a source
// is never downgraded by an older event, and the three sources never
// overwrite each other's slot. applyLastLogin_() reads this map and, for
// each person, computes TWO things independently (see summarizeLastLogin_):
//   (A) the single most recent timestamp among whichever source(s) have ever
//       recorded activity for that person, and
//   (B) the full set of sources that have EVER recorded activity for that
//       person (not just whichever is newest), always listed in the fixed
//       order GC/GM/DB.
// The two are combined into a ready-to-render string such as
// "MM/DD HH:mm (GC/GM/DB)", "MM/DD HH:mm (GC/DB)", or "MM/DD HH:mm (GM)" —
// Eastern time, computed server-side so it's correct no matter what timezone
// the viewer's own browser/OS is set to — onto every teacher/student object
// returned by getDashboardData().
var LAST_LOGIN_PROP_KEY = 'lastLoginMap';
// Lightweight realtime cache for external Google activity. This stores only
// the latest observed Meet/Classroom activity timestamp per person. It is
// refreshed by the normal Classroom sync, while the dashboard mirrors this
// tiny map every 2 seconds without calling the Google APIs.
var EXTERNAL_ACTIVITY_REALTIME_PROP_KEY = 'externalActivityRealtimeMap'; // { email: { gm: isoUTC|null, gc: isoUTC|null } } // { normalizedEmail: { gc: isoUTC|undefined, gm: isoUTC|undefined, db: isoUTC|undefined } }


/** ---------------------------------------------------------------------
 *  "Teacher NOT in Class" flow — a 3-stage cycle that refreshes on the
 *  Sheet immediately on every click (independent of the sync trigger
 *  interval), and cycles as:
 *
 *    none -> reported -> in_progress -> none -> ...
 *    "Teacher NOT in Class" -> "Tech Team talking with Teacher" ->
 *      "Teacher Returned to Class" -> "Teacher NOT in Class" -> ...
 *
 *  - none -> reported: a STUDENT in the class (or admin/headmaster) reports it.
 *  - reported -> in_progress: only the tech team (admin/headmaster)
 *    acknowledges they're talking with the teacher.
 *  - in_progress -> none: only that class's TEACHER (once back), or the
 *    tech team, confirms the teacher has returned.
 * ------------------------------------------------------------------- */
var TEACHER_NOT_IN_CLASS_NEXT_STAGE_ = { none: 'reported', reported: 'in_progress', in_progress: 'none' };

function getTeacherNotInClassMap_() {
  var raw = PropertiesService.getScriptProperties().getProperty(TEACHER_NOT_IN_CLASS_PROP_KEY);
  return raw ? JSON.parse(raw) : {};
}

function setTeacherNotInClassStage(sessionToken, courseId, targetStage) {
  var session = requireValidSession_(sessionToken);
  var allCourses = readAllCoursesFromCache_();
  var course = allCourses.filter(function (c) { return c.id === courseId; })[0];
  if (!course) throw new Error('Could not find that class — try Refresh and try again.');
  var viewer = { email: session.email, role: session.role };
  requireDashboardMutationPermission_(viewer, 'change teacher status');
  var isStaff = isAdminOrHm_(viewer.role) || classSupportElevated_(viewer, course); // VP/HM of THIS class: HM-level here only

  var map = getTeacherNotInClassMap_();
  var currentEntry = normalizeStageEntry_(map[courseId]);
  var currentStage = currentEntry.stage;
  if (TEACHER_NOT_IN_CLASS_NEXT_STAGE_[currentStage] !== targetStage) {
    throw new Error('That status just changed — click Refresh and try again.');
  }
  var cooldownWarning = stageTransitionCooldownWarning_(currentEntry);
  if (cooldownWarning) {
    // Blocked by the cooldown — return the CURRENT (unchanged) entry plus a
    // `warning` field, rather than throwing, so the client shows this as a
    // soft warning toast instead of a failure.
    var blockedResult = { stage: currentStage, updatedAt: currentEntry.updatedAt, updatedBy: currentEntry.updatedBy };
    blockedResult.warning = cooldownWarning;
    return blockedResult;
  }

  if (targetStage === 'reported') {
    // Reporting the teacher missing: a student IN THIS CLASS, or staff, can raise it.
    var canReport = isStaff || (viewer.role === 'student' && courseHasStudentEmail_(course, viewer.email));
    if (!canReport) {
      throw new Error('Only a student in this class (or an admin/headmaster) can report that the teacher is not in class.');
    }
  } else if (targetStage === 'in_progress') {
    // Acknowledging: only the tech team can mark that they're talking with the teacher.
    if (!isStaff) {
      throw new Error('Only the tech support team (admin/headmaster) can mark this as being handled.');
    }
  } else if (targetStage === 'none') {
    // Clearing it: only THIS class's teacher, or staff, can confirm the teacher is back.
    var canClear = isStaff || (viewer.role === 'teacher' && userHasCourseAccess_(viewer.email, course));
    if (!canClear) {
      throw new Error("Only this class's teacher (or an admin/headmaster) can mark the teacher as back in class.");
    }
  } else {
    throw new Error('Unknown status: ' + targetStage);
  }

  var updatedAt = new Date().toISOString();
  var updatedBy = { email: viewer.email, name: chatDisplayName_(viewer, allCourses), role: viewer.role };
  map[courseId] = { stage: targetStage, updatedAt: updatedAt, updatedBy: updatedBy };
  PropertiesService.getScriptProperties().setProperty(TEACHER_NOT_IN_CLASS_PROP_KEY, JSON.stringify(map));

  var sheet = getOrCreateCacheSheet_();
  var data = sheet.getDataRange().getValues();
  for (var i = 1; i < data.length; i++) {
    if (String(data[i][0]) === String(courseId) && data[i][17]) {
      var c = JSON.parse(data[i][17]);
      c.teacherNotInClassStage = targetStage;
      c.teacherNotInClassUpdatedAt = updatedAt;
      c.teacherNotInClassUpdatedBy = updatedBy; // who clicked — shown in the card next to the status
      var rowNum = i + 1;
      sheet.getRange(rowNum, 13).setValue(c.teacherNotInClassStage);      // "Teacher NOT In Class Stage" column
      sheet.getRange(rowNum, 14).setValue(c.teacherNotInClassUpdatedAt);  // "...Updated At" column
      sheet.getRange(rowNum, 18).setValue(JSON.stringify(c));            // "Detail JSON" column (also carries updatedBy)
      invalidateCoursesMemo_(); // r49
      break;
    }
  }

  if (targetStage === 'reported') {
    notifyStaff_(
      '⚠️ Teacher NOT in class — ' + course.name,
      'Reported by: ' + (viewer.email || 'unknown') + ' (' + viewer.role + ')\n' +
      'Class: ' + course.name + (course.section ? ' (' + course.section + ')' : '') + '\n' +
      'Time: ' + new Date().toLocaleString() + '\n\n' +
      'Open the dashboard to view or resolve this.'
    );
  }

  return map[courseId];
}

/** ---------------------------------------------------------------------
 *  "Needs Tech Support" flow — a 3-stage cycle, same instant-refresh
 *  pattern as above:
 *
 *    none -> reported -> in_progress -> none -> ...
 *    "Need Tech Support in Google Class" -> "Tech Team will Join to your
 *      Classroom" -> "Tech issue is been Resolved" ->
 *      "Need Tech Support in Google Class" -> ...
 *
 *  - none -> reported: a TEACHER or STUDENT in the class (or admin/
 *    headmaster) requests help.
 *  - reported -> in_progress: only the tech team (admin/headmaster)
 *    acknowledges they're joining the classroom.
 *  - in_progress -> none: only the tech team (admin/headmaster) marks the
 *    issue resolved.
 * ------------------------------------------------------------------- */
var NEEDS_TECH_SUPPORT_NEXT_STAGE_ = { none: 'reported', reported: 'in_progress', in_progress: 'none' };

function getNeedsTechSupportMap_() {
  var raw = PropertiesService.getScriptProperties().getProperty(NEEDS_TECH_SUPPORT_PROP_KEY);
  return raw ? JSON.parse(raw) : {};
}

function setNeedsTechSupportStage(sessionToken, courseId, targetStage) {
  var session = requireValidSession_(sessionToken);
  var allCourses = readAllCoursesFromCache_();
  var course = allCourses.filter(function (c) { return c.id === courseId; })[0];
  if (!course) throw new Error('Could not find that class — try Refresh and try again.');
  var viewer = { email: session.email, role: session.role };
  requireDashboardMutationPermission_(viewer, 'change tech support status');
  var isStaff = isAdminOrHm_(viewer.role) || classSupportElevated_(viewer, course); // VP/HM of THIS class: HM-level here only

  var map = getNeedsTechSupportMap_();
  var currentEntry = normalizeStageEntry_(map[courseId]);
  var currentStage = currentEntry.stage;
  if (NEEDS_TECH_SUPPORT_NEXT_STAGE_[currentStage] !== targetStage) {
    throw new Error('That status just changed — click Refresh and try again.');
  }
  var cooldownWarning = stageTransitionCooldownWarning_(currentEntry);
  if (cooldownWarning) {
    // Blocked by the cooldown — return the CURRENT (unchanged) entry plus a
    // `warning` field, rather than throwing, so the client shows this as a
    // soft warning toast instead of a failure.
    var blockedResult = { stage: currentStage, updatedAt: currentEntry.updatedAt, updatedBy: currentEntry.updatedBy };
    blockedResult.warning = cooldownWarning;
    return blockedResult;
  }

  if (targetStage === 'reported') {
    // Requesting help: the teacher or a student IN THIS CLASS, or staff, can raise it.
    var canRequest = isStaff ||
      (viewer.role === 'teacher' && userHasCourseAccess_(viewer.email, course)) ||
      (viewer.role === 'student' && courseHasStudentEmail_(course, viewer.email));
    if (!canRequest) {
      throw new Error('Only a teacher or student in this class (or an admin/headmaster) can request tech support for it.');
    }
  } else if (targetStage === 'in_progress' || targetStage === 'none') {
    // Acknowledging or resolving: only the tech-support team (admin/headmaster).
    if (!isStaff) {
      throw new Error('Only the tech support team (admin/headmaster) can update a tech support request.');
    }
  } else {
    throw new Error('Unknown status: ' + targetStage);
  }

  var updatedAt = new Date().toISOString();
  var updatedBy = { email: viewer.email, name: chatDisplayName_(viewer, allCourses), role: viewer.role };
  map[courseId] = { stage: targetStage, updatedAt: updatedAt, updatedBy: updatedBy };
  PropertiesService.getScriptProperties().setProperty(NEEDS_TECH_SUPPORT_PROP_KEY, JSON.stringify(map));

  var sheet = getOrCreateCacheSheet_();
  var data = sheet.getDataRange().getValues();
  for (var i = 1; i < data.length; i++) {
    if (String(data[i][0]) === String(courseId) && data[i][17]) {
      var c = JSON.parse(data[i][17]);
      c.needsTechSupportStage = targetStage;
      c.needsTechSupportUpdatedAt = updatedAt;
      c.needsTechSupportUpdatedBy = updatedBy; // who clicked — shown in the card next to the status
      var rowNum = i + 1;
      sheet.getRange(rowNum, 15).setValue(c.needsTechSupportStage);      // "Needs Tech Support Stage" column
      sheet.getRange(rowNum, 16).setValue(c.needsTechSupportUpdatedAt);  // "...Updated At" column
      sheet.getRange(rowNum, 18).setValue(JSON.stringify(c));            // "Detail JSON" column (also carries updatedBy)
      invalidateCoursesMemo_(); // r49
      break;
    }
  }

  if (targetStage === 'reported') {
    notifyStaff_(
      '🛠️ Tech Support needed — ' + course.name,
      'Reported by: ' + (viewer.email || 'unknown') + ' (' + viewer.role + ')\n' +
      'Class: ' + course.name + (course.section ? ' (' + course.section + ')' : '') + '\n' +
      'Time: ' + new Date().toLocaleString() + '\n\n' +
      'Open the dashboard to view or resolve this.'
    );
  }

  return map[courseId];
}

/** ---------------------------------------------------------------------
 *  TEACHER WEEKLY AVAILABILITY + PARENT FEEDBACK / TEACHER STAR POINTS
 *  ------------------------------------------------------------------
 *  Two independent, additive features, both keyed by a "school week" so a
 *  new week never overwrites or is affected by a previous one:
 *    - Teacher Weekly Availability: each teacher confirms (or flags as
 *      unavailable, with an arrangement) their own classes for the CURRENT
 *      week only. Stored in the "Teacher_Weekly_Availability" Sheet tab.
 *    - Parent Feedback / Teacher Star Points: a thumbs up/down + 1-5 star
 *      rating per student+course+week, rolled up into a running per-teacher
 *      total. Stored in the "Teacher_Star_Points" Sheet tab.
 *  Both tabs live in the SAME workbook as "Courses" (getWorkbook_()), same
 *  as every other tab this project uses — same sheet ID as
 *  TARGET_SPREADSHEET_ID above, per the school's own naming for these two
 *  tabs.
 *
 *  ROLE NOTE (flagged, confirm with the school): this app's role system has
 *  exactly four roles — admin / headmaster / teacher / student (see
 *  "Role-based access" in the architecture doc) — derived from
 *  ADMIN_EMAILS/HEADMASTER_EMAILS plus each course's live Google Classroom
 *  teacher/student roster. There is no separate "Parent" account anywhere
 *  in Classroom data for this school, so BY DEFAULT a STUDENT-role login is
 *  treated as the parent/student unit: the same account sees the read-only
 *  "This Week's Class" status card AND the "Rate This Week's Class"
 *  feedback form. If APS actually has (or wants) a genuinely separate
 *  parent sign-in — e.g. a parent email that is NOT the Classroom student
 *  account — that needs a new lookup (a Sheet mapping Parent Email ->
 *  Student Email/Course, the same pattern as WhatsApp_Group_Links) and a
 *  new 'parent' role branch in getViewerRole_(); this was flagged as an
 *  open question rather than built speculatively, since guessing the wrong
 *  shape here would mean redoing this whole feature's permission checks.
 *  Everywhere below, "student" role = the Parent Feedback submitter.
 *
 *  WEEK BOUNDARY (CONFIRMED with the school, 2026-09-11): APS only holds
 *  classes on Friday/Saturday/Sunday this year, so getCurrentWeekId_() uses
 *  a Friday-Sunday block (in LAST_LOGIN_TIMEZONE, America/New_York) instead
 *  of a calendar Sunday-Saturday week. On the off days (Monday-Thursday,
 *  when there is no school), "This Week" rolls FORWARD to the upcoming
 *  Friday-Sunday block (the school's explicit choice, so teachers/admins
 *  can see and plan the next weekend's availability ahead of time) rather
 *  than showing the weekend that just ended. Not tied to an assumed
 *  academic-year start date (not recorded anywhere in this project) — see
 *  that function's own doc comment for why.
 * ------------------------------------------------------------------- */

var TEACHER_AVAILABILITY_SHEET_NAME = 'Teacher_Weekly_Availability';
var TEACHER_AVAILABILITY_REALTIME_PROP_KEY = 'teacherAvailabilityRealtimeMap'; // { weekId|courseId: {weekId,courseId,status,alternative,updatedAt,updatedByName} }
var TEACHER_STAR_POINTS_SHEET_NAME = 'Teacher_Star_Points';

// Availability status codes (Teacher_Weekly_Availability sheet + client).
var AVAILABILITY_STATUS = {
  PENDING: 'pending',            // ⚪ no response yet this week
  CONFIRMED: 'confirmed',        // 🟢 teacher confirmed YES
  NOT_AVAILABLE: 'not_available' // 🔴 (plain) or 🟡 (once an alternative is on file) teacher said NO
};
// When NOT_AVAILABLE, exactly one of these explains the arrangement (🟡,
// except on_call_assigned below, which gets its own 🟣 color client-side).
var AVAILABILITY_ALTERNATIVE_LABELS = {
  parent_teacher_arranged: 'Parent Teacher Arranged',
  sub_teacher_arranged: 'Sub-Teacher Arranged',
  need_hm_support: 'Need HM Support to Arrange Alternative Teacher',
  // Sept 2026, twenty-ninth round: primary teacher is on leave, HM has
  // talked to an on-call teacher (the VCFO_AMCHATS_BOD_EMAILS / tcs_*
  // directory — see getOnCallTeachers_()), and assigned them to cover this
  // one class for this week only. Uses the same permission gate as every
  // other status change below (HM/Admin/Superadmin, or that class's own
  // Teacher) — no separate check needed.
  on_call_assigned: 'Alternative: On-Call Assigned'
};

/**
 * Returns a reliable, deterministic weekly key for "the current school
 * week" — WK-YYYY-MM-DD, where YYYY-MM-DD is the Friday (Eastern time) that
 * starts that week's Fri-Sat-Sun class block. CONFIRMED with the school
 * (2026-09-11): classes only run Friday/Saturday/Sunday this year, so the
 * week boundary is a 3-day Friday-Sunday block in LAST_LOGIN_TIMEZONE
 * (America/New_York), not a calendar Sunday-Saturday week. On Fri/Sat/Sun
 * this maps to the Friday that starts that same in-progress block; on the
 * off days Mon-Thu it rolls FORWARD to the upcoming Friday (the school's
 * confirmed choice, so "This Week" shows the next weekend to plan for, not
 * the one that just ended). Deliberately NOT tied to an assumed
 * academic-year start date — this is what the requirement's own "...or an
 * equivalent reliable week/date key" allows for, and it never needs a
 * yearly reset or manual re-entry to keep working correctly.
 */
function getCurrentWeekId_(now) {
  now = now || new Date();
  var dow = easternDayOfWeek_(now); // 0=Sunday...6=Saturday, Eastern
  var todayStr = Utilities.formatDate(now, LAST_LOGIN_TIMEZONE, 'yyyy-MM-dd');
  var todayMidnightUtc = easternWallTimeToDate_(todayStr, 0, 0);
  // Days to add to "today" to reach this block's Friday anchor, indexed by
  // Eastern day-of-week (0=Sun...6=Sat). Fri/Sat/Sun look back to (or land
  // on) the Friday that started their own in-progress block; Mon-Thu roll
  // FORWARD to the upcoming Friday per the school's confirmed choice.
  var offsetToFridayByDow = [-2, 4, 3, 2, 1, 0, -1];
  var fridayUtc = new Date(todayMidnightUtc.getTime() + offsetToFridayByDow[dow] * 24 * 60 * 60000);
  var fridayStr = Utilities.formatDate(fridayUtc, LAST_LOGIN_TIMEZONE, 'yyyy-MM-dd');
  return 'WK-' + fridayStr;
}

/** Human label for a WK-YYYY-MM-DD weekId, e.g. "Week of Sep 11 - Sep 13, 2026" (Friday-Sunday, matching the school's Fri/Sat/Sun class schedule). */
function getWeekLabel_(weekId) {
  var m = /^WK-(\d{4})-(\d{2})-(\d{2})$/.exec(weekId || '');
  if (!m) return weekId || '';
  var friday = new Date(Number(m[1]), Number(m[2]) - 1, Number(m[3]));
  var sunday = new Date(friday.getTime() + 2 * 24 * 60 * 60000);
  var fmt = function (d) { return Utilities.formatDate(d, LAST_LOGIN_TIMEZONE, 'MMM d'); };
  return 'Week of ' + fmt(friday) + ' - ' + fmt(sunday) + ', ' + m[1];
}

/**
 * Picks the one "teacher of record" for availability/feedback purposes —
 * the first non-hidden teacher already on the course (co-teaching
 * support/admin accounts are already filtered out by buildCourseRecord_).
 * Returns null if the course has no teacher.
 */
/**
 * THE Primary Teacher resolver (Classes tab, Teacher Availability report, availability status, teacher of record):
 * the Course Description's PRIMARY_TEACHER (course.teachers[].apsRoles, set at sync by classSupportForCourse_),
 * otherwise the first Classroom teacher that is not a Room-only VP / HM. Never decided by an email prefix.
 */
function primaryTeacherOf_(course) {
  // A VP / HM added for Class Support is never the teacher of record (falls back to the first teacher only when no Room is set).
  var list = course.teachers || [];
  return list.filter(function (t) { return (t.apsRoles || []).indexOf('PRIMARY_TEACHER') > -1; })[0] ||
    list.filter(function (t) { return !t.supportRole && !isRosterHiddenStaffEmail_(t.email); })[0] || // r116: hidden staff (e.g. the Grading Help Team account) is never the fallback teacher
    list.filter(function (t) { return !t.supportRole; })[0] || null;
}

/** Server-side natural compare for "NILAI - 4" vs "NILAI - 10" (mirrors Dashboard.html's client-side naturalCompare(), kept independent since this runs server-side). */
function naturalCompareJs_(a, b) {
  var an = String(a || '').match(/(\d+)(?!.*\d)/);
  var bn = String(b || '').match(/(\d+)(?!.*\d)/);
  if (an && bn) {
    var na = parseInt(an[1], 10), nb = parseInt(bn[1], 10);
    if (na !== nb) return na - nb;
  }
  return String(a || '').localeCompare(String(b || ''));
}

function getOrCreateTeacherAvailabilitySheet_() {
  var ss = getWorkbook_();
  var sheet = ss.getSheetByName(TEACHER_AVAILABILITY_SHEET_NAME);
  if (sheet) return sheet;
  sheet = ss.insertSheet(TEACHER_AVAILABILITY_SHEET_NAME);
  sheet.getRange(1, 1, 1, 11).setValues([[
    'Week ID', 'Teacher Email', 'Teacher Name', 'Course ID', 'Course Name',
    'Section (Day/Time)', 'Availability Status', 'Alternative Arrangement',
    'Updated At', 'Updated By Email', 'Updated By Name'
  ]]).setFontWeight('bold');
  sheet.setFrozenRows(1);
  return sheet;
}

/** Reads the whole Teacher_Weekly_Availability sheet into a { "weekId|courseId": {rowNum, ...fields} } map. */
function readTeacherAvailabilityMap_() {
  var sheet = getOrCreateTeacherAvailabilitySheet_();
  var lastRow = sheet.getLastRow();
  var map = {};
  if (lastRow < 2) return map;
  var values = sheet.getRange(2, 1, lastRow - 1, 11).getValues();
  values.forEach(function (row, i) {
    var weekId = row[0], courseId = String(row[3]);
    if (!weekId || !courseId) return;
    map[weekId + '|' + courseId] = {
      rowNum: i + 2,
      weekId: weekId,
      teacherEmail: row[1],
      teacherName: row[2],
      courseId: courseId,
      courseName: row[4],
      section: row[5],
      status: row[6] || AVAILABILITY_STATUS.PENDING,
      alternative: row[7] || '',
      updatedAt: row[8] || '',
      updatedByEmail: row[9] || '',
      updatedByName: row[10] || ''
    };
  });
  return map;
}

/**
 * Builds the full availability board for `weekId` from the given (already
 * role-filtered) `courses` list — one row per course that has a teacher,
 * defaulting to PENDING/⚪ for any course with no saved response yet this
 * week (nothing is pre-written to the Sheet just by viewing). Reuses
 * course.name/course.section exactly as already shown everywhere else in
 * this app (Student Onboarding groups by these same two fields) rather than
 * re-deriving day/time from the title a second time.
 */
function buildAvailabilityBoard_(courses, weekId) {
  var savedMap = readTeacherAvailabilityMap_();
  var rows = [];
  courses.forEach(function (c) {
    var teacher = primaryTeacherOf_(c);
    if (!teacher) return; // "No teacher assigned" courses have nothing to confirm
    var saved = savedMap[weekId + '|' + c.id];
    rows.push({
      weekId: weekId,
      courseId: c.id,
      courseName: c.name,
      section: c.section,
      teacherEmail: teacher.email,
      teacherName: teacher.name,
      status: saved ? saved.status : AVAILABILITY_STATUS.PENDING,
      alternative: saved ? saved.alternative : '',
      updatedAt: saved ? saved.updatedAt : '',
      updatedByName: saved ? saved.updatedByName : ''
    });
  });
  rows.sort(function (a, b) { return naturalCompareJs_(a.courseName, b.courseName); });
  return rows;
}

/**
 * Sets (or clears) the current week's availability for one course — Part of
 * "Teacher Weekly Availability". SERVER-SIDE permission check (never trusts
 * the client, per the explicit "validate on the server" requirement):
 * allowed for admin/headmaster (any course, e.g. while arranging HM support
 * on a teacher's behalf), or the course's own teacher. A student can NEVER
 * call this successfully, regardless of what the client sends.
 *
 * `status` must be 'confirmed' or 'not_available'. When 'not_available',
 * `alternative` must be one of AVAILABILITY_ALTERNATIVE_LABELS' keys; when
 * 'confirmed', any alternative is ignored/cleared.
 */
/** r103: the live overlay only matters for the current week — older weeks are dropped (the saved answers stay in the sheet). Was never pruned (67 KB by late Oct). */
function apsAvailRealtimePrune_(map, weekId) {
  Object.keys(map).forEach(function (key) { if (String(key).split('|')[0] < weekId) delete map[key]; });
  return map;
}
function updateTeacherAvailabilityRealtimeCache_(weekId, rows) {
  var map = apsAvailRealtimePrune_(getRealtimeAvailabilityMap_(), weekId);
  var prefix = weekId + '|';
  Object.keys(map).forEach(function (key) { if (key.indexOf(prefix) === 0) delete map[key]; });
  (rows || []).forEach(function (r) {
    map[weekId + '|' + r.courseId] = {
      weekId: weekId, courseId: String(r.courseId), status: r.status || AVAILABILITY_STATUS.PENDING,
      alternative: r.alternative || '', updatedAt: r.updatedAt || '', updatedByName: r.updatedByName || ''
    };
  });
  PropertiesService.getScriptProperties().setProperty(TEACHER_AVAILABILITY_REALTIME_PROP_KEY, JSON.stringify(map));
  return map;
}

function setTeacherAvailabilityStatus(sessionToken, courseId, status, alternative) {
  var session = requireValidSession_(sessionToken);
  var allowedStatuses = [
    AVAILABILITY_STATUS.CONFIRMED,
    AVAILABILITY_STATUS.NOT_AVAILABLE,
    AVAILABILITY_STATUS.PENDING
  ];
  if (allowedStatuses.indexOf(status) === -1) {
    throw new Error('Unknown availability status: ' + status);
  }
  if (status === AVAILABILITY_STATUS.NOT_AVAILABLE && !AVAILABILITY_ALTERNATIVE_LABELS.hasOwnProperty(alternative)) {
    throw new Error('Please choose an arrangement (Parent Teacher Arranged / Sub-Teacher Arranged / Need HM Support / Alternative: On-Call Assigned).');
  }
  var courses = readAllCoursesFromCache_();
  var course = courses.filter(function (c) { return String(c.id) === String(courseId); })[0];
  if (!course) throw new Error('Could not find that class — try Refresh and try again.');
  var teacher = primaryTeacherOf_(course);
  if (!teacher) throw new Error('This class has no teacher on record.');

  var viewer = { email: session.email, role: session.role };
  requireDashboardMutationPermission_(viewer, 'change teacher availability');
  if (viewer.role === 'teacher' && !classSupportElevated_(viewer, course) && isAPSSchoolHoliday(apsClassDateInWeek_(getCurrentWeekId_(), examQpParseClassName_(course.name).dayOfWeek))) // r110
    throw new Error('APS is on school leave for this class this week — no availability response is needed.');
  var isStaff = isAdminOrHm_(viewer.role) || classSupportElevated_(viewer, course);
  var isOwnClass = viewer.role === 'teacher' && userHasCourseAccess_(viewer.email, course);
  if (!isStaff && !isOwnClass) {
    classAccessDenied_(viewer, course, 'change teacher availability');
    throw new Error("Only this class's own teacher (or an admin/headmaster) can update availability.");
  }

  var weekId = getCurrentWeekId_();
  var effectiveStatus = status === AVAILABILITY_STATUS.PENDING ? AVAILABILITY_STATUS.PENDING : status;
  var effectiveAlternative = status === AVAILABILITY_STATUS.CONFIRMED || status === AVAILABILITY_STATUS.PENDING ? '' : alternative;
  var sheet = getOrCreateTeacherAvailabilitySheet_();
  var map = readTeacherAvailabilityMap_();
  var key = weekId + '|' + courseId;
  var existing = map[key];
  var updatedAt = new Date().toISOString();
  var updatedByName = chatDisplayName_(viewer, courses);
  var rowValues = [
    weekId, teacher.email, teacher.name, courseId, course.name, course.section,
    effectiveStatus, effectiveAlternative, updatedAt, viewer.email, updatedByName
  ];

  if (existing) {
    sheet.getRange(existing.rowNum, 1, 1, rowValues.length).setValues([rowValues]);
  } else {
    sheet.appendRow(rowValues);
  }

  var realtimeMap = apsAvailRealtimePrune_(getRealtimeAvailabilityMap_(), weekId);
  realtimeMap[weekId + '|' + courseId] = {
    weekId: weekId, courseId: String(courseId), status: effectiveStatus, alternative: effectiveAlternative,
    updatedAt: updatedAt, updatedByName: updatedByName
  };
  try { PropertiesService.getScriptProperties().setProperty(TEACHER_AVAILABILITY_REALTIME_PROP_KEY, JSON.stringify(realtimeMap)); } // r103: the answer is already saved in the sheet
  catch (eRt) { console.warn('[Storage] availability overlay not saved: ' + (eRt && eRt.message)); }

  return {
    weekId: weekId, courseId: courseId, courseName: course.name, section: course.section,
    teacherEmail: teacher.email, teacherName: teacher.name,
    status: effectiveStatus, alternative: effectiveAlternative, updatedAt: updatedAt, updatedByName: updatedByName
  };
}

// --- Parent Feedback / Teacher Star Points ---------------------------------

function getOrCreateTeacherStarPointsSheet_() {
  var ss = getWorkbook_();
  var sheet = ss.getSheetByName(TEACHER_STAR_POINTS_SHEET_NAME);
  if (sheet) return sheet;
  sheet = ss.insertSheet(TEACHER_STAR_POINTS_SHEET_NAME);
  sheet.getRange(1, 1, 1, 11).setValues([[
    'Week ID', 'Student Email', 'Parent Email', 'Teacher Email', 'Teacher Name',
    'Course ID', 'Course Name', 'Thumbs', 'Stars', 'Feedback At', 'Updated At'
  ]]).setFontWeight('bold');
  sheet.setFrozenRows(1);
  return sheet;
}

/** Reads the whole Teacher_Star_Points sheet into an array of row objects (each carrying its 1-based sheet row number for in-place updates). */
function readParentFeedbackRows_() {
  var sheet = getOrCreateTeacherStarPointsSheet_();
  var lastRow = sheet.getLastRow();
  if (lastRow < 2) return [];
  var values = sheet.getRange(2, 1, lastRow - 1, 11).getValues();
  return values.map(function (row, i) {
    return {
      rowNum: i + 2,
      weekId: row[0], studentEmail: row[1], parentEmail: row[2],
      teacherEmail: row[3], teacherName: row[4], courseId: String(row[5]), courseName: row[6],
      thumbs: row[7] || '', stars: row[8] ? Number(row[8]) : null,
      feedbackAt: row[9] || '', updatedAt: row[10] || ''
    };
  }).filter(function (r) { return r.weekId && r.courseId; });
}

/**
 * Rolls up an already-fetched `rows` array (see readParentFeedbackRows_())
 * into one teacher's "Teacher Annual Star Accumulation" stats. Takes the
 * rows as a parameter (rather than reading the sheet itself) so a caller
 * summarizing MULTIPLE teachers at once (see getWeeklyPanelData's admin/HM
 * branch) reads the Teacher_Star_Points sheet exactly ONCE, not once per
 * teacher. Flagged: this sums the FULL history ever recorded for that
 * teacher, since no academic-year start/end date is recorded anywhere in
 * this project to bound "annual" by — if APS wants the total to reset at
 * the start of each academic year, archiving/clearing this sheet tab at
 * that time is the simplest approach; nothing else needs to change.
 */
function computeTeacherSummaryFromRows_(rows, teacherEmail) {
  var normalized = normalizeEmail_(teacherEmail);
  var weekId = getCurrentWeekId_();
  var mine = rows.filter(function (r) { return normalizeEmail_(r.teacherEmail) === normalized; });
  var totalStars = 0, starCount = 0, thumbsUp = 0, thumbsDown = 0, thisWeekStars = 0, thisWeekCount = 0;
  mine.forEach(function (r) {
    if (r.stars) {
      totalStars += r.stars;
      starCount++;
      if (r.weekId === weekId) { thisWeekStars += r.stars; thisWeekCount++; }
    }
    if (r.thumbs === 'up') thumbsUp++;
    if (r.thumbs === 'down') thumbsDown++;
  });
  return {
    teacherEmail: teacherEmail,
    totalFeedback: mine.length,
    totalStars: totalStars,
    averageStars: starCount ? Math.round((totalStars / starCount) * 10) / 10 : null,
    thumbsUp: thumbsUp,
    thumbsDown: thumbsDown,
    thisWeekAverageStars: thisWeekCount ? Math.round((thisWeekStars / thisWeekCount) * 10) / 10 : null,
    thisWeekFeedbackCount: thisWeekCount
  };
}

/** Convenience single-teacher wrapper around computeTeacherSummaryFromRows_ — reads the sheet once for just this one call. Prefer computeTeacherSummaryFromRows_ directly when summarizing MULTIPLE teachers in one request. */
function summarizeTeacherStars_(teacherEmail) {
  return computeTeacherSummaryFromRows_(readParentFeedbackRows_(), teacherEmail);
}

/**
 * Submits (or, if this student/course/week already has one, UPDATES) one
 * feedback record — Part of "Parent Feedback". `thumbs` is 'up' | 'down' |
 * '' (optional); `stars` is 1-5 or null (optional) — at least one of the
 * two must be provided. Per the ROLE NOTE above, "Parent" is currently the
 * same login as the STUDENT-role Classroom account for that class; a
 * teacher, admin, or headmaster can never call this (there is nothing for
 * staff to submit feedback ON).
 */
function submitParentFeedback(sessionToken, courseId, thumbs, stars) {
  thumbs = (thumbs === 'up' || thumbs === 'down') ? thumbs : '';
  stars = (stars && stars >= 1 && stars <= 5) ? Math.round(stars) : null;
  if (!thumbs && !stars) throw new Error('Please give a thumbs up/down or a star rating before submitting.');

  var session = requireValidSession_(sessionToken);
  var courses = readAllCoursesFromCache_();
  var viewer = { email: session.email, role: session.role };
  if (viewer.role !== 'student') {
    throw new Error('Only a student/parent account can submit feedback for a class.');
  }
  var course = courses.filter(function (c) { return String(c.id) === String(courseId) && courseHasStudentEmail_(c, viewer.email); })[0];
  if (!course) throw new Error('That class was not found among your enrolled classes.');
  var teacher = primaryTeacherOf_(course);

  var weekId = getCurrentWeekId_();
  var sheet = getOrCreateTeacherStarPointsSheet_();
  var rows = readParentFeedbackRows_();
  var existing = rows.filter(function (r) {
    return r.weekId === weekId && r.courseId === String(courseId) && normalizeEmail_(r.studentEmail) === viewer.email;
  })[0];
  var now = new Date().toISOString();
  var rowValues = [
    weekId, viewer.email, viewer.email, teacher ? teacher.email : '', teacher ? teacher.name : '',
    courseId, course.name, thumbs, stars || '', existing ? existing.feedbackAt : now, now
  ];
  if (existing) {
    sheet.getRange(existing.rowNum, 1, 1, rowValues.length).setValues([rowValues]);
  } else {
    sheet.appendRow(rowValues);
  }
  return {
    weekId: weekId, courseId: courseId, courseName: course.name,
    teacherEmail: teacher ? teacher.email : '', teacherName: teacher ? teacher.name : '',
    thumbs: thumbs, stars: stars, feedbackAt: existing ? existing.feedbackAt : now, updatedAt: now
  };
}

/**
 * One combined, role-aware payload for the whole "This Week" panel (Teacher
 * Availability + Parent Feedback / Teacher Star Points) — a SINGLE
 * google.script.run call the dashboard makes per load/poll, matching the
 * existing getDashboardData() pattern, rather than several separate calls
 * (per the "avoid unnecessary additional calls" requirement). Every branch
 * reuses readAllCoursesFromCache_()/getViewerContext_() (no new Classroom
 * API calls) and the sheet-reading helpers above.
 */
function getWeeklyPanelData(sessionToken) {
  var session = requireValidSession_(sessionToken);
  var allCourses = readAllCoursesFromCache_();
  var ctx = getViewerContext_(allCourses, { email: session.email, role: session.role }); // { email, role, courses } — already role-filtered, same as getDashboardData
  var weekId = getCurrentWeekId_();
  var weekLabel = getWeekLabel_(weekId);
  var result = { weekId: weekId, weekLabel: weekLabel, role: ctx.role };

  result.availability = buildAvailabilityBoard_(ctx.courses, weekId);
  try { slMarkAvailability_(result.availability, ctx.courses, weekId); } catch (eSL) { /* informational */ } // r110
  // Seed the lightweight realtime availability cache from the authoritative Sheet
  // once per weekly-panel load; subsequent 2-second polls read only Script Properties.
  try { updateTeacherAvailabilityRealtimeCache_(weekId, result.availability); } catch (eRt) { console.warn('[Storage] availability overlay not saved: ' + (eRt && eRt.message)); } // r103: display-only overlay

  if (isAdminOrHm_(ctx.role) || ctx.role === VCFO_AMCHSTS_BOD_ROLE) {
    var teacherEmails = {};
    ctx.courses.forEach(function (c) {
      var t = primaryTeacherOf_(c);
      if (t && t.email) teacherEmails[normalizeEmail_(t.email)] = t;
    });
    var allFeedbackRows = readParentFeedbackRows_(); // read once, summarize every teacher from this same array
    result.teacherPerformance = Object.keys(teacherEmails).map(function (key) {
      var t = teacherEmails[key];
      var summary = computeTeacherSummaryFromRows_(allFeedbackRows, t.email);
      summary.teacherName = t.name;
      return summary;
    }).sort(function (a, b) { return (b.totalStars || 0) - (a.totalStars || 0); });
  } else if (ctx.role === 'teacher') {
    var mySummary = summarizeTeacherStars_(ctx.email);
    mySummary.teacherName = findDisplayName_(allCourses, ctx.email);
    result.teacherPerformance = [mySummary];
  } else if (ctx.role === 'student') {
    var allFeedbackForStudent = readParentFeedbackRows_(); // read once, reused below for this week's own rows AND every enrolled teacher's summary
    var weekFeedback = allFeedbackForStudent.filter(function (r) { return r.weekId === weekId && normalizeEmail_(r.studentEmail) === ctx.email; });
    var byCourse = {};
    weekFeedback.forEach(function (r) { byCourse[r.courseId] = r; });
    result.myClasses = ctx.courses.map(function (c) {
      var teacher = primaryTeacherOf_(c);
      var mine = byCourse[c.id];
      return {
        courseId: c.id, courseName: c.name, section: c.section,
        teacherEmail: teacher ? teacher.email : '', teacherName: teacher ? teacher.name : '',
        myFeedback: mine ? { thumbs: mine.thumbs, stars: mine.stars, updatedAt: mine.updatedAt } : null,
        teacherSummary: teacher ? computeTeacherSummaryFromRows_(allFeedbackForStudent, teacher.email) : null
      };
    });
  }

  return result;
}
/** =======================================================================
 *  STUDENT CLASS / GRADE CHANGE REQUEST — added twenty-fifth round (Sept 2026)
 *  =======================================================================
 *  Lets a Student (or their Parent — this app has no separate Parent login;
 *  the Student account itself submits these requests, same assumption as
 *  the sixteenth round's Parent Feedback feature) request either:
 *    (a) a TIMING CHANGE — a different day/time WITHIN THE SAME GRADE, or
 *    (b) a GRADE CHANGE — a different grade entirely, with a chosen day/
 *        time within that new grade (the student picks one exact target
 *        class — never "any available").
 *
 *  BOTH request types go through a genuine TWO-STAGE human approval before
 *  any live Google Classroom roster change happens — this is a school
 *  decision that supersedes an earlier "auto-process Timing Change"
 *  design that was discussed but never built:
 *    Stage 1 — any ONE of the 9 GRADE_CHANGE_APPROVER_EMAILS reviews and
 *              approves/rejects the request (identifies/confirms the
 *              target class). All 9 are CC'd on every notification
 *              regardless of who acts.
 *    Stage 2 — ONLY once Stage 1 approves, a SEPARATE final sign-off is
 *              required from FINAL_APPROVER_EMAIL alone — no one else can
 *              perform this step — before the real Classroom
 *              Students.remove()/Students.create() calls are made.
 *  The MAX_STUDENTS cap (7) is ALWAYS enforced with NO exceptions,
 *  rechecked LIVE against Classroom immediately before the actual
 *  mutation at Stage 2 — even if capacity looked fine when the request
 *  was raised or when Stage 1 approved it, a class that has since filled
 *  up blocks the final step rather than letting the roster exceed 7. This
 *  overrides the original request spec's own worked example (which showed
 *  a class ending up at 8 students) — an explicit school decision.
 *
 *  Untested assumption flagged for verification against the real Workspace
 *  domain: Classroom.Courses.Students.create()/.remove() require either
 *  teacher-of-course or domain-admin-with-delegation permission for the
 *  account this script runs as — this has not been exercised against
 *  production Classroom data. Test with a low-stakes course/student pair
 *  before relying on this in a real request.
 * ======================================================================= */


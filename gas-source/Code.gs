    var h = s.h ? '<div style="font-size:15px;font-weight:700;margin:18px 0 6px;padding-left:10px;border-left:4px solid ' + (/நடவடிக்கை/.test(s.h) ? '#c5221f' : /நன்றாக/.test(s.h) ? '#188038' : /சரியாக நடக்காதவை/.test(s.h) ? '#e37400' : '#127c8c') + ';">' + e(s.h) + '</div>' : '';
    var p = (s.p || []).map(function (x) { return '<p style="font-size:14px;line-height:1.65;margin:0 0 10px;">' + e(x) + '</p>'; }).join('');
    var ul = s.list ? '<ul style="font-size:14px;line-height:1.6;margin:4px 0 8px;padding-left:20px;">' + s.list.map(function (x) { return '<li style="margin:2px 0;">' + e(x) + '</li>'; }).join('') + '</ul>' : '';
    var ol = s.ol ? '<ol style="font-size:14px;line-height:1.6;margin:4px 0 8px;padding-left:22px;">' + s.ol.map(function (x) { return '<li style="margin:2px 0;">' + e(x) + '</li>'; }).join('') + '</ol>' : '';
    return h + p + ul + ol;
  }).join('') + '<p style="font-size:14px;line-height:1.6;margin:18px 0 0;">நன்றி,<br>APS தொழில்நுட்ப உதவிக் குழு<br>ஔவையார் பாடசாலை</p>';

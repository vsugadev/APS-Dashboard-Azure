/** Archive audit/log rows older than the retention window. A backup runs first. Returns a summary. */
function apsAuditArchive_(actor, opts) {
  opts = opts || {};
  var lock = LockService.getScriptLock();
  if (!lock.tryLock(20000)) throw new Error('Another maintenance run is in progress. Try again in a few minutes.');
  try {
    var days = apsAuditRetentionDays_();
    var cutoff = Date.now() - days * 86400000;
    var plan = apsAuditArchivePlan_(cutoff);
    var todo = plan.filter(function (p) { return p.old > 0; });
    var summary = { retentionDays: days, cutoff: Utilities.formatDate(new Date(cutoff), APS_TZ, 'MM/dd/yyyy'), sheets: [], moved: 0, backup: null, errors: [] };
    if (!todo.length) { summary.sheets = plan.map(apsPlanPublic_); return summary; }
    if (!opts.skipBackup) {
      summary.backup = apsSystemBackup_('before audit archive', actor);
      if (summary.backup.errors.length && !summary.backup.files.length) throw new Error('Backup failed — nothing was archived. ' + summary.backup.errors.join('; '));
    }
    var arch = apsArchiveSpreadsheet_();
    todo.forEach(function (p) {
      try {
        var tabName = (p.workbook + ' · ' + p.sheet).slice(0, 99);
        var tab = arch.getSheetByName(tabName);
        if (!tab) { tab = arch.insertSheet(tabName); tab.getRange(1, 1, 1, p._header.length + 1).setValues([p._header.concat(['Archived At'])]).setFontWeight('bold'); tab.setFrozenRows(1); }
        var stamp = Utilities.formatDate(new Date(), APS_TZ, 'MM/dd/yyyy HH:mm');
        var out = p._oldIdx.map(function (i) { return p._rows[i].concat([stamp]); });
        var width = p._header.length + 1;
        out = out.map(function (r) { while (r.length < width) r.push(''); return r.slice(0, width); });
        var start = tab.getLastRow() + 1;
        tab.getRange(start, 1, out.length, width).setValues(out);
        SpreadsheetApp.flush();
        if (tab.getLastRow() < start + out.length - 1) throw new Error('archive write could not be verified');
        // Remove from the live sheet. Old rows are normally a single block at the top (logs append at the bottom):
        // delete that block directly, which is safe while new rows are being appended.
        var contiguous = p._oldIdx.every(function (v, k) { return v === k; });
        if (contiguous) {
          p._sh.deleteRows(2, p._oldIdx.length);
        } else {
          var oldSet = {}; p._oldIdx.forEach(function (i) { oldSet[i] = true; });
          for (var k = p._oldIdx.length - 1; k >= 0; k--) p._sh.deleteRow(p._oldIdx[k] + 2); // bottom-up keeps indexes valid
        }
        summary.moved += out.length;
        summary.sheets.push({ workbook: p.workbook, sheet: p.sheet, moved: out.length, kept: p.rows - out.length, archiveTab: tabName });
      } catch (e) { summary.errors.push(p.workbook + ' / ' + p.sheet + ': ' + (e && e.message)); }
    });
    summary.archiveUrl = arch.getUrl();
    console.log('[Maintenance] archive: moved ' + summary.moved + ' rows (> ' + days + ' days) | errors ' + summary.errors.length);
    return summary;
  } finally { lock.releaseLock(); }
}
function apsPlanPublic_(p) { return { workbook: p.workbook, sheet: p.sheet, rows: p.rows, old: p.old, dateColumn: p.dateColumn || '', skipped: p.skipped || '' }; }
function apsMaintenanceRecord_(kind, result, actor) {
  try {
    var props = PropertiesService.getScriptProperties();
    var last = {}; try { last = JSON.parse(props.getProperty(APS_MAINT_LOG_PROP_) || '{}') || {}; } catch (e) { last = {}; }
    last[kind] = { at: new Date().toISOString(), by: actor || 'weekly trigger', ok: !(result && result.errors && result.errors.length),
      detail: kind === 'cleanup' ? { removed: result.removedCount, freedKb: result.freedKb, errors: (result.errors || []).slice(0, 5) } // r118
        : kind === 'backup' ? { name: result.name, url: result.folderUrl, files: result.files.length, errors: result.errors.slice(0, 5) }
        : { moved: result.moved, cutoff: result.cutoff, url: result.archiveUrl || '', errors: (result.errors || []).slice(0, 5) } };
    props.setProperty(APS_MAINT_LOG_PROP_, JSON.stringify(last));

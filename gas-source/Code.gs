var CLASS_MEET_DETECTED_SHEET_ = 'Course_Meet_Link_Detected';
var CLASS_MEET_DETECTED_HEADER_ = ['Course ID', 'Course Name', 'Meet Code', 'Source', 'Class Date', 'Detected At'];
var CLASS_MEET_CACHE_KEY_ = 'aps_class_meet_links_v2';

/** "abcdefghij" / "abc-defg-hij" / a meet.google.com URL -> "https://meet.google.com/abc-defg-hij"; '' if not a standard code. */
function classMeetUrl_(codeOrUrl) {
  var c = attNormalizeMeetCode_(codeOrUrl);

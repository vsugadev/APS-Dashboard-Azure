var WJ_OFF_PROP_ = 'APS_WEEKLY_JOBS_OFF';
function wjOff_() { var o = {}; try { (JSON.parse(PropertiesService.getScriptProperties().getProperty(WJ_OFF_PROP_) || '[]') || []).forEach(function (id) { o[id] = true; }); } catch (e) { o = {}; } return o; }

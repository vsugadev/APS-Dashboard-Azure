/* ------------------------------- create ------------------------------- */
function createTicket(sessionToken, input) {
  apsRequireTabForToken_(sessionToken, 'tickets.self'); // r56: Admin Control → Access Control
  var v = tkViewer_(sessionToken);
  if (tkReadOnly_(v)) throw new Error('Your role is read-only and cannot create tickets.');
  input = input || {};
  var cfg = tkConfig_();
  var type = String(input.type || '').toUpperCase().trim();
  if (TK_TYPES_.indexOf(type) < 0 || cfg.enabledTypes.indexOf(type) < 0) throw new Error('Please choose a valid ticket type.');
  var subject = String(input.subject || '').trim(), desc = String(input.description || '').trim();
  if (subject.length < 3 || subject.length > 150) throw new Error('Subject must be 3–150 characters.');
  if (desc.length < 5 || desc.length > 5000) throw new Error('Description must be 5–5000 characters.');
  // Priority: Admin may pick any; everyone else LOW / NORMAL / HIGH (URGENT is set by Admin). Default from settings.
  var reqP = String(input.priority || '').toUpperCase(), allowedP = tkIsAdmin_(v) ? TK_PRIORITIES_ : ['LOW', 'NORMAL', 'HIGH'];
  var priority = allowedP.indexOf(reqP) > -1 ? reqP : cfg.defaultPriority;
  var requestId = String(input.requestId || '').replace(/[^a-zA-Z0-9-]/g, '').slice(0, 64);
  var cache = CacheService.getScriptCache();
  if (requestId) { var prev = cache.get('aps_tk_req_' + requestId); if (prev) return { duplicate: true, ticketNumber: prev, ticketId: (cache.get('aps_tk_reqid_' + requestId) || '') }; }
  var courses = readAllCoursesFromCache_();
  var resolved = null;
  var needsStudent = TK_CHAIN_TYPES_.indexOf(type) > -1;
  var studentEmail = v.role === 'student' ? v.email : input.studentEmail;
  if (studentEmail || needsStudent) {
    if (!studentEmail) throw new Error('Please select the student for a ' + type + ' ticket.');
    resolved = tkResolveStudent_(v, courses, studentEmail, input.courseId); // re-resolved here — never trusted from the browser
  }
  var attachments = tkSaveAttachments_(input.attachments, v);
  var requesterName = tkNameFor_(v.email, courses);
  var actor = { email: v.email, name: requesterName };
  return tkLocked_(function () {
    if (requestId) { var again = cache.get('aps_tk_req_' + requestId); if (again) return { duplicate: true, ticketNumber: again }; }
    var tickets = tkRead_('tickets');
    // Duplicate guard: same requester + type + subject (+ student) within 2 minutes.
    var dup = tickets.filter(function (x) { return x.Requester_Email === v.email && x.Type === type && x.Subject === subject && x.Student_Email === (resolved ? resolved.student.email : '') && (Date.now() - new Date(x.Created_At).getTime()) < 120000; })[0];
    if (dup) return { duplicate: true, ticketNumber: dup.Ticket_Number, ticketId: dup.Ticket_ID };
    var day = Utilities.formatDate(new Date(), APS_TZ, 'yyyyMMdd'), prefix = 'APS-' + day + '-', max = 0;
    tickets.forEach(function (x) { if (x.Ticket_Number.indexOf(prefix) === 0) max = Math.max(max, Number(x.Ticket_Number.slice(prefix.length)) || 0); });
    var number = prefix + String(max + 1).padStart(4, '0');
    var asg = tkAssignmentFor_(type, resolved, cfg);
    var now = tkNowIso_();
    var join = function (list, key) { return (list || []).map(function (p) { return p[key]; }).join('; '); };
    var t = { Ticket_ID: tkId_('T'), Ticket_Number: number, Type: type, Subject: subject, Description: desc, Requester_Name: requesterName, Requester_Email: v.email, Requester_Role: v.role,
      Created_By: v.email, Student_Name: resolved ? resolved.student.name : '', APSID: resolved ? resolved.student.apsId : '', Student_Email: resolved ? resolved.student.email : '',
      Course_ID: resolved ? resolved.courseId : '', Classroom: resolved ? resolved.classroom : '',
      Primary_Teacher: resolved ? join(resolved.primaryTeacher, 'name') : '', Primary_Teacher_Email: resolved ? join(resolved.primaryTeacher, 'email') : '',
      Headmaster: resolved ? join(resolved.headmaster, 'name') : '', Headmaster_Email: resolved ? join(resolved.headmaster, 'email') : '',
      VP: resolved ? join(resolved.vp, 'name') : '', VP_Email: resolved ? join(resolved.vp, 'email') : '',
      Priority: priority, Status: asg.assignees.length ? 'ASSIGNED' : 'NEW', Assigned_To: asg.assignees.map(function (a) { return a.email; }).join('; '),
      Assignment_Flags: asg.flags.join(' | '), Created_At: now, Updated_At: now, Resolved_At: '', Closed_At: '', Last_Activity_By: v.email, Reply_Count: '0', Request_ID: requestId };
    tkAppend_('tickets', [t]);
    var parts = [{ Ticket_ID: t.Ticket_ID, Ticket_Number: number, Email: v.email, Name: requesterName, Role: 'REQUESTER', Participant_Type: 'PARTICIPANT', Active: 'TRUE', Added_By: 'system', Added_At: now }];
    asg.assignees.forEach(function (a) { if (a.email === v.email) parts[0].Participant_Type = 'ASSIGNEE'; else parts.push({ Ticket_ID: t.Ticket_ID, Ticket_Number: number, Email: a.email, Name: a.name, Role: a.role, Participant_Type: 'ASSIGNEE', Active: 'TRUE', Added_By: 'auto-rule', Added_At: now }); });
    tkAppend_('participants', parts);
    tkAppend_('messages', [{ Message_ID: tkId_('M'), Ticket_ID: t.Ticket_ID, Ticket_Number: number, Author_Name: requesterName, Author_Email: v.email, Author_Role: v.role, Message_Type: 'PUBLIC', Message: desc, Created_At: now, Attachments: JSON.stringify(attachments) }]);
    tkAudit_(t, 'CREATE', '', { type: type, priority: priority, student: t.Student_Email, classroom: t.Classroom }, actor, '');
    if (asg.assignees.length) tkAudit_(t, 'ASSIGN', '', t.Assigned_To, { email: 'auto-rule', name: 'Automatic assignment (' + type + ')' }, asg.flags.join(' | '));
    if (asg.flags.length) tkAudit_(t, 'ASSIGNMENT_FLAG', '', asg.flags.join(' | '), { email: 'auto-rule', name: 'Automatic assignment' }, 'Admin intervention may be needed');
    if (requestId) { cache.put('aps_tk_req_' + requestId, number, 600); cache.put('aps_tk_reqid_' + requestId, t.Ticket_ID, 600); }
    var mail = tkNotify_('CREATED', t, parts, { actor: actor, message: desc, recipients: parts.map(function (p) { return p.Email; }) });
    return { ok: true, ticketNumber: number, ticketId: t.Ticket_ID, status: t.Status, assignees: asg.assignees, flags: asg.flags, email: mail };
  });
}

/* ------------------------------- attachments ------------------------------- */
function tkAttachFolder_() {
  var props = PropertiesService.getScriptProperties(), id = props.getProperty('APS_TICKET_ATTACH_FOLDER_ID');
  if (id) { try { return DriveApp.getFolderById(id); } catch (e) { /* recreate */ } }
  var f = DriveApp.createFolder('APS Ticket Attachments - PRIVATE (' + getDashboardEnvironment_().key + ') - do not share');
  props.setProperty('APS_TICKET_ATTACH_FOLDER_ID', f.getId());

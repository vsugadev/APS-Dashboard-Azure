/**
 * APS Tamil Virtual School - Google Classroom Dashboard
 * ------------------------------------------------------
 * Data flow (rewritten to avoid Classroom API quota errors):
 *   1. syncClassroomData() runs on a time-driven trigger every N minutes.
 *      It pulls courses/teachers/students from the Classroom API (with
 *      retry/backoff + throttling) and writes results into a Sheet.
 *   2. getDashboardData() — called every time the dashboard loads or you
 *      click Refresh — reads ONLY from that Sheet. It never calls the
 *      Classroom API directly, so page loads can't trigger quota errors.
 *   3. A manual "Force Sync Now" button on the dashboard calls
 *      syncClassroomData() on demand if you don't want to wait for the timer.
 */

// ===========================================================================
// Sept 2026, fifty-fourth round: SCRIPT-PROPERTIES-BACKED CONFIGURATION.
// ---------------------------------------------------------------------------
// Apps Script has no separate "environment variables" mechanism, but Script
// Properties (Apps Script editor > Project Settings > Script Properties) is
// the direct equivalent: values stored there live ONLY inside this script
// project — never in this source file's text — so they are absent from any
// copy of Code.gs that gets exported, pasted elsewhere, or shared (this
// project's local sync folder and Claude Project docs included). Only
// someone with edit access to the actual Apps Script project can view them.
//
// Every credential (OAuth Client ID/Secret), environment-specific resource
// ID (spreadsheet/doc/folder IDs), and staff email roster that used to be a
// literal value in this file is now read through the two helpers below. See
// dashboard-architecture-and-config.md ("Fifty-fourth round") for the full
// list of required Script Property names and how to set them.
//
// Deliberately NEVER throws at load time: a missing property returns
// `fallback` (default '' / []) so one unset value degrades only the
// specific feature that needs it — not the entire script for every viewer,
// including the public sign-in page. The functions that actually DEPEND on
// a value being present (buildGoogleAuthUrl_, exchangeCodeForTokens_,
// getWorkbook_, etc.) each check for an empty result themselves and throw a
// clear, specific setup error at THAT point instead.
// ===========================================================================
function getConfigString_(key, fallback) {
  var value = PropertiesService.getScriptProperties().getProperty(key);
  if (value === null || value === undefined || value === '') {
    console.warn('[Config] Script Property "' + key + '" is not set — using fallback.');
    return fallback !== undefined ? fallback : '';
  }
  return value;
}

/** Same as getConfigString_, but JSON.parses the stored value into an array (Script Properties can only store strings, so list-valued config is stored as JSON array text, e.g. ["a@x.org","b@x.org"]). */
function getConfigList_(key, fallback) {
  var raw = PropertiesService.getScriptProperties().getProperty(key);
  if (raw === null || raw === undefined || raw === '') {
    console.warn('[Config] Script Property "' + key + '" is not set — using fallback.');
    return fallback || [];
  }
  try {
    var parsed = JSON.parse(raw);
    if (!Array.isArray(parsed)) throw new Error('not a JSON array');
    return parsed;
  } catch (e) {
    console.error('[Config] Script Property "' + key + '" is not valid JSON array text (' + e.message + ') — using fallback. Stored value was: ' + raw);
    return fallback || [];
  }
}


/* ======================= CLASS SUPPORT (VP / HM) — ROLE-BASED CLASS ACCESS ======================= */
/**
 * Oct 2026 — APS Classroom role model. The Google Classroom course itself is authoritative; email names/prefixes
 * (tts_, tcs_, hm., vp. …) NEVER decide a role. For every ACTIVE course ending with AY26-27:
 *   COURSE DESCRIPTION  -> every APS email in it          = PRIMARY_TEACHER of that class
 *   ROOM  "VP Email: a ; b | HM Email: c ; d"            = VP (a, b) and HM (c, d) of that class
 * Separators: ';' (primary), ',' and '|'; an email after '|' with no new label stays under the previous label.
 * Emails are trimmed, lower-cased, validated, de-duplicated; only APS sign-in domains (APS_ALLOWED_DOMAINS).
 * Invalid / outside-domain / unlabelled-Room emails are skipped and logged (EMAIL_SKIPPED, once per 6 h).
 * One person may hold several roles in one class (e.g. PRIMARY_TEACHER + HM): ONE record, roles merged.
 *
 * Sync (syncClassroomData -> buildCourseRecord_ -> classSupportForCourse_):
 *   - every named person not yet a Classroom TEACHER is added once (Teachers.create; APS_CLASS_SUPPORT_ADD_TO_CLASSROOM);
 *   - course.classSupport = [{email, roles:[PRIMARY_TEACHER|VP|HM], sources:[COURSE_DESCRIPTION|ROOM], member, added}];
 *   - course.teachers tagged: apsRoles + roleTags ('VP'/'HM' -> card shows "(VP)" "(HM)", never an email);
 *     a named person is shown even when HIDDEN_TEACHER_EMAIL_PREFIXES / the Hide toggle would hide the account;
 *   - Class_Access_Map rebuilt (one row per email + course) and changes written to Class_Access_Audit.
 * Dashboard (userHasCourseAccess_, server-side in every teacher-scoped check):
 *   PRIMARY_TEACHER -> full teacher access to that class;  VP / HM -> teacher access + HM operations on THAT class
 *   (classSupportElevated_). Access needs the Course label AND Classroom TEACHER membership (a failed add grants nothing).
 *   Accounts in ADMIN / HEADMASTER / SUPERADMIN / BOD lists and Dashboard_User_Roles keep their existing org-wide roles.
 * Switch off: APS_CLASS_SUPPORT_ENABLED=false.  Sync never removes anyone from Google Classroom.
 */
var CLASS_ROLE_ORDER_ = ['PRIMARY_TEACHER', 'VP', 'HM'];
var CLASS_ROLE_RANK_ = { TEACHER: 1, PRIMARY_TEACHER: 1, VP: 2, HM: 3, ADMIN: 4 };
var CLASS_ROLE_LABEL_ = { PRIMARY_TEACHER: 'Primary Teacher', TEACHER: 'Teacher', VP: 'VP', HM: 'HM' };
var CLASS_SUPPORT_EMAIL_RE_ = /^[a-z0-9._%+'-]+@[a-z0-9.-]+\.[a-z]{2,}$/;
var CLASS_ACCESS_MAP_SHEET_ = 'Class_Access_Map';
var CLASS_ACCESS_MAP_HEADER_ = ['Key', 'Email', 'APS Roles', 'Primary Role', 'Course ID', 'Course Name', 'Classroom Role', 'Source', 'Dashboard Permission', 'Status', 'First Seen', 'Last Synced'];
var CLASS_ACCESS_AUDIT_SHEET_ = 'Class_Access_Audit';
var CLASS_ACCESS_AUDIT_HEADER_ = ['Timestamp (EST)', 'Execution ID', 'Course ID', 'Course Name', 'Email', 'APS Role', 'Classroom Role', 'Source', 'Action', 'Result', 'Error Message'];
var CLASS_SUPPORT_SYNC_EVENTS_ = []; // audit rows collected during one sync, written once at the end
var CLASS_SUPPORT_EXEC_ID_ = '';

function classSupportEnabled_() { return String(PropertiesService.getScriptProperties().getProperty('APS_CLASS_SUPPORT_ENABLED') || 'true').toLowerCase() !== 'false'; }
function classSupportAddEnabled_() { return String(PropertiesService.getScriptProperties().getProperty('APS_CLASS_SUPPORT_ADD_TO_CLASSROOM') || 'true').toLowerCase() !== 'false'; }
function classSupportExecId_() {
  if (!CLASS_SUPPORT_EXEC_ID_) CLASS_SUPPORT_EXEC_ID_ = 'SYNC-' + Utilities.formatDate(new Date(), APS_TZ, 'yyyyMMdd-HHmmss') + '-' + String(Utilities.getUuid()).slice(0, 6);
  return CLASS_SUPPORT_EXEC_ID_;
}
function classRolesPrimary_(roles) {
  var best = 'TEACHER';
  (roles || []).forEach(function (r) { if (CLASS_ROLE_RANK_[r] > CLASS_ROLE_RANK_[best]) best = r; });
  return best === 'PRIMARY_TEACHER' ? 'TEACHER' : best;
}
function classRolesLabel_(roles) { return (roles && roles.length ? roles : ['TEACHER']).map(function (r) { return CLASS_ROLE_LABEL_[r] || r; }).join(' + '); }

/**
 * Parses one course: Description -> PRIMARY_TEACHER, Room labels -> VP / HM.
 * Returns { entries: [{email, roles, sources}], skipped: [{token, reason, source}] }.
 */
function classSupportParse_(room, description) {
  var out = { entries: [], skipped: [] };
  if (!classSupportEnabled_()) return out;
  var byEmail = {};
  var cand = /[^\s;,|<>()\[\]"]+@[^\s;,|<>()\[\]"]+/g;
  var take = function (raw, role, source) {
    var email = normalizeEmail_(String(raw).replace(/^[.:'`]+|[.:'`]+$/g, ''));
    if (!CLASS_SUPPORT_EMAIL_RE_.test(email)) { out.skipped.push({ token: String(raw).slice(0, 80), reason: 'invalid email format', source: source }); return; }
    if (!isApsEmailAllowed_(email)) { out.skipped.push({ token: email, reason: 'domain not allowed (APS_ALLOWED_DOMAINS)', source: source }); return; }
    var e = byEmail[email] || (byEmail[email] = { email: email, roles: [], sources: [] });
    if (e.roles.indexOf(role) < 0) e.roles.push(role);
    if (e.sources.indexOf(source) < 0) e.sources.push(source);
  };
  (String(description || '').match(cand) || []).forEach(function (raw) { take(raw, 'PRIMARY_TEACHER', 'COURSE_DESCRIPTION'); });
  var text = String(room || '');
  var re = /\b(VP|HM)\s*e-?mails?\s*:/gi, m, marks = [];
  while ((m = re.exec(text)) !== null) marks.push({ role: m[1].toUpperCase(), start: m.index, end: re.lastIndex });
  (text.slice(0, marks.length ? marks[0].start : text.length).match(cand) || []).forEach(function (raw) {
    out.skipped.push({ token: normalizeEmail_(raw).slice(0, 80), reason: 'Room email without a "VP Email:" / "HM Email:" label', source: 'ROOM' });
  });
  marks.forEach(function (mk, i) {
    var seg = text.slice(mk.end, i + 1 < marks.length ? marks[i + 1].start : text.length);
    (seg.match(cand) || []).forEach(function (raw) { take(raw, mk.role, 'ROOM'); });
    seg.split(/[\s;,|]+/).forEach(function (tok) { if (tok && tok.indexOf('@') < 0 && /^[a-z0-9._-]+_aps\d+$/i.test(tok)) out.skipped.push({ token: tok, reason: 'invalid email format (missing @domain)', source: 'ROOM' }); });
  });

  try {
    var cache = CacheService.getScriptCache();
    // Key carries a version: a newly deployed version that adds a trigger (e.g. the Teacher
    // Availability email) checks at once instead of waiting up to 6 h for the old key to expire.
    if (!force && cache.get(APS_TRIGGER_CHECK_KEY_)) return;
    cache.put(APS_TRIGGER_CHECK_KEY_, '1', 21600);
    ctaEnsureTrigger_(); // Weekly Class Teacher Availability email (Tue-Fri 6 PM) — own try/catch
    // r49: remove the legacy every-15-minutes Classroom sync (createSyncTrigger) — Classroom sync is Admin "Force Sync" +

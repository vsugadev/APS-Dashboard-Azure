/**
 * Given whatever is currently stored for ONE person in the lastLoginMap
 * Script Property, returns a normalized { gc, gm, db } object (each an ISO
 * UTC string, or simply absent if that source has never recorded activity
 * for this person). Transparently migrates the OLD single-timestamp shape
 * used by the previous "Last Login" round — { ts, source: 'GS'|'DB' } —
 * so upgrading to this three-source version doesn't crash on already-stored
 * data:
 *   - old source 'DB' is unambiguous, so its timestamp becomes the new `db`.
 *   - old source 'GS' does NOT tell us whether it came from Classroom or
 *     Meet specifically (the previous round intentionally logged both under
 *     one shared label) — per the "never fabricate" requirement this is NOT
 *     guessed into either `gc` or `gm`. It is dropped; that person's GC/GM
 *     columns simply start blank again and will be repopulated with real,
 *     correctly-labeled evidence the next time syncClassroomData() runs.
 * Returns {} for a missing/empty entry.
 */
function normalizeLastLoginEntry_(entry) {
  if (!entry) return {};
  if (entry.ts && entry.source) { // legacy single-source shape
    return entry.source === 'DB' ? { db: entry.ts } : {};
  }
  var out = {};
  if (entry.gc) out.gc = entry.gc;
  if (entry.gm) out.gm = entry.gm;
  if (entry.db) out.db = entry.db;
  return out;
}

/**
 * Merges a batch of { normalizedOrRawEmail: isoTimeString } candidate
 * activity timestamps into the persistent, cross-source "Last Login" record
 * (see LAST_LOGIN_PROP_KEY), under ONE specific source's own slot —
 * sourceKey is 'gc' (Classroom), 'gm' (Meet), or 'db' (Dashboard). Each
 * source's slot keeps only that source's single newest timestamp — an older
 * candidate NEVER overwrites a newer stored value for that same source, and
 * sources never overwrite each other's slot (a Meet timestamp can never end
 * up recorded as Classroom activity or vice versa). This is what implements
 * the "each source maintains its own latest timestamp, independently" rule
 * (section 2/9 of the spec), while applyLastLogin_/summarizeLastLogin_ below
 * separately compute the newest-overall timestamp and the full active-source
 * list for display.
 *
 * Reads and writes the underlying Script Property exactly once per call —
 * not once per candidate — so this stays cheap even when called with a
 * batch of hundreds of entries (e.g. one page of an Activities API
 * response), and wraps the read-modify-write in the same best-effort
 * LockService pattern already used by recordHeartbeat_, to reduce (not
 * eliminate) the chance of a lost update if two sources report in at
 * nearly the same moment.
 */
function mergeLastLoginActivity_(candidates, sourceKey) {
  var emails = candidates ? Object.keys(candidates) : [];
  if (!emails.length) return;

  var lock = LockService.getScriptLock();
  try { lock.tryLock(2000); } catch (e) { /* proceed best-effort even without the lock */ }
  try {
    var raw = apsBigGet_(LAST_LOGIN_PROP_KEY);
    var map = raw ? JSON.parse(raw) : {};
    var changed = false;

    emails.forEach(function (email) {
      var iso = candidates[email];
      var key = normalizeEmail_(email);
      if (!key || !iso) return;
      var t = new Date(iso).getTime();
      if (isNaN(t)) return;

      var rawExisting = map[key];
      var entry = normalizeLastLoginEntry_(rawExisting);
      var entryUpdated = false;
      if (!entry[sourceKey] || t > new Date(entry[sourceKey]).getTime()) {
        entry[sourceKey] = new Date(t).toISOString();
        entryUpdated = true;
      }
      // Persist even a no-op update to this source's timestamp if the stored
      // shape was the legacy one, so it's migrated to the new shape exactly
      // once rather than being re-migrated (and re-JSON.stringified) forever.
      var shapeChanged = JSON.stringify(rawExisting || null) !== JSON.stringify(entry);
      if (entryUpdated || shapeChanged) {
        map[key] = entry;
        changed = true;
      }
    });

    if (changed) apsBigSetSafe_(LAST_LOGIN_PROP_KEY, JSON.stringify(map), 'Last login (' + sourceKey + ')');
  } finally {
    try { lock.releaseLock(); } catch (e) { /* ignore */ }
  }
}

/** ---------------------------------------------------------------------
 *  CLASS STATUS — schedule parsing (Part 10) and the automatic state
 *  machine (Part 11/13/14). See the CLASS_STATUS_* constants above for the
 *  overall design (nothing automatic is persisted; only manual overrides are).
 * ------------------------------------------------------------------- */

/**
 * Parses a single clock-time token (e.g. "11:30", "9:00 PM", "14:00") into
 * { hour (0-23), minute, meridiemExplicit }. `meridiemExplicit` is true only
 * when the result is UNAMBIGUOUS — either an explicit AM/PM was present, or
 * the hour is outside the 1-12 range where AM/PM would have mattered (e.g.
 * "14:00" or "0:00"). A plain "9:00" with no AM/PM is genuinely ambiguous
 * (could be 9 in the morning or at night) and is deliberately NOT guessed —
 * see parseCourseSchedule_'s doc for why. Returns null if the token doesn't
 * even look like a time.
 */
function parseClockTime_(token) {
  if (!token) return null;
  var m = String(token).trim().match(/^(\d{1,2})(?::(\d{2}))?\s*(AM|PM)?$/i);
  if (!m) return null;
  var hour = parseInt(m[1], 10);
  var minute = m[2] ? parseInt(m[2], 10) : 0;
  if (hour > 23 || minute > 59) return null;
  var meridiem = m[3] ? m[3].toUpperCase() : null;
  if (meridiem) {
    if (hour < 1 || hour > 12) return null; // e.g. "13 PM" isn't a valid 12-hour time
    if (hour === 12) hour = 0;
    if (meridiem === 'PM') hour += 12;
    return { hour: hour, minute: minute, meridiemExplicit: true };
  }
  if (hour === 0 || hour >= 13) {
    return { hour: hour, minute: minute, meridiemExplicit: true }; // unambiguous 24-hour-style value
  }
  return { hour: hour, minute: minute, meridiemExplicit: false }; // ambiguous — e.g. plain "9:00"
}

/**
 * Parses the weekly day/start/end schedule embedded in a Classroom course's
 * TITLE text (Part 10), e.g.
 *   "NILAI 99 - SA | TUE 11:30 AM - 12:30 PM EST | AY26-27"
 * Course Name and Section themselves are NOT re-derived here — they already
 * come straight from the Classroom API (course.name / course.section,
 * completely untouched by this function and by this whole Class Status
 * feature). This ONLY extracts the day/start/end/timezone segment, since
 * that's the one piece of scheduling information the Classroom API has no
 * field for, and the course title is this school's only source for it.
 *
 * Looks for a "<DAY> <time> - <time> <TZ?>" pattern, preferring the segment
 * between the first two "|" pipes if present (this school's convention) but
 * falling back to searching the whole title if no pipes are found, so a
 * differently-formatted title doesn't just silently fail to parse.
 *
 * Returns:
 *   - null if no day/time-shaped segment is found at all.
 *   - { dayOfWeek, start: null, end: null, timezoneRaw } if a day/time
 *     segment IS found but either time is missing an unambiguous AM/PM —
 *     deliberately refusing to guess which half of the day was meant (never
 *     fabricate). A course in this state always shows the plain 'Scheduled'
 *     status with no automatic Yet to Start/Started/Completed transitions,
 *     rather than risk transitioning at the wrong wall-clock time.
 *   - { dayOfWeek, start: {hour,minute}, end: {hour,minute}, timezoneRaw }
 *     on a fully-confident parse — timezoneRaw is kept for DISPLAY only; all
 *     actual date/time math always uses LAST_LOGIN_TIMEZONE (America/New_York)
 *     regardless of what abbreviation appears in the title (Part 1 requires
 *     Eastern time for every class-status calculation).
 */
function parseCourseSchedule_(rawName) {
  if (!rawName) return null;
  var scheduleSegment = rawName;
  var parts = String(rawName).split('|');
  if (parts.length >= 2) scheduleSegment = parts[1];

  var m = scheduleSegment.match(/\b([A-Za-z]{3,9})\s+(\d{1,2}(?::\d{2})?\s*(?:AM|PM)?)\s*-\s*(\d{1,2}(?::\d{2})?\s*(?:AM|PM)?)\s*([A-Za-z]{2,5})?\b/i);
  if (!m && scheduleSegment !== rawName) {
    // The pipe-delimited segment didn't parse — try the whole title as a fallback.
    m = String(rawName).match(/\b([A-Za-z]{3,9})\s+(\d{1,2}(?::\d{2})?\s*(?:AM|PM)?)\s*-\s*(\d{1,2}(?::\d{2})?\s*(?:AM|PM)?)\s*([A-Za-z]{2,5})?\b/i);
  }
  if (!m) return null;

  var dayToken = m[1].toUpperCase();
  if (!CLASS_SCHEDULE_DAY_TOKENS.hasOwnProperty(dayToken)) return null;
  var dayOfWeek = CLASS_SCHEDULE_DAY_TOKENS[dayToken];
  var timezoneRaw = (m[4] || '').toUpperCase();

  var start = parseClockTime_(m[2]);
  var end = parseClockTime_(m[3]);
  if (!start || !end) {
    return { dayOfWeek: dayOfWeek, start: null, end: null, timezoneRaw: timezoneRaw };
  }

  // Common title style: only ONE side of the range spells out AM/PM, e.g.
  // "FRI 6:30 - 8:00 PM EST" (only the end says PM) or "FRI 9:00 AM - 12:00
  // EST" (only the start says AM). The other side is still unambiguous in
  // practice — a real class has a short, positive duration, and only one of
  // the two AM/PM readings of the missing side keeps the range that way — so
  // this is resolved rather than guessed. Only when BOTH sides omit AM/PM
  // (fully ambiguous, e.g. "FRI 9:00 - 10:00") is it left unresolved.
  if (!start.meridiemExplicit && !end.meridiemExplicit) {
    return { dayOfWeek: dayOfWeek, start: null, end: null, timezoneRaw: timezoneRaw };
  }
  if (!start.meridiemExplicit) {
    var inferredStart = inferMissingMeridiem_(start.hour, start.minute, end.hour * 60 + end.minute, true);
    if (!inferredStart) return { dayOfWeek: dayOfWeek, start: null, end: null, timezoneRaw: timezoneRaw };
    start = inferredStart;
  } else if (!end.meridiemExplicit) {
    var inferredEnd = inferMissingMeridiem_(end.hour, end.minute, start.hour * 60 + start.minute, false);
    if (!inferredEnd) return { dayOfWeek: dayOfWeek, start: null, end: null, timezoneRaw: timezoneRaw };
    end = inferredEnd;
  }

  return {
    dayOfWeek: dayOfWeek,
    start: { hour: start.hour, minute: start.minute },
    end: { hour: end.hour, minute: end.minute },
    timezoneRaw: timezoneRaw
  };
}

/**
 * Resolves the AM/PM of a clock-time whose meridiem was omitted, given the
 * OTHER side of the range (`anchorMinutes`, already unambiguous, expressed
 * as minutes-since-midnight) and whether the value being resolved is the
 * range's start (`solvingForStart: true`) or end (`false`).
 *
 * Tries both the AM and PM reading of `hour12`/`minute` and keeps only the
 * ones that would make the range run forward in time (start strictly before
 * end). If both readings do, the one that yields the SHORTER class duration
 * wins — e.g. for "6:30 - 8:00 PM", reading 6:30 as PM gives a plausible
 * 1.5-hour class, while reading it as AM would give an implausible
 * 13.5-hour one, so PM is chosen. This mirrors how a person reads these
 * shorthand ranges, without ever fabricating a value neither reading
 * supports. Returns null only when NEITHER reading produces a forward-
 * running range (i.e. still genuinely ambiguous).
 */
function inferMissingMeridiem_(hour12, minute, anchorMinutes, solvingForStart) {
  var amHour = (hour12 === 12) ? 0 : hour12;
  var pmHour = (hour12 === 12) ? 12 : hour12 + 12;
  var amMinutes = amHour * 60 + minute;
  var pmMinutes = pmHour * 60 + minute;

  var amDuration = solvingForStart ? (anchorMinutes - amMinutes) : (amMinutes - anchorMinutes);
  var pmDuration = solvingForStart ? (anchorMinutes - pmMinutes) : (pmMinutes - anchorMinutes);
  var amOk = amDuration > 0;
  var pmOk = pmDuration > 0;

  if (!amOk && !pmOk) return null;
  var usePm = amOk && pmOk ? (pmDuration < amDuration) : pmOk;
  return { hour: usePm ? pmHour : amHour, minute: minute, meridiemExplicit: true };
}

// -------------------------------------------------------------------------
// ROUND 37 --- Classes tab: Nilai + Class Time dropdown filters
// -------------------------------------------------------------------------
// Both filters need an EXACT dropdown value per course ("NILAI 8",
// "FRI 9:00 - 10:30 PM EST", etc.), not a free-text field. There is no
// existing structured source for either: course.section is this school's
// free-text field for other things now (e.g. an HM contact line --- see the
// "Display Google Classroom Section values" round in the architecture doc),
// and parseCourseSchedule_() above returns parsed hour/minute components for
// Class Status math, not a ready-made display string safe to exact-match
// against. So, same as parseCourseSchedule_(), this reads directly from the
// course's Google Classroom NAME text (the one place this school's
// day/time/grade convention actually lives), completely independently ---
// neither function calls the other, and neither one's behavior changes.

/** Exact Nilai dropdown values, in the required display order (index 0 = "All", never matched against a course). */
var NILAI_FILTER_OPTIONS = ['All', 'MUNMAZHALAI', 'MAZHALAI', 'NILAI 1', 'NILAI 2', 'NILAI 3', 'NILAI 4', 'NILAI 5', 'NILAI 6', 'NILAI 7', 'NILAI 8', 'THULIR(துளிர்)'];

/** Exact Class Time dropdown values, in the required display order (index 0 = "All", never matched against a course). */
var CLASS_TIME_FILTER_OPTIONS = ['All', 'FRI 6:30 - 8:00 PM EST', 'FRI 7:30 - 9:00 PM EST', 'FRI 9:00 - 10:30 PM EST', 'SAT 12:00 - 1:30 PM EST', 'SUN 7:30 - 9:00 PM EST'];

/**
 * Derives a course's exact Nilai dropdown value from its Classroom Name,
 * e.g. "NILAI - 8 - XX | FRI 9:00 - 10:30 PM EST | AY26-27" -> "NILAI 8", or
 * "MUN MAZHALAI - XX | SAT 12:00 - 1:30 PM EST | AY26-27" -> "MUNMAZHALAI".
 * Returns '' if nothing recognizable is found --- that course simply never
 * matches a specific Nilai filter (it still shows under "All").
 *
 * Exact-match safety (Part 37, explicitly required):
 *   - "NILAI 1" cannot match "NILAI 10": the digit group is captured with a
 *     trailing (?!\d) so a longer number never gets truncated into a match.
 *   - "MAZHALAI" cannot match "MUNMAZHALAI": the MUNMAZHALAI check runs
 *     FIRST and returns immediately, before the plain MAZHALAI substring
 *     check (which "MUNMAZHALAI" would otherwise also satisfy) ever runs.
 *   - THULIR is recognized from either its English or Tamil spelling.
 */
function extractNilaiFromCourseName_(rawName) {
  var segment = String(rawName || '').split('|')[0]; // the grade token always precedes the first "|", same convention parseCourseSchedule_() relies on
  if (segment.indexOf('துளிர்') !== -1) return 'THULIR(துளிர்)';
  // Collapse whitespace/punctuation so "MUN MAZHALAI" and "MUNMAZHALAI" compare equal, per "normalize whitespace only when necessary".
  var compact = segment.toUpperCase().replace(/[^A-Z0-9]+/g, '');
  if (!compact) return '';
  if (compact.indexOf('MUNMAZHALAI') !== -1) return 'MUNMAZHALAI';
  if (compact.indexOf('MAZHALAI') !== -1) return 'MAZHALAI';
  if (compact.indexOf('THULIR') !== -1) return 'THULIR(துளிர்)';
  var m = compact.match(/NILAI(\d+)(?!\d)/);
  if (m && NILAI_FILTER_OPTIONS.indexOf('NILAI ' + m[1]) !== -1) return 'NILAI ' + m[1];
  return '';
}

/** Normalizes dash characters and spacing only --- never the letters/digits --- so "FRI  6:30-8:00 PM EST" and "FRI 6:30 - 8:00 PM EST" compare equal. */
function normalizeClassTimeText_(raw) {
  return String(raw || '')
    .replace(/[‒–—−]/g, '-')
    .replace(/\s+/g, ' ')
    .replace(/\s*-\s*/g, ' - ')
    .trim()
    .toUpperCase();
}

/**
 * Derives a course's exact Class Time dropdown value from its Classroom
 * Name, by checking whether one of the five exact CLASS_TIME_FILTER_OPTIONS
 * strings (whitespace/dash-normalized) appears verbatim in the segment
 * between the first two "|" characters (same segment parseCourseSchedule_()
 * parses), falling back to the whole name if there's no second "|". Because
 * the WHOLE day+start+end+meridiem+timezone string must match exactly, this
 * cannot confuse "FRI 6:30 - 8:00 PM EST" with "FRI 7:30 - 9:00 PM EST" or
 * any other similar-looking time --- there is no partial-match path.
 * Returns '' if none of the five exact strings is present.
 */
function extractClassTimeFromCourseName_(rawName) {
  var raw = String(rawName || '');
  var parts = raw.split('|');
  var candidates = parts.length >= 2 ? [parts[1], raw] : [raw];
  for (var i = 0; i < candidates.length; i++) {
    var normalizedCandidate = normalizeClassTimeText_(candidates[i]);
    for (var j = 1; j < CLASS_TIME_FILTER_OPTIONS.length; j++) { // j starts at 1 to skip "All"
      if (normalizedCandidate.indexOf(normalizeClassTimeText_(CLASS_TIME_FILTER_OPTIONS[j])) !== -1) return CLASS_TIME_FILTER_OPTIONS[j];
    }
  }
  return '';
}

/** Attaches course.nilai / course.classTime (Part 37) to every course --- a request-time display decoration, same pattern as applyClassStatus_/applyLastLogin_ etc., reading only course.name (never mutated) and never calling Classroom or any other API. */
function applyNilaiAndClassTimeFilters_(courses) {
  (courses || []).forEach(function (course) {
    course.nilai = extractNilaiFromCourseName_(course.name);
    course.classTime = extractClassTimeFromCourseName_(course.name);
  });
}

/** Eastern-time day-of-week for `date`, as 0=Sunday...6=Saturday (matches CLASS_SCHEDULE_DAY_TOKENS). */
function easternDayOfWeek_(date) {
  // Java SimpleDateFormat pattern 'u': ISO day-of-week, 1=Monday...7=Sunday.
  var u = Number(Utilities.formatDate(date, LAST_LOGIN_TIMEZONE, 'u'));
  return u === 7 ? 0 : u;
}

/**
 * Builds the real UTC Date instant corresponding to `hour:minute` Eastern
 * wall-clock time on the given Eastern calendar date (yyyy-MM-dd), DST-aware.
 * Works by asking "what UTC offset is America/New_York observing on this
 * date" (via noon UTC that day — safely away from any DST-transition edge
 * that could fall near local midnight) and then applying that offset to the
 * requested wall-clock time. This is the one piece of real date ARITHMETIC
 * this feature needs (formatLastLoginTimestamp_ elsewhere only ever
 * *formats* an already-known instant — it doesn't need to construct one).
 */
function easternWallTimeToDate_(yyyyMmDd, hour, minute) {
  var noonUtc = new Date(yyyyMmDd + 'T12:00:00Z');
  var offset = Utilities.formatDate(noonUtc, LAST_LOGIN_TIMEZONE, 'XXX'); // e.g. "-04:00" / "-05:00"
  var hh = ('0' + hour).slice(-2);
  var mm = ('0' + minute).slice(-2);
  return new Date(yyyyMmDd + 'T' + hh + ':' + mm + ':00' + offset);
}

/**
 * Computes the AUTOMATIC Class Status (Part 11) for one course — never
 * called at all if a manual override (Cancelled/Rescheduled) is on file for
 * that course (see applyClassStatus_, which checks that first). Pure/
 * stateless with respect to its own inputs (the "don't flicker back to Yet
 * to Start" persistence is handled by the caller, applyClassStatus_, via
 * CLASS_STARTED_MARK_PROP_KEY) — safe to call every poll (Part 26).
 *
 * `schedule` is parseCourseSchedule_()'s result (or null); `now` is a Date;
 * `anyoneInMeet` is true if any teacher OR student in this course is
 * currently detected in a Meet call (Part 11: "student OR teacher").
 *
 * Returns { code, scheduledStartIso }. `code` is 'scheduled' whenever the
 * schedule can't be confidently parsed, OR today (Eastern) isn't the
 * scheduled weekday — see the design note in applyClassStatus_'s own doc
 * comment for why "not today" deliberately reads as 'scheduled' rather than
 * carrying over last week's 'completed' state for six more days.
 * `scheduledStartIso` is null unless today IS the scheduled weekday with a
 * confidently-parsed time (i.e. only when a real completion deadline
 * actually exists to compute against).
 */
function computeAutomaticClassStatus_(schedule, now, anyoneInMeet) {
  if (!schedule || !schedule.start || !schedule.end) {
    return { code: 'scheduled', scheduledStartIso: null };
  }
  if (easternDayOfWeek_(now) !== schedule.dayOfWeek) {
    return { code: 'scheduled', scheduledStartIso: null };
  }

  var todayStr = Utilities.formatDate(now, LAST_LOGIN_TIMEZONE, 'yyyy-MM-dd');
  var startDate = easternWallTimeToDate_(todayStr, schedule.start.hour, schedule.start.minute);
  var completionDate = new Date(startDate.getTime() + CLASS_STATUS_COMPLETION_MINUTES * 60000);

  if (now.getTime() < startDate.getTime()) {
    return { code: 'scheduled', scheduledStartIso: startDate.toISOString() };
  }
  if (now.getTime() >= completionDate.getTime()) {
    return { code: 'completed', scheduledStartIso: startDate.toISOString() };
  }
  return { code: anyoneInMeet ? 'started' : 'yet_to_start', scheduledStartIso: startDate.toISOString() };
}

/** Returns the persistent MANUAL Class Status override map: { courseId: { status, updatedAt, updatedBy } }. */
function getClassStatusOverrideMap_() {
  var raw = PropertiesService.getScriptProperties().getProperty(CLASS_STATUS_PROP_KEY);
  return raw ? JSON.parse(raw) : {};
}

/**
 * Computes and stamps Class Status onto every course (mutates `courses` in
 * place) — a step in getDashboardData(), run fresh on every load/poll,
 * exactly like applyLivePresence_/applyWhatsAppLinks_ above it. Nothing
 * about the automatic Scheduled/Yet to Start/Class Started/Class Completed
 * cycle is ever written to storage; only two small, idempotent things are:
 *   1. A manual Cancel/Reschedule override (via setClassStatusManual —
 *      CLASS_STATUS_PROP_KEY), which — per Part 13 — is checked FIRST and,
 *      if present, is used as-is with automatic computation skipped
 *      entirely, so nothing here can ever revert or downgrade it.
 *   2. The "seen as started" marker (CLASS_STARTED_MARK_PROP_KEY), which
 *      only prevents a brief Meet disconnect from flickering "Class
 *      Started" back to "Yet to Start" before the 90-minute completion
 *      mark — see its own doc comment above.
 *
 * DESIGN NOTE on weekly recurrence (flagged since the spec given didn't
 * explicitly cover this): each course's schedule is a WEEKLY recurring
 * day/time, so "Class Completed" needs to eventually give way to next
 * week's "Scheduled" state. This implementation does that by only ever
 * running the Yet to Start -> Started -> Completed cycle on the actual
 * scheduled weekday itself (Eastern calendar date); every other day of the
 * week reads as plain "Scheduled" (anticipating the next occurrence). This
 * means "Class Completed" is visible for the REST of the scheduled day (in
 * Eastern time) and then reverts to "Scheduled" the moment the Eastern
 * calendar date rolls over — a reasoned default, not a literal requirement
 * from the spec, so flag it for confirmation if different behavior (e.g.
 * "Completed" persisting until manually cleared) is actually wanted.
 *
 * Adds to each course: classStatus (internal code), classStatusLabel (exact
 * display string, Part 14), classStatusColorCategory (Part 16),
 * classStatusManual (bool), classStatusUpdatedAt/By (manual overrides only),
 * classSchedule (parsed {dayOfWeek,start,end,timezoneRaw} or null), and
 * scheduledStartDisplay (Eastern "MM/DD HH:mm", or '' if not applicable
 * today / unparseable).
 */
function applyClassStatus_(courses) {
  var overrideMap = getClassStatusOverrideMap_();
  var props = PropertiesService.getScriptProperties();
  var startedMarkRaw = props.getProperty(CLASS_STARTED_MARK_PROP_KEY);
  var startedMark = startedMarkRaw ? JSON.parse(startedMarkRaw) : {};
  var startedMarkChanged = false;
  var now = new Date();
  // r35 — live Google Meet status for today's classes (see LIVE CLASS MEET STATUS). Never throws.
  var liveCache = null, liveSnapshot = { at: 0, byCourse: {} }, endedMark = {};
  try {
    liveCache = CacheService.getScriptCache();
    liveSnapshot = classMeetLiveSnapshot_(courses, now, false);
    endedMark = JSON.parse(props.getProperty(CLASS_MEET_ENDED_PROP_KEY) || '{}');
  } catch (eLive) { console.warn('[Class Meet Live] ' + (eLive && eLive.message)); liveCache = null; }

  courses.forEach(function (c) {
    var schedule = parseCourseSchedule_(c.name);
    c.classSchedule = schedule ? { dayOfWeek: schedule.dayOfWeek, start: schedule.start, end: schedule.end, timezoneRaw: schedule.timezoneRaw } : null;

    var override = overrideMap[c.id];
    if (override && (override.status === 'cancelled' || override.status === 'rescheduled')) {
      c.classStatus = override.status;
      c.classStatusManual = true;
      c.classStatusUpdatedAt = override.updatedAt || null;
      c.classStatusUpdatedBy = override.updatedBy || null;
      c.scheduledStartDisplay = '';
      c.classStatusLabel = CLASS_STATUS_LABELS[override.status];
      c.classStatusColorCategory = CLASS_STATUS_COLOR_CATEGORY[override.status];
      return;
    }

    var anyoneInMeet = (c.teachers || []).some(function (t) { return t.inMeet; }) ||
      (c.students || []).some(function (s) { return s.inMeet; });
    var result = computeAutomaticClassStatus_(schedule, now, anyoneInMeet);
    c.classMeetDetail = null;
    if (liveCache && result.scheduledStartIso) {
      // Today's occurrence: the class-specific live Meet signals replace the old per-email,
      // sync-time "anyone was in some Meet" guess (which is what kept running classes on Scheduled).
      var live = null;
      try { live = classMeetApplyLive_(c, schedule, now, liveSnapshot, liveCache, startedMark, endedMark); } catch (eOne) { live = null; }
      if (startedMark.__changed) { delete startedMark.__changed; startedMarkChanged = true; }
      if (live) {
        c.classStatus = live.code;
        c.classStatusManual = false;
        c.classStatusUpdatedAt = null;
        c.classStatusUpdatedBy = null;
        c.scheduledStartDisplay = formatLastLoginTimestamp_(result.scheduledStartIso);
        c.classStatusLabel = CLASS_STATUS_LABELS[live.code];
        c.classStatusColorCategory = CLASS_STATUS_COLOR_CATEGORY[live.code];
        c.classMeetDetail = live.detail;
        return;
      }
    }

    if (result.scheduledStartIso) {
      if (result.code === 'started') {
        if (startedMark[c.id] !== result.scheduledStartIso) {
          startedMark[c.id] = result.scheduledStartIso;
          startedMarkChanged = true;
        }
      } else if (result.code === 'yet_to_start' && startedMark[c.id] === result.scheduledStartIso) {
        result.code = 'started'; // already seen "started" this occurrence — don't flicker back on a brief Meet disconnect
      }
    } else if (startedMark[c.id]) {
      // No active occurrence today (or unparseable) — nothing to remember anymore.
      delete startedMark[c.id];
      startedMarkChanged = true;
    }

    c.classStatus = result.code;
    c.classStatusManual = false;
    c.classStatusUpdatedAt = null;
    c.classStatusUpdatedBy = null;
    c.scheduledStartDisplay = result.scheduledStartIso ? formatLastLoginTimestamp_(result.scheduledStartIso) : '';
    c.classStatusLabel = CLASS_STATUS_LABELS[result.code];
    c.classStatusColorCategory = CLASS_STATUS_COLOR_CATEGORY[result.code];
  });

  if (startedMarkChanged) {
    props.setProperty(CLASS_STARTED_MARK_PROP_KEY, JSON.stringify(startedMark));
  }
  if (endedMark.__changed) {
    delete endedMark.__changed;
    Object.keys(endedMark).forEach(function (id) { if (Date.now() - new Date(endedMark[id]).getTime() > 86400000) delete endedMark[id]; }); // keep only today's
    try { props.setProperty(CLASS_MEET_ENDED_PROP_KEY, JSON.stringify(endedMark)); } catch (eEnd) { /* best effort */ }
  }
  return courses;
}

/**
 * Manually sets a course's Class Status to Cancelled or Rescheduled (Part
 * 12), or clears an existing manual override back to fully automatic
 * (action 'restore' — an addition beyond the literal spec, so a mistaken
 * Cancel/Reschedule click can be undone without editing Script Properties by
 * hand; flagged here since it wasn't explicitly requested).
 *
 * SERVER-SIDE permission check (Part 27) — never trusts the client: only
 * Admin or Headmaster may call this. Teachers and Students cannot change
 * Class Status; this workflow is reserved for a future project stage.
 */
function setClassStatusManual(sessionToken, courseId, action) {
  if (['cancel', 'reschedule', 'restore'].indexOf(action) === -1) {
    throw new Error('Unknown Class Status action: ' + action);
  }
  var session = requireValidSession_(sessionToken);
  var courses = readAllCoursesFromCache_();
  var course = courses.filter(function (c) { return String(c.id) === String(courseId); })[0];
  if (!course) throw new Error('Could not find that class — try Refresh and try again.');

  var viewer = { email: session.email, role: session.role };
  requireDashboardMutationPermission_(viewer, 'change Class Status');
  var allowed = isAdminOrHm_(viewer.role) || classSupportElevated_(viewer, course); // VP/HM of this class (Class Support)
  if (!allowed) {
    if (viewer.role === 'teacher') classAccessDenied_(viewer, course, 'change Class Status');
    throw new Error('Only an Admin or HM can change Class Status.');
  }

  var props = PropertiesService.getScriptProperties();
  var raw = props.getProperty(CLASS_STATUS_PROP_KEY);
  var map = raw ? JSON.parse(raw) : {};
  var updatedAt = new Date().toISOString();

  if (action === 'restore') {
    delete map[courseId];
  } else {
    map[courseId] = {
      status: action === 'cancel' ? 'cancelled' : 'rescheduled',
      updatedAt: updatedAt,
      updatedBy: viewer.email
    };
  }
  props.setProperty(CLASS_STATUS_PROP_KEY, JSON.stringify(map));

  // Snapshot the manual override into the Sheet's own columns too (for direct
  // CRM/Sheet visibility), mirroring the existing setLiveStatus/
  // setTeacherNotInClassStage row-patch pattern — the AUTOMATIC status
  // fields are deliberately NOT patched here since they're never cached (see
  // applyClassStatus_'s doc comment); only the manual-override snapshot is.
  var sheet = getOrCreateCacheSheet_();
  var data = sheet.getDataRange().getValues();
  for (var i = 1; i < data.length; i++) {
    if (String(data[i][0]) === String(courseId) && data[i][17]) {
      var cached = JSON.parse(data[i][17]);
      cached.classStatusManualRaw = map[courseId] ? map[courseId].status : '';
      cached.classStatusManualUpdatedAt = map[courseId] ? map[courseId].updatedAt : '';
      var rowNum = i + 1;
      sheet.getRange(rowNum, 19).setValue(cached.classStatusManualRaw);        // "Class Status (Manual Override)" column
      sheet.getRange(rowNum, 20).setValue(cached.classStatusManualUpdatedAt); // "Class Status Updated At" column
      sheet.getRange(rowNum, 18).setValue(JSON.stringify(cached));            // "Detail JSON" column
      invalidateCoursesMemo_(); // r49
      break;
    }
  }

  return map[courseId] || { status: 'scheduled' };
}
/**
 * Queries the Admin Reports API for Meet call activity and returns a map of
 * { lowercased_email: isoTimestamp } for ANYONE (teacher or student) with ANY
 * Meet call event (call_started OR call_ended) within the lookback window —
 * i.e. the same "GM" signal already shown in the Last Login badge. This does
 * NOT confirm which specific course meeting they're in — it's "recent Meet
 * activity" as a proxy for "joined this class". Fails silently (returns {})
 * if Reports API isn't available/authorized — e.g. the running account isn't
 * a super admin.
 *
 * (Part 43 — previously `presence` only counted a person whose SINGLE MOST
 * RECENT event was exactly 'call_started', treating a 'call_ended' as the
 * latest-known event as proof they'd left. That was too strict in practice:
 * Google's Admin Reports API can lag in surfacing a person's newest event, so
 * a class with real, ongoing Meet attendance could keep reading only an
 * older 'call_ended' as "latest" and never flip to Started/Live. Any Meet
 * event in the window is now sufficient — matching what the Last Login "GM"
 * badge already displays, and what admins actually look at to judge whether
 * a class has started.)
 *
 * Side effect: also merges each person's single latest Meet event timestamp
 * (call_started OR call_ended) into the persistent cross-source "Last Login"
 * record under the 'gm' (Google Meet) slot — always labeled 'GM', never
 * 'GC' — (see mergeLastLoginActivity_/LAST_LOGIN_PROP_KEY). As of Part 43
 * this is the exact same underlying data as the `presence` map returned
 * below (both come from `lastEventByEmail`), so the Last Login 'GM' badge
 * and the Class Started/Live badges can no longer disagree with each other.
 */
function getMeetPresenceMap_() {
  var lastEventByEmail = {};
  try {
    var startTime = new Date(Date.now() - MEET_ACTIVE_WINDOW_MINUTES * 60000).toISOString();
    var pageToken;
    do {
      var pt = pageToken;
      var resp = callWithBackoff_(function () {
        return AdminReports.Activities.list('all', 'meet', {
          startTime: startTime,
          maxResults: 1000,
          pageToken: pt
        });
      });
      (resp.items || []).forEach(function (item) {
        var email = item.actor && item.actor.email ? item.actor.email.toLowerCase() : '';
        var time = item.id && item.id.time;
        if (!email || !time) return;
        (item.events || []).forEach(function (ev) {
          if (ev.name !== 'call_started' && ev.name !== 'call_ended') return;
          var existing = lastEventByEmail[email];
          if (!existing || new Date(time) > new Date(existing.time)) {
            lastEventByEmail[email] = { type: ev.name, time: time };
          }
        });
      });
      pageToken = resp.nextPageToken;
    } while (pageToken);
  } catch (e) {
    // Part 41 — diagnostics only; this catch's RETURN VALUE and every other
    // behavior below is completely unchanged. Before this, a failure here
    // was totally invisible: the dashboard just showed every class as
    // "not in Meet" (Yet to Start / not Live) with nothing anywhere
    // explaining why — which is exactly the symptom behind the "classes
    // are running in Meet but still show Yet to Start" report. Logged to
    // BOTH the Apps Script Executions log (console.error, visible in
    // Stackdriver on the syncClassroomData run that hit this) AND a Script
    // Property (MEET_PRESENCE_DIAGNOSTIC_KEY — checkable from Project
    // Settings > Script Properties without digging through execution
    // logs), so the NEXT time this happens it can actually be diagnosed
    // (auth/permission error, Reports API not enabled, quota, etc.)
    // instead of guessed at. Never read by any status/Live computation.
    var errMsg = (e && e.message) ? e.message : String(e);
    console.error('getMeetPresenceMap_ failed — every class will show as not-in-Meet (Yet to Start / not Live) until this is fixed: ' + errMsg);
    try {
      PropertiesService.getScriptProperties().setProperty(MEET_PRESENCE_DIAGNOSTIC_KEY, JSON.stringify({ at: new Date().toISOString(), ok: false, error: errMsg }));
    } catch (e2) { /* best-effort diagnostics only — must never break the sync job itself */ }
    return {}; // Reports API unavailable — everyone shows as not-in-Meet, and nothing is merged into Last Login.
  }
  // Part 41 — records that this run's Reports API call succeeded (and how
  // many distinct accounts had ANY recent Meet activity), so "was the last
  // attempt healthy" is always answerable from this one property, not just
  // the failure case above. Diagnostics only — never read by status/Live logic.
  try {
    PropertiesService.getScriptProperties().setProperty(MEET_PRESENCE_DIAGNOSTIC_KEY, JSON.stringify({ at: new Date().toISOString(), ok: true, accountsWithRecentMeetActivity: Object.keys(lastEventByEmail).length }));
  } catch (e3) { /* best-effort diagnostics only */ }

  var presence = {};
  Object.keys(lastEventByEmail).forEach(function (email) {
    // Part 43 — ANY recent Meet event (call_started OR call_ended) within the
    // MEET_ACTIVE_WINDOW_MINUTES lookback now counts as "in Meet" for Class
    // Started / Live, i.e. the exact same "GM" signal already proven correct
    // by the Last Login badge below (which merges this same lastEventByEmail
    // data, any event type, into the 'gm' slot). Previously this required
    // the SINGLE MOST RECENT event for that person to be exactly
    // 'call_started' (an unmatched, presumed-still-ongoing call) — correct
    // in theory, but it meant a real, ongoing class could sit stuck on
    // "Yet to Start" for its entire period whenever Google's Admin Reports
    // API hadn't yet surfaced that person's newest event: the Last Login
    // badge would show a fresh "(GM)" timestamp from minutes into class,
    // while Class Started/Live stayed dark, because the query's *visible*
    // latest event for that person still read as 'call_ended'. Stays bounded
    // to the same MEET_ACTIVE_WINDOW_MINUTES window as before — only the
    // event-type restriction is removed.
    presence[email] = lastEventByEmail[email].time;
  });

  // Feed the persistent Last Login record with each person's single latest
  // Meet activity timestamp (any event type — see the function doc above),
  // into the 'gm' (Google Meet) slot — labeled 'GM'. mergeLastLoginActivity_
  // only ever moves THIS slot's timestamp FORWARD, so this is safe to run on
  // every sync even though the same event may be seen again on the next call
  // within MEET_ACTIVE_WINDOW_MINUTES.
  // Sept 2026, thirty-third round: these Headmaster/Admin/support-staff
  // accounts (ROSTER_HIDDEN_STAFF_EMAILS) join MANY Google Meets purely for
  // oversight, not as a real class attendee — so their GM activity is
  // deliberately EXCLUDED from the persistent Last Login record (it would
  // otherwise make their "Last Login" look like constant, dashboard-wide
  // Meet activity, which isn't meaningful). Their DB (Dashboard) last-login
  // is UNCHANGED and still captured normally by recordHeartbeat_ — this
  // exclusion only ever touches the 'gm' merge, never the 'db' one. The
  // `presence` map returned below (Live-in-Meet auto-detection) is NOT
  // filtered — see applyRosterHiddenStaffFilter_'s doc comment for why.
  var latestMeetByEmail = {};
  Object.keys(lastEventByEmail).forEach(function (email) {
    if (isRosterHiddenStaffEmail_(email)) return;
    latestMeetByEmail[email] = lastEventByEmail[email].time;
  });
  mergeLastLoginActivity_(latestMeetByEmail, 'gm');

  return presence;
}

/**
 * Queries the Admin Reports API's Classroom application audit log for recent
 * activity (a teacher opening/using their Classroom) and returns a map of
 * "lowercased_email|courseId" -> true for every (teacher, course) pair with
 * an event inside the recent window. Because Classroom log events carry the
 * course_id, this pinpoints the EXACT course — unlike Meet-based detection,
 * which can't tell which course a call belongs to.
 * Fails silently (returns {}) if the Classroom audit log isn't available/
 * enabled for this domain, or the running account isn't a super admin.
 *
 * Side effect: also merges each person's single latest Classroom activity
 * timestamp (the most recent across ALL of their courses — this map is keyed
 * "email|courseId", so multiple courses for the same person collapse down to
 * one entry here) into the persistent cross-source "Last Login" record under
 * the 'gc' (Google Classroom) slot — always labeled 'GC', never 'GM' — (see
 * mergeLastLoginActivity_/LAST_LOGIN_PROP_KEY).
 */
function getClassroomActivityMap_() {
  var activity = {}; // "email|courseId" -> true
  try {
    var startTime = new Date(Date.now() - CLASSROOM_ACTIVE_WINDOW_MINUTES * 60000).toISOString();
    var pageToken;
    do {
      var pt = pageToken;
      var resp = callWithBackoff_(function () {
        return AdminReports.Activities.list('all', 'classroom', {
          startTime: startTime,
          maxResults: 1000,
          pageToken: pt
        });
      });
      (resp.items || []).forEach(function (item) {
        var email = item.actor && item.actor.email ? item.actor.email.toLowerCase() : '';
        var time = item.id && item.id.time;
        if (!email || !time) return;
        (item.events || []).forEach(function (ev) {
          var courseId = '';
          (ev.parameters || []).forEach(function (p) {
            if (p.name === COURSE_ID_LOG_PARAM && p.value) courseId = String(p.value);
          });
          if (!courseId) return;
          var key = email + '|' + courseId;
          // Keep the MOST RECENT event time per (email, course) — stored as an
          // ISO string (still truthy) so it can double as a login-time proxy.
          if (!activity[key] || new Date(time) > new Date(activity[key])) {
            activity[key] = time;
          }
        });
      });
      pageToken = resp.nextPageToken;
    } while (pageToken);
  } catch (e) {
    return {}; // Classroom audit log unavailable/unauthorized — nobody shows as "in class" automatically, and nothing is merged into Last Login.
  }

  // Feed the persistent Last Login record with each person's single latest
  // Classroom activity timestamp across all of their courses, into the 'gc'
  // (Google Classroom) slot — labeled 'GC'.
  // Sept 2026, thirty-third round: same GC/GM Last Login exclusion as
  // getMeetPresenceMap_ above, mirrored here for Classroom activity — these
  // Headmaster/Admin/support-staff accounts (ROSTER_HIDDEN_STAFF_EMAILS)
  // open MANY Google Classrooms purely for oversight, so their GC activity
  // is excluded from the persistent Last Login record. Their DB last-login
  // is unaffected. The `activity` map returned below (used for the
  // per-course "in class" badge) is NOT filtered.
  var latestByEmail = {};
  Object.keys(activity).forEach(function (key) {
    var email = key.split('|')[0];
    if (isRosterHiddenStaffEmail_(email)) return;
    var time = activity[key];
    if (!latestByEmail[email] || new Date(time) > new Date(latestByEmail[email])) {
      latestByEmail[email] = time;
    }
  });
  mergeLastLoginActivity_(latestByEmail, 'gc');

  return activity;
}

function buildCourseRecord_(course, liveMap, meetPresence, teacherNotInClassMap, needsTechSupportMap, classroomActivity, classStatusOverrideMap) {
  var presence = meetPresence || {};
  var teachers = [];
  var students = [];
  // Kept only for the enclosing sync to build its deduplicated, lightweight
  // on-call directory; it is deleted before this course is written to Sheets.
  var onCallTeacherCandidates = [];
  var rawTeacherEmails = {}; // every Classroom TEACHER (hidden ones too) — Class Support membership check
  var teachersListed = false;
  // Role model: Description -> PRIMARY_TEACHER, Room "VP Email:" / "HM Email:" -> VP / HM (parsed once per course)
  var csParsed = classSupportParse_(course.room, course.description);
  var csNamed = {};
  csParsed.entries.forEach(function (x) { csNamed[x.email] = true; });

  try {
    var tPageToken;
    do {
      var tpt = tPageToken;
      var tResp = callWithBackoff_(function () {
        return Classroom.Courses.Teachers.list(course.id, { pageToken: tpt, pageSize: 100 });
      });
      (tResp.teachers || []).forEach(function (t) {
        var email = t.profile.emailAddress || '';
        if (email) rawTeacherEmails[normalizeEmail_(email)] = true;
        var rawName = t.profile.name ? t.profile.name.fullName : email;
        var parsed = splitNameAndPhone_(rawName);
        if (isOnCallTeacherEmail_(email)) {
          // photo is captured here (already fetched for the normal teacher
          // entry two lines below) so the per-classroom "On-Call Teachers"
          // card display can show an avatar without any extra Classroom API
          // call — see getDashboardData()'s ctx.onCallTeacher decoration.
          onCallTeacherCandidates.push({
            name: parsed.name,
            email: email,
            apsId: extractAPSID_(email),
            photo: fixPhoto_(t.profile.photoUrl)
          });
        }
        // skip support/admin co-teacher accounts — unless the Course Description / Room names this person (role model: never by prefix)
        var alwaysShow = classesAlwaysShowEmail_(email); // e.g. vsugadev@ — shown on every class card she teaches (display only)
        if (isHiddenTeacherName_(parsed.name, email) && !csNamed[normalizeEmail_(email)] && !alwaysShow) return;
        var tEmailLc = email ? email.toLowerCase() : '';
        teachers.push({
          name: teacherDisplayName_(parsed.name), // clean, phone-stripped name without a trailing "- TTS" / "(TCS)" tag — see SHOW_CONTACT_PHONE's doc comment for why the phone is never baked back into this
          phone: parsed.phone, // rendered separately (Dashboard.html) only when SHOW_CONTACT_PHONE is true
          email: email, // note: never rendered in the dashboard UI
          isHeadmaster: isInEmailList_(email, HEADMASTER_EMAILS),
          photo: fixPhoto_(t.profile.photoUrl),
          inMeet: !!(tEmailLc && presence[tEmailLc]),
          meetSince: (tEmailLc && presence[tEmailLc]) || null,
          classroomActivitySince: (tEmailLc && (classroomActivity || {})[tEmailLc + '|' + course.id]) || null,
          alwaysShow: alwaysShow || undefined // Classes tab: never hidden by the Primary Teacher view / Hide toggle
        });
      });
      tPageToken = tResp.nextPageToken;
    } while (tPageToken);
    teachersListed = true;
  } catch (e) {
    // No permission or teacher list failed — leave empty, don't kill the sync.
  }
  // VP / HM named in the Room / Description: make sure they are Classroom TEACHERs and tag them (see CLASS SUPPORT module).
  var classSupport = classSupportForCourse_(course, csParsed, teachers, rawTeacherEmails, teachersListed);
  // tcs_ / tts_ (on-call) accounts appear on the class card ONLY when the Course Description names them as the
  // Primary Teacher; every other tcs_ / tts_ co-teacher is left off the card (display only — Classroom membership,
  // the On-Call Teachers card and class access via classSupport are unchanged).
  var csPrimary = {};
  csParsed.entries.forEach(function (x) { if (x.roles.indexOf('PRIMARY_TEACHER') > -1) csPrimary[x.email] = true; });
  teachers = teachers.filter(function (t) { var e = normalizeEmail_(t.email); return !classesPrimaryOnlyPrefix_(e) || !!csPrimary[e]; });

  try {
    var sPageToken;
    do {
      var spt = sPageToken;
      var sResp = callWithBackoff_(function () {
        return Classroom.Courses.Students.list(course.id, { pageToken: spt, pageSize: 100 });
      });
      (sResp.students || []).forEach(function (s) {
        var email = s.profile.emailAddress || '';
        var rawName = s.profile.name ? s.profile.name.fullName : email;
        var parsed = splitNameAndPhone_(rawName);
        var sEmailLc = email ? email.toLowerCase() : '';
        students.push({
          name: parsed.name, // always the clean, phone-stripped name (same as teachers above)
          phone: parsed.phone, // captured but INTENTIONALLY never rendered anywhere in Dashboard.html, regardless of SHOW_CONTACT_PHONE — see that flag's doc comment
          email: email,
          photo: fixPhoto_(s.profile.photoUrl),
          inMeet: !!(sEmailLc && presence[sEmailLc]),
          meetSince: (sEmailLc && presence[sEmailLc]) || null,
          classroomActivitySince: (sEmailLc && (classroomActivity || {})[sEmailLc + '|' + course.id]) || null
        });
      });
      sPageToken = sResp.nextPageToken;
    } while (sPageToken);
  } catch (e) {
    // Roster empty/inaccessible.
  }

  var manualEntry = liveMap[course.id] || { live: false, updatedAt: null };
  // Part 42 — "Live" now goes true when EITHER the teacher OR any student is
  // in an active Meet call (source: presence[email], i.e. the 'GM' Meet
  // signal), not teacher-only as before. This intentionally mirrors
  // applyClassStatus_'s `anyoneInMeet` (teachers OR students), which already
  // used this rule for the "Class Started" status — Live and Class Status
  // now agree on what "someone is in Meet" means.
  var autoLiveMeet = teachers.some(function (t) { return t.inMeet; }) ||
    students.some(function (s) { return s.inMeet; });
  var autoLiveClassroom = !autoLiveMeet && teachers.some(function (t) {
    return t.email && (classroomActivity || {})[t.email.toLowerCase() + '|' + course.id];
  });
  var isLive = autoLiveMeet || autoLiveClassroom || manualEntry.live;
  var studentsInMeetCount = students.filter(function (s) { return s.inMeet; }).length;

  var teacherNotInClassEntry = normalizeStageEntry_((teacherNotInClassMap || {})[course.id]);
  var needsTechSupportEntry = normalizeStageEntry_((needsTechSupportMap || {})[course.id]);
  // Class Status: only the MANUAL override (if any) is snapshotted here, for
  // Sheet/CRM visibility (columns 19-20 in writeCache_) — the live
  // classStatus/classStatusLabel/etc. fields are computed fresh on every
  // getDashboardData() call by applyClassStatus_ and are NOT part of this
  // cached record at all (see that function's doc comment for why).
  var classStatusOverrideEntry = (classStatusOverrideMap || {})[course.id] || null;

  return {
    id: course.id,
    name: course.name,
    section: course.section || '',
    room: course.room || '',
    link: course.alternateLink,
    // whatsappLink is deliberately NOT set here — it's stamped on fresh at
    // request time by applyWhatsAppLinks_() in getDashboardData(), reading
    // the separate "WhatsApp_Group_Links" Sheet tab, so a school admin
    // editing that Sheet is reflected on the next 1-minute poll rather than
    // waiting for the next 15-minute Classroom sync / a Force Sync click.
    teachers: teachers,
    // r46: EVERY Google Classroom TEACHER of this course (incl. tcs_ / tts_ on-call and other accounts hidden from
    // the card), normalized emails — used ONLY for class access (courseHasTeacherEmail_). Never rendered; removed
    // from the data getDashboardData sends to the browser.
    rosterTeacherEmails: teachersListed ? Object.keys(rawTeacherEmails) : [],
    classSupport: classSupport, // [{email, roles:['PRIMARY_TEACHER'|'VP'|'HM'], sources:['COURSE_DESCRIPTION'|'ROOM'], member}] — see CLASS SUPPORT module
    roomDisplay: classSupportRoomDisplay_(course.room), // Room text with VP/HM labels + emails removed (emails are never displayed)
    meetLinkInClassroom: classMeetLinkFromClassroom_(course), // meet.google.com link written in the Classroom Description / Room / Section (see CLASS MEET LINKS)
    onCallTeacherCandidates: onCallTeacherCandidates,
    students: students,
    studentCount: students.length,
    studentsInMeetCount: studentsInMeetCount,
    noStudents: students.length === 0,
    noTeacher: teachers.length === 0,
    live: isLive,
    liveSource: autoLiveMeet ? 'meet' : (autoLiveClassroom ? 'classroom' : (manualEntry.live ? 'manual' : null)),
    liveUpdatedAt: manualEntry.updatedAt,
    teacherNotInClassStage: teacherNotInClassEntry.stage,
    teacherNotInClassUpdatedAt: teacherNotInClassEntry.updatedAt,
    teacherNotInClassUpdatedBy: teacherNotInClassEntry.updatedBy,
    needsTechSupportStage: needsTechSupportEntry.stage,
    needsTechSupportUpdatedAt: needsTechSupportEntry.updatedAt,
    needsTechSupportUpdatedBy: needsTechSupportEntry.updatedBy,
    classStatusManualRaw: classStatusOverrideEntry ? classStatusOverrideEntry.status : '',
    classStatusManualUpdatedAt: classStatusOverrideEntry ? classStatusOverrideEntry.updatedAt : ''
  };
}

/**
 * Normalizes a stored teacherNotInClassMap/needsTechSupportMap entry into
 * { stage, updatedAt }. Understands both the current 3-stage shape
 * ({stage, updatedAt}) and the older 2-state shape ({flagged, updatedAt})
 * from before this was a state machine, so any existing Script Properties
 * data from before this change still loads correctly instead of resetting.
 */
function normalizeStageEntry_(entry) {
  if (!entry) return { stage: 'none', updatedAt: null, updatedBy: null };
  if (entry.stage) return { stage: entry.stage, updatedAt: entry.updatedAt || null, updatedBy: entry.updatedBy || null };
  return { stage: entry.flagged ? 'reported' : 'none', updatedAt: entry.updatedAt || null, updatedBy: entry.updatedBy || null }; // legacy boolean shape
}

/**
 * Enforces STATUS_STAGE_MIN_TRANSITION_MS between two consecutive stage
 * changes on the same "Teacher NOT in Class" / "Needs Tech Support" flag —
 * see that constant's doc comment for what requirement this implements.
 * Returns a short "please wait" message when still cooling down, or null
 * when the transition is allowed to proceed.
 *
 * Deliberately returns a message rather than throwing: hitting the cooldown
 * is an expected, routine condition (someone double-clicking, or two staff
 * both reacting to the same card) — not a bug or a failed operation — so the
 * caller treats it as a soft WARNING it can hand back in a normal (success)
 * response, rather than as a thrown Error that aborts the call and surfaces
 * through withFailureHandler's error path.
 */
function stageTransitionCooldownWarning_(currentEntry) {
  if (!currentEntry || !currentEntry.updatedAt) return null; // nothing to cool down from yet
  var elapsed = Date.now() - new Date(currentEntry.updatedAt).getTime();
  if (elapsed < STATUS_STAGE_MIN_TRANSITION_MS) {
    var waitSec = Math.ceil((STATUS_STAGE_MIN_TRANSITION_MS - elapsed) / 1000);
    return 'Please wait ' + waitSec + ' more second' + (waitSec === 1 ? '' : 's') + ' before updating this status again.';
  }
  return null;
}

/**
 * Sept 2026 addendum: SpreadsheetApp.openById() had no retry at all, unlike
 * every Classroom API call in this file (see callWithBackoff_ above) — a
 * single transient Sheets-service hiccup (momentary "Service Spreadsheets"
 * error, or brief contention with the periodic sync triggers rewriting this
 * same workbook while many open dashboard tabs are polling it) would throw
 * immediately and, since getWorkbook_()/getAttendanceWorkbook_() sit directly
 * in the login path (authorizeDashboardAccess()/validateApsSession() both
 * call getAuthenticatedAPSUser() -> readAllCoursesFromCache_() ->
 * getOrCreateCacheSheet_() -> getWorkbook_()), surface to the user as a
 * failed login/session-check for no real authorization reason at all. Retries
 * a few times with a short backoff before giving up — 3 attempts total, kept
 * short (this is on the blocking login path) rather than the longer 6-retry
 * schedule callWithBackoff_ uses for background Classroom sync work.
 */
/**
 * Sept 2026 addendum #2: the Round 47 retry loop below treated every
 * SpreadsheetApp.openById() failure as equally likely to be transient. In
 * production it turned out at least one user's failure survived all 3
 * retries identically every time — the signature of a PERSISTENT failure,
 * not a one-off Sheets-service blip. Since this Web App is deployed
 * "Execute as: User accessing the web app", SpreadsheetApp.openById() runs
 * under THAT INDIVIDUAL user's own Google account/Drive permissions, not the
 * script owner's — so if the shared "Data Cache" workbook isn't shared with
 * a particular authorized user's actual Google account, opening it fails
 * for them every single time, retries or not, while it keeps succeeding for
 * every other user whose account does have access. Retrying 3 times against
 * a permission gap just makes the user wait longer for the same guaranteed
 * failure. This checks for that specific, recognizable error text and, when
 * matched, fails fast (no wasted retries) — the caller (getWorkbook_() /
 * getAttendanceWorkbook_()) uses isPermissionDeniedError_() again to throw a
 * distinct, accurate, actionable message instead of the generic "temporary"
 * one.
 */
function isPermissionDeniedError_(e) {
  var msg = (e && e.message) ? String(e.message) : String(e);
  return /you do not have permission|permission denied|requested document|not authorized to access/i.test(msg);
}

function openSpreadsheetByIdWithRetry_(id, logPrefix) {
  var maxAttempts = 3;
  var delay = 300; // ms, doubles each retry
  var lastError = null;
  for (var i = 0; i < maxAttempts; i++) {
    try {
      return SpreadsheetApp.openById(id);
    } catch (e) {
      lastError = e;
      if (isPermissionDeniedError_(e)) {
        console.error(logPrefix + ' open attempt ' + (i + 1) + ' failed for "' + id + '" with a PERMISSION error (not retrying further): ' + (e && e.message ? e.message : String(e)));
        break; // retrying a persistent per-account sharing gap wastes the user's time — fail fast
      }
      if (i < maxAttempts - 1) {
        console.error(logPrefix + ' open attempt ' + (i + 1) + '/' + maxAttempts + ' failed for "' + id + '": ' + (e && e.message ? e.message : String(e)));
        Utilities.sleep(delay);
        delay *= 2;
      }
    }
  }
  throw lastError;
}

/** ---------------------------------------------------------------------
 *  CACHE STORAGE — a dedicated Sheet, one row per course (JSON per cell).
 *  Row-per-course avoids the ~50k-char single-cell limit for large schools.
 * ------------------------------------------------------------------- */
/**
 * Returns the underlying Spreadsheet (not a specific tab) — either the
 * hardcoded TARGET_SPREADSHEET_ID, or an auto-created one remembered via
 * CACHE_SHEET_ID_KEY. Shared by every tab this project uses (Courses, and
 * the chat log below), so they all live in one spreadsheet.
 */
var WORKBOOK_MEMO_ = null; // r83: per-execution memo (same pattern as ATTENDANCE_WORKBOOK_MEMO_) — Apps Script globals reset every execution
function getWorkbook_() {
  if (WORKBOOK_MEMO_) return WORKBOOK_MEMO_; // r83: one SpreadsheetApp.openById per server call instead of one per helper
  // Sept 2026, fifty-fourth round: TARGET_SPREADSHEET_ID no longer has a
  // hardcoded fallback (see getTargetSpreadsheetId_ above) — a blank value
  // now fails loudly HERE instead of silently falling through to the
  // auto-create-a-different-spreadsheet path below, which is exactly the
  // failure mode the thirty-fourth round's regression caused.
  if (!TARGET_SPREADSHEET_ID) {
    throw new Error('The Script Property "TARGET_SPREADSHEET_ID" is not set. An Administrator must set it in the Apps Script editor (Project Settings > Script Properties) to the ID of the main data spreadsheet before this dashboard can load any data.');
  }
  if (TARGET_SPREADSHEET_ID) {
    try {
      return (WORKBOOK_MEMO_ = openSpreadsheetByIdWithRetry_(TARGET_SPREADSHEET_ID, '[Dashboard]'));
    } catch (e) {
      // Sept 2026 addendum: this is reachable by every signed-in role (it backs the whole
      // dashboard's data cache), so the spreadsheet ID and the raw underlying exception are
      // logged server-side ONLY (Stackdriver) — the THROWN message stays generic for every
      // caller, matching the same sanitization applied to the Attendance module's
      // getAttendanceWorkbook_() above.
      console.error('[Dashboard] Could not open TARGET_SPREADSHEET_ID "' + TARGET_SPREADSHEET_ID + '": ' + (e && e.message ? e.message : String(e)));
      // Sept 2026 addendum #2: a PERMISSION error means retries were skipped
      // (see openSpreadsheetByIdWithRetry_) because this is a persistent
      // per-account sharing gap, not a one-off blip — "try again" would
      // never help. Throw a distinct, accurate, actionable message instead
      // of the generic "temporary" one, so the client (see
      // apsClassifyServerError_ in Dashboard.html) can show the right
      // guidance rather than telling the user to just retry something that
      // will keep failing until an Administrator shares the workbook with
      // their account.
      if (isPermissionDeniedError_(e)) {
        throw new Error('Your Google account does not currently have access to the APS Dashboard\'s shared data. Please ask an Administrator to share it with your account, then try again.');
      }
      throw new Error('Could not load classroom data right now. Please try again, or contact an Administrator if this continues.');
    }
  }

  var props = PropertiesService.getScriptProperties();
  var ssId = props.getProperty(CACHE_SHEET_ID_KEY);
  var ss = null;
  if (ssId) {
    try { ss = openSpreadsheetByIdWithRetry_(ssId, '[Dashboard]'); } catch (e) { ss = null; }
  }
  if (!ss) {
    ss = SpreadsheetApp.create('APS Classroom Dashboard - Data Cache');
    props.setProperty(CACHE_SHEET_ID_KEY, ss.getId());
  }
  return (WORKBOOK_MEMO_ = ss);
}

function getOrCreateCacheSheet_() {
  var ss = getWorkbook_();
  return ss.getSheetByName('Courses') || ss.insertSheet('Courses');
}

/** ---------------------------------------------------------------------
 *  DASHBOARD CHAT — a shared chat room every recognized viewer (admin,
 *  headmaster, teacher, or student) can read and post to. Every message is
 *  appended as a row on the "Dashboard_Chat_Window" tab of the same
 *  workbook as "Courses" — nothing is stored in Script Properties, so the
 *  history is exactly what's in that Sheet tab.
 * ------------------------------------------------------------------- */
function getOrCreateChatSheet_() {
  var ss = getWorkbook_();
  var sheet = ss.getSheetByName(CHAT_SHEET_NAME);
  if (!sheet) {
    sheet = ss.insertSheet(CHAT_SHEET_NAME);
    // "Class Name" was added as a 6th column AFTER "Message" (not inserted in the
    // middle) so any pre-existing rows from before this change — which only ever
    // had 5 columns — still read back correctly; their (missing) Class Name cell
    // just comes back blank.
    sheet.getRange(1, 1, 1, 6).setValues([['Timestamp', 'Email', 'Role', 'Name', 'Message', 'Class Name']]).setFontWeight('bold');
    sheet.setFrozenRows(1);
  }
  return sheet;
}

/**
 * Deletes chat rows older than CHAT_RETENTION_DAYS from the Sheet tab itself
 * (not just what getChatMessages() returns). Throttled via a Script Property
 * so the underlying Sheet is only actually scanned/rewritten at most once per
 * CHAT_PRUNE_MIN_INTERVAL_MS, since getChatMessages() is polled every 8s by
 * every open dashboard and a full-column read/delete on every poll would be
 * wasteful.
 */
function pruneOldChatMessages_() {
  var props = PropertiesService.getScriptProperties();
  var lastPrune = props.getProperty(CHAT_LAST_PRUNE_KEY);
  var now = Date.now();
  if (lastPrune && (now - Number(lastPrune)) < CHAT_PRUNE_MIN_INTERVAL_MS) return;
  props.setProperty(CHAT_LAST_PRUNE_KEY, String(now));

  var sheet = getOrCreateChatSheet_();
  var lastRow = sheet.getLastRow();
  if (lastRow < 2) return;

  var cutoff = now - CHAT_RETENTION_DAYS * 24 * 60 * 60 * 1000;
  var timestamps = sheet.getRange(2, 1, lastRow - 1, 1).getValues();
  var firstRowToKeep = null; // 1-based Sheet row number
  for (var i = 0; i < timestamps.length; i++) {
    var ts = new Date(timestamps[i][0]).getTime();
    if (isNaN(ts) || ts >= cutoff) { firstRowToKeep = i + 2; break; } // +2: header row + 0-based offset
  }

  if (firstRowToKeep === null) {
    sheet.deleteRows(2, lastRow - 1); // every message is older than the retention window
    chatChanged_();
  } else if (firstRowToKeep > 2) {
    sheet.deleteRows(2, firstRowToKeep - 2);
    chatChanged_();
  }
}

/** Returns the class name(s) (comma-joined) the viewer teaches/attends, for tagging their chat messages. */
function findClassNamesForViewer_(courses, viewer) {
  if (viewer.role === 'teacher') {
    return courses.filter(function (c) { return userHasCourseAccess_(viewer.email, c); }).map(function (c) { return c.name; }).join(', ');
  }
  if (viewer.role === 'student') {
    return courses.filter(function (c) { return courseHasStudentEmail_(c, viewer.email); }).map(function (c) { return c.name; }).join(', ');
  }
  return '';
}

/** The part of an email before the "@", used as a short display name for admin/headmaster senders. */
function localPartOfEmail_(email) {
  var at = (email || '').indexOf('@');
  return at > -1 ? email.slice(0, at) : (email || '');
}

/**
 * Looks up a person's real Classroom display name by email across every
 * synced course's teacher/student rosters (falls back to the email itself
 * if not found — e.g. the courses haven't synced yet).
 */
function findDisplayName_(courses, email) {
  var normalized = normalizeEmail_(email);
  for (var i = 0; i < courses.length; i++) {
    var c = courses[i];
    var people = (c.teachers || []).concat(c.students || []);
    for (var j = 0; j < people.length; j++) {
      if (normalizeEmail_(people[j].email) === normalized) return people[j].name;
    }
  }
  return email;
}

/** Human display name for a chat sender: real Classroom name for teacher/student, role + email-prefix for staff. */
function chatDisplayName_(viewer, courses) {
  if (isAdminOrHm_(viewer.role)) {
    var roleLabel = viewer.role.charAt(0).toUpperCase() + viewer.role.slice(1);
    return roleLabel + ' · ' + localPartOfEmail_(viewer.email);
  }
  return findDisplayName_(courses, viewer.email);
}

// --- Real Google profile name for Admin/Headmaster, for the top-right corner badge ---
// chatDisplayName_() above deliberately keeps showing "Admin · <email-prefix>" in chat
// messages and status-flow "who clicked" captions (unchanged by this) — that's a
// separate design choice from before. The corner badge is different: it should show
// the signed-in Admin/Headmaster's actual Google account name, e.g.
// "Sugadev Velayutham (ADMIN)". An admin/headmaster account often has no Classroom
// roster entry to borrow a name from (they may not be a co-teacher on any course, or
// they are but get filtered out by the hidden-teacher-name rules), so this looks the
// name up via the Admin SDK Directory API instead.
//
// Requires: the "Admin Directory API" advanced service added in this Apps Script
// project (Editor → Services (+) → Admin Directory API), PLUS the same Workspace
// super-admin authorization already required by AUTO_LIVE_DETECTION /
// AUTO_CLASSROOM_PRESENCE_DETECTION above. If that service isn't enabled, or the
// lookup fails for any other reason, this fails silently — same graceful-degradation
// pattern as the Meet/Classroom auto-detection — and the badge falls back to the old
// "Role · email-prefix" style so nothing ever breaks.
var STAFF_NAME_CACHE_PROP_KEY = 'staffNameCache'; // { normalizedEmail: { name, cachedAt } }
var STAFF_NAME_CACHE_TTL_MS = 24 * 60 * 60 * 1000; // re-check the Directory at most once/day per person

/** Looks up `email`'s real Google account name via the Admin Directory API, caching the result for a day. Returns null if unavailable. */
function getGoogleProfileName_(email) {
  var normalized = normalizeEmail_(email);
  if (!normalized) return null;

  var props = PropertiesService.getScriptProperties();
  var raw = props.getProperty(STAFF_NAME_CACHE_PROP_KEY);
  var cache = raw ? JSON.parse(raw) : {};
  var now = Date.now();
  var entry = cache[normalized];
  if (entry && entry.name && (now - entry.cachedAt) < STAFF_NAME_CACHE_TTL_MS) {
    return entry.name;
  }

  try {
    var user = AdminDirectory.Users.get(normalized);
    var fullName = user && user.name && user.name.fullName;
    if (fullName) {
      cache[normalized] = { name: fullName, cachedAt: now };
      props.setProperty(STAFF_NAME_CACHE_PROP_KEY, JSON.stringify(cache));
      return fullName;
    }
  } catch (e) {
    // Admin Directory API not enabled/authorized, account not found, etc. — caller falls back.
  }
  return null;
}

/**
 * Display name specifically for the top-right "signed in as" corner badge —
 * NOT the same as chatDisplayName_() above (that one is unchanged). Teacher/
 * student use their real Classroom display name; admin/headmaster use their
 * real Google account name via getGoogleProfileName_(), falling back to the
 * old "Role · email-prefix" style only if that Directory lookup isn't available.
 */
function resolveViewerBadgeName_(viewer, courses) {
  if (isAdminOrHm_(viewer.role)) {
    var profileName = getGoogleProfileName_(viewer.email);
    if (profileName) return profileName;
    var roleLabel = viewer.role.charAt(0).toUpperCase() + viewer.role.slice(1);
    return roleLabel + ' · ' + localPartOfEmail_(viewer.email);
  }
  return findDisplayName_(courses, viewer.email);
}
/**
 * Returns the most recent chat messages (up to CHAT_HISTORY_LIMIT), oldest
 * first. Anyone recognized as admin/headmaster/teacher/student can read;
 * an unrecognized ('none') viewer gets an empty array — same access rule
 * as the rest of the dashboard.
 */
function getChatMessages(sessionToken) {
  var session = requireValidSession_(sessionToken);
  var viewer = { email: session.email, role: session.role };
  if (viewer.role === 'none') return [];
  // r96: served from CacheService (cleared on every post / prune) — no spreadsheet open per poll
  var cache = CacheService.getScriptCache();
  try { var hit = cache.get(CHAT_CACHE_KEY_); if (hit) return JSON.parse(hit); } catch (eC) { /* read the sheet */ }
  var v0 = chatVersion_(); // r100: a post during this read bumps the version — then the (older) list read here is not cached

  pruneOldChatMessages_(); // delete anything older than CHAT_RETENTION_DAYS (throttled internally)

  var sheet = getOrCreateChatSheet_();
  var lastRow = sheet.getLastRow();
  var out = [];
  if (lastRow >= 2) {
    var startRow = Math.max(2, lastRow - CHAT_HISTORY_LIMIT + 1);
    var numRows = lastRow - startRow + 1;
    var rows = sheet.getRange(startRow, 1, numRows, 6).getValues();
    out = rows
      .filter(function (r) { return r[4]; }) // skip any blank row
      .map(function (r) {
        return { timestamp: r[0] instanceof Date ? r[0].toISOString() : r[0], email: r[1], role: r[2], name: r[3], message: r[4], className: r[5] || '' };
      });
  }
  try {
    var json = JSON.stringify(out);
    // r100: CacheService's 100 KB limit is in BYTES (Tamil = 3 bytes per character); never cache a list older than the current version
    if (Utilities.newBlob(json).getBytes().length < 95000 && chatVersion_() === v0) cache.put(CHAT_CACHE_KEY_, json, 600);
  } catch (eP) { /* too big / unavailable: next call reads the sheet */ }
  return out;
}
/** r96: the chat list changed — drop the cached list and bump the version every open tab sees in getRealtimeStatusSnapshot. */
function chatChanged_() {
  try { var c = CacheService.getScriptCache(); c.remove(CHAT_CACHE_KEY_); c.put(CHAT_VERSION_KEY_, 'v' + Date.now(), 21600); } catch (e) { /* cache optional */ }
}
/** r96: current chat version (a new one is minted if the cache entry expired — open tabs then reload the chat once). */
function chatVersion_() {
  try { var c = CacheService.getScriptCache(), v = c.get(CHAT_VERSION_KEY_); if (!v) { v = 'v' + Date.now(); c.put(CHAT_VERSION_KEY_, v, 21600); } return v; } catch (e) { return ''; }
}

/**
 * Posts one chat message from the current viewer and returns the fresh
 * message list (so the poster's own UI can update immediately without a
 * second round trip). Only a recognized admin/headmaster/teacher/student
 * may post — mirrors the same access rule as the rest of the dashboard.
 */
function postChatMessage(sessionToken, text) {
  var message = (text || '').toString().trim();
  if (!message) throw new Error('Message is empty.');
  if (message.length > CHAT_MAX_MESSAGE_LENGTH) {
    message = message.slice(0, CHAT_MAX_MESSAGE_LENGTH);
  }

  var session = requireValidSession_(sessionToken);
  var courses = readAllCoursesFromCache_();
  var viewer = { email: session.email, role: session.role };
  if (viewer.role === 'none') {
    throw new Error('Only a recognized admin, headmaster, teacher, or student can post in the chat.');
  }

  var name = chatDisplayName_(viewer, courses);
  var className = findClassNamesForViewer_(courses, viewer); // e.g. student/teacher's own Classroom class name(s)
  var sheet = getOrCreateChatSheet_();
  sheet.appendRow([new Date().toISOString(), viewer.email, viewer.role, name, message, className]);
  chatChanged_(); // r96

  pruneOldChatMessages_();
  return getChatMessages(sessionToken);
}

function writeCache_(courses) {
  var sheet = getOrCreateCacheSheet_();
  sheet.clearContents();
  var syncedAt = new Date().toISOString();

  var header = [
    'Course ID', 'Course Name', 'Section', 'Room', 'Classroom Link',
    'Teacher(s)', 'Student Count', 'Students In Meet', 'No Students Joined', 'No Teacher Assigned',
    'Live', 'Live Updated At',
    'Teacher NOT In Class Stage', 'Teacher NOT In Class Updated At',
    'Needs Tech Support Stage', 'Needs Tech Support Updated At',
    'Last Synced', 'Detail JSON',
    // Appended AFTER Detail JSON (not inserted in the middle) so every
    // existing column position (1-18) is unchanged — same convention used
    // when the chat sheet's "Class Name" column was added. These two only
    // ever hold the MANUAL Class Status override ('cancelled'/'rescheduled'/
    // blank) — the automatic Scheduled/Yet to Start/Started/Completed states
    // are never written to the Sheet at all (see applyClassStatus_'s doc).
    'Class Status (Manual Override)', 'Class Status Updated At'
  ];

  var rows = courses.map(function (c) {
    var teacherNames = c.teachers.map(function (t) { return t.name; }).join(', ');
    return [
      c.id, c.name, c.section, c.room, c.link,
      teacherNames, c.studentCount, c.studentsInMeetCount, c.noStudents, c.noTeacher,
      c.live, c.liveUpdatedAt || '',
      c.teacherNotInClassStage, c.teacherNotInClassUpdatedAt || '',
      c.needsTechSupportStage, c.needsTechSupportUpdatedAt || '',
      syncedAt,
      JSON.stringify(c),
      c.classStatusManualRaw || '', c.classStatusManualUpdatedAt || ''
    ];
  });

  sheet.getRange(1, 1, 1, header.length).setValues([header]).setFontWeight('bold');
  if (rows.length) {
    // Force the "Course ID" column to plain text BEFORE writing values. Classroom course
    // IDs are long digit-only strings, and Sheets can otherwise auto-detect them as Numbers
    // — which then silently breaks the `String(row) === String(courseId)` lookups that
    // setLiveStatus/setTeacherNotInClassStage/setNeedsTechSupportStage rely on to find
    // and patch the right row (no error is thrown; the row just never gets updated).
    sheet.getRange(2, 1, rows.length, 1).setNumberFormat('@');
    sheet.getRange(2, 1, rows.length, header.length).setValues(rows);
  }
  sheet.autoResizeColumns(1, header.length - 1); // skip auto-resizing the huge JSON column
  invalidateCoursesMemo_(); // r49
}

/** Returns the URL of the underlying Sheet so it can be opened directly. */
function getCacheSheetUrl(sessionToken) {
  var session = requireValidSession_(sessionToken);
  if (!isAdminRole_(session.role)) throw new Error('Only Admin users can view the underlying Sheet link.');
  if (TARGET_SPREADSHEET_ID) {
    return SpreadsheetApp.openById(TARGET_SPREADSHEET_ID).getUrl();
  }
  var props = PropertiesService.getScriptProperties();
  var ssId = props.getProperty(CACHE_SHEET_ID_KEY);
  if (!ssId) return null;
  return SpreadsheetApp.openById(ssId).getUrl();
}


/** ---------------------------------------------------------------------
 *  READ PATH — called by the dashboard. No Classroom API calls here.
 * ------------------------------------------------------------------- */
/** Reads every synced course (unfiltered by role) straight from the cache Sheet. */
function readAllCoursesFromCache_() {
  // r49 performance: the parsed course list is kept in CacheService (chunked) for COURSES_MEMO_SECONDS_, so the
  // dashboard refresh, chat and every other reader no longer open the spreadsheet and re-read the whole "Courses"
  // sheet each time. Every writer of that sheet (writeCache_ and the per-course status setters) calls
  // invalidateCoursesMemo_() right after writing, so readers never see stale data. Callers get fresh objects
  // (parsed from the cached JSON) and may mutate them freely.
  var memo = coursesMemoGet_();
  if (memo) { try { return JSON.parse(memo); } catch (eMemo) { /* fall through to the sheet */ } }
  var sheet = getOrCreateCacheSheet_();
  var data = sheet.getDataRange().getValues();
  var courses = [];
  var raw = [];
  for (var i = 1; i < data.length; i++) { // skip header row
    var jsonCol = data[i][17]; // "Detail JSON" column
    if (jsonCol) {
      try { courses.push(JSON.parse(jsonCol)); raw.push(String(jsonCol)); } catch (e) { /* skip bad row */ }
    }
  }
  coursesMemoPut_('[' + raw.join(',') + ']');
  return courses;
}

/* ---------- r49: chunked CacheService memo of the Courses sheet ---------- */
var COURSES_MEMO_KEY_ = 'aps_courses_memo_v1';
var COURSES_MEMO_SECONDS_ = 600;   // 10 min safety TTL; writers invalidate immediately
var COURSES_MEMO_CHUNK_ = 30000;   // characters (CacheService value limit is 100 KB in bytes; Tamil is multi-byte)
function coursesMemoGet_() {
  try {
    var cache = CacheService.getScriptCache();
    var head = cache.get(COURSES_MEMO_KEY_);
    if (!head) return null;
    var meta = JSON.parse(head); // { gen, n }
    var keys = [];
    for (var i = 0; i < meta.n; i++) keys.push(COURSES_MEMO_KEY_ + '_' + meta.gen + '_' + i);
    var got = cache.getAll(keys);
    var parts = [];
    for (var k = 0; k < keys.length; k++) { if (got[keys[k]] == null) return null; parts.push(got[keys[k]]); }
    return parts.join('');
  } catch (e) { return null; }
}
function coursesMemoPut_(json) {
  try {
    var cache = CacheService.getScriptCache();
    var gen = String(Date.now());
    var vals = {}, n = 0;
    for (var i = 0; i < json.length; i += COURSES_MEMO_CHUNK_) { vals[COURSES_MEMO_KEY_ + '_' + gen + '_' + n] = json.slice(i, i + COURSES_MEMO_CHUNK_); n++; }
    if (n > 200) return; // unusually large — just read the sheet next time
    cache.putAll(vals, COURSES_MEMO_SECONDS_);
    cache.put(COURSES_MEMO_KEY_, JSON.stringify({ gen: gen, n: n }), COURSES_MEMO_SECONDS_);
  } catch (e) { /* cache is an optimisation only */ }
}
function invalidateCoursesMemo_() {
  try { CacheService.getScriptCache().removeAll([COURSES_MEMO_KEY_, 'aps_whatsapp_map_v1']); } catch (e) { /* ignore */ }
}

/* ==========================================================================
 * r103 — Property storage: settings stay in Script Properties; the four big per-person maps (presence, last login,
 * country, onboarded) and the per-student Google Review keys live in a SECOND property store — the deploying
 * account's User Properties. The web app (executeAs USER_DEPLOYING), every trigger and the editor run as that account,
 * so it is one shared store, with its own 500 KB quota. Reads fall back to the old Script Property until the first
 * write moves it (then the Script Property copy is deleted) — no manual migration, no data loss.
 * ========================================================================== */
var APS_PROP_LIMIT_BYTES_ = 500 * 1024;
var APS_BIG_MOVED_ = {}; // per execution: keys already confirmed gone from Script Properties
function apsBigStore_() { return PropertiesService.getUserProperties(); }
function apsBigGetStored_(key) {
  var v = null;
  try { v = apsBigStore_().getProperty(key); } catch (e) { v = null; }
  if (v === null || v === undefined) { try { v = PropertiesService.getScriptProperties().getProperty(key); } catch (e2) { v = null; } } // not moved yet
  return v === undefined ? null : v;
}
/** r119: the three per-person maps are stored compact (apcEncode_) and always handed to callers in the original JSON shape. */
function apsBigGet_(key) { var v = apsBigGetStored_(key); return APC_KEYS_[key] && v ? apcDecodeRaw_(v) : v; }
function apsBigSet_(key, value) {
  if (APC_KEYS_[key]) value = apcEncodeRaw_(key, value); // r119: compact; any problem → the original text is stored unchanged
  apsBigStore_().setProperty(key, value);
  if (APS_BIG_MOVED_[key]) return;
  try { var sp = PropertiesService.getScriptProperties(); if (sp.getProperty(key) !== null) sp.deleteProperty(key); } catch (e) { /* the old copy is removed next time */ }
  APS_BIG_MOVED_[key] = true;
}
function apsBigJson_(key) { var raw = apsBigGetStored_(key); if (!raw) return {}; try { var o = JSON.parse(raw) || {}; return APC_KEYS_[key] ? apcDecodeObj_(o) : o; } catch (e) { return {}; } }
/** Best-effort write for display-only data (online dot, last login, onboarded, country): a full store logs a warning instead of failing the dashboard. */
function apsBigSetSafe_(key, value, label) {
  try { apsBigSet_(key, value); return true; }
  catch (e) { console.warn('[Storage] ' + (label || key) + ' not saved: ' + (e && e.message)); return false; }
}

function apsPropBytes_(all) { var n = 0; Object.keys(all || {}).forEach(function (k) { n += Utilities.newBlob(k).getBytes().length + Utilities.newBlob(String(all[k])).getBytes().length; }); return n; }
/**
 * r103: daily storage check (from apsDailyForceSync). Moves any of the big maps still in Script Properties to the second
 * store, removes rebuildable diagnostics / unused old keys when Script Properties pass 70 %, and emails admin@ once a day
 * (from attendance@) if either store is still above 80 %. Never logs a value. Editor: run apsStorageReport() to see it.
 */
var APS_PROP_DIAG_KEYS_ = ['meetPresenceDiagnostic', 'classMeetLiveDiagnostic', 'attendanceSyncDiagnostic_v1', 'attendanceFinalizedThrough_v1', 'attendanceFinalizedThrough_v2'];
/** r103 (r118: shared with the Admin "Clean up temporary data" button): move the big per-person maps and the Google Review keys still in Script Properties to the second store. Returns the moved key names ('GR' per review key). */
function apsPropMoveBig_(sp) {
  var moved = [];
  [PRESENCE_PROP_KEY, LAST_LOGIN_PROP_KEY, USER_COUNTRY_PROP_KEY, ONBOARDED_STUDENTS_PROP_KEY].forEach(function (k) {
    var v = sp.getProperty(k); if (v === null) return;
    var cur = null; try { cur = apsBigStore_().getProperty(k); } catch (e) { cur = null; }
    if (cur === null) apsBigStore_().setProperty(k, v); // the second store wins once it has a value
    sp.deleteProperty(k); moved.push(k);
  });
  sp.getKeys().forEach(function (k) {
    if (k.indexOf(GR_PROMPT_PROP_PREFIX_) !== 0) return;
    try { if (apsBigStore_().getProperty(k) === null) apsBigStore_().setProperty(k, sp.getProperty(k)); sp.deleteProperty(k); moved.push('GR'); } catch (e) { /* next day */ }
  });
  return moved;
}
/** r103 (r118: shared): remove the rebuildable diagnostics (fixed allow-list) and old-week realtime availability entries. Returns the trimmed key names. */
function apsPropTrimTemp_(sp) {
  var trimmed = [];
  APS_PROP_DIAG_KEYS_.forEach(function (k) { if (sp.getProperty(k) !== null) { sp.deleteProperty(k); trimmed.push(k); } });
  try { var rt = getRealtimeAvailabilityMap_(), n0 = Object.keys(rt).length; apsAvailRealtimePrune_(rt, getCurrentWeekId_());
    if (Object.keys(rt).length < n0) { sp.setProperty(TEACHER_AVAILABILITY_REALTIME_PROP_KEY, JSON.stringify(rt)); trimmed.push(TEACHER_AVAILABILITY_REALTIME_PROP_KEY); } } catch (eR) { /* ignore */ }
  return trimmed;
}
function apsPropHealth_(allowEmail) {
  var sp = PropertiesService.getScriptProperties(), moved = apsPropMoveBig_(sp), trimmed = [];
  if (apsCountryDataPurge_()) trimmed.push(USER_COUNTRY_PROP_KEY); // r119: country feature off → its saved list is deleted
  var spBytes = apsPropBytes_(sp.getProperties());
  if (spBytes > 0.7 * APS_PROP_LIMIT_BYTES_) {
    trimmed = trimmed.concat(apsPropTrimTemp_(sp));
    spBytes = apsPropBytes_(sp.getProperties());
  }
  var bigBytes = 0; try { bigBytes = apsPropBytes_(apsBigStore_().getProperties()); } catch (eB) { bigBytes = 0; }
  var pct = function (b) { return Math.round(100 * b / APS_PROP_LIMIT_BYTES_); };
  var out = { scriptKb: Math.round(spBytes / 1024), scriptPct: pct(spBytes), secondKb: Math.round(bigBytes / 1024), secondPct: pct(bigBytes),
    moved: moved.filter(function (x) { return x !== 'GR'; }).concat(moved.indexOf('GR') > -1 ? ['GOOGLE_REVIEW_PROMPT_* (' + moved.filter(function (x) { return x === 'GR'; }).length + ')'] : []), trimmed: trimmed };
  console.log('[Storage] Script Properties ' + out.scriptKb + ' KB (' + out.scriptPct + '%), second store ' + out.secondKb + ' KB (' + out.secondPct + '%)' +
    (out.moved.length ? '; moved ' + out.moved.join(', ') : '') + (trimmed.length ? '; trimmed ' + trimmed.join(', ') : ''));
  if (allowEmail && (out.scriptPct >= 80 || out.secondPct >= 80)) {
    var day = Utilities.formatDate(new Date(), APS_TZ, 'yyyy-MM-dd');
    if (sp.getProperty('APS_STORAGE_ALERT_DAY') !== day) {
      try {
        var admin = attMailAdminCc_();
        attMailSend_({ to: [admin], cc: [], subject: 'APS Dashboard – storage almost full (' + Math.max(out.scriptPct, out.secondPct) + '%)',
          html: apsEmailShell_('Storage almost full', '<p style="font-size:15px;line-height:1.55;">Vanakkam,</p><p style="font-size:14px;line-height:1.55;">The dashboard\'s Apps Script property storage is getting full. At 100% the dashboard stops loading for everyone.</p><p style="font-size:14px;line-height:1.55;">Script Properties: <b>' + out.scriptKb + ' KB (' + out.scriptPct + '%)</b><br>Second store: <b>' + out.secondKb + ' KB (' + out.secondPct + '%)</b></p><p style="font-size:14px;line-height:1.55;">In the Apps Script editor run <b>apsStorageReport</b> to see the largest keys, then contact the developer.</p><p style="font-size:14px;">APS Tech Support Team</p>', {}),
          text: 'Apps Script property storage is getting full. Script Properties: ' + out.scriptKb + ' KB (' + out.scriptPct + '%). Second store: ' + out.secondKb + ' KB (' + out.secondPct + '%). Run apsStorageReport in the editor.' });
        sp.setProperty('APS_STORAGE_ALERT_DAY', day);
      } catch (eM) { console.warn('[Storage] alert email not sent: ' + (eM && eM.message)); }
    }
  }
  return out;
}
/** Key name for logs with the whole email hidden (APS emails contain "_": "GOOGLE_REVIEW_PROMPT_a_b_aps1@x.org" → "GOOGLE_REVIEW_PROMPT_<email>"). */
function apsPropKeyLabel_(k) {
  k = String(k);
  var pre = [GR_PROMPT_PROP_PREFIX_, STUDENT_NOTICE_PROP_PREFIX];
  for (var i = 0; i < pre.length; i++) if (k.indexOf(pre[i]) === 0 && k.indexOf('@') > -1) return pre[i] + '<email>' + k.slice(k.indexOf('@')).replace(/^@[A-Za-z0-9.-]+\.[A-Za-z]+/, '');
  return k.replace(/[A-Za-z0-9.+-]+@[A-Za-z0-9.-]+\.[A-Za-z]+/g, '<email>');
}
/** Editor / owner only: storage sizes and the 25 largest keys of each store (names and sizes only — never values). Also runs the daily move / trim. */
function apsStorageReport() {
  apsRequireOwnerOrTrigger_(null);
  var h = apsPropHealth_(false);
  var top = function (all) { return Object.keys(all).map(function (k) { return { k: apsPropKeyLabel_(k), b: Utilities.newBlob(k).getBytes().length + Utilities.newBlob(String(all[k])).getBytes().length }; })
    .sort(function (a, b) { return b.b - a.b; }).slice(0, 25).map(function (x) { return Math.round(x.b / 102.4) / 10 + ' KB  ' + x.k; }); };
  h.scriptTop = top(PropertiesService.getScriptProperties().getProperties());
  try { h.secondTop = top(apsBigStore_().getProperties()); } catch (e) { h.secondTop = []; }
  console.log(JSON.stringify(h, null, 1));
  return h;
}

/** Returns the presence map, parsed: { normalizedEmail: { lastSeen, loginAt } }. */
function getPresenceMap_() {
  return apsBigJson_(PRESENCE_PROP_KEY);
}

/**
 * Marks `email` as "currently viewing the dashboard right now" — called once
 * per getDashboardData() request, i.e. every time that person's own browser
 * loads or polls the dashboard. This is what makes the green "online" dot
 * real-time (unlike the Meet/Classroom auto-detection below, which only
 * refreshes once per Classroom sync). If they weren't seen within the last
 * PRESENCE_ONLINE_WINDOW_MINUTES (or ever), this counts as a fresh login and
 * loginAt resets to now; otherwise loginAt is preserved so the displayed
 * login time reflects when this online spell actually started, not the last
 * poll.
 *
 * Also feeds the persistent, cross-source "Last Login" record (see
 * LAST_LOGIN_PROP_KEY) with this Dashboard visit under the 'db' (Dashboard)
 * slot, labeled 'DB' — a Dashboard heartbeat is real, direct proof this
 * person is using the Dashboard right now, so it's merged in on every call
 * (not just a "fresh" one), and — like every other source feeding that
 * record — it only overwrites the 'db' slot if it's actually newer than
 * whatever is already recorded there from an earlier Dashboard visit (it
 * never touches the 'gc'/'gm' slots, which only Classroom/Meet activity can
 * update).
 *
 * This same function is also called one more time, best-effort, right as the
 * dashboard tab is hidden/closed (see recordDashboardSignOff() below and the
 * 'visibilitychange' listener in Dashboard.html), so the recorded 'DB'
 * timestamp reflects the moment the person actually left rather than only
 * their last periodic poll (up to DASHBOARD_POLL_MS old).
 */
function recordHeartbeat_(email) {
  var normalized = normalizeEmail_(email);
  if (!normalized) return;
  // r96 (simultaneous executions): one write per person per APS_HEARTBEAT_MIN_SECONDS (several tabs / load + refresh +
  // sign-off arrive together), and never wait for the shared script lock — a busy lock now skips this best-effort write
  // (the next refresh records it) instead of holding the request up to 2 s and writing without the lock.
  var hbCache = null, hbKey = 'aps_hb_' + normalized;
  try { hbCache = CacheService.getScriptCache(); if (hbKey.length <= 250 && hbCache.get(hbKey)) return; } catch (eC) { hbCache = null; }
  var lock = LockService.getScriptLock();
  var locked = false;
  try { locked = lock.tryLock(APS_HEARTBEAT_LOCK_MS_); } catch (e) { locked = false; }
  if (!locked) return;
  try { if (hbCache && hbKey.length <= 250) hbCache.put(hbKey, '1', APS_HEARTBEAT_MIN_SECONDS_); } catch (eP) { /* throttle is an optimisation only */ }
  try {
    var props = PropertiesService.getScriptProperties();
    var map = getPresenceMap_();
    var now = new Date();
    var existing = map[normalized];
    var isFreshLogin = !existing || (now.getTime() - new Date(existing.lastSeen).getTime()) > PRESENCE_ONLINE_WINDOW_MINUTES * 60000;
    map[normalized] = {
      lastSeen: now.toISOString(),
      loginAt: isFreshLogin ? now.toISOString() : (existing.loginAt || now.toISOString())
    };
    // r49: presence only drives the "online now" dot (PRESENCE_ONLINE_WINDOW_MINUTES), so entries not seen for 24 h
    // are dropped — keeps this single Script Property small (9 KB per-value limit) and every read/write cheaper.
    Object.keys(map).forEach(function (k) { if (!map[k] || (now.getTime() - new Date(map[k].lastSeen).getTime()) > 86400000) delete map[k]; });
    apsBigSetSafe_(PRESENCE_PROP_KEY, JSON.stringify(map), 'Online status');

    // --- Persistent cross-source Last Login: merge this Dashboard visit into the 'db' slot ---
    var lastLoginRaw = apsBigGet_(LAST_LOGIN_PROP_KEY);
    var lastLoginMap = lastLoginRaw ? JSON.parse(lastLoginRaw) : {};
    var rawEntry = lastLoginMap[normalized];
    var entry = normalizeLastLoginEntry_(rawEntry);
    var entryChanged = JSON.stringify(rawEntry || null) !== JSON.stringify(entry);
    if (!entry.db || now.getTime() > new Date(entry.db).getTime()) {
      entry.db = now.toISOString();
      entryChanged = true;
    }
    if (entryChanged) {
      lastLoginMap[normalized] = entry;
      apsBigSetSafe_(LAST_LOGIN_PROP_KEY, JSON.stringify(lastLoginMap), 'Last login');
    }
  } finally {
    try { lock.releaseLock(); } catch (e) { /* ignore */ }
  }
}

/**
 * DASHBOARD SIGN-OFF: called by the dashboard's own browser right as it
 * becomes hidden/closed (see the 'visibilitychange' — and, as a best-effort
 * backstop, 'pagehide' — listeners near the end of Dashboard.html) to record
 * one final Dashboard activity/sign-off timestamp for the CURRENT viewer.
 *
 * This intentionally does nothing new or different from the regular
 * heartbeat recorded by getDashboardData() on every load/poll — it just
 * calls the exact same recordHeartbeat_(email) one more time, right at the
 * moment of sign-off, using the same trusted, session-verified
 * Session.getActiveUser().getEmail() (never a client-supplied email, so this
 * can't be spoofed to sign someone else off or bump someone else's Last
 * Login). Per the requirement that a browser close/unload event is not 100%
 * reliable, this is a best-effort ENHANCEMENT layered on top of the existing
 * heartbeat mechanism, not a replacement for it: if this call never reaches
 * the server (tab killed instantly, offline, browser crash, etc.) the last
 * regular heartbeat from getDashboardData() already stands as the recorded
 * 'DB' activity time — nothing is lost, and nothing here can make the
 * recorded Dashboard activity time WORSE, only more precise when it lands.
 */
function recordDashboardSignOff(sessionToken) {
  var session = requireValidSession_(sessionToken);
  var email = session.email;
  if (email) recordHeartbeat_(email);
}

/**
 * Merges live presence onto every teacher/student across `courses` (mutates
 * the person objects in place): sets `online` (bool) and `onlineSince` (ISO
 * string or null) from whichever signal is freshest —
 *   1. a live heartbeat (dashboard open right now — real-time), else
 *   2. an active Meet call (meetSince, refreshed at last Classroom sync), else
 *   3. recent Classroom activity (classroomActivitySince, same sync lag).
 */
function applyLivePresence_(courses) {
  var presenceMap = getPresenceMap_();
  var now = Date.now();
  courses.forEach(function (c) {
    (c.teachers || []).concat(c.students || []).forEach(function (p) {
      var key = normalizeEmail_(p.email);
      var entry = key ? presenceMap[key] : null;
      var heartbeatOnline = !!(entry && (now - new Date(entry.lastSeen).getTime()) <= PRESENCE_ONLINE_WINDOW_MINUTES * 60000);
      p.online = heartbeatOnline || !!p.inMeet || !!p.classroomActivitySince;
      p.onlineSince = heartbeatOnline ? entry.loginAt : (p.inMeet ? (p.meetSince || null) : (p.classroomActivitySince || null));
    });
  });
  return courses;
}

/** Returns the persistent lastLoginMap Script Property, parsed: { normalizedEmail: { gc, gm, db } } (raw — may still contain legacy-shaped entries; callers should read through normalizeLastLoginEntry_). */
function getLastLoginMap_() {
  return apsBigJson_(LAST_LOGIN_PROP_KEY);
}

/**
 * Formats an ISO (UTC) timestamp as "MM/dd HH:mm" in US Eastern time
 * (LAST_LOGIN_TIMEZONE = 'America/New_York', DST-aware) for the Last Login
 * display. This is computed server-side (via Apps Script's
 * Utilities.formatDate, which understands IANA timezone names and handles
 * EST/EDT automatically) specifically so the displayed time is always
 * Eastern regardless of which timezone the viewer's own browser/OS happens
 * to be set to — unlike the pre-existing formatLoginTime() in
 * Dashboard.html, which formats in the *viewer's local* time and is still
 * used, unchanged, for the "who clicked / when" status captions.
 */
function formatLastLoginTimestamp_(isoUtc) {
  if (!isoUtc) return '';
  var d = new Date(isoUtc);
  if (isNaN(d.getTime())) return '';
  return Utilities.formatDate(d, LAST_LOGIN_TIMEZONE, 'MM/dd HH:mm');
}

/**
 * Given a normalized { gc, gm, db } entry (see normalizeLastLoginEntry_),
 * performs the two calculations required by the "Last Activity" spec,
 * deliberately kept SEPARATE (section 9 of the spec):
 *
 *   (A) THE TIMESTAMP — the single most recent of whichever source(s) have
 *       ever recorded real activity for this person (never fabricated: a
 *       source with nothing recorded simply isn't in the running).
 *   (B) THE SOURCE LIST — every source that has EVER recorded real activity
 *       for this person, not just whichever one happens to be newest, always
 *       rendered in the fixed order GC/GM/DB regardless of which one is
 *       actually the newest (section 10 — the order never changes based on
 *       recency).
 *
 * Example matching the spec's own worked example: GC=10:00, GM=10:05,
 * DB=10:03 → the newest timestamp is GM's 10:05, but ALL THREE sources have
 * recorded activity, so the result is "10:05 (GC/GM/DB)", not "10:05 (GM)".
 *
 * Returns { at: isoUtcOrNull, sources: 'GC/GM/DB'-style string or null,
 * display: 'MM/DD HH:mm (GC/GM/DB)' or '' }. If NO source has ever recorded
 * activity for this person, returns display: '' so the existing "No Login"
 * UI is preserved exactly as before — nothing is ever fabricated.
 */
function summarizeLastLogin_(entry) {
  if (!entry) return { at: null, sources: null, display: '' };

  var present = LAST_LOGIN_SOURCE_ORDER.filter(function (key) { return !!entry[key]; });
  if (!present.length) return { at: null, sources: null, display: '' };

  var latestIso = present.reduce(function (latest, key) {
    return (!latest || new Date(entry[key]).getTime() > new Date(latest).getTime()) ? entry[key] : latest;
  }, null);

  var sourceLabel = present.map(function (key) { return LAST_LOGIN_SOURCE_LABELS[key]; }).join('/');
  return {
    at: latestIso,
    sources: sourceLabel,
    display: formatLastLoginTimestamp_(latestIso) + ' (' + sourceLabel + ')'
  };
}

/**
 * Merges the persistent, cross-source "Last Login" record (see
 * LAST_LOGIN_PROP_KEY) onto every teacher/student across `courses` (mutates
 * the person objects in place). Unlike `online`/`onlineSince`
 * (applyLivePresence_ above), which are transient — true only while the
 * person is currently detected online — this is a PERMANENT "last known
 * activity" summary that is never cleared and never moves backward, combining
 * three INDEPENDENTLY tracked sources — Google Classroom ('gc'), Google Meet
 * ('gm'), and the Dashboard ('db') — each updated only by its own dedicated
 * call site (getClassroomActivityMap_, getMeetPresenceMap_, recordHeartbeat_/
 * recordDashboardSignOff() respectively — the only places that write to this
 * record) via mergeLastLoginActivity_().
 *
 * Adds these fields to each person object (see summarizeLastLogin_ for how
 * they're computed):
 *   - lastLoginAt       — raw ISO timestamp (UTC) of the most recent activity
 *                         across all applicable sources, or null
 *   - lastLoginSource   — combined source-code string in fixed GC/GM/DB
 *                         order, e.g. 'GC/GM/DB', 'GC/DB', 'GM', or null
 *   - lastLoginDisplay  — ready-to-render "MM/DD HH:mm (GC/GM/DB)" string,
 *                         already converted to Eastern time server-side (see
 *                         formatLastLoginTimestamp_), or '' if this person
 *                         has no recorded activity yet from any source — the
 *                         existing "nothing shown yet" ("No Login") behavior
 *                         is preserved by simply leaving this blank rather
 *                         than fabricating a value.
 *   - lastLoginBySource — { gc, gm, db } raw per-source ISO timestamps (or
 *                         null each), for anything that wants the detail
 *                         behind the combined display (e.g. a future admin
 *                         tooltip) without re-deriving it.
 */
function applyLastLogin_(courses) {
  var lastLoginMap = getLastLoginMap_();
  courses.forEach(function (c) {
    (c.teachers || []).concat(c.students || []).forEach(function (p) {
      var key = normalizeEmail_(p.email);
      var entry = key ? normalizeLastLoginEntry_(lastLoginMap[key]) : {};
      var summary = summarizeLastLogin_(entry);
      p.apsId = extractAPSID_(p.email); // shown next to the name in the roster (Dashboard.html renderPeople) — 'NA' when not applicable, never guessed
      p.lastLoginAt = summary.at;
      p.lastLoginSource = summary.sources;
      p.lastLoginDisplay = summary.display;
      p.lastLoginBySource = { gc: entry.gc || null, gm: entry.gm || null, db: entry.db || null };
    });
  });
  return courses;
}

/** ISO 3166-1 alpha-2 -> emoji flag (server-side mirror of the identical countryCodeToFlag() in Dashboard.html) via the standard "regional indicator symbol" Unicode trick — no hardcoded per-country list to keep in sync on either side. Returns '' for anything that isn't exactly 2 letters. */
function countryCodeToFlagServer_(code) {
  code = String(code || '').trim().toUpperCase();
  if (!/^[A-Z]{2}$/.test(code)) return '';
  var base = 0x1F1E6; // regional indicator "A"
  return String.fromCodePoint(base + (code.charCodeAt(0) - 65)) + String.fromCodePoint(base + (code.charCodeAt(1) - 65));
}

/** Returns the persistent USER_COUNTRY_PROP_KEY Script Property, parsed: { normalizedEmail: { countryCode, countryName, updatedAt } }. */
function getUserCountryMap_() {
  return apsCountryOn_() ? ucLegacyMap_() : {}; // r120: from the USER_COUNTRY sheet (outside-USA people only), same entry shape as before
}

/**
 * Records the CURRENT signed-in viewer's own country, as detected by their
 * OWN browser's client-side IP-geolocation lookup (see loadUserCountryFlag()
 * in Dashboard.html), identified via their verified session — this is the only place that ever writes to
 * USER_COUNTRY_PROP_KEY. Trusted identity only: the email is always
 * Session.getActiveUser().getEmail(), never anything the client passes in,
 * so this can never be used to set someone ELSE's country. Best-effort and
 * non-critical — called fire-and-forget from the client with no failure
 * handling; if it never lands, the only effect is that this person's roster
 * chip keeps showing no flag for other viewers a little longer.
 *
 * Only countryCode + countryName are ever accepted/stored — never an IP
 * address, coordinates, city, postal code, or ISP.
 */
function recordViewerCountry(sessionToken, countryCode, countryName) {
  var session = requireValidSession_(sessionToken);
  var email = session.email;
  if (!email) return;
  if (!apsCountryOn_()) return; // r119: country feature switched off — nothing is stored
  countryCode = String(countryCode || '').trim().toUpperCase();
  countryName = String(countryName || '').trim().slice(0, 100); // defensive cap — this is display text, not something to trust blindly
  if (!/^[A-Z]{2}$/.test(countryCode) || !countryName) return; // silently ignore malformed/empty input — best-effort, never throws
  return ucRecordBrowser_(session, countryCode, countryName); // r120: USER_COUNTRY sheet; the old property code below is no longer reached

  var lock = LockService.getScriptLock();
  try { lock.tryLock(2000); } catch (e) { /* proceed best-effort even without the lock */ }
  try {
    var map = getUserCountryMap_();
    var prev = map[email] || {}; // r103: keep the person's chosen Default Country (was overwritten by every auto-detect)
    var next = { countryCode: countryCode, countryName: countryName, updatedAt: new Date().toISOString() };
    ['defaultCountryCode', 'defaultCountryName', 'defaultUpdatedAt'].forEach(function (f) { if (prev[f]) next[f] = prev[f]; });
    map[email] = next;
    apsBigSetSafe_(USER_COUNTRY_PROP_KEY, JSON.stringify(map), 'Detected country');
  } finally {
    try { lock.releaseLock(); } catch (e) { /* ignore */ }
  }
}

/**
 * Resolves ONE already-fetched USER_COUNTRY_PROP_KEY map entry into the
 * ready-to-render country info for a person, applying the priority chain
 * requested for the "Display Teacher and Student Country Flag" feature:
 *   1. Browser-detected country (entry.countryCode/countryName — written
 *      only by recordViewerCountry(), i.e. that person's own dashboard
 *      session actually detected it), when available.
 *   2. Otherwise that person's own saved Default Country
 *      (entry.defaultCountryCode/defaultCountryName — see setMyDefaultCountry()),
 *      when available.
 *   3. Otherwise no flag at all — never guessed/fabricated.
 * Takes the entry itself (not an email) so a caller resolving MANY people at
 * once (applyUserCountry_, below) reads the whole map from Script Properties
 * exactly ONCE and calls this per-person from memory — never a fresh
 * Properties read per row/API call per row.
 */
function resolveCountryFlag_(entry) {
  if (entry && entry.countryCode && entry.countryName) {
    return { countryCode: entry.countryCode, countryName: entry.countryName, flag: countryCodeToFlagServer_(entry.countryCode), source: 'browser' };
  }
  if (entry && entry.defaultCountryCode && entry.defaultCountryName) {
    return { countryCode: entry.defaultCountryCode, countryName: entry.defaultCountryName, flag: countryCodeToFlagServer_(entry.defaultCountryCode), source: 'default' };
  }
  return { countryCode: '', countryName: '', flag: '', source: '' };
}

/**
 * Reusable single-email convenience helper (the exact shape requested:
 * "a reusable helper function, such as getUserCountryFlag(email)"). Applies
 * the same browser -> Default Country -> none priority chain as
 * resolveCountryFlag_() above. Prefer resolveCountryFlag_() directly (with
 * one getUserCountryMap_() read reused across everyone) when resolving many
 * people at once, as applyUserCountry_() does below — this wrapper does one
 * Script Properties read per call, so it's meant for one-off lookups, not a
 * per-row loop.
 */
function getUserCountryFlag(email) {
  apsRequireOwnerOrTrigger_(null); // r55: editor (script owner) only — not callable from the web app
  var key = normalizeEmail_(email);
  var entry = key ? getUserCountryMap_()[key] : null;
  return resolveCountryFlag_(entry);
}

/**
 * Merges each person's resolved country (see resolveCountryFlag_() above —
 * browser-detected, else saved Default Country, else none) onto every
 * teacher/student across `courses` (mutates the person objects in place) —
 * same pattern as applyLastLogin_. Adds `countryCode`, `countryName`, a
 * ready-to-render `countryFlag` emoji, and `countrySource`
 * (`'browser'`/`'default'`/`''`), each blank for anyone with no browser-
 * detected AND no saved Default Country yet — never a fabricated/guessed
 * value. Reads the whole USER_COUNTRY_PROP_KEY map from Script Properties
 * exactly once per call, regardless of how many people are in `courses` —
 * no per-row property reads or API calls.
 */
function applyUserCountry_(courses) {
  var map = apsCountryOn_() ? getUserCountryMap_() : {}; // r119: switched off — every flag blank, the map is not read
  courses.forEach(function (c) {
    (c.teachers || []).concat(c.students || []).forEach(function (p) {
      var key = normalizeEmail_(p.email);
      var info = resolveCountryFlag_(key ? map[key] : null);
      p.countryCode = info.countryCode;
      p.countryName = info.countryName;
      p.countryFlag = info.flag;
      p.countrySource = info.source;
    });
  });
  return courses;
}

/** ---------------------------------------------------------------------
 *  DEFAULT COUNTRY (Sept 2026 addition) — reuses the exact same
 *  USER_COUNTRY_PROP_KEY Script Property / getUserCountryMap_() map that
 *  recordViewerCountry()/applyUserCountry_() above already use for the
 *  best-effort, auto-detected "current login country" — no new/duplicate
 *  storage mechanism was introduced, per the "reuse existing storage"
 *  requirement. Each per-email entry now carries two independent pairs:
 *    - countryCode / countryName / updatedAt       — auto-detected (existing, unchanged)
 *    - defaultCountryCode / defaultCountryName / defaultUpdatedAt — user-chosen, sticky
 *  A user who has never set a default simply has no defaultCountryCode on
 *  their entry (or no entry at all) — this is fully backward-compatible
 *  with every entry written before this change.
 * ------------------------------------------------------------------- */

/**
 * Returns the current signed-in viewer's own saved Default Country (never
 * anyone else's — always keyed off the trusted Session.getActiveUser()
 * identity, never a client-supplied email), for the "Review Dashboard
 * Permissions" screen to decide whether to ask for a country (first time
 * only) or skip straight to the dashboard (every time after). Also returns
 * their most recent auto-detected country, if any, so the client can show
 * it as a suggested/prefilled option when a default hasn't been set yet.
 */
function getMyCountryPreference(sessionToken) {
  var session = requireValidSession_(sessionToken);
  var email = session.email;
  if (!apsCountryOn_()) return { hasDefault: true, disabled: true, defaultCountryCode: '', defaultCountryName: '', defaultFlag: '', detectedCountryCode: '', detectedCountryName: '' }; // r119: switched off — no country step, no flag
  return ucPref_(email); // r120: no country step at sign-in; the person's USER_COUNTRY row (outside USA) if any
  if (!email) return { hasDefault: false, defaultCountryCode: '', defaultCountryName: '', defaultFlag: '', detectedCountryCode: '', detectedCountryName: '' };
  var entry = getUserCountryMap_()[email] || {};
  return {
    hasDefault: !!entry.defaultCountryCode,
    defaultCountryCode: entry.defaultCountryCode || '',
    defaultCountryName: entry.defaultCountryName || '',
    defaultFlag: entry.defaultCountryCode ? countryCodeToFlagServer_(entry.defaultCountryCode) : '',
    // Best-effort hint only (e.g. to prefill the picker) — NOT used as a
    // substitute for an explicit user choice anywhere.
    detectedCountryCode: entry.countryCode || '',
    detectedCountryName: entry.countryName || ''
  };
}

/**
 * Saves (or changes) the CURRENT signed-in viewer's own Default Country.
 * Called once on first-time "Review Dashboard Permissions" (Part 1.1) and,
 * later, any time the signed-in user chooses to update it (Part 1.1.6) —
 * both paths go through this same function, so there is exactly one place
 * that ever writes a default. Trusted identity only: the email is always
 * Session.getActiveUser().getEmail(), never anything the client passes in,
 * so this can never set someone ELSE's default country.
 */
function setMyDefaultCountry(sessionToken, countryCode, countryName) {
  var session = requireValidSession_(sessionToken);
  var email = session.email;
  if (!email) throw new Error('Could not identify your signed-in account.');
  if (!apsCountryOn_()) return getMyCountryPreference(sessionToken); // r119: switched off — nothing is saved
  countryCode = String(countryCode || '').trim().toUpperCase();
  countryName = String(countryName || '').trim().slice(0, 100); // defensive cap — display text only
  if (!/^[A-Z]{2}$/.test(countryCode) || !countryName) throw new Error('Please select a valid country.');
  ucSetCountry_(email, countryCode, countryName, 'CHOSEN', email, session.role); // r120: USER_COUNTRY sheet (United States → row removed)
  return getMyCountryPreference(sessionToken);

  var lock = LockService.getScriptLock();
  try { lock.waitLock(5000); } catch (e) { /* proceed best-effort */ }
  try {
    var map = getUserCountryMap_();
    var entry = map[email] || {};
    entry.defaultCountryCode = countryCode;
    entry.defaultCountryName = countryName;
    entry.defaultUpdatedAt = new Date().toISOString();
    map[email] = entry;
    apsBigSet_(USER_COUNTRY_PROP_KEY, JSON.stringify(map)); // the person's own choice — a failure is reported to them
  } finally {
    try { lock.releaseLock(); } catch (e) { /* ignore */ }
  }
  return getMyCountryPreference(sessionToken);
}

/**
 * Marks a student as PERMANENTLY "onboarded" the first time they are ever
 * seen online by any signal (dashboard heartbeat, Meet, or Classroom
 * activity — see applyLivePresence_, which MUST run before this so that
 * `student.online` already reflects all three signals). Unlike the
 * transient `online`/`onlineSince` fields, `onboarded` is never cleared
 * once set — going offline afterward does not un-onboard a student. Mutates
 * `courses` in place, adding `onboarded` (bool) and `onboardedAt` (ISO
 * string or null) to every student across every course.
 */
function applyStudentOnboardedFlag_(courses) {
  var map = apsBigJson_(ONBOARDED_STUDENTS_PROP_KEY);
  var changed = false;
  var nowIso = new Date().toISOString();

  courses.forEach(function (c) {
    (c.students || []).forEach(function (s) {
      var key = normalizeEmail_(s.email);
      if (key && !map[key] && s.online) {
        map[key] = nowIso;
        changed = true;
      }
      s.onboarded = !!(key && map[key]);
      s.onboardedAt = (key && map[key]) || null;
    });
  });

  if (changed) apsBigSetSafe_(ONBOARDED_STUDENTS_PROP_KEY, JSON.stringify(map), 'Onboarded students');
  return courses;
}

/**
 * Returns { email, role, name, courses } for the person who opened the
 * dashboard — see getViewerContext_() above for exactly how role and the
 * course list are determined. The dashboard's allCourses is now this
 * filtered `courses` list, not the full synced set. Also records this
 * viewer's own presence heartbeat (see recordHeartbeat_) and merges live
 * online/login-time status onto every roster person (see applyLivePresence_),
 * merges the permanent, cross-source Last Login value onto every roster
 * person (see applyLastLogin_), computes the Class Status state machine
 * (see applyClassStatus_) for every course, then applies the permanent
 * per-student onboarded flag (see applyStudentOnboardedFlag_).
 */
function getDashboardData(sessionToken) {
  APS_REQ_MEMO_ = {}; // r121: request-scoped memo (settings read once per request)
  try { return apsSlimDashboardPayload_(getDashboardDataInner_(sessionToken)); } finally { APS_REQ_MEMO_ = null; }
}
function getDashboardDataInner_(sessionToken) {
  var session = requireValidSession_(sessionToken);
  var email = session.email;
  if (email) recordHeartbeat_(email);

  var courses = readAllCoursesFromCache_();
  applyRosterHiddenStaffFilter_(courses); // display-only Hide/Show toggle — filtered first so hidden accounts skip every decoration pass below too
  applyLivePresence_(courses);
  applyLastLogin_(courses);
  applyUserCountry_(courses);
  applyClassStatus_(courses);
  applyStudentOnboardedFlag_(courses);
  var availabilityByCourse = {}, availabilityAltByCourse = {};
  buildAvailabilityBoard_(courses, getCurrentWeekId_()).forEach(function (row) {
    availabilityByCourse[String(row.courseId)] = row.status === AVAILABILITY_STATUS.CONFIRMED ? 'Available to Take Classes' :
      row.status === AVAILABILITY_STATUS.NOT_AVAILABLE ? 'Not Available to Take Classes' : 'Not Set';
    if (row.status === AVAILABILITY_STATUS.NOT_AVAILABLE) availabilityAltByCourse[String(row.courseId)] = row.alternative || 'none'; // r77: quick filter by arrangement
  });
  courses.forEach(function (course) { course.teacherAvailabilityStatus = availabilityByCourse[String(course.id)] || 'Not Set'; course.teacherAvailabilityAlt = availabilityAltByCourse[String(course.id)] || ''; });
  applyWhatsAppLinks_(courses); // reads the editable WhatsApp_Group_Links sheet fresh every call
  applyMeetLinks_(courses); // Google Meet link per class (Admin mapping > Classroom text > auto-detected) — see CLASS MEET LINKS
  applyNilaiAndClassTimeFilters_(courses); // Round 37: attaches course.nilai / course.classTime for the new Classes-tab dropdown filters
  // Round 36: user asked that the classroom list ALWAYS display in plain
  // Ascending order (by name) — replacing the previous Live-first / No-
  // Students-first prioritization, which is no longer applied. Uses the
  // existing numeric-aware naturalCompareJs_() (mirrors the client's
  // naturalCompare()) so "NILAI - 10" sorts after "NILAI - 2", not before it.
  courses.sort(function (a, b) { return naturalCompareJs_(a.name, b.name); });

  var ctx = getViewerContext_(courses, { email: session.email, role: session.role });
  ctx.name = resolveViewerBadgeName_({ role: ctx.role, email: ctx.email }, courses); // real Google profile name for the top-right corner badge
  ctx.apsId = extractAPSID_(ctx.email);
  // Sept 2026 addendum: a viewer whose Dashboard role outranks 'teacher' in
  // getViewerRole_()'s priority order (Admin/Headmaster/BOD/SuperAdmin) but
  // who ALSO co-teaches an active Classroom course — common at a small
  // volunteer-run school, where the Principal/admin staff often also teach a
  // class themselves — previously had no way to request their own Reference
  // Letter: the tab/permission check required role === 'teacher' exactly,
  // which their higher-priority role always failed. This flag is computed
  // from the SAME already-in-hand `courses` list (no extra Sheet/Classroom
  // read), and is used, alongside role === 'teacher', to open Reference
  // Letter self-service to every actual classroom teacher regardless of
  // their overall Dashboard role. See getReferenceLetterAccessInfo()/
  // submitReferenceLetterRequest()/getMyReferenceLetterRequests() in Code.gs
  // and updateReferenceLetterTabVisibility()/loadReferenceLetterView() in
  // Dashboard.html.
  ctx.isClassroomTeacher = courses.some(function (c) { return courseHasTeacherEmail_(c, ctx.email); });
  ctx.apsRole = apsRoleFor_({ email: ctx.email, role: ctx.role }, courses); // VP / HM → "Class Support" label in the header
  ctx.roleLabel = isOnCallCoordinatorEmail_(ctx.email) ? ON_CALL_COORDINATOR_LABEL_ : ''; // r54: "On-Call Coordinator" badge (display only)
  ctx.tabAccess = acEffectiveForRole_(ctx.role); // r56: Access Control (tabs turned off for this role)
  ctx.coverageAccess = tccCanUse_(ctx.role, ctx.email, courses); // r58: Temporary Class Coverage sub-tab
  ctx.coverageTrackingAccess = ctx.coverageAccess; // r70: Class Coverage Tracking sub-tab (Admin / Super Admin / HM / class VP-HM)
  ctx.assignMonAccess = amAccessFlag_(ctx.role, ctx.email, courses); // r85: 📚 Assignment Monitoring (Access Control + class VP / HM; master ON/OFF)
  try { tccStampToday_(ctx.courses || []); } catch (eTcc) { console.warn('[Coverage] banner: ' + (eTcc && eTcc.message)); } // r58: "merged today" banner on class cards
  try { ttmStampCards_(ctx.courses || []); } catch (eTtm) { console.warn('[TempTeacher] card note: ' + (eTtm && eTtm.message)); } // r89: "On-Call Teacher Assigned" note on class cards (every role)
  ctx.tempTeacherAccess = ttmCanUse_(ctx.role, ctx.email); // r89: Classes → Temp Teacher sub-tab (server re-checks every call)
  (ctx.courses || []).forEach(function (c) { c.liveBox = apsClassLiveBox_(c); }); // r64: class-card "Status" box (class time / live Meet only)
  ctx.canViewMonitoringFilters = canViewMonitoringFilters_(ctx.role);
  ctx.canViewMonitoringTotals = canViewMonitoringTotals_(ctx.role);
  ctx.permissions = getDashboardRolePermission_(ctx.role);
  ctx.examinationAccess = examinationAccessForRole_(ctx.role); // Examination tab gate (see EXAMINATION MODULE)
  ctx.gradingAccess = rosterAccessForRole_(ctx.role); // Examination > Grading sub-tab gate (see CLASSROOM ROSTER / GRADING MODULE)
  if (isAdminRole_(ctx.role)) rosterEnsureTrigger_(false); // daily 5 PM automatic syncs (one cache read; trigger check at most every 6 h)
  ctx.environment = getDashboardEnvironment_();
  // Current "Hide/Show" toggle state, piggy-backed onto the payload every
  // getDashboardData() call already returns — so the toolbar button (Admin/
  // Super Admin only, see updateHiddenStaffToggle() in Dashboard.html) can
  // show the correct Hide/Show label without a separate round trip.
  ctx.rosterHiddenStaffVisible = getRosterHiddenStaffVisible_();
  var onCallTeachers = getOnCallTeachers_();
  // Sept 2026, twenty-eighth round: decorate EVERY on-call teacher once,
  // up front (country flag + [TCS] flag) — not just whichever single one
  // used to be featured. The per-classroom roster below now picks
  // independently PER COURSE (see below), so every candidate needs this
  // data ready beforehand. Still zero extra Classroom API calls: this only
  // touches the small, already-cached getOnCallTeachers_() directory (a
  // handful of entries at most) — same resolveCountryFlag_() every other
  // roster entry already goes through.
  var onCallUserCountryMap = getUserCountryMap_();
  onCallTeachers.forEach(function (t) {
    var info = resolveCountryFlag_(onCallUserCountryMap[normalizeEmail_(t.email)]);
    t.countryCode = info.countryCode;
    t.countryName = info.countryName;
    t.countryFlag = info.flag;
    // [TCS] badge — true for every tcs_* address, false for the one
    // specifically-named legacy on-call account; computed once here,
    // server-side, from the same isOnCallTeacherEmail_() pattern rather than
    // re-deriving it from a raw email string on the client.
    t.isTcs = normalizeEmail_(t.email).indexOf('tcs_') === 0;
  });

  // Dashboard-wide pick — kept for the existing top-of-page banner only
  // (unchanged behavior: one pick, re-rolled every getDashboardData() call).
  ctx.onCallTeacherCount = onCallTeachers.length;
  ctx.onCallTeacher = onCallTeachers.length
    ? onCallTeachers[Math.floor(Math.random() * onCallTeachers.length)]
    : null;

  // r68 performance: the per-classroom on-call pick (course.onCallTeacher / onCallTeacherCount / onCallOtherNames)
  // is no longer attached to every course — the on-call roster left the class card in r45 and the browser never read
  // these fields again (≈0.5–1 KB per class in every dashboard load). The dashboard-wide pick above (top banner) is unchanged.
  (ctx.courses || []).forEach(function (course) { delete course.rosterTeacherEmails; delete course.onCallRoster; }); // r46/r47: server-side data only
  try { ctx.schoolLeave = getAPSSchoolLeaveStatus(new Date()); } catch (eSL) { ctx.schoolLeave = { isSchoolLeave: false }; } // r109 banner
  return ctx;
}

function getLastSyncInfo(sessionToken) {
  requireValidSession_(sessionToken);
  return PropertiesService.getScriptProperties().getProperty(LAST_SYNC_KEY) || null;
}

/**
 * Lightweight realtime status endpoint used by the open dashboard.
 *
 * IMPORTANT: This deliberately does NOT call getDashboardData(), Classroom,
 * or any of the expensive presence/roster logic. The Teacher NOT in Class
 * and Needs Tech Support flows already persist their state immediately in
 * Script Properties, so polling these tiny maps is enough to make those
 * operational alerts appear on other open dashboards within a few seconds.
 */
function updateExternalActivityRealtimeCache_(meetPresence, classroomActivity) {
  var map = {};
  var gm = meetPresence || {};
  Object.keys(gm).forEach(function (email) {
    var key = normalizeEmail_(email);
    if (key && gm[email]) map[key] = { gm: gm[email], gc: null };
  });
  var gcLatest = {};
  Object.keys(classroomActivity || {}).forEach(function (key) {
    var parts = String(key).split('|');
    var email = normalizeEmail_(parts.shift());
    var time = classroomActivity[key];
    if (!email || !time) return;
    if (!gcLatest[email] || new Date(time).getTime() > new Date(gcLatest[email]).getTime()) gcLatest[email] = time;
  });
  Object.keys(gcLatest).forEach(function (email) {
    map[email] = map[email] || { gm: null, gc: null };
    map[email].gc = gcLatest[email];
  });
  PropertiesService.getScriptProperties().setProperty(EXTERNAL_ACTIVITY_REALTIME_PROP_KEY, JSON.stringify(map));
  return map;
}

function getExternalActivityRealtimeMap_() {
  var raw = PropertiesService.getScriptProperties().getProperty(EXTERNAL_ACTIVITY_REALTIME_PROP_KEY);
  return raw ? JSON.parse(raw) : {};
}

function getRealtimeAvailabilityMap_() {
  var raw = PropertiesService.getScriptProperties().getProperty(TEACHER_AVAILABILITY_REALTIME_PROP_KEY);
  return raw ? JSON.parse(raw) : {};
}

function getRealtimeStatusSnapshot(sessionToken) {
  var session = requireValidSession_(sessionToken);
  APS_REQ_MEMO_ = {}; // r121: request-scoped memo
  try {
  var liveStatus = null; // r64: class-card "Status" box (null on any error → the browser keeps what it shows)

      }
      Object.assign(have[k], { email: w.email, roles: w.roles, primary: w.primary, courseId: w.courseId, courseName: w.courseName, classroomRole: w.classroomRole, source: w.source, permission: w.permission, status: 'ACTIVE', lastSynced: now });
